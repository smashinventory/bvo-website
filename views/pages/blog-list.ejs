<%/* Public Blog List — /blog */%>
<div class="blog-hero">
  <div class="blog-hero-inner">
    <h1 class="blog-hero-title">Bathroom Design Blog</h1>
    <p class="blog-hero-sub">Renovation tips, product guides, and design inspiration</p>
  </div>
</div>

<div class="blog-list-wrap">
  <div class="blog-list-container">

    <% if (!posts.length) { %>
    <div class="blog-empty">
      <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity:.3;margin-bottom:1rem"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      <p>No posts yet — check back soon!</p>
    </div>
    <% } %>

    <div class="blog-grid">
      <% posts.forEach(function(p) {
        var pubDate = p.published_at ? new Date(p.published_at).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) : '';
        var tags    = (p.tags || '').split(',').map(function(t){return t.trim();}).filter(Boolean);
      %>
      <article class="blog-card">
        <% if (p.featured_image) { %>
        <a href="/blog/<%= p.slug %>" class="blog-card-img-link">
          <img src="<%= p.featured_image %>" alt="<%= p.title %>" class="blog-card-img" loading="lazy">
        </a>
        <% } %>
        <div class="blog-card-body">
          <% if (tags.length) { %>
          <div class="blog-card-tags">
            <% tags.slice(0,3).forEach(function(tag) { %><span class="blog-tag"><%= tag %></span><% }); %>
          </div>
          <% } %>
          <h2 class="blog-card-title"><a href="/blog/<%= p.slug %>"><%= p.title %></a></h2>
          <p class="blog-card-excerpt"><%= p.excerpt %></p>
          <div class="blog-card-meta">
            <% if (pubDate) { %><time datetime="<%= p.published_at %>" class="blog-card-date"><%= pubDate %></time><% } %>
            <% if (p.author) { %><span class="blog-card-author">by <%= p.author %></span><% } %>
          </div>
          <a href="/blog/<%= p.slug %>" class="blog-read-more">Read more →</a>
        </div>
      </article>
      <% }); %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <nav class="blog-pagination" aria-label="Blog pages">
      <% if (page > 1) { %>
      <a href="/blog?page=<%= page-1 %>" class="blog-pg-btn">← Previous</a>
      <% } %>
      <% for (var i=1; i<=totalPages; i++) { %>
      <a href="/blog?page=<%= i %>" class="blog-pg-btn <%= i===page?'active':'' %>"><%= i %></a>
      <% } %>
      <% if (page < totalPages) { %>
      <a href="/blog?page=<%= page+1 %>" class="blog-pg-btn">Next →</a>
      <% } %>
    </nav>
    <% } %>

  </div>
</div>
