<%/* ── Bundle Builder ─────────────────────────────────────────────────
     /bundle-builder — standalone page (not a collection)
     Step 1 · Cabinet Only  (required)           → 0 % off alone
     Step 2 · Vanity Top    (required + cabinet) → 5 % off
     Step 3 · Mirror        (optional)           → 10% off
     Step 4 · Faucet        (coming soon)        → 15% off
     ──────────────────────────────────────────────────────────────── */%>

<!-- Breadcrumb — site standard pattern (matches collection pages) -->
<div class="breadcrumb">
  <a href="/">Home</a> &rsaquo;
  James Martin Bundle Builder
</div>

<div class="bb-wrap">

  <!-- ── Page hero ──────────────────────────────────────────────── -->
  <header class="bb-hero">
    <p class="bb-eyebrow">James Martin Vanities</p>
    <h1 class="bb-title">Build Your Unique Bundle</h1>
    <p class="bb-subtitle">Mix and match, save up to 15%. Mirrors and faucets can be added as a matched pair for double vanities — a pair still counts as one bundle step. Each item ships free.</p>

    <!-- Discount tier bar (starts at Vanity + Top — no 0% entry) -->
    <div class="bb-tiers" aria-label="Bundle discount tiers">
      <div class="bb-tier" data-items="2">
        <span class="bb-tier-label">Vanity + Top</span>
        <span class="bb-tier-pct">5% Off</span>
      </div>
      <div class="bb-tier-arrow" aria-hidden="true">›</div>
      <div class="bb-tier" data-items="3">
        <span class="bb-tier-label">+ Mirror (or pair)</span>
        <span class="bb-tier-pct">10% Off</span>
      </div>
      <div class="bb-tier-arrow" aria-hidden="true">›</div>
      <div class="bb-tier" data-items="4">
        <span class="bb-tier-label">+ Faucet (or pair)</span>
        <span class="bb-tier-pct">15% Off</span>
      </div>
    </div>
  </header>

  <!-- ── Steps ──────────────────────────────────────────────────── -->
  <div class="bb-steps">

    <!-- ── STEP 1: Cabinet ──────────────────────────────────────── -->
    <section class="bb-step" id="bb-step-cabinet">
      <div class="bb-step-hd">
        <div class="bb-step-num" aria-hidden="true">1</div>
        <div class="bb-step-hd-text">
          <h2 class="bb-step-title">Pick Your Vanity Cabinet</h2>
          <p class="bb-step-meta" id="bb-meta-cabinet">Required · Stone-top-compatible cabinets · Top sold separately</p>
        </div>
        <div class="bb-vnav" id="bb-vnav-cabinet">
          <span class="bb-vnav-count" id="bb-count-cabinet">—</span>
        </div>
        <div class="bb-sel-badge" id="bb-badge-cabinet" hidden>
          <svg viewBox="0 0 20 20" width="13" height="13" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
          <span id="bb-badge-text-cabinet"></span>
        </div>
      </div>

      <div class="bb-mcard" id="bb-mcard-cabinet">
        <!-- Image col -->
        <div class="bb-mcard-img-col">
          <img class="bb-mcard-img" id="bb-img-cabinet" src="" alt="" loading="lazy">
          <button class="bb-img-arrow bb-img-arrow--prev" id="bb-prev-cabinet" type="button" aria-label="Previous model">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="bb-img-arrow bb-img-arrow--next" id="bb-next-cabinet" type="button" aria-label="Next model">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
          <button class="heart-btn" id="bb-heart-cabinet" type="button"
                  data-product-id="" data-product-slug="" aria-label="Save to favorites">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
        </div>
        <!-- Info col -->
        <div class="bb-mcard-info">
          <p class="bb-mcard-collection" id="bb-col-cabinet"></p>
          <div class="bb-mcard-name-price">
            <span class="bb-mcard-name" id="bb-name-cabinet"></span>
            <div class="bb-mcard-price-block">
              <span class="bb-mcard-price" id="bb-price-cabinet"></span>
              <s class="bb-mcard-compare" id="bb-compare-cabinet"></s>
              <span class="bb-mcard-save-badge" id="bb-save-cabinet"></span>
            </div>
          </div>
          <!-- Size chips -->
          <div class="bb-picker-row">
            <span class="bb-picker-lbl">Size</span>
            <div class="bb-size-chips" id="bb-sizes-cabinet"></div>
          </div>
          <!-- Finish swatches -->
          <div class="bb-picker-row bb-picker-row--finish">
            <span class="bb-picker-lbl">Finish</span>
            <div class="bb-swatches-wrap">
              <div class="bb-swatches" id="bb-swatches-cabinet"></div>
              <span class="bb-finish-name" id="bb-finish-cabinet"></span>
            </div>
          </div>
          <a class="bb-view-link" id="bb-viewlink-cabinet" href="" target="_blank">View product page ›</a>
          <button class="btn btn-navy bb-select-btn" id="bb-select-cabinet" type="button" disabled>Select</button>
        </div>
      </div>
    </section>

    <!-- ── STEP 2: Top ──────────────────────────────────────────── -->
    <section class="bb-step bb-step--locked" id="bb-step-top">
      <div class="bb-step-hd">
        <div class="bb-step-num" aria-hidden="true">2</div>
        <div class="bb-step-hd-text">
          <h2 class="bb-step-title">Pick Your Vanity Top</h2>
          <p class="bb-step-meta" id="bb-meta-top">Required · Select a vanity cabinet first · Adds 5% off</p>
        </div>
        <div class="bb-vnav" id="bb-vnav-top">
          <span class="bb-vnav-count" id="bb-count-top">—</span>
        </div>
        <div class="bb-sel-badge" id="bb-badge-top" hidden>
          <svg viewBox="0 0 20 20" width="13" height="13" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
          <span id="bb-badge-text-top"></span>
        </div>
      </div>

      <div class="bb-mcard" id="bb-mcard-top">
        <div class="bb-locked-msg">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
          </svg>
          <p>Select your vanity cabinet above to see matching tops</p>
        </div>
      </div>
    </section>

    <!-- ── STEP 3: Mirror ──────────────────────────────────────── -->
    <section class="bb-step" id="bb-step-mirror">
      <div class="bb-step-hd">
        <div class="bb-step-num" aria-hidden="true">3</div>
        <div class="bb-step-hd-text">
          <h2 class="bb-step-title">Pick Your Mirror <span class="bb-optional-tag">Optional</span></h2>
          <p class="bb-step-meta">Add a mirror — or a matched pair for double vanities — to unlock 10% off your entire bundle</p>
        </div>
        <div class="bb-vnav" id="bb-vnav-mirror">
          <span class="bb-vnav-count" id="bb-count-mirror">—</span>
        </div>
        <div class="bb-sel-badge" id="bb-badge-mirror" hidden>
          <svg viewBox="0 0 20 20" width="13" height="13" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
          <span id="bb-badge-text-mirror"></span>
        </div>
      </div>

      <div class="bb-mcard" id="bb-mcard-mirror">
        <!-- Image col -->
        <div class="bb-mcard-img-col">
          <img class="bb-mcard-img" id="bb-img-mirror" src="" alt="" loading="lazy">
          <button class="bb-img-arrow bb-img-arrow--prev" id="bb-prev-mirror" type="button" aria-label="Previous model">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="bb-img-arrow bb-img-arrow--next" id="bb-next-mirror" type="button" aria-label="Next model">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
          <button class="heart-btn" id="bb-heart-mirror" type="button"
                  data-product-id="" data-product-slug="" aria-label="Save to favorites">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
        </div>
        <!-- Info col -->
        <div class="bb-mcard-info">
          <p class="bb-mcard-collection" id="bb-col-mirror"></p>
          <div class="bb-mcard-name-price">
            <span class="bb-mcard-name" id="bb-name-mirror"></span>
            <div class="bb-mcard-price-block">
              <span class="bb-mcard-price" id="bb-price-mirror"></span>
              <s class="bb-mcard-compare" id="bb-compare-mirror"></s>
              <span class="bb-mcard-save-badge" id="bb-save-mirror"></span>
            </div>
          </div>
          <!-- Size chips -->
          <div class="bb-picker-row">
            <span class="bb-picker-lbl">Size</span>
            <div class="bb-size-chips" id="bb-sizes-mirror"></div>
          </div>
          <!-- Finish swatches -->
          <div class="bb-picker-row bb-picker-row--finish">
            <span class="bb-picker-lbl">Finish</span>
            <div class="bb-swatches-wrap">
              <div class="bb-swatches" id="bb-swatches-mirror"></div>
              <span class="bb-finish-name" id="bb-finish-mirror"></span>
            </div>
          </div>
          <a class="bb-view-link" id="bb-viewlink-mirror" href="" target="_blank">View product page ›</a>
          <button class="btn btn-navy bb-select-btn" id="bb-select-mirror" type="button" disabled>Select</button>
          <!-- Qty toggle — shown after selection -->
          <div class="bb-qty-row" id="bb-qty-row-mirror" style="display:none">
            <span class="bb-qty-lbl">Quantity:</span>
            <div class="bb-qty-btns">
              <button class="bb-qty-btn is-active" data-step="mirror" data-qty="1" type="button">1</button>
              <button class="bb-qty-btn" data-step="mirror" data-qty="2" type="button">2 &mdash; Matched Pair</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── STEP 4: Faucet ────────────────────────────────────────── -->
    <section class="bb-step" id="bb-step-faucet">
      <div class="bb-step-hd">
        <div class="bb-step-num" aria-hidden="true">4</div>
        <div class="bb-step-hd-text">
          <h2 class="bb-step-title">Pick Your Faucet <span class="bb-optional-tag">Optional</span></h2>
          <p class="bb-step-meta">Add a faucet — or a matched pair for double vanities — to unlock 15% off your entire bundle</p>
        </div>
        <div class="bb-vnav" id="bb-vnav-faucet">
          <span class="bb-vnav-count" id="bb-count-faucet">—</span>
        </div>
        <div class="bb-sel-badge" id="bb-badge-faucet" hidden>
          <svg viewBox="0 0 20 20" width="13" height="13" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
          <span id="bb-badge-text-faucet"></span>
        </div>
      </div>

      <!-- Universal compatibility note -->
      <div class="bb-compat-note">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd"/></svg>
        <span>James Martin vanities use standard 8&rdquo; widespread faucet holes &mdash; compatible with any brand. Mix and match freely.</span>
      </div>

      <div class="bb-mcard" id="bb-mcard-faucet">
        <!-- Image col -->
        <div class="bb-mcard-img-col">
          <img class="bb-mcard-img" id="bb-img-faucet" src="" alt="" loading="lazy">
          <button class="bb-img-arrow bb-img-arrow--prev" id="bb-prev-faucet" type="button" aria-label="Previous faucet">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="bb-img-arrow bb-img-arrow--next" id="bb-next-faucet" type="button" aria-label="Next faucet">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
          <button class="heart-btn" id="bb-heart-faucet" type="button"
                  data-product-id="" data-product-slug="" aria-label="Save to favorites">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
        </div>
        <!-- Info col -->
        <div class="bb-mcard-info">
          <p class="bb-mcard-collection" id="bb-col-faucet"></p>
          <div class="bb-mcard-name-price">
            <span class="bb-mcard-name" id="bb-name-faucet"></span>
            <div class="bb-mcard-price-block">
              <span class="bb-mcard-price" id="bb-price-faucet"></span>
              <s class="bb-mcard-compare" id="bb-compare-faucet"></s>
              <span class="bb-mcard-save-badge" id="bb-save-faucet"></span>
            </div>
          </div>
          <!-- Size chips (faucet — optional, shown only if width_in present) -->
          <div class="bb-picker-row" id="bb-sizes-row-faucet">
            <span class="bb-picker-lbl">Size</span>
            <div class="bb-size-chips" id="bb-sizes-faucet"></div>
          </div>
          <!-- Finish swatches -->
          <div class="bb-picker-row bb-picker-row--finish">
            <span class="bb-picker-lbl">Finish</span>
            <div class="bb-swatches-wrap">
              <div class="bb-swatches" id="bb-swatches-faucet"></div>
              <span class="bb-finish-name" id="bb-finish-faucet"></span>
            </div>
          </div>
          <a class="bb-view-link" id="bb-viewlink-faucet" href="" target="_blank">View product page ›</a>
          <button class="btn btn-navy bb-select-btn" id="bb-select-faucet" type="button" disabled>Select</button>
          <!-- Qty toggle — shown after selection -->
          <div class="bb-qty-row" id="bb-qty-row-faucet" style="display:none">
            <span class="bb-qty-lbl">Quantity:</span>
            <div class="bb-qty-btns">
              <button class="bb-qty-btn is-active" data-step="faucet" data-qty="1" type="button">1</button>
              <button class="bb-qty-btn" data-step="faucet" data-qty="2" type="button">2 &mdash; Matched Pair</button>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div><!-- /.bb-steps -->

  <!-- ── Sticky summary ────────────────────────────────────────── -->
  <div class="bb-summary" id="bb-summary">

    <table class="bb-sum-table">
      <colgroup>
        <col class="bsc-num">
        <col class="bsc-product">
        <col class="bsc-msrp">
        <col class="bsc-sale">
        <col class="bsc-bundle">
        <col class="bsc-final">
      </colgroup>
      <thead>
        <!-- Spanning title row -->
        <tr class="bb-sum-hd-span">
          <th colspan="2" class="bb-sum-hd-title">Your Custom Bundle</th>
          <th></th>
          <th colspan="2" class="bb-sum-hd-disc">Discounts</th>
          <th></th>
        </tr>
        <!-- Column headers -->
        <tr>
          <th class="bb-sum-num">Item</th>
          <th class="bb-sum-name">Product</th>
          <th class="bb-sum-msrp">MSRP</th>
          <th class="bb-sum-sale-col">Sale ↓</th>
          <th class="bb-sum-bundle-col">Bundle ↓</th>
          <th class="bb-sum-price">Final</th>
        </tr>
      </thead>
      <!-- Item rows — JS replaces tbody innerHTML -->
      <tbody id="bb-summary-items">
        <tr class="bb-sum-row--empty"><td class="bb-sum-num">1</td><td class="bb-sum-name bb-sum-none">Cabinet not selected</td><td class="bb-sum-msrp bb-sum-none">—</td><td class="bb-sum-sale-col bb-sum-none">—</td><td class="bb-sum-bundle-col bb-sum-none">—</td><td class="bb-sum-price bb-sum-none">—</td></tr>
        <tr class="bb-sum-row--empty"><td class="bb-sum-num">2</td><td class="bb-sum-name bb-sum-none">Top not selected</td><td class="bb-sum-msrp bb-sum-none">—</td><td class="bb-sum-sale-col bb-sum-none">—</td><td class="bb-sum-bundle-col bb-sum-none">—</td><td class="bb-sum-price bb-sum-none">—</td></tr>
        <tr class="bb-sum-row--empty"><td class="bb-sum-num">3</td><td class="bb-sum-name bb-sum-none">Mirror not selected</td><td class="bb-sum-msrp bb-sum-none">—</td><td class="bb-sum-sale-col bb-sum-none">—</td><td class="bb-sum-bundle-col bb-sum-none">—</td><td class="bb-sum-price bb-sum-none">—</td></tr>
        <tr class="bb-sum-row--empty"><td class="bb-sum-num">4</td><td class="bb-sum-name bb-sum-none">Faucet not selected</td><td class="bb-sum-msrp bb-sum-none">—</td><td class="bb-sum-sale-col bb-sum-none">—</td><td class="bb-sum-bundle-col bb-sum-none">—</td><td class="bb-sum-price bb-sum-none">—</td></tr>
      </tbody>
      <!-- Totals tbody — JS shows/hides via id="bb-savings-breakdown" -->
      <tbody id="bb-savings-breakdown" style="display:none">
        <tr class="bb-sum-row--sub">
          <td colspan="4" class="bb-sum-totals-lbl">Total Retail</td>
          <td colspan="2" class="bb-sum-amt" id="bb-original-total"></td>
        </tr>
        <tr class="bb-sum-row--sub">
          <td colspan="4" class="bb-sum-totals-lbl bb-sav-lbl">Outlet Savings</td>
          <td colspan="2" class="bb-sum-amt bb-sav-green" id="bb-outlet-sav"></td>
        </tr>
        <tr class="bb-sum-row--sub">
          <td colspan="4" class="bb-sum-totals-lbl bb-sav-lbl">Bundle Savings</td>
          <td colspan="2" class="bb-sum-amt bb-sav-amber" id="bb-bundle-sav"></td>
        </tr>
        <tr class="bb-sum-row--bundle-total">
          <td colspan="4" class="bb-sum-bundle-total-lbl">Your Custom Bundle Total</td>
          <td colspan="2" class="bb-final-total" id="bb-final-total"></td>
        </tr>
      </tbody>
    </table>

    <!-- Actions bar -->
    <div class="bb-sum-actions-bar">
      <div class="bb-discount-badge" id="bb-discount-badge">Add items to save</div>
      <div class="bb-sum-btn-group">
        <button class="btn btn-navy bb-cart-btn" id="bb-add-cart" type="button" disabled>
          Add Bundle to Cart
        </button>
        <p class="bb-cart-note">Each item added at the discounted price</p>
      </div>
    </div>

  </div>

</div><!-- /.bb-wrap -->

<script nonce="<%= cspNonce %>">
(function () {
  'use strict';

  /* ── Server data ──────────────────────────────────────────────── */
  var CABINET_MODELS = <%- JSON.stringify(cabinetModels) %>;
  var TOP_MODELS     = <%- JSON.stringify(topModels)     %>;
  var MIRROR_MODELS  = <%- JSON.stringify(mirrorModels)  %>;
  var FAUCET_MODELS  = <%- JSON.stringify(faucetModels)  %>;
  var FAMILY_HEX     = <%- JSON.stringify(familyHex)     %>;
  var SIZE_BUCKETS   = <%- JSON.stringify(sizeBuckets)   %>;

  /* ── Per-item-type bundle discounts ───────────────────────────── */
  /* Vanity is never discounted; each add-on earns its own fixed % off */
  var ITEM_DISC = { cabinet: 0, top: 5, mirror: 10, faucet: 15 };

  /* ── Viewer state ─────────────────────────────────────────────── */
  var gIdx   = { cabinet: 0,    top: 0,    mirror: 0,    faucet: 0    };  // current model index
  var gSize  = { cabinet: null,             mirror: null, faucet: null };  // persists across model nav
  var gColor = { cabinet: null, top: null,  mirror: null, faucet: null };  // resets on model change

  /* ── Selection state ──────────────────────────────────────────── */
  var state = { cabinet: null, top: null, mirror: null, faucet: null, mirrorQty: 1, faucetQty: 1 };

  /* ── Helpers ──────────────────────────────────────────────────── */

  /* Map a raw width_in value to its SIZE_BUCKET object (or null) */
  function getBucket(widthIn) {
    var w = parseFloat(widthIn);
    if (isNaN(w) || w <= 0) return null;
    return SIZE_BUCKETS.find(function(b) { return w >= b.min && w <= b.max; }) || null;
  }

  /* Derive 'S' (Single) or 'D' (Double) from a product_type string, or null if unknown */
  function sinkKeyFromProductType(pt) {
    if (!pt) return null;
    if (pt.indexOf('Single') !== -1) return 'S';
    if (pt.indexOf('Double') !== -1) return 'D';
    return null;
  }

  /* Unique sorted size chip objects for a model.
   * When a size bucket has BOTH Single and Double SKUs, emits two chips:
   *   { label: '60S', min, max, sink: 'S' } and { label: '60D', min, max, sink: 'D' }
   * When only one sink config exists at a size, emits a plain chip:
   *   { label: '60',  min, max, sink: null }
   * All other steps (mirror, faucet) have no product_type distinction — plain chips always. */
  function modelBuckets(model) {
    if (!model) return [];
    var skus = model.skus || [];

    /* First pass: per-bucket, record which sink keys are present */
    var bktSinkPresent = {}; /* { '60': { S: true, D: true } } */
    skus.forEach(function(s) {
      var b = getBucket(s.width_in);
      if (!b) return;
      var sk = sinkKeyFromProductType(s.product_type);
      if (!bktSinkPresent[b.label]) bktSinkPresent[b.label] = {};
      bktSinkPresent[b.label][sk || 'none'] = true;
    });

    /* Second pass: emit chip objects, deduplicating by chip label */
    var seen = {};
    var out  = [];
    skus.forEach(function(s) {
      var b = getBucket(s.width_in);
      if (!b) return;
      var sk = sinkKeyFromProductType(s.product_type);
      var hasBoth = bktSinkPresent[b.label] &&
                    bktSinkPresent[b.label]['S'] &&
                    bktSinkPresent[b.label]['D'];
      /* Only split into S/D chips when both configs exist AND we have a known sink key */
      var chipLabel = (hasBoth && sk) ? (b.label + sk) : b.label;
      var chipSink  = (hasBoth && sk) ? sk : null;
      if (!seen[chipLabel]) {
        seen[chipLabel] = true;
        out.push({ label: chipLabel, min: b.min, max: b.max, sink: chipSink });
      }
    });
    out.sort(function(a, b) {
      if (a.min !== b.min) return a.min - b.min;
      return (a.sink || '').localeCompare(b.sink || '');
    });
    return out;
  }

  function fmt(n) {
    return '$' + parseFloat(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function esc(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function el(id) { return document.getElementById(id); }

  /* ── Model lists ──────────────────────────────────────────────── */
  function getModels(step) {
    if (step === 'cabinet') return CABINET_MODELS;
    if (step === 'top')     return activeTops();
    if (step === 'mirror')  return activeMirrors();
    if (step === 'faucet')  return FAUCET_MODELS;
    return [];
  }

  /* Mirrors sorted with same-model mirror first once a cabinet is selected.
     Full list remains navigable — this is a suggestion, not a filter.
     When no cabinet is selected (or cabinet has no model), returns MIRROR_MODELS
     in original order. Re-sort fires whenever state.cabinet changes. */
  function activeMirrors() {
    if (!state.cabinet || !state.cabinet.model) return MIRROR_MODELS;
    var cabModel = state.cabinet.model;
    var match    = MIRROR_MODELS.filter(function(m) { return m.model === cabModel; });
    var rest     = MIRROR_MODELS.filter(function(m) { return m.model !== cabModel; });
    return match.concat(rest);
  }

  /* Tops: each SKU is its own navigable item.
     Stone/composite tops have no meaningful color variants — each is a
     distinct material (Carrara White Marble, White Zeus Quartz, etc.).
     Flattening to individual SKUs lets the user arrow through all options.
     Width bucket filter applied once a cabinet is selected (range match,
     not exact equality, to handle minor dimension variations). */
  function activeTops() {
    var allSkus = [];
    TOP_MODELS.forEach(function(m) { allSkus = allSkus.concat(m.skus); });

    if (state.cabinet && state.cabinet.width_in) {
      var cabBkt = getBucket(state.cabinet.width_in);
      if (cabBkt) {
        allSkus = allSkus.filter(function(s) {
          var w = parseFloat(s.width_in);
          return w >= cabBkt.min && w <= cabBkt.max;
        });
      }
    }

    // Each SKU becomes its own model entry — no color grouping for tops
    return allSkus.map(function(s) { return { model: null, skus: [s] }; });
  }

  /* SKUs for current model, optionally size-filtered (except top — already width-locked).
     gSize[step] is a SIZE_BUCKET object { label, min, max } or null. */
  function getSizeFilteredSkus(step, model) {
    if (!model) return [];
    var skus = model.skus;
    if (step === 'top') return skus;
    var bkt = gSize[step];
    if (bkt) {
      var f = skus.filter(function(s) {
        var w = parseFloat(s.width_in);
        if (w < bkt.min || w > bkt.max) return false;
        /* When the chip has a sink key (e.g. 'S' or 'D'), also filter by
           single/double config so '60S' and '60D' show distinct products. */
        if (bkt.sink) {
          var sk = sinkKeyFromProductType(s.product_type);
          return sk === bkt.sink;
        }
        return true;
      });
      if (f.length) return f;
    }
    return skus;
  }

  /* The SKU to display right now (color-selected or first available) */
  function getDisplaySku(step, model) {
    var skus = getSizeFilteredSkus(step, model);
    var c    = gColor[step];
    if (c) {
      var m = skus.find(function(s) { return s.color === c; });
      if (m) return m;
    }
    return skus[0] || null;
  }

  /* ── Price block renderer (compare, sale, save-badge) ────────── */
  function renderPriceBlock(step, displaySku) {
    var priceEl     = el('bb-price-'   + step);
    var compareEl   = el('bb-compare-' + step);
    var saveBadgeEl = el('bb-save-'    + step);
    if (!displaySku || !parseFloat(displaySku.price)) {
      if (priceEl)     priceEl.textContent    = '';
      if (compareEl)   compareEl.textContent   = '';
      if (saveBadgeEl) saveBadgeEl.textContent = '';
      return;
    }
    var sp = parseFloat(displaySku.price);
    var cp = parseFloat(displaySku.compare_price || 0);
    if (priceEl) priceEl.textContent = fmt(sp);
    if (compareEl) {
      if (cp > sp) { compareEl.textContent = fmt(cp); compareEl.style.display = ''; }
      else         { compareEl.textContent = '';       compareEl.style.display = 'none'; }
    }
    if (saveBadgeEl) {
      if (cp > sp) { saveBadgeEl.textContent = 'Save ' + fmt(cp - sp); saveBadgeEl.style.display = ''; }
      else         { saveBadgeEl.textContent = '';                      saveBadgeEl.style.display = 'none'; }
    }
  }

  /* ── Swatch rendering ─────────────────────────────────────────── */
  function swatchHtml(step, sku) {
    var chipImg  = sku.chip_image;
    var cfKey    = sku.color_family || '';
    var hex      = FAMILY_HEX[cfKey] || '#C9B89A';
    var border   = FAMILY_HEX[cfKey + '_border'] || hex;
    var isActive = gColor[step] === sku.color;
    var style    = chipImg
      ? 'background-image:url(' + esc(chipImg) + ');background-size:cover;background-position:center;border-color:' + (isActive ? 'var(--amber,#B8862A)' : border)
      : 'background-color:' + hex + ';border-color:' + (isActive ? 'var(--amber,#B8862A)' : border);
    return '<button class="bb-swatch' + (isActive ? ' is-active' : '') + '"'
      + ' type="button"'
      + ' data-step="'  + step         + '"'
      + ' data-color="' + esc(sku.color) + '"'
      + ' title="'      + esc(sku.color) + '"'
      + ' aria-label="' + esc(sku.color) + '"'
      + ' style="'      + style          + '">'
      + '</button>';
  }

  /* ── Top material swatches (Step 2 — stone tops) ─────────────── */
  function topMatSwatchHtml(material, imgUrl, topIdx, isActive) {
    var style = imgUrl
      ? 'background-image:url(' + esc(imgUrl) + ');background-size:cover;background-position:center;'
      : 'background-color:#C9B89A;';
    return '<button class="bb-swatch bb-swatch--topmat' + (isActive ? ' is-active' : '') + '"'
      + ' type="button" data-top-idx="' + topIdx + '"'
      + ' title="'      + esc(material || 'Other') + '"'
      + ' aria-label="' + esc(material || 'Other') + '"'
      + ' style="' + style + '">'
      + '</button>';
  }

  function matBaseKey(mat) {
    // Silestone is Cosentino's brand of engineered quartz — normalize it so
    // "X Quartz" and "X Silestone" share one swatch. Marble stays distinct.
    return mat.replace(/\bSilestone\b/i, 'Quartz').toLowerCase().trim();
  }

  function renderTopMatSwatches() {
    var allTops = activeTops();
    var seen = {};
    var mats = [];
    allTops.forEach(function(m, idx) {
      var sku = m.skus[0];
      var mat = sku ? (sku.stone_material || '') : '';
      var key = matBaseKey(mat);
      if (!seen[key]) {
        seen[key] = true;
        mats.push({ material: mat, imgUrl: (sku && sku.stone_image) || null, topIdx: idx });
      }
    });
    var swatchEl = el('bb-swatches-top');
    if (!swatchEl) return;
    swatchEl.innerHTML = mats.map(function(m) {
      return topMatSwatchHtml(m.material, m.imgUrl, m.topIdx, m.topIdx === gIdx.top);
    }).join('');
    /* Stone Material name */
    var finEl = el('bb-finish-top');
    if (finEl) {
      var cur = allTops[gIdx.top];
      finEl.textContent = (cur && cur.skus[0] && cur.skus[0].stone_material)
        ? cur.skus[0].stone_material : '';
    }
  }

  /* ── Full viewer render for a step ───────────────────────────── */
  function renderViewer(step) {
    var models = getModels(step);
    var idx    = gIdx[step];
    var model  = models[idx] || null;
    var total  = models.length;

    /* Nav counter + arrows */
    var countEl = el('bb-count-' + step);
    if (countEl) countEl.textContent = total ? (idx + 1) + ' / ' + total : '—';
    var prevBtn = el('bb-prev-' + step);
    var nextBtn = el('bb-next-' + step);
    if (prevBtn) prevBtn.disabled = (idx === 0 || !total);
    if (nextBtn) nextBtn.disabled = (idx >= total - 1 || !total);

    /* If step is top and no cabinet selected yet → leave locked */
    if (step === 'top' && !state.cabinet) return;

    /* No models */
    if (!model) {
      var mc = el('bb-mcard-' + step);
      if (mc) mc.innerHTML = '<p class="bb-empty bb-empty--padded">No products match your current selection.</p>';
      return;
    }

    var sizeSkus   = getSizeFilteredSkus(step, model);
    var displaySku = getDisplaySku(step, model);

    /* Image */
    var imgEl = el('bb-img-' + step);
    if (imgEl) {
      imgEl.src = (displaySku && displaySku.primary_image) || '/images/placeholder-product.png';
      imgEl.alt = (displaySku && displaySku.name) || model.model;
    }

    /* Heart */
    var hrt = el('bb-heart-' + step);
    if (hrt && displaySku) {
      hrt.dataset.productId   = displaySku.id;
      hrt.dataset.productSlug = displaySku.slug;
      hrt.classList.remove('is-saved');
    }

    /* View link */
    var vlink = el('bb-viewlink-' + step);
    if (vlink && displaySku) vlink.href = '/products/' + displaySku.slug;

    /* Collection / model name */
    var colEl = el('bb-col-' + step);
    if (colEl) colEl.textContent = model.model || '';

    /* SKU name + price block */
    var nameEl = el('bb-name-' + step);
    if (nameEl) nameEl.textContent = (displaySku && displaySku.name) || '';
    renderPriceBlock(step, displaySku);

    /* Size chips (cabinet + mirror only — tops are width-locked).
       Uses modelBuckets() chip objects — may include S/D variants (e.g. "60S", "60D")
       when both Single and Double Sink configs exist for a size.
       No inch mark in visible text (Rule 13). */
    if (step !== 'top') {
      var buckets   = modelBuckets(model);
      var activeLbl = gSize[step] ? gSize[step].label : null;
      var sizesEl   = el('bb-sizes-' + step);
      if (sizesEl) {
        sizesEl.innerHTML = buckets.map(function(b) {
          /* aria-label: "60S inch" → "60 inch Single sink"; plain "36 inch" unchanged */
          var ariaLabel = b.sink === 'S' ? (b.min + ' inch Single sink')
                        : b.sink === 'D' ? (b.min + ' inch Double sink')
                        : (b.label + ' inch');
          return '<button class="model-card-size-btn' + (activeLbl === b.label ? ' is-active' : '') + '"'
            + ' type="button" data-step="' + esc(step) + '" data-bucket="' + esc(b.label) + '"'
            + ' aria-label="' + ariaLabel + '" title="' + ariaLabel + '">'
            + esc(b.label) + '</button>';
        }).join('');
      }
    }

    /* Finish / Stone Material swatches */
    if (step === 'top') {
      renderTopMatSwatches();
    } else {
      var seen = {};
      var uniqueSkus = [];
      sizeSkus.forEach(function(s) {
        if (s.color && !seen[s.color]) { seen[s.color] = true; uniqueSkus.push(s); }
      });
      var swatchEl = el('bb-swatches-' + step);
      if (swatchEl) swatchEl.innerHTML = uniqueSkus.map(function(s) { return swatchHtml(step, s); }).join('');

      /* Finish name */
      var finEl = el('bb-finish-' + step);
      if (finEl) finEl.textContent = (displaySku && displaySku.color) ? displaySku.color : '';
    }

    /* Select button */
    var selBtn = el('bb-select-' + step);
    if (selBtn) {
      var isSel  = !!(state[step] && displaySku && String(state[step].id) === String(displaySku.id));
      selBtn.disabled    = !displaySku;
      selBtn.textContent = isSel ? 'Selected ✓' : 'Select';
      selBtn.classList.toggle('is-selected', isSel);
    }
  }

  /* Lightweight image/name/price update after swatch/size pick */
  function updateCard(step, displaySku) {
    var imgEl  = el('bb-img-'      + step);
    var nameEl = el('bb-name-'     + step);
    var finEl  = el('bb-finish-'   + step);
    var vlink  = el('bb-viewlink-' + step);
    var hrt    = el('bb-heart-'    + step);
    if (!displaySku) return;
    if (imgEl)  imgEl.src = displaySku.primary_image || '/images/placeholder-product.png';
    if (nameEl) nameEl.textContent = displaySku.name || '';
    renderPriceBlock(step, displaySku);
    if (finEl)  finEl.textContent = displaySku.color || '';
    if (vlink)  vlink.href = '/products/' + displaySku.slug;
    if (hrt) { hrt.dataset.productId = displaySku.id; hrt.dataset.productSlug = displaySku.slug; }
    var selBtn = el('bb-select-' + step);
    if (selBtn) {
      var isSel = !!(state[step] && String(state[step].id) === String(displaySku.id));
      selBtn.disabled    = false;
      selBtn.textContent = isSel ? 'Selected ✓' : 'Select';
      selBtn.classList.toggle('is-selected', isSel);
    }
  }

  /* ── Navigation ───────────────────────────────────────────────── */
  function navModel(step, dir) {
    var models = getModels(step);
    var newIdx = gIdx[step] + dir;
    if (newIdx < 0 || newIdx >= models.length) return;
    gIdx[step]   = newIdx;
    gColor[step] = null;          /* reset color, keep size */
    renderViewer(step);
  }

  /* ── Top material swatch pick ────────────────────────────────── */
  function pickTopMat(topIdx) {
    gIdx.top = topIdx;
    renderViewer('top');
  }

  /* ── Size chip ────────────────────────────────────────────────── */
  function pickSize(step, chipLabel) {
    /* Look up the chip object by its label (e.g. "36", "60S", "60D").
       Chip comes from modelBuckets() — may carry a sink key for S/D disambiguation.
       Toggle: clicking the already-active chip de-selects it. */
    var models = getModels(step);
    var model  = models[gIdx[step]] || null;
    var chip   = modelBuckets(model).find(function(c) { return c.label === chipLabel; });
    if (!chip) return;
    gSize[step]  = (gSize[step] && gSize[step].label === chipLabel) ? null : chip;
    gColor[step] = null;
    renderViewer(step);
  }

  /* ── Swatch pick ──────────────────────────────────────────────── */
  function pickColor(step, color) {
    gColor[step] = (gColor[step] === color) ? null : color;

    /* Update swatch active styles */
    var container = el('bb-swatches-' + step);
    if (container) {
      container.querySelectorAll('.bb-swatch').forEach(function(btn) {
        var isActive = btn.dataset.color === gColor[step];
        btn.classList.toggle('is-active', isActive);
        /* update border colour inline */
        var cfKey  = ''; /* we don't have cf per-btn; just use amber / default */
        btn.style.borderColor = isActive ? 'var(--amber,#B8862A)' : '';
      });
    }

    /* Lightweight card update */
    var models = getModels(step);
    var model  = models[gIdx[step]] || null;
    if (model) updateCard(step, getDisplaySku(step, model));
  }

  /* ── Select/deselect ──────────────────────────────────────────── */
  function selectProduct(step) {
    var models     = getModels(step);
    var model      = models[gIdx[step]] || null;
    var displaySku = model ? getDisplaySku(step, model) : null;
    if (!displaySku) return;

    if (state[step] && String(state[step].id) === String(displaySku.id)) {
      state[step] = null;
      if (step === 'cabinet') {
        lockTopStep();
        /* Cabinet deselected — reset mirror to default order */
        gIdx.mirror = 0; gColor.mirror = null;
        renderViewer('mirror');
      }
      /* Reset qty on deselect */
      if (step === 'mirror' || step === 'faucet') {
        state[step + 'Qty'] = 1;
        var qtyRow = el('bb-qty-row-' + step);
        if (qtyRow) qtyRow.style.display = 'none';
        document.querySelectorAll('.bb-qty-btn[data-step="' + step + '"]').forEach(function(b) {
          b.classList.toggle('is-active', parseInt(b.dataset.qty, 10) === 1);
        });
      }
    } else {
      state[step] = displaySku;
      if (step === 'cabinet') {
        unlockTopStep();
        /* Cabinet selected — float same-model mirror to front */
        gIdx.mirror = 0; gColor.mirror = null;
        renderViewer('mirror');
      }
      /* Show qty row on select */
      if (step === 'mirror' || step === 'faucet') {
        var qtyRow = el('bb-qty-row-' + step);
        if (qtyRow) qtyRow.style.display = '';
      }
    }

    updateBadge(step);
    renderViewer(step);
    updateSummary();
  }

  /* ── Top step lock / unlock ───────────────────────────────────── */
  function lockTopStep() {
    var section = el('bb-step-top');
    if (section) section.classList.add('bb-step--locked');
    state.top  = null; gIdx.top = 0; gColor.top = null;
    var mc = el('bb-mcard-top');
    if (mc) mc.innerHTML = '<div class="bb-locked-msg"><svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg><p>Select your vanity cabinet above to see matching tops</p></div>';
    var meta = el('bb-meta-top');
    if (meta) meta.textContent = 'Required · Select a vanity cabinet first · Adds 5% off';
    var countEl = el('bb-count-top');
    if (countEl) countEl.textContent = '—';
    var pBtn = el('bb-prev-top'); var nBtn = el('bb-next-top');
    if (pBtn) pBtn.disabled = true;
    if (nBtn) nBtn.disabled = true;
    updateBadge('top');
    updateSummary();
  }

  function unlockTopStep() {
    var section = el('bb-step-top');
    if (section) section.classList.remove('bb-step--locked');
    gIdx.top = 0; gColor.top = null;

    /* Rebuild mcard markup for top */
    var mc = el('bb-mcard-top');
    if (mc) {
      mc.innerHTML =
        '<div class="bb-mcard-img-col">'
        + '<img class="bb-mcard-img" id="bb-img-top" src="" alt="" loading="lazy">'
        + '<button class="bb-img-arrow bb-img-arrow--prev" id="bb-prev-top" type="button" aria-label="Previous top"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>'
        + '<button class="bb-img-arrow bb-img-arrow--next" id="bb-next-top" type="button" aria-label="Next top"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>'
        + '<button class="heart-btn" id="bb-heart-top" type="button" data-product-id="" data-product-slug="" aria-label="Save to favorites">'
        + '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>'
        + '</button>'
        + '</div>'
        + '<div class="bb-mcard-info">'
        + '<p class="bb-mcard-collection" id="bb-col-top"></p>'
        + '<div class="bb-mcard-name-price"><span class="bb-mcard-name" id="bb-name-top"></span>'
        + '<div class="bb-mcard-price-block"><span class="bb-mcard-price" id="bb-price-top"></span><s class="bb-mcard-compare" id="bb-compare-top"></s><span class="bb-mcard-save-badge" id="bb-save-top"></span></div></div>'
        + '<div class="bb-picker-row bb-picker-row--finish"><span class="bb-picker-lbl">Stone Material</span><div class="bb-swatches-wrap"><div class="bb-swatches" id="bb-swatches-top"></div></div></div>'
        + '<p class="bb-topmat-name" id="bb-finish-top"></p>'
        + '<a class="bb-view-link" id="bb-viewlink-top" href="" target="_blank">View product page ›</a>'
        + '<button class="btn btn-navy bb-select-btn" id="bb-select-top" type="button" disabled>Select</button>'
        + '</div>';
    }

    var tops  = activeTops();
    var meta  = el('bb-meta-top');
    if (meta) {
      var cabBucket  = getBucket(state.cabinet.width_in);
      var bucketLabel = cabBucket ? cabBucket.label : state.cabinet.width_in;
      meta.textContent = 'Showing ' + tops.length + ' top' + (tops.length !== 1 ? 's' : '')
        + ' matching ' + bucketLabel + '" cabinet · Adds 5% off';
    }
    renderViewer('top');
  }

  /* ── Badge ────────────────────────────────────────────────────── */
  function updateBadge(step) {
    var badge = el('bb-badge-' + step);
    var text  = el('bb-badge-text-' + step);
    if (!badge) return;
    if (state[step]) {
      if (text) text.textContent = state[step].name;
      badge.hidden = false;
    } else {
      badge.hidden = true;
    }
  }

  /* ── Summary bar ──────────────────────────────────────────────── */
  function itemCount() {
    return (state.cabinet ? 1 : 0) + (state.top ? 1 : 0) + (state.mirror ? 1 : 0) + (state.faucet ? 1 : 0);
  }

  function updateSummary() {
    var count = itemCount();

    /* Tier highlights */
    document.querySelectorAll('.bb-tier').forEach(function(t) {
      t.classList.toggle('is-active', parseInt(t.dataset.items, 10) === count);
    });

    /* Compute totals — each item type uses its own fixed discount % */
    var msrpTotal   = 0;
    var saleTotal   = 0;
    var bundleTotal = 0;
    ['cabinet','top','mirror','faucet'].forEach(function(k) {
      if (!state[k]) return;
      var qty  = (k === 'mirror' || k === 'faucet') ? (state[k + 'Qty'] || 1) : 1;
      var sp   = parseFloat(state[k].price || 0) * qty;
      var cp   = parseFloat(state[k].compare_price || 0) * qty;
      var disc = ITEM_DISC[k];
      saleTotal   += sp;
      msrpTotal   += (cp > sp) ? cp : sp;
      bundleTotal += sp * (1 - disc / 100);
    });
    var outletSavings = msrpTotal - saleTotal;
    var bundleSavings = saleTotal - bundleTotal;
    var totalSavings  = msrpTotal - bundleTotal;

    /* Badge — show dollar bundle savings */
    var badge = el('bb-discount-badge');
    if (badge) {
      if (bundleSavings > 0.005) {
        badge.textContent = 'Bundle Savings: −' + fmt(bundleSavings);
        badge.classList.add('has-discount');
      } else {
        badge.textContent = 'Add items to save';
        badge.classList.remove('has-discount');
      }
    }

    /* Number-only formatter (no $ — used in totals where $ is a separate cell) */
    function num(n) {
      return parseFloat(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    /* Item rows — 6 columns: # | product | MSRP | sale savings | bundle savings | final */
    var wrap = el('bb-summary-items');
    if (wrap) {
      var nums    = { cabinet: '1', top: '2', mirror: '3', faucet: '4' };
      var empties = { cabinet: 'Cabinet not selected', top: 'Top not selected', mirror: 'Mirror not selected', faucet: 'Faucet not selected' };
      var html = ['cabinet','top','mirror','faucet'].map(function(k) {
        var item = state[k];
        if (!item) return '<tr class="bb-sum-row--empty">'
          + '<td class="bb-sum-num">'         + nums[k]    + '</td>'
          + '<td class="bb-sum-name bb-sum-none">' + empties[k] + '</td>'
          + '<td class="bb-sum-msrp bb-sum-none">—</td>'
          + '<td class="bb-sum-sale-col bb-sum-none">—</td>'
          + '<td class="bb-sum-bundle-col bb-sum-none">—</td>'
          + '<td class="bb-sum-price bb-sum-none">—</td>'
          + '</tr>';
        var qty       = (k === 'mirror' || k === 'faucet') ? (state[k + 'Qty'] || 1) : 1;
        var sp        = parseFloat(item.price || 0) * qty;
        var cp        = parseFloat(item.compare_price || 0) * qty;
        var itemDisc  = ITEM_DISC[k];
        var outletSav = (cp > sp) ? (cp - sp) : 0;
        var dp        = sp * (1 - itemDisc / 100);
        var bundleSav = sp - dp;
        var namePart  = esc(item.name) + (qty > 1 ? ' <span class="bb-qty-x2">×' + qty + '</span>' : '');
        return '<tr>'
          + '<td class="bb-sum-num">'    + nums[k] + '</td>'
          + '<td class="bb-sum-name">'   + namePart + '</td>'
          + '<td class="bb-sum-msrp">'   + (cp > sp ? fmt(cp) : '—') + '</td>'
          + '<td class="bb-sum-sale-col' + (outletSav > 0.005 ? ' bb-sav-green' : '') + '">' + (outletSav > 0.005 ? '(' + fmt(outletSav) + ')' : '—') + '</td>'
          + '<td class="bb-sum-bundle-col' + (bundleSav > 0.005 ? ' bb-sav-amber' : '') + '">' + (bundleSav > 0.005 ? '(' + fmt(bundleSav) + ')' : '—') + '</td>'
          + '<td class="bb-sum-price">'  + fmt(dp) + '</td>'
          + '</tr>';
      });
      wrap.innerHTML = html.join('');
    }

    /* Totals — $ is included inline in the amount cell (colspan="2") */
    var origEl      = el('bb-original-total');
    var outletSavEl = el('bb-outlet-sav');
    var bundleSavEl = el('bb-bundle-sav');
    var finEl       = el('bb-final-total');
    var breakdownEl = el('bb-savings-breakdown');
    if (origEl)      origEl.textContent      = msrpTotal > 0     ? '$ ' + num(msrpTotal)     : '';
    if (outletSavEl) outletSavEl.textContent = outletSavings > 0.005 ? '$ ' + num(outletSavings) : '—';
    if (bundleSavEl) bundleSavEl.textContent = bundleSavings > 0.005 ? '$ ' + num(bundleSavings) : (saleTotal > 0 && !state.top ? 'Add Top to unlock' : '—');
    if (finEl)       finEl.textContent       = saleTotal > 0     ? '$ ' + num(bundleTotal)   : '';
    if (breakdownEl) breakdownEl.style.display = saleTotal > 0 ? '' : 'none';

    var cartBtn = el('bb-add-cart');
    if (cartBtn) cartBtn.disabled = !state.cabinet;
  }

  /* ── Add to cart ──────────────────────────────────────────────── */
  function addToCart() {
    if (!state.cabinet) return;
    var btn = el('bb-add-cart');
    btn.disabled    = true;
    btn.textContent = 'Adding…';
    var bundleId = 'bndl_' + Date.now(); // unique ID ties all items in this bundle together
    /* Build items list — track type so we can apply the correct per-item discount */
    var items = [];
    ['cabinet','top','mirror','faucet'].forEach(function(k) {
      if (!state[k]) return;
      var qty = (k === 'mirror' || k === 'faucet') ? (state[k + 'Qty'] || 1) : 1;
      for (var i = 0; i < qty; i++) items.push({ item: state[k], type: k });
    });
    // Sequential (not parallel) — Promise.all fires all fetches simultaneously,
    // causing a session race condition where each request reads the same empty
    // cart, adds one item, and saves, with the last write winning. Sequential
    // execution ensures each add completes (session saved) before the next read.
    items.reduce(function(chain, entry) {
      return chain.then(function() {
        var item = entry.item;
        var disc = ITEM_DISC[entry.type];          // per-item-type discount %
        var dp   = (parseFloat(item.price) * (1 - disc / 100)).toFixed(2);
        var fd   = new URLSearchParams();
        fd.append('product_id',          item.id);
        fd.append('slug',                item.slug);
        fd.append('name',                item.name);
        fd.append('price',               dp);
        fd.append('image',               item.primary_image || '');
        fd.append('original_price',      item.price);
        fd.append('compare_price',       item.compare_price || '');
        fd.append('bundle_discount_pct', disc);
        fd.append('bundle_id',           bundleId);
        fd.append('qty', '1');
        return fetch('/cart/add', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' }, body: fd })
          .then(function(resp) {
            // fetch() only rejects on network failure — HTTP 4xx/5xx resolve normally.
            // Explicitly check resp.ok so CSRF errors, product-not-found, and DB
            // failures all surface as an alert instead of silently landing on empty cart.
            if (!resp.ok) {
              return resp.json().catch(function() { return {}; }).then(function(data) {
                throw new Error(data.error || ('Server error ' + resp.status));
              });
            }
          });
      });
    }, Promise.resolve())
      .then(function() { window.location.href = '/cart'; })
      .catch(function(err) {
        btn.disabled    = false;
        btn.textContent = 'Add Bundle to Cart';
        alert('Something went wrong. Please try again.' + (err && err.message ? ' (' + err.message + ')' : ''));
      });
  }

  /* ── Global click handler ─────────────────────────────────────── */
  function onPageClick(e) {
    /* Prev/next model */
    var prev = e.target.closest('[id^="bb-prev-"]');
    if (prev) { navModel(prev.id.replace('bb-prev-', ''), -1); return; }
    var next = e.target.closest('[id^="bb-next-"]');
    if (next) { navModel(next.id.replace('bb-next-', ''),  1); return; }

    /* Size chip */
    var sChip = e.target.closest('.model-card-size-btn[data-step]');
    if (sChip) { pickSize(sChip.dataset.step, sChip.dataset.bucket); return; }

    /* Top material swatch */
    var topSw = e.target.closest('.bb-swatch--topmat');
    if (topSw) { pickTopMat(parseInt(topSw.dataset.topIdx, 10)); return; }

    /* Finish swatch */
    var sw = e.target.closest('.bb-swatch[data-step]');
    if (sw) { pickColor(sw.dataset.step, sw.dataset.color); return; }

    /* Qty toggle (mirror / faucet pair) */
    var qtyBtn = e.target.closest('.bb-qty-btn');
    if (qtyBtn) {
      var qStep = qtyBtn.dataset.step;
      var qty   = parseInt(qtyBtn.dataset.qty, 10);
      state[qStep + 'Qty'] = qty;
      document.querySelectorAll('.bb-qty-btn[data-step="' + qStep + '"]').forEach(function(b) {
        b.classList.toggle('is-active', parseInt(b.dataset.qty, 10) === qty);
      });
      updateSummary();
      return;
    }

    /* Select button */
    var selBtn = e.target.closest('[id^="bb-select-"]');
    if (selBtn && !selBtn.disabled) { selectProduct(selBtn.id.replace('bb-select-', '')); return; }

    /* Add bundle to cart */
    if (e.target.closest('#bb-add-cart')) { addToCart(); return; }
  }

  /* ── Init ─────────────────────────────────────────────────────── */
  function init() {
    renderViewer('cabinet');
    renderViewer('mirror');
    renderViewer('faucet');
    updateSummary();
    document.addEventListener('click', onPageClick);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
