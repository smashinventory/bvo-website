<script>
(function () {
  'use strict';

  /* ── Server data ──────────────────────────────────────────────── */
  var CABINET_MODELS = <%- JSON.stringify(cabinetModels) %>;
  var TOP_MODELS     = <%- JSON.stringify(topModels)     %>;
  var MIRROR_MODELS  = <%- JSON.stringify(mirrorModels)  %>;
  var FAUCET_MODELS  = <%- JSON.stringify(faucetModels)  %>;
  var FAMILY_HEX     = <%- JSON.stringify(familyHex)     %>;
  var SIZE_BUCKETS   = <%- JSON.stringify(sizeBuckets)   %>;

  /* ── Discount tiers: index = selected-item count ──────────────── */
  /* 0 items→0%, 1 cabinet only→0%, 2 cab+top→5%, 3→10%, 4→15% */
  var TIERS = [0, 0, 5, 10, 15];

  /* ── Viewer state ─────────────────────────────────────────────── */
  var gIdx   = { cabinet: 0,    top: 0,    mirror: 0,    faucet: 0    };  // current model index
  var gSize  = { cabinet: null,             mirror: null, faucet: null };  // persists across model nav
  var gColor = { cabinet: null, top: null,  mirror: null, faucet: null };  // resets on model change

  /* ── Selection state ──────────────────────────────────────────── */
  var state = { cabinet: null, top: null, mirror: null, faucet: null };

  /* ── Helpers ──────────────────────────────────────────────────── */

  /* Map a raw width_in value to its SIZE_BUCKET object (or null) */
  function getBucket(widthIn) {
    var w = parseFloat(widthIn);
    if (isNaN(w) || w <= 0) return null;
    return SIZE_BUCKETS.find(function(b) { return w >= b.min && w <= b.max; }) || null;
  }

  /* Unique sorted buckets for all SKUs in a model (used for size chips) */
  function modelBuckets(model) {
    var seen = {};
    var out  = [];
    (model ? model.skus : []).forEach(function(s) {
      var b = getBucket(s.width_in);
      if (b && !seen[b.label]) { seen[b.label] = true; out.push(b); }
    });
    out.sort(function(a, b) { return a.min - b.min; });
    return out;
  }

  function fmt(n) {
    return '$' + parseFloat(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function esc(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function el(id) { return document.getElementById(id); }

  /* ── Model lists ──────────────────────────────────────────────── */
  function getModels(step) {
    if (step === 'cabinet') return CABINET_MODELS;
    if (step === 'top')     return activeTops();
    if (step === 'mirror')  return activeMirrors();
    if (step === 'faucet')  return FAUCET_MODELS;
    return [];
  }

  /* Mirrors sorted with same-model mirror first once a cabinet is selected.
     Full list remains navigable — this is a suggestion, not a filter.
     When no cabinet is selected (or cabinet has no model), returns MIRROR_MODELS
     in original order. Re-sort fires whenever state.cabinet changes. */
  function activeMirrors() {
    if (!state.cabinet || !state.cabinet.model) return MIRROR_MODELS;
    var cabModel = state.cabinet.model;
    var match    = MIRROR_MODELS.filter(function(m) { return m.model === cabModel; });
    var rest     = MIRROR_MODELS.filter(function(m) { return m.model !== cabModel; });
    return match.concat(rest);
  }

  /* Tops: each SKU is its own navigable item.
     Stone/composite tops have no meaningful color variants — each is a
     distinct material (Carrara White Marble, White Zeus Quartz, etc.).
     Flattening to individual SKUs lets the user arrow through all options.
     Width bucket filter applied once a cabinet is selected (range match,
     not exact equality, to handle minor dimension variations). */
  function activeTops() {
    var allSkus = [];
    TOP_MODELS.forEach(function(m) { allSkus = allSkus.concat(m.skus); });

    if (state.cabinet && state.cabinet.width_in) {
      var cabBkt = getBucket(state.cabinet.width_in);
      if (cabBkt) {
        allSkus = allSkus.filter(function(s) {
          var w = parseFloat(s.width_in);
          return w >= cabBkt.min && w <= cabBkt.max;
        });
      }
    }

    // Each SKU becomes its own model entry — no color grouping for tops
    return allSkus.map(function(s) { return { model: null, skus: [s] }; });
  }

  /* SKUs for current model, optionally size-filtered (except top — already width-locked).
     gSize[step] is a SIZE_BUCKET object { label, min, max } or null. */
  function getSizeFilteredSkus(step, model) {
    if (!model) return [];
    var skus = model.skus;
    if (step === 'top') return skus;
    var bkt = gSize[step];
    if (bkt) {
      var f = skus.filter(function(s) {
        var w = parseFloat(s.width_in);
        return w >= bkt.min && w <= bkt.max;
      });
      if (f.length) return f;
    }
    return skus;
  }

  /* The SKU to display right now (color-selected or first available) */
  function getDisplaySku(step, model) {
    var skus = getSizeFilteredSkus(step, model);
    var c    = gColor[step];
    if (c) {
      var m = skus.find(function(s) { return s.color === c; });
      if (m) return m;
    }
    return skus[0] || null;
  }

  /* ── Price block renderer (compare, sale, save-badge) ────────── */
  function renderPriceBlock(step, displaySku) {
    var priceEl     = el('bb-price-'   + step);
    var compareEl   = el('bb-compare-' + step);
    var saveBadgeEl = el('bb-save-'    + step);
    if (!displaySku || !parseFloat(displaySku.price)) {
      if (priceEl)     priceEl.textContent    = '';
      if (compareEl)   compareEl.textContent   = '';
      if (saveBadgeEl) saveBadgeEl.textContent = '';
      return;
    }
    var sp = parseFloat(displaySku.price);
    var cp = parseFloat(displaySku.compare_price || 0);
    if (priceEl) priceEl.textContent = fmt(sp);
    if (compareEl) {
      if (cp > sp) { compareEl.textContent = fmt(cp); compareEl.style.display = ''; }
      else         { compareEl.textContent = '';       compareEl.style.display = 'none'; }
    }
    if (saveBadgeEl) {
      if (cp > sp) { saveBadgeEl.textContent = 'Save ' + fmt(cp - sp); saveBadgeEl.style.display = ''; }
      else         { saveBadgeEl.textContent = '';                      saveBadgeEl.style.display = 'none'; }
    }
  }

  /* ── Swatch rendering ─────────────────────────────────────────── */
  function swatchHtml(step, sku) {
    var chipImg  = sku.chip_image;
    var cfKey    = sku.color_family || '';
    var hex      = FAMILY_HEX[cfKey] || '#C9B89A';
    var border   = FAMILY_HEX[cfKey + '_border'] || hex;
    var isActive = gColor[step] === sku.color;
    var style    = chipImg
      ? 'background-image:url(' + esc(chipImg) + ');background-size:cover;background-position:center;border-color:' + (isActive ? 'var(--amber,#B8862A)' : border)
      : 'background-color:' + hex + ';border-color:' + (isActive ? 'var(--amber,#B8862A)' : border);
    return '<button class="bb-swatch' + (isActive ? ' is-active' : '') + '"'
      + ' type="button"'
      + ' data-step="'  + step         + '"'
      + ' data-color="' + esc(sku.color) + '"'
      + ' title="'      + esc(sku.color) + '"'
      + ' aria-label="' + esc(sku.color) + '"'
      + ' style="'      + style          + '">'
      + '</button>';
  }

  /* ── Top material swatches (Step 2 — stone tops) ─────────────── */
  function topMatSwatchHtml(material, imgUrl, topIdx, isActive) {
    var style = imgUrl
      ? 'background-image:url(' + esc(imgUrl) + ');background-size:cover;background-position:center;'
      : 'background-color:#C9B89A;';
    return '<button class="bb-swatch bb-swatch--topmat' + (isActive ? ' is-active' : '') + '"'
      + ' type="button" data-top-idx="' + topIdx + '"'
      + ' title="'      + esc(material || 'Other') + '"'
      + ' aria-label="' + esc(material || 'Other') + '"'
      + ' style="' + style + '">'
      + '</button>';
  }

  function renderTopMatSwatches() {
    var allTops = activeTops();
    var seen = {};
    var mats = [];
    allTops.forEach(function(m, idx) {
      var sku = m.skus[0];
      var mat = sku ? (sku.stone_material || '') : '';
      if (!seen[mat]) {
        seen[mat] = true;
        mats.push({ material: mat, imgUrl: (sku && sku.stone_image) || null, topIdx: idx });
      }
    });
    var swatchEl = el('bb-swatches-top');
    if (!swatchEl) return;
    swatchEl.innerHTML = mats.map(function(m) {
      return topMatSwatchHtml(m.material, m.imgUrl, m.topIdx, m.topIdx === gIdx.top);
    }).join('');
    /* Stone Material name */
    var finEl = el('bb-finish-top');
    if (finEl) {
      var cur = allTops[gIdx.top];
      finEl.textContent = (cur && cur.skus[0] && cur.skus[0].stone_material)
        ? cur.skus[0].stone_material : '';
    }
  }

  /* ── Full viewer render for a step ───────────────────────────── */
  function renderViewer(step) {
    var models = getModels(step);
    var idx    = gIdx[step];
    var model  = models[idx] || null;
    var total  = models.length;

    /* Nav counter + arrows */
    var countEl = el('bb-count-' + step);
    if (countEl) countEl.textContent = total ? (idx + 1) + ' / ' + total : '—';
    var prevBtn = el('bb-prev-' + step);
    var nextBtn = el('bb-next-' + step);
    if (prevBtn) prevBtn.disabled = (idx === 0 || !total);
    if (nextBtn) nextBtn.disabled = (idx >= total - 1 || !total);

    /* If step is top and no cabinet selected yet → leave locked */
    if (step === 'top' && !state.cabinet) return;

    /* No models */
    if (!model) {
      var mc = el('bb-mcard-' + step);
      if (mc) mc.innerHTML = '<p class="bb-empty bb-empty--padded">No products match your current selection.</p>';
      return;
    }

    var sizeSkus   = getSizeFilteredSkus(step, model);
    var displaySku = getDisplaySku(step, model);

    /* Image */
    var imgEl = el('bb-img-' + step);
    if (imgEl) {
      imgEl.src = (displaySku && displaySku.primary_image) || '/images/placeholder-product.png';
      imgEl.alt = (displaySku && displaySku.name) || model.model;
    }

    /* Heart */
    var hrt = el('bb-heart-' + step);
    if (hrt && displaySku) {
      hrt.dataset.productId   = displaySku.id;
      hrt.dataset.productSlug = displaySku.slug;
      hrt.classList.remove('is-saved');
    }

    /* View link */
    var vlink = el('bb-viewlink-' + step);
    if (vlink && displaySku) vlink.href = '/products/' + displaySku.slug;

    /* Collection / model name */
    var colEl = el('bb-col-' + step);
    if (colEl) colEl.textContent = model.model || '';

    /* SKU name + price block */
    var nameEl = el('bb-name-' + step);
    if (nameEl) nameEl.textContent = (displaySku && displaySku.name) || '';
    renderPriceBlock(step, displaySku);

    /* Size chips (cabinet + mirror only — tops are width-locked).
       Uses SIZE_BUCKETS nominal labels (e.g. "36") — same method as
       the collection page and megamenu. No inch mark in visible text (Rule 13). */
    if (step !== 'top') {
      var buckets  = modelBuckets(model);
      var activeLbl = gSize[step] ? gSize[step].label : null;
      var sizesEl   = el('bb-sizes-' + step);
      if (sizesEl) {
        sizesEl.innerHTML = buckets.map(function(b) {
          return '<button class="model-card-size-btn' + (activeLbl === b.label ? ' is-active' : '') + '"'
            + ' type="button" data-step="' + step + '" data-bucket="' + esc(b.label) + '"'
            + ' aria-label="' + b.label + ' inch" title="' + b.label + ' inch">'
            + b.label + '</button>';
        }).join('');
      }
    }

    /* Finish / Stone Material swatches */
    if (step === 'top') {
      renderTopMatSwatches();
    } else {
      var seen = {};
      var uniqueSkus = [];
      sizeSkus.forEach(function(s) {
        if (s.color && !seen[s.color]) { seen[s.color] = true; uniqueSkus.push(s); }
      });
      var swatchEl = el('bb-swatches-' + step);
      if (swatchEl) swatchEl.innerHTML = uniqueSkus.map(function(s) { return swatchHtml(step, s); }).join('');

      /* Finish name */
      var finEl = el('bb-finish-' + step);
      if (finEl) finEl.textContent = (displaySku && displaySku.color) ? displaySku.color : '';
    }

    /* Select button */
    var selBtn = el('bb-select-' + step);
    if (selBtn) {
      var isSel  = !!(state[step] && displaySku && String(state[step].id) === String(displaySku.id));
      selBtn.disabled    = !displaySku;
      selBtn.textContent = isSel ? 'Selected ✓' : 'Select';
      selBtn.classList.toggle('is-selected', isSel);
    }
  }

  /* Lightweight image/name/price update after swatch/size pick */
  function updateCard(step, displaySku) {
    var imgEl  = el('bb-img-'      + step);
    var nameEl = el('bb-name-'     + step);
    var finEl  = el('bb-finish-'   + step);
    var vlink  = el('bb-viewlink-' + step);
    var hrt    = el('bb-heart-'    + step);
    if (!displaySku) return;
    if (imgEl)  imgEl.src = displaySku.primary_image || '/images/placeholder-product.png';
    if (nameEl) nameEl.textContent = displaySku.name || '';
    renderPriceBlock(step, displaySku);
    if (finEl)  finEl.textContent = displaySku.color || '';
    if (vlink)  vlink.href = '/products/' + displaySku.slug;
    if (hrt) { hrt.dataset.productId = displaySku.id; hrt.dataset.productSlug = displaySku.slug; }
    var selBtn = el('bb-select-' + step);
    if (selBtn) {
      var isSel = !!(state[step] && String(state[step].id) === String(displaySku.id));
      selBtn.disabled    = false;
      selBtn.textContent = isSel ? 'Selected ✓' : 'Select';
      selBtn.classList.toggle('is-selected', isSel);
    }
  }

  /* ── Navigation ───────────────────────────────────────────────── */
  function navModel(step, dir) {
    var models = getModels(step);
    var newIdx = gIdx[step] + dir;
    if (newIdx < 0 || newIdx >= models.length) return;
    gIdx[step]   = newIdx;
    gColor[step] = null;          /* reset color, keep size */
    renderViewer(step);
  }

  /* ── Top material swatch pick ────────────────────────────────── */
  function pickTopMat(topIdx) {
    gIdx.top = topIdx;
    renderViewer('top');
  }

  /* ── Size chip ────────────────────────────────────────────────── */
  function pickSize(step, bucketLabel) {
    /* Look up the bucket object by its label (e.g. "36").
       Toggle: clicking the already-active chip de-selects it. */
    var bucket = SIZE_BUCKETS.find(function(b) { return b.label === bucketLabel; });
    if (!bucket) return;
    gSize[step]  = (gSize[step] && gSize[step].label === bucketLabel) ? null : bucket;
    gColor[step] = null;
    renderViewer(step);
  }

  /* ── Swatch pick ──────────────────────────────────────────────── */
  function pickColor(step, color) {
    gColor[step] = (gColor[step] === color) ? null : color;

    /* Update swatch active styles */
    var container = el('bb-swatches-' + step);
    if (container) {
      container.querySelectorAll('.bb-swatch').forEach(function(btn) {
        var isActive = btn.dataset.color === gColor[step];
        btn.classList.toggle('is-active', isActive);
        /* update border colour inline */
        var cfKey  = ''; /* we don't have cf per-btn; just use amber / default */
        btn.style.borderColor = isActive ? 'var(--amber,#B8862A)' : '';
      });
    }

    /* Lightweight card update */
    var models = getModels(step);
    var model  = models[gIdx[step]] || null;
    if (model) updateCard(step, getDisplaySku(step, model));
  }

  /* ── Select/deselect ──────────────────────────────────────────── */
  function selectProduct(step) {
    var models     = getModels(step);
    var model      = models[gIdx[step]] || null;
    var displaySku = model ? getDisplaySku(step, model) : null;
    if (!displaySku) return;

    if (state[step] && String(state[step].id) === String(displaySku.id)) {
      state[step] = null;
      if (step === 'cabinet') {
        lockTopStep();
        /* Cabinet deselected — reset mirror to default order */
        gIdx.mirror = 0; gColor.mirror = null;
        renderViewer('mirror');
      }
    } else {
      state[step] = displaySku;
      if (step === 'cabinet') {
        unlockTopStep();
        /* Cabinet selected — float same-model mirror to front */
        gIdx.mirror = 0; gColor.mirror = null;
        renderViewer('mirror');
      }
    }

    updateBadge(step);
    renderViewer(step);
    updateSummary();
  }

  /* ── Top step lock / unlock ───────────────────────────────────── */
  function lockTopStep() {
    var section = el('bb-step-top');
    if (section) section.classList.add('bb-step--locked');
    state.top  = null; gIdx.top = 0; gColor.top = null;
    var mc = el('bb-mcard-top');
    if (mc) mc.innerHTML = '<div class="bb-locked-msg"><svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg><p>Select your vanity cabinet above to see matching tops</p></div>';
    var meta = el('bb-meta-top');
    if (meta) meta.textContent = 'Required · Select a vanity cabinet first · Adds 5% off';
    var countEl = el('bb-count-top');
    if (countEl) countEl.textContent = '—';
    var pBtn = el('bb-prev-top'); var nBtn = el('bb-next-top');
    if (pBtn) pBtn.disabled = true;
    if (nBtn) nBtn.disabled = true;
    updateBadge('top');
    updateSummary();
  }

  function unlockTopStep() {
    var section = el('bb-step-top');
    if (section) section.classList.remove('bb-step--locked');
    gIdx.top = 0; gColor.top = null;

    /* Rebuild mcard markup for top */
    var mc = el('bb-mcard-top');
    if (mc) {
      mc.innerHTML =
        '<div class="bb-mcard-img-col">'
        + '<img class="bb-mcard-img" id="bb-img-top" src="" alt="" loading="lazy">'
        + '<button class="heart-btn" id="bb-heart-top" type="button" data-product-id="" data-product-slug="" aria-label="Save to favorites">'
        + '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>'
        + '</button>'
        + '</div>'
        + '<div class="bb-mcard-info">'
        + '<p class="bb-mcard-collection" id="bb-col-top"></p>'
        + '<div class="bb-mcard-name-price"><span class="bb-mcard-name" id="bb-name-top"></span>'
        + '<div class="bb-mcard-price-block"><span class="bb-mcard-price" id="bb-price-top"></span><s class="bb-mcard-compare" id="bb-compare-top"></s><span class="bb-mcard-save-badge" id="bb-save-top"></span></div></div>'
        + '<div class="bb-picker-row bb-picker-row--finish"><span class="bb-picker-lbl">Stone Material</span><div class="bb-swatches-wrap"><div class="bb-swatches" id="bb-swatches-top"></div></div></div>'
        + '<p class="bb-topmat-name" id="bb-finish-top"></p>'
        + '<a class="bb-view-link" id="bb-viewlink-top" href="" target="_blank">View product page ›</a>'
        + '<button class="btn btn-navy bb-select-btn" id="bb-select-top" type="button" disabled>Select</button>'
        + '</div>';
    }

    var tops  = activeTops();
    var meta  = el('bb-meta-top');
    if (meta) {
      var cabBucket  = getBucket(state.cabinet.width_in);
      var bucketLabel = cabBucket ? cabBucket.label : state.cabinet.width_in;
      meta.textContent = 'Showing ' + tops.length + ' top' + (tops.length !== 1 ? 's' : '')
        + ' matching ' + bucketLabel + '" cabinet · Adds 5% off';
    }
    renderViewer('top');
  }

  /* ── Badge ────────────────────────────────────────────────────── */
  function updateBadge(step) {
    var badge = el('bb-badge-' + step);
    var text  = el('bb-badge-text-' + step);
    if (!badge) return;
    if (state[step]) {
      if (text) text.textContent = state[step].name;
      badge.hidden = false;
    } else {
      badge.hidden = true;
    }
  }

  /* ── Summary bar ──────────────────────────────────────────────── */
  function itemCount() {
    return (state.cabinet ? 1 : 0) + (state.top ? 1 : 0) + (state.mirror ? 1 : 0) + (state.faucet ? 1 : 0);
  }
  function discount() { return TIERS[Math.min(itemCount(), 4)]; }

  function updateSummary() {
    var disc  = discount();
    var count = itemCount();

    /* Tier highlights */
    document.querySelectorAll('.bb-tier').forEach(function(t) {
      t.classList.toggle('is-active', parseInt(t.dataset.items, 10) === count);
    });

    /* Compute totals */
    var msrpTotal = 0;
    var saleTotal = 0;
    ['cabinet','top','mirror','faucet'].forEach(function(k) {
      if (!state[k]) return;
      var sp = parseFloat(state[k].price || 0);
      var cp = parseFloat(state[k].compare_price || 0);
      saleTotal += sp;
      msrpTotal += (cp > sp) ? cp : sp;  // fallback to sale price when no MSRP
    });
    var bundleTotal    = saleTotal * (1 - disc / 100);
    var outletSavings  = msrpTotal - saleTotal;
    var bundleSavings  = saleTotal - bundleTotal;
    var totalSavings   = msrpTotal - bundleTotal;

    /* Badge — show dollar bundle savings */
    var badge = el('bb-discount-badge');
    if (badge) {
      if (disc > 0 && bundleSavings > 0.005) {
        badge.textContent = 'Bundle Savings: −' + fmt(bundleSavings);
        badge.classList.add('has-discount');
      } else {
        badge.textContent = 'Add items to save';
        badge.classList.remove('has-discount');
      }
    }

    /* Price line: MSRP strikethrough → bundle total */
    var origEl = el('bb-original-total');
    var finEl  = el('bb-final-total');
    if (origEl) origEl.innerHTML  = msrpTotal > 0 ? '<s>' + fmt(msrpTotal) + '</s>' : '';
    if (finEl)  finEl.textContent = saleTotal > 0 ? fmt(bundleTotal) : '$0.00';

    /* Savings breakdown */
    var breakdownEl = el('bb-savings-breakdown');
    var outletSavEl = el('bb-outlet-sav');
    var bundleSavEl = el('bb-bundle-sav');
    var totalSavEl  = el('bb-total-sav');
    if (breakdownEl) breakdownEl.style.display = saleTotal > 0 ? '' : 'none';
    if (outletSavEl) outletSavEl.textContent = outletSavings > 0.005 ? '−' + fmt(outletSavings) : '—';
    if (bundleSavEl) bundleSavEl.textContent = bundleSavings > 0.005 ? '−' + fmt(bundleSavings) : (disc === 0 && saleTotal > 0 ? 'Add Top to unlock' : '—');
    if (totalSavEl)  totalSavEl.textContent  = totalSavings  > 0.005 ? '−' + fmt(totalSavings) : '';

    /* Item rows — show MSRP strikethrough → bundle price */
    var wrap = el('bb-summary-items');
    if (wrap) {
      var labels = { cabinet: 'Cabinet', top: 'Top', mirror: 'Mirror', faucet: 'Faucet' };
      var html = ['cabinet','top','mirror','faucet'].map(function(k) {
        var item = state[k];
        if (!item) return '<div class="bb-sum-row bb-sum-row--empty"><span class="bb-sum-cat">' + labels[k] + '</span><span class="bb-sum-none">Not selected</span></div>';
        var sp = parseFloat(item.price);
        var cp = parseFloat(item.compare_price || 0);
        var dp = sp * (1 - disc / 100);
        /* Show MSRP strike-through when available; otherwise sale price strike-through if bundle discount applies */
        var strikePrice = cp > sp ? cp : (disc > 0 ? sp : 0);
        var priceHtml = (strikePrice > 0 ? '<s class="bb-sum-orig">' + fmt(strikePrice) + '</s> ' : '') + fmt(dp);
        return '<div class="bb-sum-row"><span class="bb-sum-cat">' + labels[k] + '</span>'
          + '<span class="bb-sum-name">' + esc(item.name) + '</span>'
          + '<span class="bb-sum-price">' + priceHtml + '</span></div>';
      });
      wrap.innerHTML = html.join('');
    }

    var cartBtn = el('bb-add-cart');
    if (cartBtn) cartBtn.disabled = !state.cabinet;
  }

  /* ── Add to cart ──────────────────────────────────────────────── */
  function addToCart() {
    if (!state.cabinet) return;
    var btn = el('bb-add-cart');
    btn.disabled    = true;
    btn.textContent = 'Adding…';
    var disc  = discount();
    var items = ['cabinet','top','mirror','faucet'].filter(function(k) { return !!state[k]; }).map(function(k) { return state[k]; });
    // Sequential (not parallel) — Promise.all fires all fetches simultaneously,
    // causing a session race condition where each request reads the same empty
    // cart, adds one item, and saves, with the last write winning. Sequential
    // execution ensures each add completes (session saved) before the next read.
    items.reduce(function(chain, item) {
      return chain.then(function() {
        var dp = (parseFloat(item.price) * (1 - disc / 100)).toFixed(2);
        var fd = new URLSearchParams();
        fd.append('product_id',          item.id);
        fd.append('slug',                item.slug);
        fd.append('name',                item.name);
        fd.append('price',               dp);
        fd.append('image',               item.primary_image || '');
        fd.append('original_price',      item.price);
        fd.append('compare_price',       item.compare_price || '');
        fd.append('bundle_discount_pct', disc);
        fd.append('qty', '1');
        return fetch('/cart/add', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' }, body: fd });
      });
    }, Promise.resolve())
      .then(function() { window.location.href = '/cart'; })
      .catch(function() {
        btn.disabled    = false;
        btn.textContent = 'Add Bundle to Cart';
        alert('Something went wrong. Please try again.');
      });
  }

  /* ── Global click handler ─────────────────────────────────────── */
  function onPageClick(e) {
    /* Prev/next model */
    var prev = e.target.closest('[id^="bb-prev-"]');
    if (prev) { navModel(prev.id.replace('bb-prev-', ''), -1); return; }
    var next = e.target.closest('[id^="bb-next-"]');
    if (next) { navModel(next.id.replace('bb-next-', ''),  1); return; }

    /* Size chip */
    var sChip = e.target.closest('.model-card-size-btn[data-step]');
    if (sChip) { pickSize(sChip.dataset.step, sChip.dataset.bucket); return; }

    /* Top material swatch */
    var topSw = e.target.closest('.bb-swatch--topmat');
    if (topSw) { pickTopMat(parseInt(topSw.dataset.topIdx, 10)); return; }

    /* Finish swatch */
    var sw = e.target.closest('.bb-swatch[data-step]');
    if (sw) { pickColor(sw.dataset.step, sw.dataset.color); return; }

    /* Select button */
    var selBtn = e.target.closest('[id^="bb-select-"]');
    if (selBtn && !selBtn.disabled) { selectProduct(selBtn.id.replace('bb-select-', '')); return; }

    /* Add bundle to cart */
    if (e.target.closest('#bb-add-cart')) { addToCart(); return; }
  }

  /* ── Init ─────────────────────────────────────────────────────── */
  function init() {
    renderViewer('cabinet');
    renderViewer('mirror');
    renderViewer('faucet');
    updateSummary();
    document.addEventListener('click', onPageClick);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
