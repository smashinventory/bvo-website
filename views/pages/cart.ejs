<div class="cart-page">

  <div class="cart-header">
    <h1>Your Cart <span class="cart-count-label">(<%= cart.count %> <%= cart.count === 1 ? 'item' : 'items' %>)</span></h1>
  </div>

  <% if (cart.items.length === 0) { %>
  <!-- Empty cart -->
  <div class="cart-empty">
    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" style="opacity:.3;margin:0 auto 20px">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <path d="M16 10a4 4 0 0 1-8 0"/>
    </svg>
    <p>Your cart is empty.</p>
    <a href="/collections" class="btn btn-sage" style="margin-top:20px">Start Shopping</a>
  </div>

  <% } else { %>
  <div class="cart-layout">

    <!-- ── Line items ─────────────────────────────────────────────── -->
    <div class="cart-items">
      <% cart.items.forEach(item => { %>
      <div class="cart-item">
        <!-- Image -->
        <div class="cart-item-img">
          <% if (item.image) { %>
            <img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy">
          <% } else { %>
            <div class="cart-img-placeholder"></div>
          <% } %>
        </div>

        <!-- Info -->
        <div class="cart-item-info">
          <a href="/products/<%= item.slug %>" class="cart-item-name"><%= item.name %></a>
          <%
            var _cp   = parseFloat(item.compare_price) || 0;  // MSRP
            var _sale = parseFloat(item.price) || 0;           // sale price from DB
            var _disc = parseFloat(item.bundle_discount_pct) || 0;
            var _bp   = parseFloat((_sale * (1 - _disc / 100)).toFixed(2)); // bundle price
            // Show MSRP as strikethrough if it's higher than the bundle-final price
            var _show_msrp = _cp > _bp && _cp > 0;
          %>
          <p class="cart-item-price">
            <% if (_show_msrp) { %>
              <s class="cart-item-msrp">$<%= _cp.toLocaleString('en-US',{minimumFractionDigits:2}) %></s>
            <% } %>
            <span class="cart-item-final">$<%= _bp.toLocaleString('en-US',{minimumFractionDigits:2}) %> each</span>
          </p>
        </div>

        <!-- Qty + remove -->
        <div class="cart-item-actions">
          <form action="/cart/update" method="POST" class="cart-qty-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="product_id" value="<%= item.product_id %>">
            <div class="detail-qty" style="margin-bottom:8px">
              <button class="qty-btn" type="submit" name="qty" value="<%= item.qty - 1 %>" aria-label="Decrease">−</button>
              <span class="qty-val"><%= item.qty %></span>
              <button class="qty-btn" type="submit" name="qty" value="<%= item.qty + 1 %>" aria-label="Increase">+</button>
            </div>
          </form>
          <form action="/cart/remove" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="product_id" value="<%= item.product_id %>">
            <button type="submit" class="cart-remove-btn">Remove</button>
          </form>
        </div>

        <!-- Line total (bundle-discounted price × qty) -->
        <div class="cart-item-total">
          <%
            var _ltDisc  = parseFloat(item.bundle_discount_pct) || 0;
            var _ltPrice = (parseFloat(item.price) || 0) * (1 - _ltDisc / 100);
          %>
          $<%= (item.qty * _ltPrice).toLocaleString('en-US',{minimumFractionDigits:2}) %>
        </div>
      </div>
      <% }) %>
    </div><!-- /cart-items -->

    <!-- ── Order summary ──────────────────────────────────────────── -->
    <aside class="cart-summary">
      <h2>Order Summary</h2>

      <%
        // Outlet savings = MSRP − sale price (compare_price vs price)
        var _outletSavings = cart.items.reduce(function(acc, i) {
          var cp   = parseFloat(i.compare_price) || 0;
          var sale = parseFloat(i.price)         || 0;
          if (cp > sale && sale > 0) acc += i.qty * (cp - sale);
          return acc;
        }, 0);
        // Bundle savings = sale price − bundle price (pct applied to sale price)
        var _bundleSavings = cart.items.reduce(function(acc, i) {
          var pct  = parseFloat(i.bundle_discount_pct) || 0;
          var sale = parseFloat(i.price)               || 0;
          if (pct > 0 && sale > 0) acc += i.qty * sale * (pct / 100);
          return acc;
        }, 0);
        // Item subtotal = sum of sale prices (before bundle discount)
        var _itemSubtotal = cart.items.reduce(function(acc, i) {
          return acc + i.qty * (parseFloat(i.price) || 0);
        }, 0);
      %>

      <div class="summary-row">
        <span>Subtotal</span>
        <span>$<%= _itemSubtotal.toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
      </div>
      <div class="summary-row summary-shipping">
        <span>Shipping</span>
        <span class="free-label">FREE</span>
      </div>

      <% if (_outletSavings > 0.01) { %>
      <div class="summary-savings summary-savings--outlet">
        <span class="savings-label">💚 Outlet savings</span>
        <strong>−$<%= _outletSavings.toLocaleString('en-US',{minimumFractionDigits:2}) %></strong>
      </div>
      <% } %>
      <% if (_bundleSavings > 0.01) { %>
      <div class="summary-savings summary-savings--bundle">
        <span class="savings-label">🎉 Bundle savings</span>
        <strong>−$<%= _bundleSavings.toLocaleString('en-US',{minimumFractionDigits:2}) %></strong>
      </div>
      <% } %>

      <div class="summary-row summary-total">
        <span>Total</span>
        <span>$<%= (parseFloat(cart.subtotal)||0).toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
      </div>

      <p class="summary-note">Taxes calculated at checkout</p>

      <a href="/checkout" class="btn btn-amber" style="width:100%;margin-bottom:12px;padding:.9rem">
        Proceed to Checkout
      </a>
      <a href="/collections" class="btn btn-outline" style="width:100%;text-align:center">
        Continue Shopping
      </a>

      <!-- Trust row -->
      <div class="cart-trust-row">
        <div class="ctr-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>256-bit SSL</span>
        </div>
        <div class="ctr-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/>
          </svg>
          <span>30-Day Returns</span>
        </div>
        <div class="ctr-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h3l4 4v5h-7V8z"/>
            <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
          <span>Free Shipping</span>
        </div>
      </div>

      <!-- Payment logos -->
      <div class="cart-payment-logos">
        <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="Visa">
          <rect width="60" height="38" rx="4" fill="#1A1F71"/>
          <text x="30" y="24" text-anchor="middle" fill="#fff" font-size="15" font-weight="700" font-style="italic" font-family="Arial,sans-serif" letter-spacing="1">VISA</text>
        </svg>
        <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="Mastercard">
          <rect width="60" height="38" rx="4" fill="#f0f0f0" stroke="#ddd" stroke-width=".5"/>
          <circle cx="23" cy="19" r="10" fill="#EB001B"/>
          <circle cx="37" cy="19" r="10" fill="#F79E1B"/>
          <path d="M30 11.2a10 10 0 0 1 0 15.6A10 10 0 0 1 30 11.2Z" fill="#FF5F00"/>
        </svg>
        <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="American Express">
          <rect width="60" height="38" rx="4" fill="#007BC1"/>
          <text x="30" y="16" text-anchor="middle" fill="#fff" font-size="7" font-weight="600" font-family="Arial,sans-serif" letter-spacing=".8">AMERICAN</text>
          <text x="30" y="27" text-anchor="middle" fill="#fff" font-size="9" font-weight="800" font-family="Arial,sans-serif" letter-spacing=".5">EXPRESS</text>
        </svg>
        <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="PayPal">
          <rect width="60" height="38" rx="4" fill="#fff" stroke="#ddd" stroke-width=".5"/>
          <text x="30" y="24" text-anchor="middle" font-size="12" font-weight="800" font-style="italic" font-family="Arial,sans-serif">
            <tspan fill="#003087">Pay</tspan><tspan fill="#009CDE">Pal</tspan>
          </text>
        </svg>
        <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="Apple Pay">
          <rect width="60" height="38" rx="4" fill="#000"/>
          <text x="30" y="24" text-anchor="middle" fill="#fff" font-size="11" font-weight="500" font-family="-apple-system,Arial,sans-serif">&#xf8ff; Pay</text>
        </svg>
        <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="Google Pay">
          <rect width="60" height="38" rx="4" fill="#fff" stroke="#ddd" stroke-width=".5"/>
          <text x="30" y="24" text-anchor="middle" font-size="12" font-weight="500" font-family="Arial,sans-serif">
            <tspan fill="#4285F4">G</tspan><tspan fill="#757575">Pay</tspan>
          </text>
        </svg>
      </div>

      <%
        var _gs2 = settings && settings.global ? settings.global : {};
        var _cartRating = parseFloat(_gs2.google_reviews_rating) || 0;
        var _cartCount  = parseInt(_gs2.google_reviews_count, 10) || 0;
      %>
      <% if (_cartRating > 0) { %>
      <div class="cart-google-rating">
        <span class="pgr-stars" aria-hidden="true">★★★★★</span>
        <span class="pgr-score"><%= _cartRating.toFixed(1) %></span>
        <a href="https://www.google.com/search?q=Bathroom+Vanities+Outlet+reviews"
           target="_blank" rel="noopener noreferrer" class="pgr-link">
          <%= _cartCount > 0 ? '(' + _cartCount + ' Google Reviews)' : 'Google Reviews' %>
        </a>
      </div>
      <% } %>
    </aside>

  </div><!-- /cart-layout -->
  <% } %>
</div>
