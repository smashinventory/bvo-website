<link rel="stylesheet" href="/css/site3.css?v=27"><!-- site3: injected per-page (perf) -->

<%
/* Page 1 of 3 — who you are, where it goes.
 *
 * No Stripe on this page at all. The order row is written from here with
 * a real email attached, which is what turns an abandoned checkout into
 * something we can follow up. See docs/briefs/BVO_CHECKOUT_SPEC.md §3.
 *
 * STAGE 1 is guest-only. Sign in / register arrive in stage 2; no dead
 * buttons for them are rendered.
 */
/* PRECEDENCE, and the order is the whole point:
     1. `old`   -- what they just typed on a submit that bounced
     2. `draft` -- what is already on this order
     3. saved   -- their last delivery address (item 28)
     4. fallback
   A saved address must NEVER overwrite something the buyer typed on
   THIS order. show() already guards by only fetching `savedAddress`
   when there is no draft and nothing bounced; this ordering is the
   second line of defence. */
const SAVED_MAP = {
  ship_address1: 'address1', ship_address2: 'address2',
  ship_city: 'city', ship_state: 'state', ship_zip: 'zip',
  ship_phone: 'phone', ship_phone_ext: 'phone_ext',
  ship_address_type: 'address_type',
};
const savedVal = (k) => {
  if (!savedAddress) return '';
  const col = SAVED_MAP[k];
  return col && savedAddress[col] != null ? savedAddress[col] : '';
};

const val = (k, fallback) =>
  (old && old[k] != null && old[k] !== '') ? old[k]
  : (draft && draft[k] != null && draft[k] !== '') ? draft[k]
  : (savedVal(k) || fallback || '');

/* CHECKBOXES CANNOT USE val(). An unchecked box submits NOTHING, so
   val() sees undefined, falls through to the fallback, and re-checks a
   box the buyer deliberately cleared. On the pre-checked delivery-SMS
   box that is not a cosmetic bug: bounce the form on any validation
   error and the consent record would claim they agreed when they had
   just said no.

   So the submitted state is read from the PRESENCE of the key, and the
   default applies only on a first render — when `old` does not exist
   because nothing has been submitted yet.

   `stored` lets a returning customer's saved preference win over the
   default — but ONLY once they have actually answered the question.

   WHY `answered` IS A SEPARATE ARGUMENT AND NOT INFERRED FROM `stored`:
   both consent columns are NOT NULL DEFAULT 0, so a customer created
   thirty seconds ago at /checkout/identify has delivery_sms_consent = 0
   — identical to someone who deliberately said no. Treating 0 as an
   answer meant the pre-checked default applied to nobody, ever. Caught
   by the gate, not by a customer.

   The *_consent_at timestamps are the only thing that distinguishes
   "never asked" from "asked and declined", which is exactly why they
   are in the schema.

   ⚠️ `old` IS ALWAYS AN OBJECT, NEVER NULL. takeCheckoutFlash returns
   `s.checkoutOld || {}`, and {} is TRUTHY — so a bare `if (old)` takes
   the was-submitted branch on a first render too, returns false for
   every box, and the pre-checked default reaches nobody. That shipped
   in e613af5 and was visible on the live page within the hour.

   The gate did not catch it because the fixture passed `old: null`,
   which the controller never produces. A test of a state that cannot
   occur proves nothing. Emptiness is the discriminator, not existence. */
const submitted = old && Object.keys(old).length > 0;
const checked = (k, dflt, stored, answered) => {
  if (submitted) return old[k] === '1' || old[k] === 1 || old[k] === true;
  if (answered) return !!Number(stored);
  return !!dflt;
};

const draftName = draft
  ? [draft.ship_first_name, draft.ship_last_name].filter(Boolean).join(' ')
  : (savedAddress
      ? [savedAddress.first_name, savedAddress.last_name].filter(Boolean).join(' ')
      : '');
const STATES = ['AL','AK','AZ','AR','CA','CO','CT','DE','DC','FL','GA','HI','ID','IL','IN','IA',
  'KS','KY','LA','ME','MD','MA','MI','MN','MS','MO','MT','NE','NV','NH','NJ','NM','NY','NC','ND',
  'OH','OK','OR','PA','RI','SC','SD','TN','TX','UT','VT','VA','WA','WV','WI','WY'];
const money = n => '$' + Number(n || 0).toLocaleString('en-US',
  { minimumFractionDigits: 2, maximumFractionDigits: 2 });
%>

<div class="checkout-page">

  <div class="checkout-header">
    <h1>Checkout</h1>
    <a href="/cart" class="checkout-back">&larr; Back to cart</a>
  </div>

  <%- include('../partials/checkout-steps', { step: 1 }) %>

  <% if (checkoutError) { %>
    <div class="checkout-error-banner" role="alert">
      <span><%= checkoutError %></span>
    </div>
  <% } %>

  <%/* ── Address check (item 16) ───────────────────────────────────────
       Shown once, after a submit whose address came back fix or suspect.
       The order is ALREADY SAVED by the time this renders and the buyer
       is never blocked - submitting again proceeds whatever they choose.

       Tone matters here more than anywhere else on the page. This appears
       after someone has typed their own address, so it cannot read as an
       accusation. It is a typo check offered once, in the buyer's
       interest, because a wrong apartment number on a freight delivery
       costs them a redelivery fee and a second day at home.

       No jargon reaches the buyer. DPV codes, CMRA, granularity and the
       USPS flags are for the admin order screen; here it is plain English
       about what to look at. */%>
  <% if (typeof addrWarning !== 'undefined' && addrWarning) { %>
    <%
      const w  = addrWarning;
      const fl = String(w.flags || '');
      const uf = String(w.uspsFlags || '');
      /* Most specific true thing first. A buyer told "check the apartment
         number" fixes it; one told "we could not verify this address"
         shrugs and carries on. */
      let headline, detail;
      if (fl.includes('missing_subpremise') || w.dpv === 'D') {
        headline = 'Is there an apartment, suite or unit number?';
        detail   = 'The post office has this building but no unit. Freight is delivered to a door, so without it the driver may not find you.';
      } else if (w.dpv === 'S') {
        headline = 'Double-check the apartment or suite number.';
        detail   = 'The street address checks out, but the post office does not recognise that unit at this building.';
      } else if (uf.includes('vacant')) {
        headline = 'Please confirm this address is occupied.';
        detail   = 'The post office currently lists it as vacant. If you have just moved in, that is normal and you can carry on.';
      } else if (uf.includes('cmra') || uf.includes('no_secure_location') || uf.includes('door_not_accessible')) {
        headline = 'This may not be a good address for a freight delivery.';
        detail   = 'It looks like a mailbox or a location where a driver cannot leave a large crate. A street address where someone can receive a pallet works best.';
      } else {
        headline = 'Please double-check this address.';
        detail   = 'We could not fully confirm it with the post office. It may still be correct — a new build often is.';
      }
    %>
    <div class="checkout-addr-check" role="region" aria-labelledby="addr-check-h">
      <h2 class="checkout-addr-check-h" id="addr-check-h"><%= headline %></h2>
      <p class="checkout-addr-check-sub"><%= detail %></p>

      <% if (w.corrected) { %>
        <div class="checkout-addr-opts">
          <div class="checkout-addr-opt">
            <p class="checkout-addr-opt-label">You entered</p>
            <p class="checkout-addr-opt-body"><%= w.typed.address1 %><% if (w.typed.address2) { %><br><%= w.typed.address2 %><% } %><br><%= w.typed.city %>, <%= w.typed.state %> <%= w.typed.zip %></p>
          </div>
          <div class="checkout-addr-opt checkout-addr-opt--suggested">
            <p class="checkout-addr-opt-label">Post office version</p>
            <p class="checkout-addr-opt-body"><%= w.corrected.address1 %><% if (w.typed.address2) { %><br><%= w.typed.address2 %><% } %><br><%= w.corrected.city %>, <%= w.corrected.state %> <%= w.corrected.zip %></p>
            <%/* Fills the form rather than submitting. The buyer still
                 presses Continue themselves - nothing is decided for
                 them, and the apartment line is theirs either way. */%>
            <button type="button" class="btn btn-secondary checkout-addr-use"
                    id="addr-use"
                    data-a1="<%= w.corrected.address1 %>"
                    data-city="<%= w.corrected.city %>"
                    data-state="<%= w.corrected.state %>"
                    data-zip="<%= w.corrected.zip %>">Use this version</button>
          </div>
        </div>
      <% } %>

      <p class="checkout-addr-check-foot">Edit the address below if you need to, or just press Continue to keep what you entered.</p>
    </div>
  <% } %>

  <div class="checkout-layout">
    <form method="POST" action="/checkout/info" novalidate id="info-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Contact -->
      <div class="checkout-card">
        <h2 class="checkout-card-title">Contact information</h2>
        <p class="checkout-card-sub">We send your receipt and delivery updates here.</p>

        <%/* NOT AN INPUT ANY MORE. Identity is settled at
             /checkout/identify before this page renders, and the address
             was PROVEN there by a six-digit code. An editable field here
             would let someone change it to an unproven address after the
             proving step — which is the whole value of the gate, handed
             back.

             No hidden input either: saveInfo reads the address from the
             session, never from the body. A hidden field would be a
             forgeable copy of a fact the server already holds. */%>
        <div class="checkout-field">
          <label>Email address</label>
          <p class="checkout-readonly" id="checkout-email">
            <%= (customer && customer.email) || '' %>
            <a href="/checkout/identify?change=1" class="checkout-readonly-change">Not you?</a>
          </p>
          <span class="checkout-field-hint">Your receipt and delivery updates go here.</span>
        </div>

        <%/* MARKETING CONSENT — owner-approved verbatim, spec 9.2.
             UNCHECKED by default (9.2a): a pre-ticked marketing box is
             weaker evidence of consent and off-tone for a site that
             otherwise tells people plainly what it does.

             Inline in the form, not a screen and not a gate. Wayfair
             gives this its own step because it is selling a $29
             membership; a screen implies a decision worth stopping for,
             which invites "no". */%>
        <label class="checkout-consent" for="marketing_opt_in">
          <input type="checkbox" id="marketing_opt_in" name="marketing_opt_in" value="1"
                 <%= checked('marketing_opt_in', false, customer && customer.accepts_marketing, customer && customer.marketing_consent_at) ? 'checked' : '' %>>
          <span>
            <strong>Email me about my vanity.</strong><br>
            Matching pieces in your finish when they go on sale, new sizes in your
            model line, replacement parts when we stock them, and how to care for
            your countertop. Nothing else, and one click to stop.
          </span>
        </label>
      </div>

      <!-- Shipping -->
      <div class="checkout-card">
        <h2 class="checkout-card-title">Delivery address</h2>
        <p class="checkout-card-sub">Where the freight truck is going. You'll enter the address on your card at the payment step.</p>

        <%/* SAY SO. Spec §7 Stage 3 item 28: prefill VISIBLY.
             A trade buyer ships to a different jobsite every job. Fill
             the fields silently and a 300 lb vanity goes to the site
             they finished last month -- expensive to reverse, and the
             kind of error that is blamed on the website. */%>
        <% if (savedAddress) { %>
          <p class="checkout-prefill-note">
            Shipping to your last address<% if (savedAddress.city) { %>
            in <%= savedAddress.city %><% if (savedAddress.state) { %>, <%= savedAddress.state %><% } %><% } %>.
            <strong>Change anything below if this order goes somewhere else.</strong>
          </p>
        <% } %>

        <div class="checkout-field">
          <label for="ship_name">Full name <span class="req">*</span></label>
          <input type="text" id="ship_name" name="ship_name" autocomplete="name"
                 value="<%= val('ship_name', draftName) %>">
          <% if (errors.ship_name) { %><span class="checkout-field-error"><%= errors.ship_name %></span><% } %>
          <span class="checkout-field-hint">Who the carrier asks for at the door.</span>
        </div>

        <%/* Street address. The input is a PLAIN TEXT INPUT that happens to
             have suggestions attached — it is not a widget. With JS off, the
             Places key absent, the library blocked or the quota tripped, it
             is still typable and the form still submits. That is the whole
             design constraint: a degraded address field is acceptable, a
             broken one loses the order.

             role/aria-* are set here rather than in script so a screen
             reader gets the same markup whether or not the library loads;
             aria-expanded flips to true only when there is a list to
             expand. */%>
        <div class="checkout-field checkout-ac" id="ac-wrap">
          <label for="ship_address1">Street address <span class="req">*</span></label>
          <input type="text" id="ship_address1" name="ship_address1" autocomplete="address-line1"
                 role="combobox" aria-autocomplete="list" aria-expanded="false"
                 aria-controls="ac-list" aria-describedby="ac-status"
                 value="<%= val('ship_address1') %>">
          <ul class="checkout-ac-list" id="ac-list" role="listbox" aria-label="Address suggestions" hidden></ul>
          <span class="checkout-ac-status" id="ac-status" role="status" aria-live="polite"></span>
          <%/* ONLY when a key exists, and removed by giveUp() if the
               library fails at runtime. A field that says "choose from
               the list" and then never shows one reads as broken - which
               is exactly how the 4-character minimum read before this
               line existed. Suggestions are poor below 5-6 characters, so
               the answer is to set the expectation rather than fire
               earlier and return noise. */%>
          <% if (mapsKey) { %>
            <span class="checkout-field-hint" id="ac-hint">Start typing and choose your address from the list.</span>
          <% } %>
          <% if (errors.ship_address1) { %><span class="checkout-field-error"><%= errors.ship_address1 %></span><% } %>
        </div>

        <%/* Provenance, decided by the server from these three (item 17).
             ship_autofill_snapshot carries what autocomplete actually wrote,
             so saveInfo can tell 'picked and left alone' from 'picked then
             edited' by comparing it to what was submitted. There is
             deliberately NO ship_address_source field here: a source string
             the page could set is a fraud signal the fraudster controls. */%>
        <input type="hidden" name="ship_place_id" id="ship_place_id" value="">
        <input type="hidden" name="ship_formatted_address" id="ship_formatted_address" value="">
        <input type="hidden" name="ship_autofill_snapshot" id="ship_autofill_snapshot" value="">

        <%/* The LIVE autocomplete session token, or empty.
             Server-side Address Validation can terminate an unfinished
             autocomplete session, which makes every keystroke in it free.
             Only useful while the session is still live: picking a
             suggestion already terminates it via Place Details, and a
             spent token is both invalid and billed separately. So this is
             cleared the moment a suggestion is chosen. */%>
        <input type="hidden" name="ship_autocomplete_session" id="ship_autocomplete_session" value="">

        <div class="checkout-field">
          <label for="ship_address2">Apartment, suite, unit</label>
          <input type="text" id="ship_address2" name="ship_address2" autocomplete="address-line2"
                 placeholder="Optional" value="<%= val('ship_address2') %>">
        </div>

        <div class="checkout-field-row">
          <div class="checkout-field">
            <label for="ship_city">City <span class="req">*</span></label>
            <input type="text" id="ship_city" name="ship_city" autocomplete="address-level2"
                   value="<%= val('ship_city') %>">
            <% if (errors.ship_city) { %><span class="checkout-field-error"><%= errors.ship_city %></span><% } %>
          </div>
          <div class="checkout-field-row">
            <div class="checkout-field">
              <label for="ship_state">State <span class="req">*</span></label>
              <select id="ship_state" name="ship_state" autocomplete="address-level1">
                <option value="">Choose</option>
                <% STATES.forEach(function (s) { %>
                  <option value="<%= s %>" <%= val('ship_state', draft && draft.ship_state) === s ? 'selected' : '' %>><%= s %></option>
                <% }); %>
              </select>
              <% if (errors.ship_state) { %><span class="checkout-field-error"><%= errors.ship_state %></span><% } %>
            </div>
            <div class="checkout-field">
              <label for="ship_zip">ZIP <span class="req">*</span></label>
              <input type="text" id="ship_zip" name="ship_zip" inputmode="numeric"
                     autocomplete="postal-code" maxlength="10" value="<%= val('ship_zip') %>">
              <% if (errors.ship_zip) { %><span class="checkout-field-error"><%= errors.ship_zip %></span><% } %>
            </div>
          </div>
        </div>

        <%/* The delivery phone is its own fact, separate from whatever
             phone the cardholder gives Stripe later. This is the number
             the carrier dials to book the appointment, and without it a
             freight order cannot be dispatched at all. */%>
        <div class="checkout-phone-row">
          <div class="checkout-field">
            <label for="ship_phone">Phone number <span class="req">*</span></label>
            <input type="tel" id="ship_phone" name="ship_phone" inputmode="tel"
                   autocomplete="tel" placeholder="(404) 555-1234"
                   value="<%= val('ship_phone') %>">
          </div>
          <div class="checkout-field">
            <label for="ship_phone_ext">Ext.</label>
            <input type="text" id="ship_phone_ext" name="ship_phone_ext"
                   inputmode="numeric" maxlength="8" placeholder="Optional"
                   value="<%= val('ship_phone_ext') %>">
          </div>
        </div>
        <span class="checkout-field-hint">The freight carrier calls this number to schedule your delivery.</span>
        <% if (errors.ship_phone) { %><span class="checkout-field-error"><%= errors.ship_phone %></span><% } %>

        <%/* DELIVERY SMS CONSENT — owner-approved verbatim, spec 9.2.
             PRE-CHECKED by default (9.2a), and sitting directly under
             the number it governs rather than in a consent block
             elsewhere. A checkbox beside the field it concerns explains
             itself; the same words on their own screen do not.

             Pre-checking is defensible ONLY because this is
             transactional: the buyer hands over this number precisely so
             the carrier can reach them about this shipment, and texting
             the window is that same purpose done better. The carrier
             calls either way.

             ⛔ THE CONDITION THAT MAKES IT LAWFUL, AND IT IS NOT
             OPTIONAL: this channel carries DELIVERY INFORMATION ONLY.
             Forever. No promotion, no "while we're here", no cross-sell,
             not once. The moment a promotion goes down this path it
             stops being transactional consent and becomes exactly what
             gets retailers sued under the TCPA — and this box would then
             have to revert to unchecked with consent re-collected from
             everyone who ever ticked it. If the content of delivery
             texts is ever widened: unset the default and re-consent. Do
             not reason that "they already agreed". Spec 9.2a / 9.4. */%>
        <label class="checkout-consent" for="delivery_sms_opt_in">
          <input type="checkbox" id="delivery_sms_opt_in" name="delivery_sms_opt_in" value="1"
                 <%= checked('delivery_sms_opt_in', true, customer && customer.delivery_sms_consent, customer && customer.delivery_sms_consent_at) ? 'checked' : '' %>>
          <span>
            <strong>Text me about my delivery.</strong><br>
            The carrier calls to book your appointment. We'll also text the window
            and let you know when the truck is out.
          </span>
        </label>

        <fieldset class="checkout-radio-group">
          <legend>Delivery location <span class="req">*</span></legend>
          <label class="checkout-check" for="dt-res">
            <input type="radio" name="ship_address_type" id="dt-res" value="residential"
                   <%= val('ship_address_type', draft && draft.ship_address_type) !== 'commercial' ? 'checked' : '' %>>
            <span>Residential &mdash; a house or apartment</span>
          </label>
          <label class="checkout-check" for="dt-com">
            <input type="radio" name="ship_address_type" id="dt-com" value="commercial"
                   <%= val('ship_address_type', draft && draft.ship_address_type) === 'commercial' ? 'checked' : '' %>>
            <span>Commercial &mdash; a business with a loading dock or forklift</span>
          </label>
          <span class="checkout-field-hint">This tells the carrier what kind of truck and crew to send.</span>
          <% if (errors.ship_address_type) { %><span class="checkout-field-error"><%= errors.ship_address_type %></span><% } %>
        </fieldset>
      </div>

      <button type="submit" class="btn btn-primary checkout-submit-btn">
        Continue to delivery
      </button>
    </form>

    <!-- Summary -->
    <aside class="checkout-summary">
      <div class="checkout-card">
        <h2 class="checkout-card-title">Order summary</h2>
        <% cart.items.forEach(function (item) { %>
          <div class="co-item">
            <% if (item.image) { %>
              <img src="<%= item.image %>" alt="" class="co-item-img" width="56" height="56">
            <% } else { %>
              <div class="co-item-img co-item-img--placeholder"></div>
            <% } %>
            <div>
              <p class="co-item-name"><%= item.name %></p>
              <p class="co-item-meta">Qty: <%= item.qty || 1 %></p>
            </div>
            <span class="co-item-price"><%= money((item.price || 0) * (item.qty || 1)) %></span>
          </div>
        <% }); %>

        <div class="co-sum-row"><span>Subtotal</span><span><%= money(subtotal) %></span></div>
        <div class="co-sum-row"><span>Shipping</span><span>FREE</span></div>
        <div class="co-sum-row co-sum-total"><span>Total</span><span><%= money(subtotal) %></span></div>
        <p class="co-sum-note">Sales tax is calculated at the payment step.</p>
      </div>
    </aside>
  </div>
</div>

<script nonce="<%= cspNonce %>">
(function () {
  'use strict';

  /* Mirrors toE164() in checkoutController.js. The server is what decides
     what enters the column; this only spares the buyer a round trip. */
  function e164(raw) {
    var s = String(raw || '').trim()
      .replace(/[\s,;]*(?:ext|extension|xt|x|#)\.?\s*\d+\s*$/i, '');
    var d = s.replace(/[^\d+]/g, '');
    if (d.charAt(0) === '+') return d;
    d = d.replace(/\D/g, '');
    if (d.length === 10) return '+1' + d;
    if (d.length === 11 && d.charAt(0) === '1') return '+' + d;
    return d ? '+' + d : '';
  }

  var phone = document.getElementById('ship_phone');
  var ext   = document.getElementById('ship_phone_ext');

  /* An extension typed into the number box moves across rather than being
     eaten. Only when the Ext box is empty - never overwrite a deliberate
     entry. */
  function harvestExt() {
    var m = /[\s,;]*(?:ext|extension|xt|x|#)\.?\s*(\d{1,8})\s*$/i.exec(phone.value);
    if (m && !ext.value.trim()) {
      ext.value   = m[1];
      phone.value = phone.value.slice(0, m.index).replace(/[\s,;]+$/, '');
    }
  }
  phone.addEventListener('blur', harvestExt);

  /* "Use this version" on the address check panel. Fills the four fields
     and nothing else - the apartment line stays the buyer's, and they
     still press Continue themselves. Lives in THIS script block, not the
     autocomplete one, because the panel must work with no Places key and
     with the Maps library blocked. */
  var addrUse = document.getElementById('addr-use');
  if (addrUse) {
    addrUse.addEventListener('click', function () {
      var map = { ship_address1: 'a1', ship_city: 'city', ship_state: 'state', ship_zip: 'zip' };
      Object.keys(map).forEach(function (id) {
        var el = document.getElementById(id);
        var v  = addrUse.getAttribute('data-' + map[id]);
        if (el && v) { el.value = v; el.dispatchEvent(new Event('change', { bubbles: true })); }
      });
      addrUse.disabled = true;
      addrUse.textContent = 'Filled in below';
    });
  }

  /* Block a submit that the server would only bounce back. Same rules,
     stated to the buyer where they are looking. */
  document.getElementById('info-form').addEventListener('submit', function (ev) {
    harvestExt();
    if (!/^\+1\d{10}$/.test(e164(phone.value))) {
      ev.preventDefault();
      phone.focus();
      phone.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
  });
})();
</script>

<% if (mapsKey) { %>
<%/* ── Places Autocomplete (New) — item 15 ──────────────────────────────
     Rendered ONLY when GOOGLE_MAPS_API_KEY is set. No key, no script tag,
     no console error, and the street field above is an ordinary text input
     that works exactly as it did before.

     WHY THE PROGRAMMATIC API AND NOT THE WIDGET
     google.maps.places.Autocomplete (the legacy widget) would be a
     fraction of this code, and it is the wrong tool twice over:
       1. It fires a request per KEYSTROKE with no debounce hook. Ten
          keystrokes is ten billable requests. Debouncing is the single
          most effective cost control available and the widget forbids it.
       2. Address Validation can only share a billing session with
          Autocomplete (NEW) - confirmed in Google's sessionToken reference,
          2026-09-27. Pairing the legacy widget with validation means the
          autocomplete requests are billed separately AND the validation is
          billed separately.
     So: our own debounce, our own session token, our own dropdown.

     HOW THE MONEY WORKS
     One session = many autocomplete requests + ONE terminating call
     (Place Details or Address Validation). Terminated, the autocomplete
     requests in it are free. Abandoned, every request is billed on its
     own. So the session token must persist across keystrokes and be
     replaced only after a selection - a fresh token per keystroke would
     bill every single one. */%>
<script nonce="<%= cspNonce %>">
(function () {
  'use strict';

  var KEY = <%- JSON.stringify(String(mapsKey)) %>;

  var input  = document.getElementById('ship_address1');
  var list   = document.getElementById('ac-list');
  var status = document.getElementById('ac-status');
  var wrap   = document.getElementById('ac-wrap');
  var fPlace = document.getElementById('ship_place_id');
  var fFmt   = document.getElementById('ship_formatted_address');
  var fSnap  = document.getElementById('ship_autofill_snapshot');
  var fSess  = document.getElementById('ship_autocomplete_session');
  if (!input || !list || !fPlace) return;

  /* Publish the live session token so the server can terminate the
     session with its Address Validation call, making every autocomplete
     request in it free.

     GUARDED, because this reads an UNDOCUMENTED internal. Google's
     AutocompleteSessionToken is an opaque class; the underlying string
     sits on a `token` property that is not part of the public API.
     Verified on the live site 2026-09-27 - a 36-character value, matching
     the documented maximum. If Google ever renames it, the regex fails,
     the field stays empty, and we quietly lose the saving. That is the
     correct failure: a cost optimisation degrading is fine, a checkout
     breaking over one is not. */
  function publishToken() {
    if (!fSess) return;
    var raw = (token && typeof token.token === 'string') ? token.token : '';
    fSess.value = /^[A-Za-z0-9_-]{1,36}$/.test(raw) ? raw : '';
  }

  /* ── Cost guards, in code ──────────────────────────────────────────
     DEBOUNCE_MS is the approved ~300ms. MIN_CHARS skips the first few
     keystrokes, which can never produce a useful street suggestion but
     would each be billed. MAX_REQUESTS is the backstop: a bug that
     re-fires in a loop stops at a bounded cost instead of an invoice.
     The Cloud quota cap (2,000/day, 100/min) sits behind all three. */
  var DEBOUNCE_MS   = 300;
  var MIN_CHARS     = 4;
  var MAX_REQUESTS  = 40;

  var timer = null, seq = 0, spent = 0, token = null, items = [], active = -1;
  var Suggestion = null, SessionToken = null;

  function say(msg) { status.textContent = msg || ''; }

  function close() {
    list.hidden = true;
    list.innerHTML = '';
    items = []; active = -1;
    input.setAttribute('aria-expanded', 'false');
    input.removeAttribute('aria-activedescendant');
  }

  /* Suggestion text is inserted with textContent, never innerHTML. It is
     third-party data arriving over the network and it lands next to a
     payment flow. */
  function draw() {
    list.innerHTML = '';
    items.forEach(function (it, i) {
      var li = document.createElement('li');
      li.className = 'checkout-ac-item';
      li.id = 'ac-opt-' + i;
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', i === active ? 'true' : 'false');
      if (i === active) li.classList.add('is-active');

      var main = document.createElement('span');
      main.className = 'checkout-ac-main';
      main.textContent = it.main;
      li.appendChild(main);

      if (it.secondary) {
        var sec = document.createElement('span');
        sec.className = 'checkout-ac-sec';
        sec.textContent = it.secondary;
        li.appendChild(sec);
      }

      /* mousedown, not click: the input's blur handler closes the list, and
         blur fires before click. */
      li.addEventListener('mousedown', function (ev) { ev.preventDefault(); choose(i); });
      list.appendChild(li);
    });

    /* Google Maps Platform terms require attribution when Places data is
       shown outside a Google map. */
    var cred = document.createElement('li');
    cred.className = 'checkout-ac-credit';
    cred.setAttribute('role', 'presentation');
    cred.textContent = 'Powered by Google';
    list.appendChild(cred);

    list.hidden = false;
    input.setAttribute('aria-expanded', 'true');
  }

  function move(delta) {
    if (list.hidden || !items.length) return;
    active = (active + delta + items.length) % items.length;
    draw();
    input.setAttribute('aria-activedescendant', 'ac-opt-' + active);
  }

  /* ── Library load, once, lazily ──────────────────────────────────────
     Not on page load: a buyer who arrives with the address already
     prefilled from a draft never touches this field, and loading the
     library for them is a download they did not need. Triggered by the
     first focus instead. */
  var loading = null;
  function load() {
    if (loading) return loading;
    loading = new Promise(function (resolve, reject) {
      if (window.google && window.google.maps && window.google.maps.importLibrary) return resolve();

      /* &callback=, NOT script.onload. THIS IS A RACE AND onload LOSES.
         Measured on the live site 2026-09-27:
           onload fired
           google.maps exists at onload:     true
           importLibrary type at onload:     undefined
           -> TypeError: google.maps.importLibrary is not a function
         onload fires when the bootstrap script finishes executing, which
         is BEFORE the API finishes installing importLibrary. The callback
         is Google's documented signal that the API is actually ready, and
         it is the only one that is true at the moment it fires.

         The failure was invisible: the library went on loading normally,
         so google.maps was present a few hundred ms later and everything
         looked healthy. Only the one rejected promise - already swallowed
         by giveUp() - knew anything had gone wrong. */
      window.bvoPlacesReady = function () { resolve(); };

      var s = document.createElement('script');
      s.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(KEY)
            + '&libraries=places&loading=async&v=weekly&callback=bvoPlacesReady';
      s.async = true;
      /* onerror still matters: it is what catches a blocked or offline
         script, where the callback simply never fires. */
      s.onerror = function () { reject(new Error('script blocked')); };
      /* And a ceiling, because a callback that never fires would otherwise
         leave the promise pending forever and the field in a state that
         never resolves either way. */
      setTimeout(function () { reject(new Error('maps callback never fired')); }, 10000);
      document.head.appendChild(s);
    }).then(function () {
      return google.maps.importLibrary('places');
    }).then(function (places) {
      Suggestion   = places.AutocompleteSuggestion;
      SessionToken = places.AutocompleteSessionToken;
      if (!Suggestion || !SessionToken) throw new Error('places (new) unavailable');
    });
    return loading;
  }

  /* Every failure path lands here. The field stays usable and the buyer is
     told nothing, because there is nothing for them to do about it - they
     were always able to just type the address. An ad blocker, a tripped
     quota, a revoked key and an offline phone all look the same from here
     and all have the same correct response. */
  function giveUp() {
    close();
    say('');
    /* The hint promised a list. There is not going to be one. */
    var hint = document.getElementById('ac-hint');
    if (hint) hint.remove();
    input.removeAttribute('role');
    input.removeAttribute('aria-autocomplete');
    input.removeAttribute('aria-expanded');
    input.removeAttribute('aria-controls');
    ask = function () {};
  }

  var ask = function () {
    var q = input.value.trim();
    if (q.length < MIN_CHARS) { close(); return; }
    if (spent >= MAX_REQUESTS) { close(); return; }

    load().then(function () {
      if (!token) { token = new SessionToken(); publishToken(); }
      var mine = ++seq;
      spent++;
      return Suggestion.fetchAutocompleteSuggestions({
        input: q,
        sessionToken: token,
        /* US only, and street-level types only. A buyer cannot take
           freight delivery in another country, and suggesting cities or
           regions invites a selection that fills nothing useful. */
        includedRegionCodes: ['us'],
        includedPrimaryTypes: ['street_address', 'premise', 'subpremise'],
      }).then(function (res) {
        /* A slower earlier request must not overwrite a faster later one.
           Without this the list can settle on suggestions for a prefix the
           buyer has already typed past. */
        if (mine !== seq) return;

        items = (res.suggestions || []).map(function (s) {
          var p = s.placePrediction;
          if (!p) return null;
          return {
            placeId:   p.placeId,
            main:      p.mainText ? p.mainText.toString() : p.text.toString(),
            secondary: p.secondaryText ? p.secondaryText.toString() : '',
            place:     p.toPlace(),
          };
        }).filter(Boolean).slice(0, 5);

        active = -1;
        if (items.length) { draw(); say(items.length + ' address suggestions. Use arrow keys to review.'); }
        else { close(); say(''); }
      });
    }).catch(giveUp);
  };

  function debounced() {
    /* Typing invalidates a previous selection. Clearing the hidden fields
       here is what makes 'edited' detectable: the snapshot survives so the
       server can compare, but a half-typed address never keeps a Place ID
       that no longer describes it. */
    fPlace.value = '';
    fFmt.value   = '';
    clearTimeout(timer);
    timer = setTimeout(function () { ask(); }, DEBOUNCE_MS);
  }

  function setField(id, value) {
    var el = document.getElementById(id);
    if (!el || !value) return;
    el.value = value;
    /* The state field is a <select>; anything watching it needs the event. */
    el.dispatchEvent(new Event('change', { bubbles: true }));
  }

  function choose(i) {
    var it = items[i];
    if (!it) return;
    close();

    /* THE TERMINATING CALL. fetchFields is the Place Details request that
       closes the billing session, which makes every autocomplete request in
       it free. Only the four location fields are asked for - the cheapest
       tier. Adding a field from a richer tier here would silently reprice
       every selection. */
    it.place.fetchFields({ fields: ['addressComponents', 'formattedAddress', 'id'] })
      .then(function () {
        var p = it.place;
        var get = function (type, useShort) {
          var c = (p.addressComponents || []).find(function (comp) {
            return (comp.types || []).indexOf(type) !== -1;
          });
          return c ? (useShort ? c.shortText : c.longText) : '';
        };

        var num    = get('street_number');
        var street = get('route');
        var line1  = [num, street].filter(Boolean).join(' ');

        /* A suggestion with no house number would blank a line the buyer
           had already typed correctly. Leave theirs alone instead. */
        if (line1) setField('ship_address1', line1);
        setField('ship_city', get('locality') || get('sublocality') || get('postal_town'));
        setField('ship_state', get('administrative_area_level_1', true));
        setField('ship_zip', get('postal_code'));

        /* ship_address2 is DELIBERATELY not written. Google can return a
           subpremise, but it is the buyer who knows whether the crate goes
           to apartment 4B, and overwriting what they typed there is how a
           freight delivery ends up at the wrong door. */

        fPlace.value = p.id || it.placeId || '';
        fFmt.value   = p.formattedAddress || '';

        /* Snapshot of exactly what was written, for the server to compare
           against what is submitted. */
        fSnap.value = JSON.stringify({
          ship_address1: document.getElementById('ship_address1').value,
          ship_city:     document.getElementById('ship_city').value,
          ship_state:    document.getElementById('ship_state').value,
          ship_zip:      document.getElementById('ship_zip').value,
        });

        /* Session is spent - Place Details terminated it, so every
           autocomplete request in it is already free. The next keystroke
           starts a new one; reusing this token would bill each of its
           requests separately AND Google treats a concluded token as
           invalid. Clearing the hidden field stops the server sending a
           spent token to Address Validation. */
        token = null;
        publishToken();
        say('Address filled in. Check it and add an apartment or suite number if you have one.');
        var a2 = document.getElementById('ship_address2');
        if (a2 && !a2.value) a2.focus();
      })
      .catch(giveUp);
  }

  input.addEventListener('input', debounced);
  input.addEventListener('focus', function () { load().catch(giveUp); }, { once: true });
  input.addEventListener('blur', function () { setTimeout(close, 150); });

  input.addEventListener('keydown', function (ev) {
    if (ev.key === 'ArrowDown') { ev.preventDefault(); move(1); }
    else if (ev.key === 'ArrowUp') { ev.preventDefault(); move(-1); }
    else if (ev.key === 'Enter') {
      /* Enter only commits when a suggestion is highlighted. Otherwise it
         must submit the form as it always has - swallowing Enter on a text
         field is the kind of change that makes a checkout feel broken. */
      if (!list.hidden && active >= 0) { ev.preventDefault(); choose(active); }
    }
    else if (ev.key === 'Escape') { close(); }
  });

  document.addEventListener('click', function (ev) {
    if (!wrap.contains(ev.target)) close();
  });
})();
</script>
<% } %>
