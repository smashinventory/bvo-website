          <rect width="60" height="38" rx="4" fill="#fff" stroke="#ddd" stroke-width=".5"/>
          <text x="30" y="24" text-anchor="middle" font-size="12" font-weight="500" font-family="Arial,sans-serif">
            <tspan fill="#4285F4">G</tspan><tspan fill="#757575">Pay</tspan>
