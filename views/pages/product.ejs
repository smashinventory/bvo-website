      <% productDocs.forEach(function(doc) { %>
      <a href="<%= doc.url %>" target="_blank" rel="noopener" class="product-doc-card">
        <span class="product-doc-icon"><%= _dlIcons[doc.doc_type] || '📎' %></span>
        <span class="product-doc-name"><%= doc.label || _dlLabels[doc.doc_type] || doc.doc_type %></span>
        <span class="product-doc-dl">Download ↓</span>
      </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ── Watch This Product ──────────────────────────────────────────── -->
<%
  var _allVideos = [];
  if (product.video_url) _allVideos.push({ url: product.video_url, title: product.name + ' — Product Video' });
  if (typeof productVideos !== 'undefined') {
    productVideos.forEach(function(v){ _allVideos.push(v); });
  }
  function _isYTUrl(u){ return !!(u && /youtu\.be|youtube\.com/.test(String(u))); }
  function _ytIdFromUrl(u){
    if (!u) return null;
    var m = String(u).match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?.*?v=|shorts\/))([a-zA-Z0-9_-]{11})/);
    return m ? m[1] : null;
  }
%>
<% if (_allVideos.length) { %>
<section class="section pdp-videos-section" aria-labelledby="pdp-videos-heading">
  <div class="pdp-videos-inner">
    <h2 id="pdp-videos-heading">Watch This Product</h2>
    <div class="pdp-videos-grid">
      <% _allVideos.forEach(function(vid, vi) { %>
      <%
        var _vIsYT  = _isYTUrl(vid.url);
        var _vYTId  = _vIsYT ? _ytIdFromUrl(vid.url) : null;
        var _vTitle = vid.title || (product.name + (vi > 0 ? ' — Video ' + (vi + 1) : ' — Product Video'));
      %>
      <div class="pdp-video-item">
        <div class="pdp-video-embed">
          <% if (_vIsYT && _vYTId) { %>
          <iframe
            src="https://www.youtube-nocookie.com/embed/<%= _vYTId %>?rel=0&modestbranding=1&cc_load_policy=0&iv_load_policy=3"
            title="<%= _vTitle %>"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen loading="lazy">
          </iframe>
          <% } else { %>
          <video controls preload="metadata" title="<%= _vTitle %>">
            <source src="<%= vid.url %>" type="video/mp4">
            Your browser does not support video playback.
          </video>
          <% } %>
        </div>
        <% if (vid.title) { %><p class="pdp-video-title"><%= vid.title %></p><% } %>
      </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- Complete the Look — same-collection JM mirrors (vanity pages only) -->
<% if (suggestedMirrors && suggestedMirrors.length > 0) { %>
<section class="related-section" aria-labelledby="ctl-heading">
  <div class="section-header">
    <p class="section-eyebrow"><%= product.model %> Collection</p>
    <h2 class="section-title" id="ctl-heading">Complete the Look</h2>
  </div>
  <div class="product-grid">
    <% suggestedMirrors.forEach(function(m) { %>
    <article class="product-card">
      <%# One DOM shape for .product-img everywhere: the box is the parent,
          the <a> wraps the photo. No badge on this card today, kept identical
          so a single CSS rule describes every product card on the site. %>
      <div class="product-img">
        <a href="/products/<%= m.slug %>" class="product-img-link">
          <% if (m.primary_image) { %>
            <img src="<%= m.primary_image %>" alt="<%= (m.brand ? m.brand + ' ' : '') + m.name %>" loading="lazy">
          <% } else { %>
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
          <% } %>
        </a>
      </div>
      <div class="product-body">
        <p class="product-brand"><%= product.brand %></p>
        <p class="product-title"><a href="/products/<%= m.slug %>"><%= m.name %></a></p>
        <div class="product-price-row">
          <span class="product-price">$<%= parseFloat(m.price).toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
          <% if (m.compare_price && m.compare_price > m.price) { %>
          <span class="product-was">$<%= parseFloat(m.compare_price).toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
          <% } %>
        </div>
        <a href="/products/<%= m.slug %>" class="btn btn-sage">View Mirror</a>
      </div>
    </article>
    <% }) %>
  </div>
</section>
<% } %>

<!-- Related products -->
