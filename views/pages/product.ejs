<!-- Breadcrumb -->
<div class="breadcrumb">
  <a href="/">Home</a> &rsaquo;
  <% if (category) { %><a href="/collections/<%= category.slug %>"><%= category.name %></a> &rsaquo;<% } %>
  <span><%= product.name %></span>
</div>

<!-- ── Product Detail Layout ──────────────────────────────────────── -->
<div class="detail-layout">

  <!-- ── Gallery ──────────────────────────────────────────────────── -->
  <%
    const _imgs  = product.images || [];
    const _shown = _imgs.slice(0, 6);
    const _total = _imgs.length;
    // Indices that span the full gallery width (hero rows)
    const _heroIdx = new Set([0, 3]);
    const _badgeLabel = { sale: 'SALE', new: 'NEW', best: 'BEST SELLER' };
  %>
  <div class="detail-gallery" id="pdp-gallery">

    <!-- Main image viewer -->
    <div class="gallery-main" id="gallery-main"
         role="button" tabindex="0" aria-label="View full-size image"
         onclick="pdpLightbox.open(pdpGallery.getActive())"
         onkeydown="if(event.key==='Enter')pdpLightbox.open(pdpGallery.getActive())">
      <img class="gallery-main-img" id="gallery-main-img"
           src="<%= (_imgs[0]||{}).url||'' %>"
           alt="<%= (_imgs[0]||{}).alt_text || product.name %>"
           loading="eager" draggable="false">
      <% if (product.badge && _badgeLabel[product.badge]) { %>
      <span class="gallery-badge"><%= _badgeLabel[product.badge] %></span>
      <% } %>
      <span class="gallery-main-zoom" aria-hidden="true">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
      </span>
    </div>

    <!-- Thumbnail grid: 3 per row, 2 rows shown, expand for more -->
    <% if (_total > 1) { %>
    <div class="gallery-thumbs-wrap">
      <div class="gallery-thumbs" id="gallery-thumbs">
        <% _imgs.forEach(function(img, idx) { %>
        <button class="gallery-thumb<%= idx===0?' is-active':'' %><%= idx>=6?' thumb-hidden':'' %>"
                type="button" data-idx="<%= idx %>"
                aria-label="Image <%= idx+1 %><%= _total > 1 ? ' of ' + _total : '' %>"
                onclick="pdpGallery.select(<%= idx %>)">
          <img src="<%= img.url %>" alt="" loading="lazy" draggable="false">
        </button>
        <% }) %>
      </div>
      <% if (_total > 6) { %>
      <button class="gallery-seemore-btn" id="gallery-seemore-btn" type="button"
              onclick="pdpGallery.showMore(this)">
        See <%= _total - 6 %> more &#8595;
      </button>
      <% } %>
    </div>
    <% } %>

    <!-- ── Lightbox ──────────────────────────────────────────────── -->
    <div class="gallery-lightbox" id="pdp-lightbox"
         role="dialog" aria-modal="true" aria-label="Product image gallery" hidden>
      <button class="lb-close" onclick="pdpLightbox.close()" aria-label="Close gallery" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
      <button class="lb-arrow lb-prev" onclick="pdpLightbox.prev()" aria-label="Previous image" type="button">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="lb-stage">
        <img class="lb-img" id="lb-img" src="" alt="" draggable="false">
      </div>
      <button class="lb-arrow lb-next" onclick="pdpLightbox.next()" aria-label="Next image" type="button">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
      <div class="lb-footer">
        <p class="lb-counter" id="lb-counter" aria-live="polite"></p>
        <div class="lb-thumbs" id="lb-thumbs">
          <% _imgs.forEach((img, idx) => { %>
          <button class="lb-thumb" data-idx="<%= idx %>"
                  onclick="pdpLightbox.goTo(<%= idx %>)" type="button"
                  aria-label="Image <%= idx + 1 %>">
            <img src="<%= img.url %>" alt="" loading="lazy">
          </button>
          <% }); %>
        </div>
      </div>
    </div>

  <script>
  var pdpGallery = (function(){
    var _allImgs = <%- JSON.stringify(_imgs.map(function(i){return{url:i.url||'',alt:i.alt_text||''};})) %>;
    var _active = 0;
    function select(idx) {
      _active = idx;
      var el = document.getElementById('gallery-main-img');
      if (el) { el.src = _allImgs[idx].url; el.alt = _allImgs[idx].alt; }
      document.querySelectorAll('.gallery-thumb').forEach(function(t, i) {
        t.classList.toggle('is-active', i === idx);
      });
    }
    function showMore(btn) {
      document.querySelectorAll('#gallery-thumbs .thumb-hidden').forEach(function(t) {
        t.classList.remove('thumb-hidden');
        t.style.display = '';
      });
      if (btn) btn.style.display = 'none';
    }
    function getActive() { return _active; }
    return { select: select, showMore: showMore, getActive: getActive };
  })();
  </script>

  </div><!-- /detail-gallery -->

  <!-- ── Product info ──────────────────────────────────────────────── -->
  <div class="detail-info">

    <!-- Badges -->
    <div class="detail-badges">
      <% if (product.badge === 'sale')  { %><span class="product-badge badge-sale">SALE</span><% } %>
      <% if (product.badge === 'new')   { %><span class="product-badge badge-new">NEW</span><% } %>
      <% if (product.badge === 'best')  { %><span class="product-badge badge-best">BEST SELLER</span><% } %>
      <% if (!product.inStock)          { %><span class="product-badge" style="background:#7A7264">OUT OF STOCK</span><% } %>
    </div>

    <% if (product.brand) { %><p class="product-brand" style="margin-bottom:6px"><%= product.brand %></p><% } %>
    <h1 class="detail-title"><%= product.name %></h1>
    <p class="detail-sku">SKU: <%= product.sku %></p>

    <!-- Price -->
    <div class="detail-price-row">
      <span class="detail-price">$<%= product.price.toLocaleString('en-US', {minimumFractionDigits:2}) %></span>
      <% if (product.compare_price && product.compare_price > product.price) { %>
      <span class="detail-was">$<%= product.compare_price.toLocaleString('en-US', {minimumFractionDigits:2}) %></span>
      <span class="detail-save">Save <%= product.savingsPct %>%</span>
      <% } %>
    </div>
    <p class="detail-shipping">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="1" y="3" width="15" height="13" rx="1"/>
        <path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
      </svg>
      Free shipping — arrives in 5–10 business days
    </p>

    <hr class="detail-rule">

    <!-- Short description -->
    <% if (product.short_desc) { %>
    <p class="detail-short-desc"><%= product.short_desc %></p>
    <hr class="detail-rule">
    <% } %>

    <!-- Qty stepper -->
    <div class="detail-qty" role="group" aria-label="Quantity">
      <button class="qty-btn" type="button" aria-label="Decrease quantity" onclick="changeQty(-1)">−</button>
      <span class="qty-val" id="qty-val">1</span>
      <button class="qty-btn" type="button" aria-label="Increase quantity" onclick="changeQty(1)">+</button>
    </div>

    <!-- CTAs -->
    <div class="detail-ctas">
      <form action="/cart/add" method="POST">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <input type="hidden" name="slug"        value="<%= product.slug %>">
        <input type="hidden" name="name"        value="<%= product.name %>">
        <input type="hidden" name="price"       value="<%= product.price %>">
        <input type="hidden" name="image"       value="<%= (product.images[0]||{}).url||'' %>">
        <input type="hidden" name="qty"         id="atc-qty" value="1">
        <button type="submit" class="btn btn-amber" <%= !product.inStock ? 'disabled' : '' %> style="width:100%">
          <%= product.inStock ? 'Add to Cart' : 'Out of Stock' %>
        </button>
      </form>
      <button type="button"
              class="btn btn-outline heart-btn heart-btn--pdp<%= isFavorited ? ' is-saved' : '' %>"
              data-product-id="<%= product.id %>"
              data-product-slug="<%= product.slug %>"
              style="width:100%;text-align:center"
              aria-label="<%= isFavorited ? 'Remove from saved items' : 'Save to favorites' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" style="vertical-align:middle;margin-right:6px" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="heart-btn-label"><%= isFavorited ? 'Saved' : 'Save to Wishlist' %></span>
      </button>
    </div>

    <!-- ── At a Glance + Dims + Specs ─────────────────────────────── -->
    <%
      var _inchKeys = new Set(['size_in','width_in','depth_in','height_in',
                               'sink_depth_in','sink_width_in','sink_basin_depth_in',
                               'countertop_thickness','faucet_spread_in']);
      var _hiddenKeys = new Set(['substitute_sku']);
      var _lblOver = {
        'wireless_charging_fc_certified': 'Wireless Charging FC Certified',
        'wireless_charging_ul':           'Wireless Charging UL Certification',
        'tip_out_drawers':                'Tip-Out Drawers',
        'drawer_count':                   'Number of Drawers',
        'num_doors':                      'Number of Doors',
        'num_shelves':                    'Number of Shelves',
        'sink_width_in':                  'Sink Width',
        'sink_depth_in':                  'Sink Depth',
        'sink_basin_depth_in':            'Sink Basin Depth',
        'faucet_spread_in':               'Faucet Spread',
        'ada_compliant':                  'ADA Compliant',
        'has_electrical':                 'Electrical Component',
        'has_makeup_counter':             'Includes Makeup Counter',
        'primary_material':               'Primary Material',
        'vanity_type':                    'Vanity Type',
      };
      var _fmtN = function(v){ return v ? String(parseFloat(v)) : ''; };
      var _specRows = []; var _seenK = new Set();
      product.attributes.forEach(function(a) {
        if (_hiddenKeys.has(a.attr_key) || _seenK.has(a.attr_key)) return;
        _seenK.add(a.attr_key);
        var lbl = _lblOver[a.attr_key]
          || (a.display_name && a.display_name !== a.attr_key ? a.display_name : null)
          || a.attr_key.replace(/_in$/, '').replace(/_/g,' ')
                       .replace(/\b\w/g, function(c){ return c.toUpperCase(); });
        var inch = _inchKeys.has(a.attr_key);
        var val  = '';
        if (a.value_text)             val = inch ? a.value_text + '"' : a.value_text;
        else if (a.value_num != null) val = inch ? _fmtN(a.value_num) + '"' : String(a.value_num);
        if (val) _specRows.push({ label:lbl, val:val, key:a.attr_key });
      });
      if (product.width_in   && !_seenK.has('width_in'))   _specRows.push({ label:'Width',  val:_fmtN(product.width_in)+'"',  key:'width_in'   });
      if (product.depth_in   && !_seenK.has('depth_in'))   _specRows.push({ label:'Depth',  val:_fmtN(product.depth_in)+'"',  key:'depth_in'   });
      if (product.height_in  && !_seenK.has('height_in'))  _specRows.push({ label:'Height', val:_fmtN(product.height_in)+'"', key:'height_in'  });
      if (product.weight_lbs && !_seenK.has('weight_lbs')) _specRows.push({ label:'Weight', val:product.weight_lbs+' lbs',    key:'weight_lbs' });
      var _gkMap = {
        'countertop_material_type': { icon:'countertop', gl:'Countertop'      },
        'sink_type':                { icon:'sink',       gl:'Sink Type'        },
        'primary_material':         { icon:'material',   gl:'Primary Material' },
        'finish':                   { icon:'finish',     gl:'Finish'           },
        'vanity_type':              { icon:'type',       gl:'Style'            },
        'hardware_finish':          { icon:'finish',     gl:'Hardware Finish'  },
        'number_of_sinks':          { icon:'sink',       gl:'Number of Sinks'  },
        'warranty':                 { icon:'warranty',   gl:'Warranty'         },
        'certifications':           { icon:'cert',       gl:'Certifications'   },
        'sink_material':            { icon:'sink',       gl:'Sink Material'    },
        'material':                 { icon:'material',   gl:'Material'         },
      };
      var _glanceItems = []; var _usedGK = new Set();
      _specRows.forEach(function(r) {
        if (_gkMap[r.key] && !_usedGK.has(r.key) && _glanceItems.length < 4) {
          _usedGK.add(r.key);
          _glanceItems.push({ icon:_gkMap[r.key].icon, label:_gkMap[r.key].gl, val:r.val });
        }
      });
      var _hasDims = !!(product.width_in || product.height_in || product.depth_in);
    %>

    <% if (_glanceItems.length > 0) { %>
    <div class="pdp-glance">
      <p class="pdp-glance-title">At a Glance</p>
      <div class="pdp-glance-highlights">
        <% _glanceItems.forEach(function(gi) { %>
        <div class="pdp-glance-item">
          <div class="pdp-glance-icon">
            <% if (gi.icon==='material') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            <% } else if (gi.icon==='countertop') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1" y="9" width="22" height="4" rx="1"/><path d="M4 13v5M20 13v5M6 13v5M18 13v5"/><rect x="3" y="4" width="18" height="5" rx="1"/></svg>
            <% } else if (gi.icon==='sink') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h18v9a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V7z"/><path d="M12 3v4"/><circle cx="12" cy="13" r="3"/></svg>
            <% } else if (gi.icon==='finish') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M8.5 12a3.5 3.5 0 0 1 7 0"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/></svg>
            <% } else if (gi.icon==='type') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="11" width="20" height="10" rx="1.5"/><path d="M7 11V8a5 5 0 0 1 10 0v3"/></svg>
            <% } else if (gi.icon==='warranty') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10" stroke-width="2"/></svg>
            <% } else if (gi.icon==='cert') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="5"/><path d="M8 14l-2 7 6-3 6 3-2-7"/></svg>
            <% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
            <% } %>
          </div>
          <div class="pdp-glance-item-text">
            <span class="pdp-glance-label"><%= gi.label %></span>
            <span class="pdp-glance-val"><%= gi.val %></span>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (_hasDims) { %>
    <div class="pdp-dims">
      <p class="pdp-dims-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 6H3M21 12H3M21 18H3" stroke-width="1.3"/><line x1="3" y1="3" x2="3" y2="21" stroke-width="2"/></svg>
        Product Dimensions
      </p>
      <div class="pdp-dims-grid">
        <% if (product.width_in) { %>
        <div class="pdp-dim-item">
          <div class="pdp-dim-value"><%= _fmtN(product.width_in) %><span class="pdp-dim-unit">&Prime;</span></div>
          <div class="pdp-dim-label">Width</div>
        </div>
        <% } %>
        <% if (product.height_in) { %>
        <div class="pdp-dim-item">
          <div class="pdp-dim-value"><%= _fmtN(product.height_in) %><span class="pdp-dim-unit">&Prime;</span></div>
          <div class="pdp-dim-label">Height</div>
        </div>
        <% } %>
        <% if (product.depth_in) { %>
        <div class="pdp-dim-item">
          <div class="pdp-dim-value"><%= _fmtN(product.depth_in) %><span class="pdp-dim-unit">&Prime;</span></div>
          <div class="pdp-dim-label">Depth</div>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (_specRows.length > 0) { %>
    <div class="specs-card" id="pdpSpecsCard">
      <div class="specs-card-head">
        <p class="specs-card-title">Specifications &amp; Measurements</p>
      </div>
      <table class="specs-table" aria-label="Product specifications">
        <tbody>
          <% _specRows.forEach(function(r, idx) { %>
          <tr<%= idx >= 8 ? ' class="specs-row-hidden"' : '' %>>
            <td><%= r.label %></td>
            <td><%= r.val %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (_specRows.length > 8) { %>
      <div class="specs-seemore-wrap">
        <button class="specs-seemore-btn" id="pdpSpecsToggle" aria-expanded="false">
          <svg class="specs-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          See all <%= _specRows.length %> specifications
        </button>
      </div>
      <% } %>
    </div>
    <script>
    (function(){
      var btn = document.getElementById('pdpSpecsToggle');
      if (!btn) return;
      btn.addEventListener('click', function() {
        var open = btn.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
        document.querySelectorAll('#pdpSpecsCard tr.specs-row-hidden').forEach(function(r){
          r.style.display = open ? '' : 'none';
        });
        btn.innerHTML = open
          ? '<svg class="specs-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg> Show fewer'
          : '<svg class="specs-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> See all <%= _specRows.length %> specifications';
      });
    })();
    </script>
    <% } %>

  </div><!-- /detail-info -->
</div><!-- /detail-layout -->

<!-- ── Trust badges (19G.6) ────────────────────────────────────────── -->
<div class="trust-bar" aria-label="Why shop with us">
  <div class="trust-item">
    <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
    </svg>
    <span>Warranty Included</span>
  </div>
  <div class="trust-item">
    <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
      <polyline points="22 4 12 14.01 9 11.01"/>
    </svg>
    <span>Satisfaction Guaranteed</span>
  </div>
  <div class="trust-item">
    <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <rect x="1" y="3" width="15" height="13" rx="1"/>
      <path d="M16 8h4l3 3v5h-7V8z"/>
      <circle cx="5.5" cy="18.5" r="2.5"/>
      <circle cx="18.5" cy="18.5" r="2.5"/>
    </svg>
    <span>Free Shipping</span>
  </div>
  <div class="trust-item">
    <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <polyline points="9 14 4 9 9 4"/>
      <path d="M20 20v-7a4 4 0 0 0-4-4H4"/>
    </svg>
    <span>Easy Returns</span>
  </div>
</div>

<!-- Long description -->
<% if (product.long_desc) { %>
<section class="section product-desc-section">
  <div class="product-desc-inner">
    <h2>Product Description</h2>
    <div class="product-desc-body"><%- product.long_desc %></div>
  </div>
</section>
<% } %>

<!-- Downloads & Resources -->
<% if (typeof productDocs !== 'undefined' && productDocs.length) { %>
<%
  var _dlLabels = {
    spec_sheet:'Spec Sheet', installation_guide:'Installation Guide',
    warranty:'Warranty', rebate_form:'Rebate Form',
    cad_drawing:'CAD Drawing', measurement_guide:'Measurement Guide',
    care_guide:'Care Guide', other:'Document'
  };
  var _dlIcons = {
    spec_sheet:'📄', installation_guide:'🔧', warranty:'🛡',
    rebate_form:'💰', cad_drawing:'📐', measurement_guide:'📏',
    care_guide:'✨', other:'📎'
  };
%>
<section class="section product-docs-section">
  <div class="product-docs-inner">
    <h2>Downloads &amp; Resources</h2>
    <div class="product-docs-grid">
      <% productDocs.forEach(function(doc) { %>
      <a href="<%= doc.url %>" target="_blank" rel="noopener" class="product-doc-card">
        <span class="product-doc-icon"><%= _dlIcons[doc.doc_type] || '📎' %></span>
        <span class="product-doc-name"><%= doc.label || _dlLabels[doc.doc_type] || doc.doc_type %></span>
        <span class="product-doc-dl">Download ↓</span>
      </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ── Watch This Product ──────────────────────────────────────────── -->
<%
  var _allVideos = [];
  if (product.video_url) _allVideos.push({ url: product.video_url, title: product.name + ' — Product Video' });
  if (typeof productVideos !== 'undefined') {
    productVideos.forEach(function(v){ _allVideos.push(v); });
  }
  function _isYTUrl(u){ return !!(u && /youtu\.be|youtube\.com/.test(String(u))); }
  function _ytIdFromUrl(u){
    if (!u) return null;
    var m = String(u).match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?.*?v=|shorts\/))([a-zA-Z0-9_-]{11})/);
    return m ? m[1] : null;
  }
%>
<% if (_allVideos.length) { %>
<section class="section pdp-videos-section" aria-labelledby="pdp-videos-heading">
  <div class="pdp-videos-inner">
    <h2 id="pdp-videos-heading">Watch This Product</h2>
    <div class="pdp-videos-grid">
      <% _allVideos.forEach(function(vid, vi) { %>
      <%
        var _vIsYT  = _isYTUrl(vid.url);
        var _vYTId  = _vIsYT ? _ytIdFromUrl(vid.url) : null;
        var _vTitle = vid.title || (product.name + (vi > 0 ? ' — Video ' + (vi + 1) : ' — Product Video'));
      %>
      <div class="pdp-video-item">
        <div class="pdp-video-embed">
          <% if (_vIsYT && _vYTId) { %>
          <iframe
            src="https://www.youtube-nocookie.com/embed/<%= _vYTId %>?rel=0&modestbranding=1"
            title="<%= _vTitle %>"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen loading="lazy">
          </iframe>
          <% } else { %>
          <video controls preload="metadata" title="<%= _vTitle %>">
            <source src="<%= vid.url %>" type="video/mp4">
            Your browser does not support video playback.
          </video>
          <% } %>
        </div>
        <% if (vid.title) { %><p class="pdp-video-title"><%= vid.title %></p><% } %>
      </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- Related products -->
<% if (related.length > 0) { %>
<section class="related-section" aria-labelledby="related-heading">
  <div class="section-header">
    <p class="section-eyebrow">You May Also Like</p>
    <h2 class="section-title" id="related-heading">Related Products</h2>
  </div>
  <div class="product-grid">
    <% related.forEach(p => { %>
    <article class="product-card">
      <a href="/products/<%= p.slug %>" class="product-img-link">
        <div class="product-img">
          <% if (p.primary_image) { %>
            <img src="<%= p.primary_image %>" alt="<%= p.name %>" loading="lazy">
          <% } else { %>
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
          <% } %>
          <% if (p.badge) { %><span class="product-badge badge-<%= p.badge %>"><%= p.badge.toUpperCase() %></span><% } %>
        </div>
      </a>
      <div class="product-body">
        <% if (p.brand) { %><p class="product-brand"><%= p.brand %></p><% } %>
        <h3 class="product-title"><a href="/products/<%= p.slug %>"><%= p.name %></a></h3>
        <div class="product-price-row">
          <span class="product-price">$<%= p.price.toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
          <% if (p.compare_price && p.compare_price > p.price) { %>
          <span class="product-was">$<%= p.compare_price.toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
          <% } %>
        </div>
        <a href="/products/<%= p.slug %>" class="btn btn-sage">View Details</a>
      </div>
    </article>
    <% }) %>
  </div>
</section>
<% } %>

<%
/*
 * Product JSON-LD — schema.org/Product
 * Helps Google display rich results (price, availability, ratings).
 * Images: prefer product.images array; fall back to primary_image field.
 */
const _pdUrl   = typeof siteUrl !== 'undefined' ? siteUrl : 'https://bathroomvanitiesoutlet.com';
const _pdImages = (product.images && product.images.length)
  ? product.images.map(i => i.url)
  : (product.primary_image ? [product.primary_image] : []);
const _pdAvail  = product.inStock
  ? 'https://schema.org/InStock'
  : 'https://schema.org/OutOfStock';
const _pdJsonLd = {
  '@context': 'https://schema.org/',
  '@type':    'Product',
  name:        product.name,
  description: product.short_desc || '',
  sku:         product.sku || product.slug,
  image:       _pdImages,
  brand: product.brand ? { '@type': 'Brand', name: product.brand } : undefined,
  offers: {
    '@type':          'Offer',
    url:              `${_pdUrl}/products/${product.slug}`,
    priceCurrency:    'USD',
    price:            product.price.toFixed(2),
    availability:     _pdAvail,
    itemCondition:    'https://schema.org/NewCondition',
    seller: {
      '@type': 'Organization',
      name:    'BathroomVanitiesOutlet.com',
    },
  },
};
if (product.compare_price && product.compare_price > product.price) {
  _pdJsonLd.offers.priceValidUntil = new Date(Date.now() + 30*24*60*60*1000).toISOString().split('T')[0];
}
%>
<script type="application/ld+json"><%- JSON.stringify(_pdJsonLd) %></script>
<%
  var _pdVideos = [];
  if (product.video_url) _pdVideos.push({ url: product.video_url, title: product.name + ' — Product Video' });
  if (typeof productVideos !== 'undefined') productVideos.forEach(function(v){ _pdVideos.push(v); });
  var _pdPrimaryImg = (product.images && product.images[0] && product.images[0].url) || product.primary_image_url || '';
%>
<% if (_pdVideos.length) { %>
<% _pdVideos.forEach(function(vid) {
  var _vldIsYT = !!(vid.url && /youtu\.be|youtube\.com/.test(vid.url));
  var _vldYTId = null;
  if (_vldIsYT) { var _mm = vid.url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?.*?v=|shorts\/))([a-zA-Z0-9_-]{11})/); _vldYTId = _mm ? _mm[1] : null; }
  var _vldObj = {
    '@context':     'https://schema.org',
    '@type':        'VideoObject',
    name:           vid.title || (product.name + ' — Product Video'),
    description:    product.short_desc || product.name,
    thumbnailUrl:   _pdPrimaryImg,
    uploadDate:     (product.updated_at || product.created_at || new Date()).toISOString ? new Date(product.updated_at || product.created_at || Date.now()).toISOString().split('T')[0] : new Date().toISOString().split('T')[0],
  };
  if (_vldIsYT && _vldYTId) { _vldObj.embedUrl = 'https://www.youtube-nocookie.com/embed/' + _vldYTId; }
  else { _vldObj.contentUrl = vid.url; }
%>
<script type="application/ld+json"><%- JSON.stringify(_vldObj) %></script>
<% }); } %>
