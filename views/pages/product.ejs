    <!-- ── At a Glance + Dims + Specs ─────────────────────────────── -->
    <%
      var _inchKeys = new Set(['size_in','width_in','depth_in','height_in',
                               'sink_depth_in','sink_width_in','sink_basin_depth_in',
                               'faucet_spread_in']);
      // countertop_thickness is stored in CM (not inches) — display as e.g. "3 CM"
      var _cmKeys   = new Set(['countertop_thickness']);
      var _hiddenKeys = new Set(['substitute_sku']);
      var _lblOver = {
        'wireless_charging_fc_certified': 'Wireless Charging FC Certified',
        'wireless_charging_ul':           'Wireless Charging UL Certification',
        'tip_out_drawers':                'Tip-Out Drawers',
        'drawer_count':                   'Number of Drawers',
        'num_doors':                      'Number of Doors',
        'num_shelves':                    'Number of Shelves',
        'sink_width_in':                  'Sink Width',
        'sink_depth_in':                  'Sink Depth',
        'sink_basin_depth_in':            'Sink Basin Depth',
        'faucet_spread_in':               'Faucet Spread',
        'ada_compliant':                  'ADA Compliant',
        'has_electrical':                 'Electrical Component',
        'has_makeup_counter':             'Includes Makeup Counter',
        'primary_material':               'Primary Material',
        'vanity_type':                    'Vanity Type',
      };
      var _fmtN = function(v){ return v ? String(parseFloat(v)) : ''; };
      var _specRows = []; var _seenK = new Set();
      product.attributes.forEach(function(a) {
        if (_hiddenKeys.has(a.attr_key) || _seenK.has(a.attr_key)) return;
        _seenK.add(a.attr_key);
        var lbl = _lblOver[a.attr_key]
          || (a.display_name && a.display_name !== a.attr_key ? a.display_name : null)
          || a.attr_key.replace(/_in$/, '').replace(/_/g,' ')
                       .replace(/\b\w/g, function(c){ return c.toUpperCase(); });
        var inch = _inchKeys.has(a.attr_key);
        var cm   = _cmKeys.has(a.attr_key);
        var val  = '';
        if (a.value_text)             val = inch ? a.value_text + '"' : (cm ? a.value_text + ' CM' : a.value_text);
        else if (a.value_num != null) val = inch ? _fmtN(a.value_num) + '"' : (cm ? String(a.value_num) + ' CM' : String(a.value_num));
        if (val) _specRows.push({ label:lbl, val:val, key:a.attr_key });
      });
      if (product.width_in   && !_seenK.has('width_in'))   _specRows.push({ label:'Width',  val:_fmtN(product.width_in)+'"',  key:'width_in'   });
      if (product.depth_in   && !_seenK.has('depth_in'))   _specRows.push({ label:'Depth',  val:_fmtN(product.depth_in)+'"',  key:'depth_in'   });
      if (product.height_in  && !_seenK.has('height_in'))  _specRows.push({ label:'Height', val:_fmtN(product.height_in)+'"', key:'height_in'  });
      if (product.weight_lbs && !_seenK.has('weight_lbs')) _specRows.push({ label:'Weight', val:product.weight_lbs+' lbs',    key:'weight_lbs' });
      var _gkMap = {
        'countertop_material_type': { icon:'countertop', gl:'Countertop'      },
        'sink_type':                { icon:'sink',       gl:'Sink Type'        },
        'primary_material':         { icon:'material',   gl:'Primary Material' },
        'finish':                   { icon:'finish',     gl:'Finish'           },
        'vanity_type':              { icon:'type',       gl:'Style'            },
        'hardware_finish':          { icon:'finish',     gl:'Hardware Finish'  },
        'number_of_sinks':          { icon:'sink',       gl:'Number of Sinks'  },
        'warranty':                 { icon:'warranty',   gl:'Warranty'         },
        'certifications':           { icon:'cert',       gl:'Certifications'   },
        'sink_material':            { icon:'sink',       gl:'Sink Material'    },
        'material':                 { icon:'material',   gl:'Material'         },
      };
      var _glanceItems = []; var _usedGK = new Set();
      _specRows.forEach(function(r) {
        if (_gkMap[r.key] && !_usedGK.has(r.key) && _glanceItems.length < 4) {
          _usedGK.add(r.key);
          _glanceItems.push({ icon:_gkMap[r.key].icon, label:_gkMap[r.key].gl, val:r.val });
        }
      });
      var _hasDims = !!(product.width_in || product.height_in || product.depth_in);
    %>

    <% if (_glanceItems.length > 0) { %>
    <div class="pdp-glance">
      <p class="pdp-glance-title">At a Glance</p>
      <div class="pdp-glance-highlights">
        <% _glanceItems.forEach(function(gi) { %>
        <div class="pdp-glance-item">
          <div class="pdp-glance-icon">
            <% if (gi.icon==='material') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            <% } else if (gi.icon==='countertop') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1" y="9" width="22" height="4" rx="1"/><path d="M4 13v5M20 13v5M6 13v5M18 13v5"/><rect x="3" y="4" width="18" height="5" rx="1"/></svg>
            <% } else if (gi.icon==='sink') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h18v9a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V7z"/><path d="M12 3v4"/><circle cx="12" cy="13" r="3"/></svg>
            <% } else if (gi.icon==='finish') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M8.5 12a3.5 3.5 0 0 1 7 0"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/></svg>
            <% } else if (gi.icon==='type') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="11" width="20" height="10" rx="1.5"/><path d="M7 11V8a5 5 0 0 1 10 0v3"/></svg>
            <% } else if (gi.icon==='warranty') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10" stroke-width="2"/></svg>
            <% } else if (gi.icon==='cert') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="5"/><path d="M8 14l-2 7 6-3 6 3-2-7"/></svg>
            <% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
