    </div>

    <%# ── THE STORE'S GOOGLE RATING ──────────────────────────────────────
         ⚠️ THIS DESCRIBES THE SHOP, NOT THIS VANITY, AND IT USED TO SIT
         DIRECTLY UNDER THE ADD TO CART BUTTON — where a shopper reads it as
         the product's rating. Two different ratings now appear on this page:
         the product's own figure above the price, and this one. Putting the
         store rating in the buy box made the page quietly claim that every
         product is rated 4.9.

         It is kept, because it is real and it is ours, but moved below the
         payment logos and relabelled so the subject is unambiguous. %>
    <% if (_grRating > 0) { %>
    <div class="pdp-google-rating pdp-google-rating--store">
      <span class="pgr-stars" aria-hidden="true">★★★★★</span>
      <span class="pgr-score"><%= _grRating.toFixed(1) %></span>
      <a href="https://www.google.com/search?q=Bathroom+Vanities+Outlet+reviews"
         target="_blank" rel="noopener noreferrer" class="pgr-link"
         aria-label="BathroomVanitiesOutlet.com is rated <%= _grRating.toFixed(1) %> from <%= _grCount %> Google reviews">
        BathroomVanitiesOutlet.com<% if (_grCount > 0) { %> &middot; <%= _grCount %> Google reviews<% } %>
      </a>
    </div>
    <% } %>


    <!-- ── Social Share Bar ──────────────────────────────────────────── -->
    <%# ONE definition, in views/partials/social-share.ejs. This bar used to be
        written inline here AND again in inspiration-guide.ejs, and each button
        was gated on settings.social.<network>_url — so sharing to LinkedIn was
        off site-wide purely because that profile field was blank, and an
        Instagram FOLLOW link sat inside a bar headed "Share this product".
        Both fixed in the partial; do not reinstate either here. %>
    <%- include('../partials/social-share', {
          shareLabel: 'Share this product',
          shareTitle: product.name + ' - BathroomVanitiesOutlet.com',
          shareImage: (_imgs[0] || {}).url || ''
        }) %>

    <!-- ── Variant Selector: Size, Finish, Stone Top ───────────────── -->
    <% if (typeof variantConfig !== 'undefined' && variantConfig) { %>
    <% var _vc = variantConfig; %>

    <%/* Card 1 — View Other Options (size chips + finish swatches) */%>
    <% if (_vc.sizeChips.length > 1 || _vc.colorSwatches.length > 1) { %>
    <div class="pdp-vc-card">
      <h4 class="pdp-vc-heading">View Other Options</h4>

      <% if (_vc.sizeChips.length > 1) { %>
      <div class="pdp-vc-row">
        <span class="pdp-vc-label">SIZE</span>
        <div class="pdp-vc-options">
          <% _vc.sizeChips.forEach(function(chip) { %>
          <a href="/products/<%= chip.slug %>"
             class="pdp-size-chip<%= chip.isSelected ? ' is-selected' : '' %>"
             aria-current="<%= chip.isSelected ? 'page' : 'false' %>"
          ><%= Math.round(chip.width_in) %>&quot;</a>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (_vc.colorSwatches.length > 1) { %>
      <div class="pdp-vc-row">
        <span class="pdp-vc-label">FINISH</span>
        <div class="pdp-vc-options">
          <%
            _vc.colorSwatches.forEach(function(sw) {
              var _cf   = _vc.colorFamilyMap[sw.color_family];
              var _hex  = _cf ? _cf.hex    : '#ccc';
              var _brd  = _cf ? _cf.border : '#aaa';
