        <% if (product.depth_in) { %>
        <div class="pdp-dim-item">
          <div class="pdp-dim-value"><%= _fmtN(product.depth_in) %><span class="pdp-dim-unit">&Prime;</span></div>
          <div class="pdp-dim-label">Depth</div>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (_specRows.length > 0) { %>
    <div class="specs-card" id="pdpSpecsCard">
      <div class="specs-card-head">
        <p class="specs-card-title">Specifications &amp; Measurements</p>
      </div>
      <table class="specs-table" aria-label="Product specifications">
        <tbody>
          <% _specRows.slice(0, 8).forEach(function(r) { %>
          <tr>
            <td><%= r.label %></td>
            <td><%= r.val %></td>
          </tr>
          <% }) %>
        </tbody>
        <% if (_specRows.length > 8) { %>
        <tbody id="pdpSpecsExtra" style="display:none">
          <% _specRows.slice(8).forEach(function(r) { %>
          <tr>
            <td><%= r.label %></td>
            <td><%= r.val %></td>
          </tr>
          <% }) %>
        </tbody>
        <% } %>
      </table>
      <% if (_specRows.length > 8) { %>
      <div class="specs-seemore-wrap">
        <button class="specs-seemore-btn" id="pdpSpecsToggle" aria-expanded="false">
          <svg class="specs-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          See all <%= _specRows.length %> specifications
        </button>
      </div>
      <% } %>
    </div>
    <script nonce="<%= cspNonce %>">
    (function(){
      var btn   = document.getElementById('pdpSpecsToggle');
      var extra = document.getElementById('pdpSpecsExtra');
      if (!btn || !extra) return;
      btn.addEventListener('click', function() {
        var open = btn.classList.toggle('is-open');
