        extra.style.display = open ? 'table-row-group' : 'none';
        btn.innerHTML = open
          ? '<svg class="specs-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg> Show less'
