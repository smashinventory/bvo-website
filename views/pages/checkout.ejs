<link rel="stylesheet" href="/css/site3.css?v=18"><!-- site3: injected per-page (perf) -->
<div class="checkout-page">
  <div class="checkout-header">
    <h1>Checkout</h1>
    <a href="/cart" class="checkout-back">← Back to cart</a>
  </div>

  <% if (typeof checkoutError !== 'undefined' && checkoutError) { %>
  <div class="checkout-error-banner" role="alert">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/>
      <line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    <%= checkoutError %>
  </div>
  <% } %>

  <div class="checkout-layout">

    <!-- ── Left: Contact + Billing + Card ────────────────────────── -->
    <div class="checkout-form-section">

      <form action="/checkout" method="POST" id="checkout-form" class="checkout-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Hidden nonce fields (populated by Accept.js) -->
        <input type="hidden" name="dataDescriptor" id="dataDescriptor">
        <input type="hidden" name="dataValue"      id="dataValue">

        <!-- Hidden conversion tracking fields -->
        <input type="hidden" name="order_source"   id="order_source">
        <input type="hidden" name="order_referrer" id="order_referrer">
        <input type="hidden" name="utm_campaign"   id="utm_campaign">
        <input type="hidden" name="utm_medium"     id="utm_medium">
        <input type="hidden" name="utm_source"     id="utm_source">

        <!-- Contact Information -->
        <div class="checkout-card">
          <h2 class="checkout-card-title">Contact Information</h2>
          <div class="checkout-field-row">
            <div class="checkout-field">
              <label for="co-first">First Name <span class="req">*</span></label>
              <input type="text" id="co-first" name="first_name" placeholder="First name"
                     autocomplete="given-name" required>
            </div>
            <div class="checkout-field">
              <label for="co-last">Last Name <span class="req">*</span></label>
              <input type="text" id="co-last" name="last_name" placeholder="Last name"
                     autocomplete="family-name" required>
            </div>
          </div>
          <div class="checkout-field">
            <label for="co-email">Email Address <span class="req">*</span></label>
            <input type="email" id="co-email" name="email" placeholder="you@example.com"
                   autocomplete="email" required>
            <span class="checkout-field-hint">Your order confirmation will be sent here.</span>
          </div>
          <div class="checkout-field">
            <label for="co-phone">Phone (optional)</label>
            <input type="tel" id="co-phone" name="phone" placeholder="(555) 000-0000"
                   autocomplete="tel">
          </div>
        </div>

        <!-- Billing Address (for AVS fraud protection) -->
        <div class="checkout-card">
          <h2 class="checkout-card-title">Billing Address</h2>
          <p class="checkout-card-sub">Used for card verification. Your order ships to the address you provide after checkout.</p>
          <div class="checkout-field">
            <label for="bill-address1">Street Address <span class="req">*</span></label>
            <input type="text" id="bill-address1" name="bill_address1" placeholder="123 Main St"
                   autocomplete="billing street-address" required>
          </div>
          <div class="checkout-field-row">
            <div class="checkout-field" style="flex:2">
              <label for="bill-city">City <span class="req">*</span></label>
              <input type="text" id="bill-city" name="bill_city" placeholder="City"
                     autocomplete="billing address-level2" required>
            </div>
            <div class="checkout-field" style="flex:1">
              <label for="bill-state">State <span class="req">*</span></label>
              <select id="bill-state" name="bill_state" autocomplete="billing address-level1" required
                      class="checkout-select">
                <option value="">— State —</option>
                <% [['AL','Alabama'],['AK','Alaska'],['AZ','Arizona'],['AR','Arkansas'],['CA','California'],
                    ['CO','Colorado'],['CT','Connecticut'],['DE','Delaware'],['FL','Florida'],['GA','Georgia'],
                    ['HI','Hawaii'],['ID','Idaho'],['IL','Illinois'],['IN','Indiana'],['IA','Iowa'],
                    ['KS','Kansas'],['KY','Kentucky'],['LA','Louisiana'],['ME','Maine'],['MD','Maryland'],
                    ['MA','Massachusetts'],['MI','Michigan'],['MN','Minnesota'],['MS','Mississippi'],['MO','Missouri'],
                    ['MT','Montana'],['NE','Nebraska'],['NV','Nevada'],['NH','New Hampshire'],['NJ','New Jersey'],
                    ['NM','New Mexico'],['NY','New York'],['NC','North Carolina'],['ND','North Dakota'],['OH','Ohio'],
                    ['OK','Oklahoma'],['OR','Oregon'],['PA','Pennsylvania'],['RI','Rhode Island'],['SC','South Carolina'],
                    ['SD','South Dakota'],['TN','Tennessee'],['TX','Texas'],['UT','Utah'],['VT','Vermont'],
                    ['VA','Virginia'],['WA','Washington'],['WV','West Virginia'],['WI','Wisconsin'],['WY','Wyoming']
                   ].forEach(([abbr, name]) => { %>
                  <option value="<%= abbr %>"><%= name %></option>
                <% }); %>
              </select>
            </div>
            <div class="checkout-field" style="flex:1">
              <label for="bill-zip">ZIP <span class="req">*</span></label>
              <input type="text" id="bill-zip" name="bill_zip" placeholder="00000"
                     autocomplete="billing postal-code" maxlength="10" required>
            </div>
          </div>
        </div>

        <!-- Card Details — entered in Authorize.net's hosted form (AcceptUI).
             There are deliberately NO card inputs on this page. The card is typed
             into an iframe served by Authorize.net, which scripts on this page
             cannot read. Keeps the site at PCI SAQ A. -->
        <div class="checkout-card">
          <h2 class="checkout-card-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" aria-hidden="true" style="vertical-align:middle;margin-right:6px">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            Payment
          </h2>
          <p class="checkout-card-sub">When you click <strong>Place Order</strong>, a secure Authorize.net window opens for your card details. Your card number is entered directly with Authorize.net and never touches our website.</p>
          <div id="payment-error" role="alert" style="display:none;color:var(--red);margin-top:8px;font-size:14px"></div>
        </div>

        <%/* The AcceptUI launcher. AcceptUI.js binds to every element with
             class="AcceptUI" when it loads, so this must exist in the DOM
             before the script tag at the bottom of the page. It is hidden:
             the visible Place Order button validates the form first and then
             clicks this one, so the popup never opens over a half-filled form.
             data-billingAddressOptions show:false because the server already
             sends the full billing address in createTransactionRequest, and
             Authorize.net uses that ZIP for AVS in preference to the nonce's,
             so asking for name and ZIP again in the popup would only duplicate
             fields. */%>
        <button type="button" id="acceptUIBtn" class="AcceptUI" hidden aria-hidden="true" tabindex="-1"
                data-billingAddressOptions='{"show":false,"required":false}'
                data-apiLoginID="<%= aNetApiLoginId %>"
                data-clientKey="<%= aNetPublicKey %>"
                data-acceptUIFormBtnTxt="Pay Securely"
                data-acceptUIFormHeaderTxt="Card Details"
                data-paymentOptions='{"showCreditCard":true,"showBankAccount":false}'
                data-responseHandler="responseHandler">Enter card</button>

      </form><!-- /checkout-form -->

      <!-- Order items -->
      <div class="checkout-card checkout-items-card">
        <h2 class="checkout-card-title">Your Order</h2>
        <% cart.items.forEach(function(item) { %>
        <div class="co-item">
          <% if (item.image) { %>
          <img src="<%= item.image %>?width=200" alt="<%= item.name %>" class="co-item-img" loading="lazy">
          <% } else { %>
          <div class="co-item-img co-item-img--placeholder"></div>
          <% } %>
          <div class="co-item-info">
            <p class="co-item-name"><%= item.name %></p>
            <p class="co-item-meta">Qty: <%= item.qty %></p>
          </div>
          <div class="co-item-price">
            $<%= (item.qty * (parseFloat(item.price)||0)).toLocaleString('en-US',{minimumFractionDigits:2}) %>
          </div>
        </div>
        <% }); %>
      </div>

    </div><!-- /checkout-form-section -->

    <!-- ── Right: Order summary ──────────────────────────────────── -->
    <aside class="checkout-summary">
      <div class="checkout-card">
        <h2 class="checkout-card-title">Order Summary</h2>

        <div class="co-sum-row">
          <span>Subtotal (<%= cart.count %> <%= cart.count === 1 ? 'item' : 'items' %>)</span>
          <span>$<%= (parseFloat(cart.subtotal)||0).toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
        </div>
        <div class="co-sum-row">
          <span>Shipping</span>
          <span class="free-label">FREE</span>
        </div>
        <div class="co-sum-row co-sum-total">
          <span>Total</span>
          <span>$<%= (parseFloat(cart.subtotal)||0).toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
        </div>

        <p class="co-sum-note">Taxes calculated at next step</p>

        <%
          /* Agreement line — must sit IMMEDIATELY above the Place Order button.
             This is what makes the policy pages binding rather than merely
             published: the arbitration clause, the liability cap and the 25%
             restocking fee all depend on the customer having been shown the
             terms at the moment of purchase. A footer link is weak evidence
             of that; a line adjacent to the button is the standard one.

             Passive by design — no checkbox. Decided 8 Sept 2026.

             The four hrefs are the slugs seeded by migration 012 and used by
             the footer menus in migration 015. They are NOT guesses: an
             earlier draft of the policy migration invented `terms`,
             `privacy` and `returns-refunds`, which would have 404'd here in
             exactly the place a 404 does the most damage. Verified by gate 1
             in git_push_checkout_agreement.sh.

             Reuses .co-sum-note (site3.css, already used by the taxes note
             directly above) — no new class, no CSS change, no ?v= bump. */
        %>
        <p class="co-sum-note">
          By placing your order you agree to our
          <a href="/pages/terms-and-conditions">Terms &amp; Conditions</a>,
          <a href="/pages/privacy-policy">Privacy Policy</a>,
          <a href="/pages/shipping-policy">Shipping Policy</a> and
          <a href="/pages/returns-policy">Returns &amp; Refunds</a>.
        </p>

        <button type="button" id="payBtn" class="btn btn-amber checkout-submit-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" aria-hidden="true" style="margin-right:6px;vertical-align:middle">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          Place Order
        </button>
        <p class="co-sum-redirect-note">Payment is encrypted and processed securely by Authorize.net.</p>

        <!-- Trust row -->
        <div class="cart-trust-row" style="margin-top:1rem">
          <div class="ctr-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>256-bit SSL</span>
          </div>
          <div class="ctr-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/>
            </svg>
            <span>30-Day Returns</span>
          </div>
          <div class="ctr-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h3l4 4v5h-7V8z"/>
              <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
            <span>Free Shipping</span>
          </div>
        </div>

        <!-- Payment logos -->
        <div class="cart-payment-logos" style="margin-top:1rem">
          <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="Visa">
            <rect width="60" height="38" rx="4" fill="#1A1F71"/>
            <text x="30" y="24" text-anchor="middle" fill="#fff" font-size="15" font-weight="700" font-style="italic" font-family="Arial,sans-serif" letter-spacing="1">VISA</text>
          </svg>
          <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="Mastercard">
            <rect width="60" height="38" rx="4" fill="#f0f0f0" stroke="#ddd" stroke-width=".5"/>
            <circle cx="23" cy="19" r="10" fill="#EB001B"/>
            <circle cx="37" cy="19" r="10" fill="#F79E1B"/>
            <path d="M30 11.2a10 10 0 0 1 0 15.6A10 10 0 0 1 30 11.2Z" fill="#FF5F00"/>
          </svg>
          <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="American Express">
            <rect width="60" height="38" rx="4" fill="#007BC1"/>
            <text x="30" y="16" text-anchor="middle" fill="#fff" font-size="7" font-weight="600" font-family="Arial,sans-serif" letter-spacing=".8">AMERICAN</text>
            <text x="30" y="27" text-anchor="middle" fill="#fff" font-size="9" font-weight="800" font-family="Arial,sans-serif" letter-spacing=".5">EXPRESS</text>
          </svg>
          <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="Discover">
            <rect width="60" height="38" rx="4" fill="#fff" stroke="#ddd" stroke-width=".5"/>
            <text x="30" y="24" text-anchor="middle" fill="#F76F20" font-size="11" font-weight="700" font-family="Arial,sans-serif">DISCOVER</text>
          </svg>
        </div>

      </div>
    </aside>

  </div><!-- /checkout-layout -->
</div>

<!-- AcceptUI.js (Authorize.net hosted card form). Loaded AFTER #acceptUIBtn
     exists, which the library requires. -->
<script src="<%= aNetScriptUrl %>" nonce="<%= cspNonce %>" charset="utf-8"></script>

<script nonce="<%= cspNonce %>">
/* ── Capture UTM params + referrer for conversion tracking ── */
(function () {
  var p   = new URLSearchParams(window.location.search);
  var set = function (id, val) { var el = document.getElementById(id); if (el && val) el.value = val; };
  set('utm_campaign',   p.get('utm_campaign'));
  set('utm_medium',     p.get('utm_medium'));
  set('utm_source',     p.get('utm_source'));
  set('order_referrer', document.referrer || '');
  var src = p.get('utm_source') ||
    (document.referrer ? (function(){ try { return new URL(document.referrer).hostname; } catch(e) { return document.referrer; } })() : 'direct');
  set('order_source', src);
})();

var payBtn      = document.getElementById('payBtn');
var payBtnLabel = payBtn.innerHTML;      /* keep the shield icon when resetting */

function resetPayBtn() {
  payBtn.disabled  = false;
  payBtn.innerHTML = payBtnLabel;
}

function showPayError(msg) {
  var el = document.getElementById('payment-error');
  el.textContent = msg;
  el.style.display = 'block';
  resetPayBtn();
  el.scrollIntoView({ block: 'center', behavior: 'smooth' });
}

/* Called by AcceptUI.js with the nonce. Must be a GLOBAL function: the
   button names it in data-responseHandler. Same opaqueData shape as the old
   Accept.dispatchData flow, so the server needs no change. */
function responseHandler(resp) {
  if (!resp || !resp.messages || resp.messages.resultCode === 'Error') {
    var msg = (resp && resp.messages && resp.messages.message || [])
      .map(function (m) { return m.text; }).join(' ') || 'Your card could not be processed. Please try again.';
    showPayError(msg);
    return;
  }
  document.getElementById('dataDescriptor').value = resp.opaqueData.dataDescriptor;
  document.getElementById('dataValue').value      = resp.opaqueData.dataValue;
  payBtn.disabled    = true;
  payBtn.textContent = 'Processing…';
  document.getElementById('checkout-form').submit();
}
window.responseHandler = responseHandler;

/* Place Order: validate contact + billing first, THEN open the card popup.
   The button is not disabled here - if the customer closes the popup
   without paying, AcceptUI does not call back, so the button must stay
   usable for another attempt. */
payBtn.addEventListener('click', function () {
  var form = document.getElementById('checkout-form');
  if (!form.checkValidity()) { form.reportValidity(); return; }
  document.getElementById('payment-error').style.display = 'none';
  document.getElementById('acceptUIBtn').click();
});
</script>
