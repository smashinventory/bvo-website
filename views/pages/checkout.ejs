<link rel="stylesheet" href="/css/site3.css?v=21"><!-- site3: injected per-page (perf) -->
<div class="checkout-page">
  <div class="checkout-header">
    <h1>Checkout</h1>
    <a href="/cart" class="checkout-back">← Back to cart</a>
  </div>

  <% if (typeof checkoutError !== 'undefined' && checkoutError) { %>
  <div class="checkout-error-banner" role="alert">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/>
      <line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    <%= checkoutError %>
  </div>
  <% } %>

  <div class="checkout-layout">

    <!-- ── Left: Stripe-collected details + payment ──────────────── -->
    <div class="checkout-form-section">

      <%/* THERE ARE NO CARD INPUTS ON THIS PAGE, AND THERE MUST NEVER BE.

           Every field below is rendered by Stripe inside an iframe served
           from js.stripe.com. Card data never enters a DOM node this site
           controls, which is what keeps BVO at PCI SAQ A. Hand-rolling card
           fields against Stripe.js tokenisation would work, and would move
           the site to SAQ A-EP — a materially longer compliance burden.
           This is the same reasoning that chose Authorize.net's AcceptUI
           before it. See docs/briefs/BVO_COMMERCE_STACK_BRIEF.md §4.

           Contact and billing are Stripe elements rather than our own
           fields because `automatic_tax` computes from the address Stripe
           holds. Collecting it ourselves and pushing it across means two
           copies of the address that can drift, and the failure mode is
           silently wrong sales tax. */%>

      <!-- Contact -->
      <div class="checkout-card">
        <h2 class="checkout-card-title">Contact Information</h2>
        <div id="contact-details-element"></div>
        <span class="checkout-field-hint">Your order confirmation will be sent here.</span>

        <%/* OUR OWN INPUT, deliberately.
             phone_number_collection on the session renders a phone field in
             Stripe's HOSTED checkout. In elements mode it does not - verified
             on the live page 2026-09-26: the Contact Details Element renders
             email and nothing else, whatever options it is handed (it accepts
             {phone:'always'} without complaint and ignores it).

             actions.updatePhoneNumber() does work, so the value is pushed into
             the session on change and arrives as customer_details.phone in the
             webhook like every other contact field. No card data is involved,
             so this does not affect PCI scope. */%>
        <div class="checkout-phone-row">
          <div class="checkout-field">
            <label for="ship-phone">Phone Number <span class="req">*</span></label>
            <input type="tel" id="ship-phone" name="ship_phone" autocomplete="tel"
                   inputmode="tel" placeholder="(404) 555-1234">
          </div>
          <%/* Optional, and shown to everyone rather than only on commercial
               delivery - people give a work number for a home delivery too.
               Its own field because an extension is a different fact from the
               number: ship_phone has to stay dialable E.164 for the carrier
               and for Stripe, and "+14045551234 x22" is neither. */%>
          <div class="checkout-field">
            <label for="ship-phone-ext">Ext.</label>
            <input type="text" id="ship-phone-ext" name="ship_phone_ext"
                   inputmode="numeric" maxlength="8" placeholder="Optional">
          </div>
        </div>
        <span class="checkout-field-hint">Required. The freight carrier calls this number to schedule your delivery.</span>
        <span id="phone-error" role="alert" style="display:none;color:var(--red,#c00);font-size:.78rem"></span>
      </div>

      <!-- Billing -->
      <div class="checkout-card">
        <h2 class="checkout-card-title">Billing Address</h2>
        <p class="checkout-card-sub">The address on your card. Used for card verification and to calculate sales tax.</p>
        <div id="billing-address-element"></div>

        <%/* Default is ship-to-billing, which is the overwhelming majority.
             Phrased as the EXCEPTION ("a different address") so the common
             case is a no-op and only the minority types anything. */%>
        <label class="checkout-check" for="ship-different">
          <input type="checkbox" id="ship-different">
          <span>Ship to a different address</span>
        </label>

        <div id="shipping-address-wrap" hidden>
          <h3 class="checkout-card-title" style="font-size:16px;margin-top:18px">Shipping Address</h3>
          <div id="shipping-address-element"></div>
        </div>

        <%/* Freight carriers price residential and commercial delivery
             differently and guess when nobody declares it. Guessing wrong
             produces a surcharge after the fact that cannot be passed on. */%>
        <fieldset class="checkout-radio-group">
          <legend>Delivery location</legend>
          <label class="checkout-check" for="dt-res">
            <input type="radio" name="delivery_type" id="dt-res" value="residential" checked>
            <span>Residential &mdash; a house or apartment</span>
          </label>
          <label class="checkout-check" for="dt-com">
            <input type="radio" name="delivery_type" id="dt-com" value="commercial">
            <span>Commercial &mdash; a business with a loading dock or forklift</span>
          </label>
          <span class="checkout-field-hint">Your vanity ships by freight. This tells the carrier what kind of truck and crew to send.</span>
        </fieldset>
      </div>

      <!-- Payment -->
      <div class="checkout-card">
        <h2 class="checkout-card-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" aria-hidden="true" style="vertical-align:middle;margin-right:6px">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          Payment
        </h2>
        <p class="checkout-card-sub">Your card is entered directly with Stripe and never touches our website. <strong>Placing your order authorizes the payment — we do not charge your card until we have confirmed availability.</strong></p>
        <div id="payment-element"></div>
        <div id="payment-error" role="alert" style="display:none;color:var(--red);margin-top:8px;font-size:14px"></div>
      </div>

      <!-- Order items -->
      <div class="checkout-card checkout-items-card">
        <h2 class="checkout-card-title">Your Order</h2>
        <% cart.items.forEach(function(item) { %>
        <div class="co-item">
          <% if (item.image) { %>
          <img src="<%= item.image %>?width=200" alt="<%= item.name %>" class="co-item-img" loading="lazy">
          <% } else { %>
          <div class="co-item-img co-item-img--placeholder"></div>
          <% } %>
          <div class="co-item-info">
            <p class="co-item-name"><%= item.name %></p>
            <p class="co-item-meta">Qty: <%= item.qty %></p>
          </div>
          <div class="co-item-price">
            $<%= (item.qty * (parseFloat(item.price)||0)).toLocaleString('en-US',{minimumFractionDigits:2}) %>
          </div>
        </div>
        <% }); %>
      </div>

    </div><!-- /checkout-form-section -->

    <!-- ── Right: Order summary ──────────────────────────────────── -->
    <aside class="checkout-summary">
      <div class="checkout-card">
        <h2 class="checkout-card-title">Order Summary</h2>

        <div class="co-sum-row">
          <span>Subtotal (<%= cart.count %> <%= cart.count === 1 ? 'item' : 'items' %>)</span>
          <span id="sum-subtotal">$<%= (parseFloat(cart.subtotal)||0).toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
        </div>
        <div class="co-sum-row">
          <span>Shipping</span>
          <span class="free-label">FREE</span>
        </div>
        <%/* Tax starts as a dash and is filled by the checkout 'change'
             event once Stripe has an address to compute against. The row is
             rendered up front rather than injected so the summary does not
             jump when the figure arrives. */%>
        <div class="co-sum-row">
          <span>Sales Tax</span>
          <span id="sum-tax">—</span>
        </div>
        <div class="co-sum-row co-sum-total">
          <span>Total</span>
          <span id="sum-total">$<%= (parseFloat(cart.subtotal)||0).toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
        </div>

        <p class="co-sum-note" id="tax-note">Tax is calculated once you enter your billing address.</p>

        <%
          /* Agreement line — must sit IMMEDIATELY above the Place Order button.
             This is what makes the policy pages binding rather than merely
             published: the arbitration clause, the liability cap and the 25%
             restocking fee all depend on the customer having been shown the
             terms at the moment of purchase. A footer link is weak evidence
             of that; a line adjacent to the button is the standard one.

             Passive by design — no checkbox. Decided 8 Sept 2026.

             The four hrefs are the slugs seeded by migration 012 and used by
             the footer menus in migration 015. They are NOT guesses: an
             earlier draft of the policy migration invented `terms`,
             `privacy` and `returns-refunds`, which would have 404'd here in
             exactly the place a 404 does the most damage. */
        %>
        <p class="co-sum-note">
          By placing your order you agree to our
          <a href="/pages/terms-and-conditions">Terms &amp; Conditions</a>,
          <a href="/pages/privacy-policy">Privacy Policy</a>,
          <a href="/pages/shipping-policy">Shipping Policy</a> and
          <a href="/pages/returns-policy">Returns &amp; Refunds</a>.
        </p>

        <%/* Disabled until Stripe reports canConfirm — i.e. every required
             field across all three elements is valid. Enabling it earlier
             means a click that can only fail. */%>
        <button type="button" id="payBtn" class="btn btn-amber checkout-submit-btn" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" aria-hidden="true" style="margin-right:6px;vertical-align:middle">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span id="payBtnText">Place Order</span>
        </button>
        <p class="co-sum-redirect-note">Payment is encrypted and processed securely by Stripe. Your card is authorized now and charged only once we confirm availability.</p>

        <!-- Trust row -->
        <div class="cart-trust-row" style="margin-top:1rem">
          <div class="ctr-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>256-bit SSL</span>
          </div>
          <div class="ctr-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/>
            </svg>
            <span>30-Day Returns</span>
          </div>
          <div class="ctr-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h3l4 4v5h-7V8z"/>
              <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
            <span>Free Shipping</span>
          </div>
        </div>

        <!-- Payment logos -->
        <div class="cart-payment-logos" style="margin-top:1rem">
          <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="Visa">
            <rect width="60" height="38" rx="4" fill="#1A1F71"/>
            <text x="30" y="24" text-anchor="middle" fill="#fff" font-size="15" font-weight="700" font-style="italic" font-family="Arial,sans-serif" letter-spacing="1">VISA</text>
          </svg>
          <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="Mastercard">
            <rect width="60" height="38" rx="4" fill="#f0f0f0" stroke="#ddd" stroke-width=".5"/>
            <circle cx="23" cy="19" r="10" fill="#EB001B"/>
            <circle cx="37" cy="19" r="10" fill="#F79E1B"/>
            <path d="M30 11.2a10 10 0 0 1 0 15.6A10 10 0 0 1 30 11.2Z" fill="#FF5F00"/>
          </svg>
          <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="American Express">
            <rect width="60" height="38" rx="4" fill="#007BC1"/>
            <text x="30" y="16" text-anchor="middle" fill="#fff" font-size="7" font-weight="600" font-family="Arial,sans-serif" letter-spacing=".8">AMERICAN</text>
            <text x="30" y="27" text-anchor="middle" fill="#fff" font-size="9" font-weight="800" font-family="Arial,sans-serif" letter-spacing=".5">EXPRESS</text>
          </svg>
          <svg class="pay-logo" viewBox="0 0 60 38" role="img" aria-label="Discover">
            <rect width="60" height="38" rx="4" fill="#fff" stroke="#ddd" stroke-width=".5"/>
            <text x="30" y="24" text-anchor="middle" fill="#F76F20" font-size="11" font-weight="700" font-family="Arial,sans-serif">DISCOVER</text>
          </svg>
        </div>

      </div>
    </aside>

  </div><!-- /checkout-layout -->
</div>

<%/* Stripe.js must be loaded from js.stripe.com on every page that touches
     payment — self-hosting it breaks PCI compliance and Stripe blocks it.
     The CSP allows this host under frame-src; script-src uses
     strict-dynamic with a nonce, so the nonce below is what admits it. */%>
<script src="https://js.stripe.com/dahlia/stripe.js" nonce="<%= cspNonce %>"></script>

<script nonce="<%= cspNonce %>">
(function () {
  'use strict';

  var payBtn     = document.getElementById('payBtn');
  var payBtnText = document.getElementById('payBtnText');
  var errEl      = document.getElementById('payment-error');

  /* ── TEMPORARY on-page debug panel ───────────────────────────────
     Only renders with ?debug=1 in the URL, so customers never see it.
     Exists because confirm() is failing somewhere the server cannot
     observe, and reading it out of devtools has proved impractical.
     Everything logged here also goes to the console.
     DELETE this block, and the calls to dbg(), once checkout works. */
  var DEBUG = /[?&]debug=1/.test(location.search);
  var dbgBox;
  if (DEBUG) {
    dbgBox = document.createElement('pre');
    dbgBox.style.cssText =
      'position:fixed;bottom:0;left:0;right:0;max-height:42vh;overflow:auto;' +
      'z-index:99999;margin:0;padding:10px 12px;background:#101418;color:#9ef;' +
      'font:11px/1.45 ui-monospace,Menlo,monospace;white-space:pre-wrap;' +
      'border-top:3px solid #0074d4';
    dbgBox.textContent = 'checkout debug — select all and copy\n';
    document.body.appendChild(dbgBox);
  }
  function dbg(label, value) {
    var line = '[checkout] ' + label +
      (value === undefined ? '' : ' ' + (function () {
        try { return typeof value === 'string' ? value : JSON.stringify(value); }
        catch (e) { return String(value); }
      })());
    console.log(line);
    if (dbgBox) dbgBox.textContent += line + '\n';
  }
  window.addEventListener('error', function (ev) {
    dbg('WINDOW ERROR:', (ev.message || '') + ' @ ' + (ev.filename || '') + ':' + (ev.lineno || ''));
  });

  function showError(msg) {
    errEl.textContent = msg;
    errEl.style.display = 'block';
    errEl.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }

  /* Stripe's session totals are NOT plain minor-unit integers.
     `session.total.total.amount` is a DISPLAY STRING, already formatted
     and currency-symbolled ("$1,649.00"). Passing that through
     Number()/100 gives NaN, which is what the first live test rendered
     across Subtotal and Total on 2026-09-25.

     Handles both shapes rather than betting on one: a string is already
     display-ready and is used verbatim; a number is treated as minor
     units. Anything else renders an em-dash rather than "NaN" or "$0.00",
     because a zero total on a checkout page is a worse lie than a
     visible blank. */
  function money(v) {
    if (v == null) return '—';
    if (typeof v === 'object') v = (v.amount != null ? v.amount : v.value);
    if (typeof v === 'string') return v.trim() || '—';
    var n = Number(v);
    if (!isFinite(n)) return '—';
    return '$' + (n / 100).toLocaleString('en-US',
      { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  /* Conversion attribution. Read here and posted with the session request,
     because the referrer and the query string are gone by the time the
     webhook runs — and the webhook is where the order is finalised. */
  function attribution() {
    var p = new URLSearchParams(window.location.search);
    var ref = document.referrer || '';
    var host = '';
    try { host = ref ? new URL(ref).hostname : ''; } catch (e) { host = ref; }
    return {
      utm_campaign:   p.get('utm_campaign')  || null,
      utm_medium:     p.get('utm_medium')    || null,
      utm_source:     p.get('utm_source')    || null,
      order_referrer: ref || null,
      order_source:   p.get('utm_source') || host || 'direct',
    };
  }

  /* The SDK takes clientSecret as a PROMISE and resolves it during init.
     POST /checkout/session writes the order row first and only then calls
     Stripe — so if this rejects, nothing was charged and no session exists.
     The CSRF token is required: the endpoint sits behind the same
     validator as every other non-GET route. */
  var clientSecretPromise = fetch('/checkout/session', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': '<%= csrfToken %>',
      'X-Requested-With': 'XMLHttpRequest',
    },
    body: JSON.stringify(attribution()),
  })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (!d.ok) throw new Error(d.error || 'Could not start checkout.');
      return d.clientSecret;
    });

  clientSecretPromise.catch(function (e) {
    showError(e.message || 'Could not start checkout. Please refresh and try again.');
  });

  var stripe   = Stripe('<%= stripePublishableKey %>');
  var checkout = stripe.initCheckoutElementsSdk({
    clientSecret: clientSecretPromise,
    elementsOptions: {
      appearance: {
        variables: {
          fontFamily: 'Georgia, serif',
          colorText:  '#182840',
          borderRadius: '4px',
        },
      },
    },
  });

  /* TEMPORARY — goes out with the rest of the ?debug=1 panel.
     Enumerating the live SDK is the only reliable way to learn what it
     exposes: confirm() was written from a docs example, does not exist on
     this object, and cost an evening of zero PaymentIntents. Read the
     object, then write the shipping code. */
  if (DEBUG) {
    window.__ck = checkout;
    dbg('sdk methods:', Object.keys(checkout).filter(function (k) {
      return typeof checkout[k] === 'function';
    }).sort().join(','));
    dbg('sdk non-fn keys:', Object.keys(checkout).filter(function (k) {
      return typeof checkout[k] !== 'function';
    }).sort().join(','));
  }

  /* Fires whenever any element changes. Two jobs: keep the summary in step
     with Stripe's own totals (tax only exists once there is an address),
     and gate the button on canConfirm so it is never clickable in a state
     that can only fail. */
  checkout.on('change', function (session) {
    payBtn.disabled = !session.canConfirm;

    var t = session.total;
    if (!t) return;

    /* One-time shape dump. The SDK's total object is not documented field
       by field, and guessing at it is what produced $NaN on the first
       test. Logged once so the real shape is visible in the console
       instead of being inferred from a broken render. */
    if (!window.__loggedTotalShape) {
      window.__loggedTotalShape = true;
      dbg('session.total shape:', t);
    }

    /* TEMPORARY — shows whether the elements are actually feeding the
       session. If canConfirm never turns true, or the tax status never
       leaves requires_location_inputs after an address is typed, the
       address is not reaching Stripe and confirm() can never complete. */
    /* shipping= is the one that matters now. Enabling
       shipping_address_collection means Stripe wants a ship-to before it
       will confirm, and with the checkbox unticked that address only
       arrives via the billing->shipping mirror. If billing goes true and
       shipping stays false, the mirror is the fault and canConfirm can
       never turn true however complete the card is. */
    dbg('change: canConfirm=' + session.canConfirm +
        ' status=' + (session.status && session.status.type ? session.status.type : session.status) +
        ' email=' + !!session.email +
        ' billing=' + !!(session.billingAddress || session.billing_address) +
        ' shipping=' + !!session.shippingAddress +
        ' phone=' + !!session.phoneNumber +
        ' shipDiff=' + (shipDiff ? shipDiff.checked : 'n/a'));

    if (t.subtotal != null) {
      document.getElementById('sum-subtotal').textContent = money(t.subtotal);
    }

    /* There is NO `t.tax`. The real shape, logged from a live session on
       2026-09-25, is:

         subtotal      {amount:"$1,049.99", minorUnitsAmount:104999}
         taxExclusive  {amount:"$0.00",     minorUnitsAmount:0}
         taxInclusive  {amount:"$0.00",     minorUnitsAmount:0}
         shippingRate  discount  total  appliedBalance  surcharge

       The account's default tax behaviour is EXCLUSIVE (tax added on top
       of our prices), so taxExclusive is the figure to show. taxInclusive
       is the fallback in case that setting is ever changed, and `tax` is
       kept last purely in case the SDK shape shifts again. */
    var taxObj   = t.taxExclusive || t.taxInclusive || t.tax;
    var taxMinor = (taxObj && taxObj.minorUnitsAmount != null)
      ? taxObj.minorUnitsAmount : null;

    if (taxObj != null) {
      document.getElementById('sum-tax').textContent = money(taxObj);
      /* Only retire the "calculated once you enter your address" note once
         there is real tax to show. taxExclusive exists from the very first
         change event reading $0.00, so its mere presence proves nothing —
         hiding on that would tell the customer tax was calculated before
         they had typed an address. */
      if (taxMinor > 0) {
        document.getElementById('tax-note').style.display = 'none';
      }
    }
    if (t.total != null) {
      var tot = money(t.total);
      document.getElementById('sum-total').textContent = tot;
      /* Only label the button with a real figure. "Place Order — —" is
         worse than no figure at all. */
      payBtnText.textContent = (tot === '—')
        ? 'Place Order'
        : 'Place Order — ' + tot;
    }

    /* Keep ship-to in step with billing while the checkbox is unticked.
       Declared below; function declarations hoist, and the guard inside
       covers a change that fires before the elements are wired. */
    mirrorBillingToShipping(session);
  });

  checkout.createContactDetailsElement().mount('#contact-details-element');
  checkout.createBillingAddressElement().mount('#billing-address-element');
  checkout.createPaymentElement().mount('#payment-element');

  /* ── Ship-to ──────────────────────────────────────────────────────
     Two states, one source of truth.

     UNCHECKED (the default, and the overwhelming majority): the billing
     address is mirrored to shipping on every change, so the buyer types
     one address and the freight still has a destination. Without this the
     ship_* columns stay null and the order cannot be booked at all - which
     is exactly what happened to every order before today.

     CHECKED: Stripe's own Shipping Address Element is mounted and owns the
     value. The mirror stops immediately, or it would overwrite what the
     buyer just typed on their next billing keystroke.

     updateShippingAddress() and createShippingAddressElement() were both
     confirmed present on the live SDK before this was written. */
  /* loadActions() is async and returns a fresh object each call. Memoised
     so the mirror does not re-load it on every keystroke, and normalised
     because the actions live under .actions on this SDK - the shape that
     cost an evening when confirm() was called on the wrapper instead. */
  var _actionsPromise = null;
  function loadActionsOnce() {
    if (!_actionsPromise) {
      _actionsPromise = checkout.loadActions().then(function (loaded) {
        return (loaded && loaded.actions) ? loaded.actions : loaded;
      });
    }
    return _actionsPromise;
  }

  var shipDiff  = document.getElementById('ship-different');
  var shipWrap  = document.getElementById('shipping-address-wrap');
  var shipEl    = null;
  var lastMirror = '';

  function mirrorBillingToShipping(session) {
    /* change can fire during init, before the lines below have run.
       Reading .checked off undefined there would throw inside Stripe's
       own listener, where nothing surfaces it. */
    if (!session || !shipDiff || shipDiff.checked) return;
    var b = session.billingAddress;
    if (!b || !b.address || !b.address.line1 || !b.address.postal_code) return;

    /* Stripe fires change on every keystroke. Sending an identical address
       each time would be a network call per character. */
    var sig = JSON.stringify(b.address) + '|' + (b.name || '');
    if (sig === lastMirror) return;
    lastMirror = sig;

    loadActionsOnce().then(function (actions) {
      return actions.updateShippingAddress({ name: b.name || '', address: b.address });
    }).then(function () {
      dbg('mirror ok: billing copied to shipping');
    }).catch(function (e) {
      /* Never block the buyer. A failed mirror leaves ship_* to the
         webhook's billing fallback, which lands on the same address. */
      dbg('mirror failed: ' + (e && e.message ? e.message : String(e)));
    });
  }

  shipDiff.addEventListener('change', function () {
    shipWrap.hidden = !shipDiff.checked;
    if (shipDiff.checked) {
      if (!shipEl) {
        shipEl = checkout.createShippingAddressElement();
        shipEl.mount('#shipping-address-element');
      }
    } else {
      /* Back to mirroring. Cleared so the next billing change is treated
         as new and re-sent rather than skipped by the signature check. */
      lastMirror = '';
      loadActionsOnce()
        .then(function (actions) { return actions.getSession(); })
        .then(mirrorBillingToShipping)
        .catch(function () {});
    }
  });

  /* ── Phone ────────────────────────────────────────────────────────
     Stripe wants E.164. A buyer types "(404) 555-1234". Normalise rather
     than reject: a validation error on a field the customer filled in
     correctly by any human standard is a lost order.

     10 digits is assumed US (+1) - BVO ships domestic LTL only. 11 digits
     starting 1 is the same number with the country code already typed.
     Anything else is handed over as-is and Stripe decides. */
  var phoneEl  = document.getElementById('ship-phone');
  var extEl    = document.getElementById('ship-phone-ext');
  var phoneErr = document.getElementById('phone-error');

  /* Split a trailing extension off the number.
     Returns { number, ext }.

     This runs BEFORE punctuation is stripped. After that point "ext 22" is
     indistinguishable from the rest of the digit run, which is how
     "404-555-1234 ext 22" became +404555123422 - twelve digits that passed
     a loose length check and could not be dialled.

     The extension is MOVED to its own field, not discarded. Throwing away
     digits the buyer typed, without telling them, is its own bug: the
     carrier would ring the main line and nobody would know why. */
  function splitExt(raw) {
    var s = String(raw || '').trim();
    var m = /[\s,;]*(?:ext|extension|xt|x|#)\.?\s*(\d{1,8})\s*$/i.exec(s);
    return m
      ? { number: s.slice(0, m.index), ext: m[1] }
      : { number: s, ext: '' };
  }

  function e164(raw) {
    var s = splitExt(raw).number;
    var d = s.replace(/[^\d+]/g, '');
    if (d.charAt(0) === '+') return d;
    d = d.replace(/\D/g, '');
    if (d.length === 10) return '+1' + d;
    if (d.length === 11 && d.charAt(0) === '1') return '+' + d;
    return d ? '+' + d : '';
  }

  /* US: +1 and exactly ten digits. Anything else the buyer typed with an
     explicit + is treated as international and allowed through at 10-15
     digits - a foreign mobile on a US delivery address is unusual but
     real, and Stripe validates it properly either way.

     Deliberately NOT a loose /\+\d{10,15}/ on everything: that is what let
     the extension case through. */
  function phoneValid() {
    var v = e164(phoneEl.value);
    if (/^\+1\d{10}$/.test(v)) return true;
    return String(phoneEl.value).trim().charAt(0) === '+' && /^\+\d{10,15}$/.test(v);
  }

  /* If the buyer typed the extension into the number box, move it across
     rather than silently eating it. Only when the extension box is empty -
     never overwrite something they typed there deliberately. */
  function harvestExt() {
    var parts = splitExt(phoneEl.value);
    if (parts.ext && !extEl.value.trim()) {
      extEl.value  = parts.ext;
      phoneEl.value = parts.number.replace(/[\s,;]+$/, '');
    }
  }

  function saveExt() {
    var v = extEl.value.replace(/\D/g, '').slice(0, 8);
    extEl.value = v;
    /* Stripe has no field for this, so it goes straight to our own order
       row like the delivery type. */
    return fetch('/checkout/order-details', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json',
                 'X-CSRF-Token': '<%= csrfToken %>' },
      body:    JSON.stringify({ phone_ext: v }),
    }).catch(function () {});
  }

  function pushPhone() {
    phoneErr.style.display = 'none';
    harvestExt();
    saveExt();
    if (!phoneEl.value.trim()) return Promise.resolve();
    if (!phoneValid()) {
      phoneErr.textContent = 'Please enter a 10-digit phone number, e.g. (404) 555-1234.';
      phoneErr.style.display = 'block';
      return Promise.resolve();
    }
    return loadActionsOnce()
      .then(function (actions) { return actions.updatePhoneNumber(e164(phoneEl.value)); })
      .catch(function (e) {
        /* Do not block the sale. The number is still submitted with the
           order below; this only means Stripe's copy is missing. */
        dbg('updatePhoneNumber failed: ' + (e && e.message ? e.message : String(e)));
      });
  }
  phoneEl.addEventListener('change', pushPhone);
  phoneEl.addEventListener('blur', pushPhone);
  extEl.addEventListener('change', saveExt);
  extEl.addEventListener('blur', saveExt);

  /* Residential vs commercial. Written to our own order row - Stripe has
     no field for it. Fire and forget: a buyer must never be stopped from
     paying because this did not save. */
  function saveDeliveryType() {
    var picked = document.querySelector('input[name="delivery_type"]:checked');
    if (!picked) return;
    fetch('/checkout/order-details', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json',
                 'X-CSRF-Token': '<%= csrfToken %>' },
      body:    JSON.stringify({ type: picked.value }),
    }).catch(function () {});
  }
  Array.prototype.forEach.call(
    document.querySelectorAll('input[name="delivery_type"]'),
    function (r) { r.addEventListener('change', saveDeliveryType); }
  );

  /* Persist the DEFAULT too, once the order row exists - otherwise a buyer
     who accepts "Residential" without touching it leaves the column NULL,
     and NULL is reserved for "never asked". The order row is created by
     POST /checkout/session, so this waits on that promise rather than
     racing it. */
  clientSecretPromise.then(saveDeliveryType).catch(function () {});

  /* Spinner + honest status. A dead button with static text for 30-60s
     reads as broken, and a customer who thinks it is broken clicks again.
     The button is disabled from the first click, so a second click cannot
     submit - but the copy has to say so, because the customer cannot see
     the disabled state on a filled button. */
  function busy(label) {
    payBtn.disabled = true;
    payBtnText.innerHTML =
      '<span style="display:inline-block;width:13px;height:13px;margin-right:8px;' +
      'vertical-align:-2px;border:2px solid currentColor;border-right-color:transparent;' +
      'border-radius:50%;animation:bvo-spin .7s linear infinite"></span>' + label;
  }
  function idle(label) {
    payBtn.disabled = false;
    payBtnText.textContent = label || 'Place Order';
  }
  (function () {
    var st = document.createElement('style');
    st.textContent = '@keyframes bvo-spin{to{transform:rotate(360deg)}}';
    document.head.appendChild(st);
  })();

  payBtn.addEventListener('click', async function () {
    errEl.style.display = 'none';

    /* Checked BEFORE the card is authorised, not after. A freight order
       without a consignee phone cannot be dispatched, and chasing the
       number afterwards means either an email the buyer may not read or a
       hold expiring while we wait. Stripe's own canConfirm gate knows
       nothing about this field. */
    if (!phoneValid()) {
      phoneErr.textContent = phoneEl.value.trim()
        ? 'Please enter a 10-digit phone number, e.g. (404) 555-1234.'
        : 'A phone number is required — the freight carrier needs it to schedule delivery.';
      phoneErr.style.display = 'block';
      phoneEl.focus();
      phoneEl.scrollIntoView({ block: 'center', behavior: 'smooth' });
      return;
    }
    await pushPhone();

    busy('Authorizing your payment…');

    var note = document.querySelector('.co-sum-redirect-note');
    var noteWas = note ? note.innerHTML : null;
    if (note) {
      note.innerHTML = '<strong>Please don’t close this page or click again.</strong> ' +
        'Authorizing with your bank — this can take up to a minute.';
    }

    /* A successful confirm redirects to return_url and this page goes
       away, so nothing after it should run on the happy path. If the
       redirect does not happen, the button would otherwise spin forever
       while the payment sat authorized in Stripe.

       60s, not 20s: an authorization that has to clear 3D Secure can
       legitimately take that long, and the earlier 20s fuse fired
       mid-flight and mislabelled working payments as stuck.

       Never invite a retry here - that would double-authorize a payment
       that already succeeded. */
    var stuck = setTimeout(function () {
      payBtn.disabled = true;
      payBtnText.textContent = 'Payment submitted';
      if (note) note.innerHTML = noteWas;
      showError('Your payment was submitted, but this page did not finish loading. '
        + 'DO NOT try again — please contact us with your email address and we '
        + 'will confirm your order.');
    }, 60000);

    function fail(msg) {
      clearTimeout(stuck);
      if (note) note.innerHTML = noteWas;
      showError(msg);
      idle('Place Order');
    }

    try {
      /* THE FIX.

         checkout.confirm() does not exist. The SDK returned by
         initCheckoutElementsSdk exposes createPaymentElement, on,
         loadActions and friends - and nothing called confirm. Calling it
         threw a TypeError that the catch below turned into a generic
         "something went wrong", so no network request was ever made.
         Stripe's API log showed six session creations and zero
         PaymentIntents, which is exactly that signature.

         confirm() lives on the object returned by loadActions():
             const { actions } = await checkout.loadActions();
             await actions.confirm();

         Verified on 2026-09-25 by enumerating the live SDK object rather
         than reading it out of a docs example - the same mistake that
         produced $NaN and the non-existent `tax` key. */
      var loaded = await checkout.loadActions();
      var actions = (loaded && loaded.actions) ? loaded.actions : loaded;
      dbg('loadActions ->', Object.keys(actions || {}).join(','));

      if (!actions || typeof actions.confirm !== 'function') {
        fail('Checkout could not start. Please refresh and try again.');
        return;
      }

      /* Validate before confirming. Without this a missing or malformed
         field fails inside confirm with a generic message instead of
         marking the offending field. */
      if (typeof actions.validateElements === 'function') {
        var v = await actions.validateElements();
        dbg('validateElements ->', v);
        if (v && v.type === 'error') {
          fail((v.error && v.error.message)
            ? v.error.message
            : 'Please check the highlighted fields and try again.');
          return;
        }
      }

      var t0 = Date.now();
      var result = await actions.confirm();
      dbg('confirm RESOLVED after ' + (Date.now() - t0) + 'ms ->', result);

      /* Only reached on an immediate error - success redirects away. */
      if (result && result.type === 'error') {
        fail((result.error && result.error.message)
          ? result.error.message
          : 'Your payment could not be authorized. Please check your details and try again.');
      }
    } catch (e) {
      dbg('confirm THREW: ' + (e && e.message ? e.message : String(e)));
      fail(e && e.message ? e.message : 'Something went wrong. Nothing has been charged.');
    }
  });

  window.addEventListener('unhandledrejection', function (ev) {
    dbg('UNHANDLED REJECTION: ' + (ev.reason && ev.reason.message ? ev.reason.message : String(ev.reason)));
  });
})();
</script>
