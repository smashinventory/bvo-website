<%
  /* Search results page.

     Card markup deliberately reuses the class names from collection.ejs
     (product-card, product-body, card-price-qty-row, ...) so it inherits
     the existing CSS and needs none of its own. It is a SIMPLER card
     though: no finish swatches or size chips, because those are driven by
     modelColorMap / modelSizeMap / familyHex, which are built by the
     collections controller from a category. Building them here would mean
     three more queries for decoration on a page whose job is to get the
     shopper to the right product.

     Quantity uses the same banding as the collection grid — exact below 4,
     compressed above — so the two pages never disagree about stock. */
  function _qtyBand(raw) {
    var n = parseInt(raw || 0, 10);
    return n <= 3 ? n : n <= 6 ? 4 : n <= 9 ? 5 : n <= 12 ? 6 : n <= 15 ? 7 : n <= 20 ? 8 : 9;
  }
  function _money(v) {
    return parseFloat(v).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }
  function _qs(over) {
    var p = new URLSearchParams();
    if (q) p.set('q', q);
    var s = (over && 'sort' in over) ? over.sort : sort;
    var g = (over && 'page' in over) ? over.page : page;
    if (s && s !== 'relevance') p.set('sort', s);
    if (g && g > 1) p.set('page', g);
    return '/search?' + p.toString();
  }
%>

<div class="breadcrumb">
  <a href="/">Home</a> &rsaquo; Search
</div>

<div class="cat-header">
  <div class="cat-header-inner">
    <% if (q) { %>
      <h1>Search results for &ldquo;<%= q %>&rdquo;</h1>
      <p>
        <% if (total === 0) { %>
          No products matched your search.
        <% } else { %>
          <%= total.toLocaleString('en-US') %> product<%= total !== 1 ? 's' : '' %> found
        <% } %>
      </p>
    <% } else { %>
      <h1>Search</h1>
      <p>Enter a model name, SKU, colour or size to find a product.</p>
    <% } %>
  </div>
</div>

<div class="listing-layout listing-layout--full">
  <div class="listing-main">

    <% if (total > 0) { %>
    <div class="listing-bar">
      <span class="listing-count">
        Showing <%= ((page - 1) * 24) + 1 %>&ndash;<%= Math.min(page * 24, total) %>
        of <%= total.toLocaleString('en-US') %>
      </span>
      <form method="GET" action="/search" class="listing-sort">
        <input type="hidden" name="q" value="<%= q %>">
        <label class="sr-only" for="search-sort">Sort results</label>
        <select name="sort" id="search-sort" class="listing-sort-select" onchange="this.form.submit()">
          <% sortLabels.forEach(function(o) { %>
          <option value="<%= o[0] %>" <%= sort === o[0] ? 'selected' : '' %>><%= o[1] %></option>
          <% }); %>
        </select>
      </form>
    </div>

    <div class="product-grid">
      <% products.forEach(function(product) { %>
      <%
        var _qtyRaw = parseInt(product.qty_on_hand || 0, 10);
        var _onSale = product.compare_price && parseFloat(product.compare_price) > parseFloat(product.price);
      %>
      <article class="product-card<%= _qtyRaw === 0 ? ' product-card--no-stock' : '' %>">
        <a href="/products/<%= product.slug %>" class="product-img-link" aria-label="<%= product.name %>">
          <div class="product-img">
            <% if (product.primary_image) { %>
              <img class="product-img-pri" src="<%= product.primary_image %>" alt="<%= product.name %>" loading="lazy">
            <% } else { %>
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            <% } %>
            <% if (product.badge === 'best') { %>
              <span class="product-badge badge-best">BEST</span>
            <% } else if (product.badge === 'new') { %>
              <span class="product-badge badge-new">NEW</span>
            <% } %>
          </div>
        </a>
        <div class="product-body">
          <% if (product.brand) { %><p class="product-brand"><%= product.brand %></p><% } %>
          <h3 class="product-title">
            <a href="/products/<%= product.slug %>"><%= product.name %></a>
          </h3>
          <% if (product.price) { %>
          <div class="card-price-qty-row">
            <div class="card-price">
              <% if (_onSale) { %>
                <span class="card-price__sale">$<%= _money(product.price) %></span>
                <span class="card-price__was">$<%= _money(product.compare_price) %></span>
                <span class="card-save-badge">Save $<%= Math.round(parseFloat(product.compare_price) - parseFloat(product.price)).toLocaleString('en-US') %></span>
              <% } else { %>
                <span class="card-price__regular">$<%= _money(product.price) %></span>
              <% } %>
            </div>
            <span class="card-qty<%= _qtyRaw === 0 ? ' card-qty--zero' : '' %>">QTY: <%= _qtyBand(_qtyRaw) %></span>
          </div>
          <% } %>
          <a href="/products/<%= product.slug %>" class="btn btn-primary product-cta">View Details</a>
        </div>
      </article>
      <% }); %>
    </div>

    <% if (pages > 1) { %>
    <nav class="pagination" aria-label="Search results pages">
      <% if (page > 1) { %>
        <a class="page-link" href="<%= _qs({ page: page - 1 }) %>" rel="prev">&laquo; Prev</a>
      <% } %>
      <span class="page-current">Page <%= page %> of <%= pages %></span>
      <% if (page < pages) { %>
        <a class="page-link" href="<%= _qs({ page: page + 1 }) %>" rel="next">Next &raquo;</a>
      <% } %>
    </nav>
    <% } %>

    <% } else { %>

    <%# Empty state. Reached by a typo far more often than by a genuinely
        absent product, because LIKE matching has no typo tolerance. %>
    <div class="search-empty">
      <% if (q) { %>
        <h2>Nothing matched &ldquo;<%= q %>&rdquo;</h2>
        <ul class="search-empty-tips">
          <li>Check the spelling — try a shorter word, like <em>brittany</em> rather than the full name.</li>
          <li>Search by size or colour on its own, such as <em>36 white</em>.</li>
          <li>Paste a SKU directly if you have one.</li>
        </ul>
      <% } else { %>
        <h2>Search our catalogue</h2>
        <p>Try a model name, a SKU, or a size and colour together.</p>
      <% } %>
      <p><a class="btn btn-outline" href="/collections/bathroom-vanities">Browse all vanities</a></p>
    </div>

    <% if (popular && popular.length) { %>
    <section class="section">
      <div class="section-header" style="text-align:center">
        <p class="section-eyebrow">Popular Right Now</p>
        <h2 class="section-title">Our Best Sellers</h2>
      </div>
      <div class="product-grid">
        <% popular.forEach(function(product) { %>
        <%
          var _qtyRaw = parseInt(product.qty_on_hand || 0, 10);
          var _onSale = product.compare_price && parseFloat(product.compare_price) > parseFloat(product.price);
        %>
        <article class="product-card<%= _qtyRaw === 0 ? ' product-card--no-stock' : '' %>">
          <a href="/products/<%= product.slug %>" class="product-img-link" aria-label="<%= product.name %>">
            <div class="product-img">
              <% if (product.primary_image) { %>
                <img class="product-img-pri" src="<%= product.primary_image %>" alt="<%= product.name %>" loading="lazy">
              <% } %>
            </div>
          </a>
          <div class="product-body">
            <% if (product.brand) { %><p class="product-brand"><%= product.brand %></p><% } %>
            <h3 class="product-title">
              <a href="/products/<%= product.slug %>"><%= product.name %></a>
            </h3>
            <% if (product.price) { %>
            <div class="card-price-qty-row">
              <div class="card-price">
                <% if (_onSale) { %>
                  <span class="card-price__sale">$<%= _money(product.price) %></span>
                  <span class="card-price__was">$<%= _money(product.compare_price) %></span>
                <% } else { %>
                  <span class="card-price__regular">$<%= _money(product.price) %></span>
                <% } %>
              </div>
            </div>
            <% } %>
          </div>
        </article>
        <% }); %>
      </div>
    </section>
    <% } %>

    <% } %>
  </div>
</div>
