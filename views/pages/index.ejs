<%/* site3.css is loaded per-page via the layout's style slot, not globally.
     On THIS page everything it styles is below the fold — the featured-card
     save badge (~L684) and the whole hp-inspo block (~L901-932). Audited
     2026-09-17: its only .btn rule is ".confirm-actions .btn" (order
     confirmation), and its .active/.is-active rules are scoped to
     lb-size-chip / lb-card-swatch / blog-pg-btn. Nothing above the fold.
     So load it without blocking first paint — it was 570ms of blocking CSS.
     Every other page keeps the plain blocking <link>; do not change those. */%>
<%/* NO <noscript> fallback here. A <noscript> injected through the layout's
     style slot into <head> does not survive parsing — verified live
     2026-09-17, the inner <link> ended up in <head> as a plain blocking
     stylesheet (inNoscript:false, media:""), which defeated the whole point.
     Cost of omitting it: a JS-disabled visitor loses styling on the featured
     save badge and the hp-inspo block, both below the fold. */%>
<link rel="stylesheet" href="/css/site3.css?v=18" media="print" id="site3-css">
<%/* media flip done by a nonced script, not onload="": the CSP's
     script-src-attr 'none' blocks inline handlers, which would leave site3.css
     stuck at media=print (unstyled) once the policy is enforced. */%>
<script nonce="<%= cspNonce %>">(function(l){if(!l)return;function on(){l.media='all';}if(l.sheet){on();}else{l.addEventListener('load',on);}})(document.getElementById('site3-css'));</script>
<%
const S    = settings || {};
const hero = S.hero               || {};
const tick = S.scrolling_ticker   || {};
const bl   = S.brand_logos        || {};

/* ── Responsive hero: one file, many widths ───────────────────────────────
   The hero is full-bleed at every breakpoint, so sizes="100vw" is exact and
   the browser picks from the ladder below. Before this, one 1604x927 file
   (122 KB) went to every device including phones. Measured off the pull zone:

       480w  21.3 KB     1024w  66.8 KB
       768w  43.6 KB     1280w  87.7 KB
                         1604w 122.1 KB   (the source, unchanged)

   A 390px phone at dpr2 now takes 1024w instead of 1604w: 66.8 KB against
   122.1 KB, 45% off the largest asset on the page and the LCP element.

   Two guards, same reasoning as the ?width= guard on the category cards:
     • non-Bunny URL  -> no srcset. Only the pull zone has a resizer; a local
       /images/uploads path would 404 every candidate and blank the hero.
     • URL already carrying a query string -> left alone, so a hand-written
       Theme Editor URL always wins and we never emit "?a=b?width=".

   The ladder stops at 1604 because that is the source's natural width and
   Bunny will not invent pixels above it. If the hero is ever replaced with a
   larger master, extend this list to match, or the widest screens will keep
   being served 1604w. */
var _HERO_WIDTHS = [480, 768, 1024, 1280, 1604];
/* Intrinsic box for the phone hero image, so the browser can reserve the
   space before a byte of it arrives.

   WHY THIS EXISTS. The stacked layout took the image out of
   position:absolute and released the section height, which is correct — but
   the <img> carries a 1x1 transparent GIF as src (the real file comes from
   <source srcset>), has no width/height attributes and no aspect-ratio. So
   it occupies one pixel until the image decodes and then jumps to ~300px,
   shoving the page down. Measured on PageSpeed 2026-09-23: CLS 0 -> 0.321,
   which cost the whole score. Every other metric was unchanged.

   WHY NOT A HARDCODED RATIO. The shape is chosen in the image URL
   (?crop=W,H,x,y on Bunny). Pin a constant here and it silently fights
   whatever the owner set. So the ratio is DERIVED from that URL, and only
   when the URL does not carry one does hero_mobile.image_aspect supply it.
   One fact, one source, with an explicit fallback rather than a guess.

   The numbers are used for ratio only — CSS sets width:100%;height:auto —
   so "1160 x 927" and "4 x 3" reserve the same box. */
function _heroBox(url, fallbackAspect) {
  var m = /[?&]crop=(\d+),(\d+)/.exec(String(url || ''));
  if (m) return { w: +m[1], h: +m[2] };
  var a  = String(fallbackAspect || '').trim();
  var am = /^(\d+(?:\.\d+)?)\s*[:\/xX]\s*(\d+(?:\.\d+)?)$/.exec(a);
  if (am && +am[1] > 0 && +am[2] > 0) {
    return { w: Math.round(+am[1] * 1000), h: Math.round(+am[2] * 1000) };
  }
  return null;
}
function _heroSrcset(u) {
  u = String(u || '');
  if (u.indexOf('images.bathroomvanitiesoutlet.com') === -1) return '';

  /* It used to be `if (u.indexOf('?') !== -1) return '';` — any query string
     at all and the ladder was abandoned. That made the crop URL and the
     responsive ladder mutually exclusive: with ?crop= set, EVERY phone
     downloaded one fixed rung.

     Measured on the CDN 2026-09-23, crop 1160x927:
         width=750   49.1 KB   <- what every phone was getting
         width=480   25.1 KB
         width=375   17.8 KB
     A small or 1x device was paying roughly double.

     Bunny applies crop and width together, so the two were never actually
     in conflict. Existing params are carried onto every rung; only `width`
     is dropped, because this function is the thing that sets it and two
     conflicting width params is undefined behaviour. */
  var parts = u.split('?');
  var path  = parts[0];
  var keep  = (parts[1] || '').split('&').filter(function (p) {
    return p && !/^width=/i.test(p);
  });

  /* Do not offer rungs wider than the source. With ?crop=1160,... the image
     IS 1160 wide; asking Bunny for 1604 either upscales or silently clamps,
     and either way the browser may pick a rung that buys nothing and costs
     bytes. Rungs are capped at the crop width, with the crop width itself
     kept as the top rung so high-DPR phones still have a real ceiling. */
  var box    = _heroBox(u, '');
  var widths = _HERO_WIDTHS.slice();
  if (box && box.w) {
    widths = widths.filter(function (w) { return w < box.w; });
    widths.push(box.w);
  }
  if (!widths.length) return '';

  return widths.map(function (w) {
    return path + '?' + keep.concat(['width=' + w]).join('&') + ' ' + w + 'w';
  }).join(', ');
}
/* Responsive ladder for the before/after slider.

   WHY THIS EXISTS. These two images were the only ones on the homepage
   emitted raw — no ?width=, no srcset, no loading attribute — so they
   bypassed the Bunny resizer entirely and shipped their full master file,
   eagerly, from below the fold. GTmetrix 2026-09-23 flagged the same two
   images under BOTH "Properly size images" and "Defer offscreen images":

       after-bathroom.webp    28.2 KB   19.1 KB oversized
       before-bathroom.webp   21.2 KB   14.3 KB oversized
                                        49.4 KB deferrable in full

   The ladder tops out at 1800 because .ba-slider-wrap is max-width:900px,
   so 1800 covers a 2x screen at full size. Bunny clamps anything wider
   than the master, so a rung above the source costs nothing.

   Same two guards as _heroSrcset, for the same reasons: only the Bunny
   pull zone has a resizer, and an existing width= is dropped rather than
   duplicated. Unlike the hero these URLs carry no ?crop=, so there is no
   box to derive and the full ladder always applies. */
var _BA_WIDTHS = [480, 768, 900, 1200, 1800];
function _baSrcset(u) {
  u = String(u || '');
  if (u.indexOf('images.bathroomvanitiesoutlet.com') === -1) return '';
  var parts = u.split('?');
  var path  = parts[0];
  var keep  = (parts[1] || '').split('&').filter(function (p) {
    return p && !/^width=/i.test(p);
  });
  return _BA_WIDTHS.map(function (w) {
    return path + '?' + keep.concat(['width=' + w]).join('&') + ' ' + w + 'w';
  }).join(', ');
}
/* Append a section's brand filter to its CTA so "See All Our JM Models"
   lands on the JM-filtered list instead of the mixed one — the reason this
   whole change exists.

   Two guards, both deliberate:
     • no brand set  → URL is returned untouched
     • URL already has a brand= → left alone, so a hand-written Theme Editor
       URL always wins over the automatic append and cannot end up with two
       conflicting brand params.
   Written to tolerate absolute URLs and existing query strings. */
function _ctaWithBrand(url, brand) {
  var u = String(url || '');
  var b = String(brand || '').trim();
  if (!u || !b) return u;
  if (/[?&]brand=/.test(u)) return u;
  return u + (u.indexOf('?') === -1 ? '?' : '&') + 'brand=' + encodeURIComponent(b);
}
/* cs / fs_ / fm_ are gone deliberately. They pointed at the BASE slot only,
   so any code reaching for them inside a duplicated section would silently
   read the first copy's settings. Every one of the three sections now uses
   the per-slot `_d`. Removing the names rather than leaving them unused
   means a stray reference fails loudly instead of rendering wrong. */
const bt_  = S.bundle_teaser       || {};
const iwt  = S.image_with_text    || {};
const iwt2  = S.image_with_text_2  || {};
const vt2   = S.video_text_2       || {};
const tb2   = S.trust_band_2       || {};
const par2  = S.parallax_2         || {};
const test2 = S.testimonials_2     || {};
const vt   = S.video_text         || {};
const ba   = S.before_after       || {};
const ba2  = S.before_after_2     || {};
const tb   = S.trust_band         || {};
const par  = S.parallax           || {};
const test = S.testimonials       || {};
const news = S.newsletter         || {};

/* Video helpers — extract YouTube ID, detect source type */
function _ytId(url) {
  if (!url) return null;
  var m = String(url).match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?.*?v=|shorts\/))([a-zA-Z0-9_-]{11})/);
  return m ? m[1] : null;
}
function _isYT(url) { return !!(url && /youtu\.be|youtube\.com/.test(String(url))); }

/* Security: whitelist heading tag values so theme settings can't inject arbitrary HTML
   via raw EJS output tags (e.g. _heroTag, _csTag) used to emit heading elements. */
const _ALLOWED_TAGS = new Set(['h1','h2','h3','h4','h5','h6']);
function _safeTag(val, def) { return _ALLOWED_TAGS.has(val) ? val : (def || 'h2'); }

/* Salsify (Cloudinary) on-the-fly resize — inserts transform params into CDN URL.
   Reduces 2–4 MB hero/featured images to ~30–60 KB at the displayed size.
   If images ever 403, remove the transform call and they fall back to originals. */
function _salsifyImg(url, w, h) {
  if (!url || !url.includes('images.salsify.com/image/upload/')) return url;
  return url.replace('/image/upload/', '/image/upload/w_' + w + ',h_' + h + ',c_fill,f_auto,q_auto/');
}

const _DEFAULT_ORDER = ['scrolling_ticker','hero','hero_mobile','brand_logos','categories_section','bundle_teaser',
  'featured_section','featured_models','inspiration','image_with_text','video_text','before_after','trust_band','parallax','testimonials','newsletter'];
const _STATIC_SET  = new Set(_DEFAULT_ORDER);
/* Must stay in step with DUPLICATABLE_BASES in adminController.themeDuplicate
   and _DUPL_BASES in admin/theme.ejs. If a base is duplicatable there but
   missing here, _isValidKey rejects the new slot and the copy renders
   nothing — the admin shows a section that does not exist on the page. */
const _DUPL_BASES  = new Set(['image_with_text','before_after','video_text','trust_band','parallax','testimonials',
                              'featured_section','featured_models','categories_section']);

// Accept any _N copy of a duplicatable base type (image_with_text_2, _3, _4, …)
function _isValidKey(k) {
  if (_STATIC_SET.has(k)) return true;
  var m = k.match(/^(.+?)_(\d+)$/);
  return !!(m && _DUPL_BASES.has(m[1]));
}

// Use saved order from DB; backfill any new static sections that were added
// after the order was last saved (e.g. bundle_teaser added in a later deploy).
const _rawOrder = (Array.isArray(S.homepage_section_order) && S.homepage_section_order.length)
  ? S.homepage_section_order
  : _DEFAULT_ORDER;
const _sectionOrder = _rawOrder.slice(); // mutable copy
_DEFAULT_ORDER.forEach(function(k) {
  if (_sectionOrder.indexOf(k) === -1) {
    // Insert after its left-neighbour in _DEFAULT_ORDER, or append
    var prevKey = _DEFAULT_ORDER[_DEFAULT_ORDER.indexOf(k) - 1];
    var insertAt = prevKey ? _sectionOrder.indexOf(prevKey) + 1 : _sectionOrder.length;
    if (insertAt <= 0) insertAt = _sectionOrder.length;
    _sectionOrder.splice(insertAt, 0, k);
  }
});
%>

<% _sectionOrder.forEach(function(sectionKey) { %>
<% if (!_isValidKey(sectionKey)) { return; } %>
<% var _baseKey = sectionKey.replace(/_\d+$/, ''); var _d = S[sectionKey] || {}; %>
<%
  var _showOn   = (_d && _d.show_on) || 'all';
  var _visClass = _showOn === 'desktop' ? 'sec--desktop-only'
                : _showOn === 'mobile'  ? 'sec--mobile-only'
                : '';
%>
<% if (_visClass) { %><div class="<%= _visClass %>"><% } %>

<%# ── SCROLLING TICKER ──────────────────────────────────────────── %>
<% if (sectionKey === 'scrolling_ticker' && tick.enabled !== false && tick.items && tick.items.length) { %>
<%
  var _tickStyle = '';
  if (tick.bg_color)       _tickStyle += 'background:' + tick.bg_color + ';';
  if (tick.text_color)     _tickStyle += 'color:' + tick.text_color + ';';
  if (+tick.font_size > 0) _tickStyle += 'font-size:' + tick.font_size + 'px;';
%>
<div class="scrolling-ticker" data-section="scrolling_ticker" data-section-label="Announcement Bar" aria-label="Announcements"<%= _tickStyle ? ' style="' + _tickStyle + '"' : '' %>>
  <div class="ticker-track" style="animation-duration:<%= tick.speed_seconds || 40 %>s">
    <% var _tickItems = tick.items; %>
    <% ;[..._tickItems, ..._tickItems].forEach(function(item) { %>
    <span class="ticker-item"><%= item %></span>
    <% }) %>
  </div>
</div>
<% } /* end scrolling_ticker */ %>

<%# ── HERO ──────────────────────────────────────────────────────── %>
<% if (sectionKey === 'hero') { %>
<%
  var _heroTag    = _safeTag(hero.heading_level, 'h1');
  /* No `|| 'left'` here any more. themeSettings.js now carries
     hero.text_align: 'center' as a real default, so this is the owner's
     saved value or that default — one source either way. The old literal
     disagreed with production (which renders centre) AND with the literal
     in theme.ejs, so losing the settings file changed the homepage with
     nothing to explain it.

     _safeAlign is a sanitiser, not a second default. This value is
     interpolated straight into a <style> block, so an unexpected string
     would emit `text-align:<junk>` — or `text-align:undefined` if the key
     were ever absent. Same reasoning as _safeColor in main.ejs, which
     validates hex before injecting colours (MED-3). Only the three values
     the Theme Editor can produce are allowed through. */
  function _safeAlign(v) {
    return (v === 'left' || v === 'center' || v === 'right') ? v : 'center';
  }
  var _heroAlign  = _safeAlign(hero.text_align);
  var _heroHSize  = hero.heading_size  ? 'font-size:'+hero.heading_size+'px;' : '';
  var _heroSSize  = hero.subtext_size  ? 'font-size:'+hero.subtext_size+'px;' : '';
  var _heroH2Size = (+hero.h2_size > 0) ? 'font-size:'+hero.h2_size+'px;' : '';
  var _heroESize  = (+hero.eyebrow_size > 0 && hero.eyebrow_size != 11) ? 'font-size:'+hero.eyebrow_size+'px;' : '';
  var _heroS2Size = (+hero.sub2_size > 0 && hero.sub2_size != 14) ? 'font-size:'+hero.sub2_size+'px;' : '';
  var _heroBSize  = (+hero.badge_size > 0 && hero.badge_size != 10) ? 'font-size:'+hero.badge_size+'px;' : '';
  var _heroLayout = hero.layout || 'split';
  // Auto-switch to bg layout when video is present in split mode — Option 2 (2026-08-09)
  if (hero.video_url && _heroLayout === 'split') _heroLayout = 'bg';
  var _textPct    = parseInt(hero.text_col_pct) || 45;
  var _imgPct     = 100 - _textPct;
  var _ovColor    = hero.overlay_color || '#0f1f35';
  var _ovOp       = (hero.overlay_opacity !== undefined && hero.overlay_opacity !== '') ? (+hero.overlay_opacity / 100).toFixed(2) : '0.55';
  /* Build section inline style — CSS custom props + layout/height overrides */
  var _heroStyle  = '--ov-clr:'+_ovColor+';--ov-op:'+_ovOp+';';
  if (_heroLayout === 'split') _heroStyle += 'grid-template-columns:'+_textPct+'% '+_imgPct+'%;';
  if (+hero.height_vh > 0)           _heroStyle += 'height:'+hero.height_vh+'vh;';
  if (+hero.min_height_px > 0)       _heroStyle += 'min-height:'+hero.min_height_px+'px;';
  if (+hero.max_height_px === 0)     _heroStyle += 'max-height:none;';
  else if (+hero.max_height_px > 0)  _heroStyle += 'max-height:'+hero.max_height_px+'px;';
  /* Per-section text color CSS custom properties */
  if (hero.eyebrow_color)    _heroStyle += '--hero-eyebrow:'+hero.eyebrow_color+';';
  if (hero.heading_color)    _heroStyle += '--hero-h1:'+hero.heading_color+';';
  if (hero.h2_color)         _heroStyle += '--hero-h2:'+hero.h2_color+';';
  if (hero.subtext_color)    _heroStyle += '--hero-sub:'+hero.subtext_color+';';
  if (hero.sub2_color)       _heroStyle += '--hero-sub2:'+hero.sub2_color+';';
  /* Content box CSS vars (bg-video layout) */
  var _boxColor = hero.content_box_color || '#0f1f35';
  var _boxOp    = hero.content_box_opacity !== undefined ? hero.content_box_opacity : 60;
  var _boxHex   = _boxColor.match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})/i);
  if (_boxHex) _heroStyle += '--content-box-bg:rgba('+parseInt(_boxHex[1],16)+','+parseInt(_boxHex[2],16)+','+parseInt(_boxHex[3],16)+','+(_boxOp/100).toFixed(2)+');';
  if (+hero.content_box_padding > 0)  _heroStyle += '--content-box-pad:'+hero.content_box_padding+'px;';
  if (+hero.content_box_radius  >= 0) _heroStyle += '--content-box-radius:'+hero.content_box_radius+'px;';
  if (+hero.content_max_width   > 0)  _heroStyle += '--content-max-w:'+hero.content_max_width+'px;';
  if (hero.content_v_offset !== undefined && hero.content_v_offset !== '') _heroStyle += '--content-v-offset:'+hero.content_v_offset+'%;';
  if (hero.content_h_offset !== undefined && hero.content_h_offset !== '') _heroStyle += '--content-h-offset:'+hero.content_h_offset+'%;';
  var _ctaAlign = _heroAlign==='center'?'justify-content:center':_heroAlign==='right'?'justify-content:flex-end':'';
%>
<%/* ONE hero section, ONE <h1>. The phone hero used to be a second
    <section> carrying a second copy of the same heading, with CSS hiding
    whichever one did not apply — so the page always shipped two <h1>
    elements with identical text, one of them display:none. SEO tools
    flagged the pair, and demoting either one only moves the problem
    (whichever survives then sits inside a display:none block at the other
    viewport, which is the version search engines discount).

    Now the phone settings are an OVERRIDE LAYER on this element: a scoped
    <style> block below re-declares the custom properties at <=480px and
    swaps the background layer. Same look, one heading.

    hero--desktop-version is GONE from this class list on purpose. It
    carries display:none below 480px. Leave it here and the single hero
    vanishes on phones. See HERO_CURRENT_STATE_2026-09-13.md §3. */%>
<section id="hero-main" class="hero hero--<%= _heroLayout %><%= hero.video_on_mobile === false ? ' hero--no-mobile-video' : '' %><%= hero.mobile_image_url ? ' hero--has-mobile-img' : '' %><%= hero.text_shadow !== false ? ' hero--text-shadow' : '' %>" data-section="hero" data-section-label="Hero Banner" aria-label="Hero" style="<%= _heroStyle %>">
  <%/* NO inline text-align here. It used to carry an inline
       style="text-align:..." fed by _heroAlign, which is why the phone
       override needed !important to beat it — an inline declaration
       outranks any stylesheet rule without one.

       Both directions are now scoped rules in the <style> block below, so
       there is no conflict to resolve and no window in which the wrong
       alignment can paint. Measured at 412px: the copy moves up to 65px
       sideways between left and centre (h2 worst), and CLS counts
       horizontal movement exactly like vertical. Same treatment applied
       to .hero-ctas, which had the same inline pattern. */%>
  <div class="hero-content">
    <div class="hero-content-box">
      <p class="hero-eyebrow" style="<%= _heroESize %>"><%= hero.eyebrow || 'Curated for Your Bathroom Renovation' %></p>
      <<%- _heroTag %> class="hero-h1" style="<%= _heroHSize %>"><%= hero.heading_line1 || 'Premium Vanities.' %></<%- _heroTag %>>
      <p class="hero-h2" style="<%= _heroH2Size %>"><%= hero.heading_line2 || 'Outlet Prices.' %></p>
      <div class="hero-rule" aria-hidden="true"></div>
      <p class="hero-sub" style="<%= _heroSSize %>"><%= hero.subtext || 'Top brands, delivered free to your door.' %></p>
      <p class="hero-sub2" style="<%= _heroS2Size %>"><%= hero.sub2_text || 'James Martin · Kohler · Moen · Delta and more' %></p>
      <%/* inline style removed — see the note on .hero-content above */%>
      <div class="hero-ctas">
        <a href="<%= hero.cta1_url || '/collections/bathroom-vanities' %>" class="btn btn-navy"><%= hero.cta1_text || 'Shop Vanities' %></a>
        <% if (hero.cta2_text || hero.cta2_url) { %>
        <a href="<%= hero.cta2_url || '/collections/sale' %>" class="btn btn-sage"><%= hero.cta2_text || 'View Sale' %></a>
        <% } %>
      </div>
    </div>
  </div>
  <div class="hero-image hero-layer--desktop">
    <div class="hero-overlay" aria-hidden="true"></div>
    <%/* Desktop image — always rendered with hero-poster class for consistent mobile CSS targeting.
        Gets hero-img-desktop class only when a separate mobile image is set, so CSS can swap them.

        NOTE there are TWO separate "image on small screens" mechanisms and
        they are not the same thing:
          hero.mobile_image_url      swaps this <img> at <=860px
          hero_mobile.image_url      swaps the whole layer at <=480px
        Both still work. See HERO_CURRENT_STATE_2026-09-13.md §6. */%>
    <%/* This whole layer is display:none at <=480px whenever the phone layer
         exists (hero_mobile enabled), but an eager <img> downloads anyway —
         measured 2026-09-22: 44KB fetched on a phone that never shows it, and
         it lands mid-LCP, competing with the phone hero for bandwidth on a
         slow connection. So when the phone layer is on, each image here goes
         in a <picture> whose <source> is min-width:481px; narrower screens
         fall through to a 1x1 GIF and fetch nothing. When hero_mobile is OFF
         this layer IS the phone hero, so it stays a plain <img>.
         Mirror of the same treatment on the phone layer below. */%>
    <% var _dkGate = (S.hero_mobile || {}).enabled !== false;
       var _blankPx = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'; %>
    <% if (hero.image_url) { %>
    <%/* fetchpriority: on desktop THIS tag is the LCP element, and it carried
         loading="eager" with no priority hint. The mobile layer already has one. */%>
    <% var _hsDesk = _heroSrcset(hero.image_url);
       var _dkAlt  = hero.image_alt || (S.global || {}).site_name || 'Bathroom Vanities Outlet - Quality Bath Vanity Cabinets and More'; %>
    <% if (_dkGate) { %>
    <picture>
      <source media="(min-width: 481px)" srcset="<%= _hsDesk || hero.image_url %>"<% if (_hsDesk) { %> sizes="100vw"<% } %>>
      <img class="hero-poster<%= hero.mobile_image_url ? ' hero-img-desktop' : '' %>"
           fetchpriority="high" decoding="async" src="<%= _blankPx %>"
           alt="<%= _dkAlt %>" loading="eager">
    </picture>
    <% } else { %>
    <img class="hero-poster<%= hero.mobile_image_url ? ' hero-img-desktop' : '' %>"
         fetchpriority="high" decoding="async"
         src="<%= hero.image_url %>"
         <% if (_hsDesk) { %>srcset="<%= _hsDesk %>" sizes="100vw"<% } %>
         alt="<%= _dkAlt %>"
         loading="eager">
    <% } %>
    <% } %>
    <%/* Mobile image — hidden on desktop, swaps in at ≤860px when set */%>
    <% if (hero.mobile_image_url) { %>
    <% var _hsMob = _heroSrcset(hero.mobile_image_url);
       var _mbAlt = hero.mobile_image_alt || hero.image_alt || (S.global || {}).site_name || 'Bathroom Vanities Outlet - Quality Bath Vanity Cabinets and More'; %>
    <% if (_dkGate) { %>
    <picture>
      <source media="(min-width: 481px)" srcset="<%= _hsMob || hero.mobile_image_url %>"<% if (_hsMob) { %> sizes="100vw"<% } %>>
      <img class="hero-img-mobile" src="<%= _blankPx %>" alt="<%= _mbAlt %>" loading="eager" decoding="async">
    </picture>
    <% } else { %>
    <img class="hero-img-mobile"
         src="<%= hero.mobile_image_url %>"
         <% if (_hsMob) { %>srcset="<%= _hsMob %>" sizes="100vw"<% } %>
         alt="<%= _mbAlt %>"
         loading="eager">
    <% } %>
    <% } %>
    <%/* Video — only when video_url is set */%>
    <% if (hero.video_url) { %>
      <% if (_isYT(hero.video_url)) { var _ytVid = _ytId(hero.video_url); %>
        <% if (_ytVid) { %>
        <div class="hero-video-wrap">
          <%/* data-src instead of src — JS injects after window.load so YouTube never blocks FCP */%>
          <iframe class="hero-video-iframe" data-hero-video="yt"
            data-src="https://www.youtube-nocookie.com/embed/<%= _ytVid %>?autoplay=1&mute=1&loop=1&controls=0&playlist=<%= _ytVid %>&rel=0&showinfo=0&modestbranding=1&playsinline=1&cc_load_policy=0&iv_load_policy=3&fs=0&disablekb=1"
            allow="autoplay; encrypted-media; picture-in-picture" frameborder="0" aria-hidden="true" tabindex="-1" title="Hero background video">
          </iframe>
        </div>
        <% } %>
      <% } else { %>
      <video class="hero-video-player" data-hero-video="mp4" autoplay muted loop playsinline preload="metadata">
        <source src="<%= hero.video_url %>" type="video/mp4">
      </video>
      <% } %>
    <% } %>
    <% if (!hero.image_url && !hero.mobile_image_url && !hero.video_url) { %>
    <div class="hero-img-placeholder" aria-hidden="true">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      <span>Hero image</span>
    </div>
    <% } %>
  </div>

<%# ── PHONE OVERRIDE LAYER (≤480px) — same section, no second heading ── %>
<%
  /* ── The phone hero, as an override layer ──────────────────────
     Every value below used to build a SECOND <section> containing a second
     copy of the heading, subtext and CTAs. It now builds a scoped CSS rule
     applied to this same section below 480px instead.

     What that costs: nothing the admin can reach. The Theme Editor's
     hero_mobile panel exposes fourteen fields and every one is styling —
     image, video, layout, alignment, heights, overlay, content box. It has
     no text field at all. The text keys that exist in the defaults
     (heading_line1, eyebrow, cta1_text …) can only be set by hand-editing
     JSON, and each one falls back to its desktop twin when blank, so with
     nothing configured every phone string already resolved to the desktop
     string. The two <h1> elements were identical by construction.

     Inventory of what the panel offers, and of the unreachable keys:
     HERO_CURRENT_STATE_2026-09-13.md §5. */
  var _hm       = S.hero_mobile || {};
  var _hmEna    = (_hm.enabled !== false);
  var _hmAlign  = _hm.text_align || 'center';
  var _hmLayout = _hm.layout || 'bg';
  if (_hm.video_url && _hmLayout === 'split') _hmLayout = 'bg';  // matches the desktop auto-switch

  /* ── Layout emulation at phone width — DO NOT DELETE ──────────────
     The section can only carry one layout class, and it carries the
     DESKTOP one. When the phone layout differs we have to reproduce its
     rules here, scoped to the id.

     I first talked myself out of this on the grounds that site4.css forces
     .hero--split into the same image-behind-text arrangement as .hero--bg
     below 860px. That is true of .hero-image and FALSE of .hero-content,
     which is the half I did not check:

       bg    @media (max-width:519px)
             .hero--bg .hero-content{display:flex;align-items:center;
               justify-content:flex-start;padding:0 5% 0 var(--content-h-offset,5%)}
       split @media (max-width:860px)
             .hero--split .hero-content{justify-content:flex-end!important;
               padding-bottom:56px!important}

     bg centres the copy; split pushes it to the bottom with 56px of
     padding. A desktop-split / phone-bg site — which is the default — would
     have had its phone hero copy jump to the bottom of the image. The
     render-and-compare caught it; reading the CSS did not.

     !important on the overrides is required: site4.css marks its rules
     !important, so specificity alone loses. #hero-main .hero-content is
     (1,0,1) against .hero--split .hero-content at (0,2,0), so with both
     sides !important the id wins. */
  var _hmLayoutCss = '';
  if (_hmEna && _hmLayout === 'bg' && _heroLayout !== 'bg') {
    _hmLayoutCss =
      '#hero-main{grid-template-columns:1fr!important;grid-template-rows:1fr}' +
      '#hero-main .hero-content{grid-row:1;grid-column:1;position:relative!important;' +
        'z-index:2!important;display:flex;flex-direction:row;align-items:center;' +
        'justify-content:flex-start!important;padding:0 5% 0 var(--content-h-offset,5%)!important}' +
      '#hero-main .hero-image{grid-row:1;grid-column:1;position:absolute!important;inset:0!important;z-index:0}';
  }
  /* ── 'stacked' — photo in row 1, copy in row 2, nothing overlapping ──
     The other two layouts put the copy ON the image. This one puts it
     under, so the photo is never covered and the copy never needs a scrim
     to be readable.

     Three things are switched off because in this layout they have no job,
     not because a setting is being overruled:

       .hero-overlay        exists to darken the photo UNDER the copy
       .hero-image::after   a bottom gradient, same purpose
       height / min-height  the section sizes to its two rows instead

     Everything that is still a real choice is left to the editor. The
     content box keeps --content-box-bg, side padding keeps
     --content-h-offset, and hero_mobile.text_shadow is respected exactly
     as set — a shadow over cream looks muddy, but that is one tick in the
     Theme Editor and not something to hardcode away here.

     NO ASPECT RATIO IS SET. height:auto on the image plus object-fit:contain
     means the shape comes from whatever crop the image URL asks Bunny for
     (?crop=W,H,X,Y). Pin a ratio here and it fights the URL silently.

     content_v_offset is neutralised: it shifts the copy vertically WITHIN
     the image, and here the copy has its own row.

     EMITTED AT <=860, NOT <=480 — which is why it is its own variable and
     not part of _hmLayoutCss. _hmLayoutCss goes into the phone-only block;
     this has to reach the tablet band too.

     Consequence worth knowing: between 481 and 860 the phone image layer is
     hidden (.hero-layer--mobile) AND its <picture><source> is capped at
     480px, so the element stacked in that band is the DESKTOP .hero-image
     carrying hero.image_url. hero_mobile.image_url — and therefore any
     ?crop= on it — applies at <=480 only. Both are matched by the
     #hero-main .hero-image selectors below, so both stack correctly; they
     just show different pictures. */
  var _hmStackCss = '';
  if (_hmEna && _hmLayout === 'stacked') {
    _hmStackCss =
      '#hero-main{grid-template-columns:1fr!important;grid-template-rows:auto auto!important;' +
        'height:auto!important;min-height:0!important;max-height:none!important}' +
      '#hero-main .hero-image{grid-row:1;grid-column:1;position:relative!important;' +
        'inset:auto!important;z-index:0;width:100%;height:auto!important}' +
      /* position:relative is the load-bearing one, not height. .hero-poster
           is position:absolute;inset:0 (site-bundle.css), so the <img> is out
           of flow and .hero-image{height:auto} collapses to ZERO — measured
           live at 768px on 54574bb: natural 768x444, rendered 0x0, grid row
           0px. Releasing height alone does nothing; the image has to be put
           back in normal flow first.

           Note this layer can hold TWO <img> elements — .hero-poster and,
           when hero.mobile_image_url is set, .hero-img-mobile which replaces
           it at <=860. The bare `img` selector is deliberate so it catches
           whichever one is displayed. */
      '#hero-main .hero-image img{position:relative!important;inset:auto!important;' +
        'width:100%!important;height:auto!important;object-fit:contain!important}' +
      '#hero-main .hero-image::after{display:none!important}' +
      '#hero-main .hero-overlay{display:none!important}' +
      '#hero-main .hero-content{grid-row:2;grid-column:1;position:relative!important;' +
        'z-index:2!important;display:block!important;transform:none!important;' +
        'padding:var(--content-box-pad,28px) var(--content-h-offset,5%)!important}' +
      /* The content BOX is dismantled here, not just widened.
         .hero-content-box is max-width:var(--content-max-w,520px);width:100%
         with a translucent background, blur, radius and its own padding —
         every one of those describes a panel floating ON a photo.

         Measured live at 700px before this: the box was 320px wide (the
         configured content_max_width) and pinned hard LEFT, 21px one side
         and 359px of empty page the other, because a width:100% block with
         a max-width and no auto margins does not centre.

         So in stacked it stops being a box: no background, no blur, no
         radius, no cap, no transform. Padding moves to .hero-content above,
         where --content-h-offset still governs the side gap.

         Four more settings go quiet in this layout for the same reason the
         overlay does — content_max_width, content_box_color,
         content_box_opacity, content_box_radius all configure a panel that
         no longer exists. Documented in the Theme Editor hint. */
      '#hero-main .hero-content-box{max-width:none!important;width:100%!important;' +
        'background:none!important;backdrop-filter:none!important;' +
        '-webkit-backdrop-filter:none!important;border-radius:0!important;' +
        'padding:0!important;transform:none!important}';
  }
  /* Font sizes need !important: the desktop values are INLINE styles on each
     element, and an inline style beats a media-query rule of any specificity.
     Without it the phone type sizes silently stop applying. */
  var _hmFont   = '';
  if (+_hm.heading_size > 0) _hmFont += '#hero-main .hero-h1{font-size:'+(+_hm.heading_size)+'px!important}';
  if (+_hm.h2_size      > 0) _hmFont += '#hero-main .hero-h2{font-size:'+(+_hm.h2_size)+'px!important}';
  if (+_hm.subtext_size > 0) _hmFont += '#hero-main .hero-sub{font-size:'+(+_hm.subtext_size)+'px!important}';
  if (+_hm.sub2_size    > 0) _hmFont += '#hero-main .hero-sub2{font-size:'+(+_hm.sub2_size)+'px!important}';
  if (+_hm.eyebrow_size > 0) _hmFont += '#hero-main .hero-eyebrow{font-size:'+(+_hm.eyebrow_size)+'px!important}';
  var _hmStyle  = '';
  /* _hmCtaAl is computed OUTSIDE the _hmEna gate on purpose. It is a pure
     function of _hmAlign, and the <=860 alignment block below runs whether
     or not the mobile hero is enabled — leave it inside and the disabled
     case gets aligned text with unaligned buttons, which is the exact
     split this change was made to remove. */
  var _hmCtaAl  = _hmAlign==='center' ? 'justify-content:center'
                : _hmAlign==='right'  ? 'justify-content:flex-end' : '';
  if (_hmEna) {
    var _hmOvClr  = _hm.overlay_color || '#0f1f35';
    var _hmOvOp   = (_hm.overlay_opacity !== undefined) ? (+_hm.overlay_opacity / 100).toFixed(2) : '0.55';
    _hmStyle = '--ov-clr:'+_hmOvClr+';--ov-op:'+_hmOvOp+';';
    if (+_hm.height_vh > 0)           _hmStyle += 'height:'+_hm.height_vh+'vh;';
    if (+_hm.min_height_px > 0)       _hmStyle += 'min-height:'+_hm.min_height_px+'px;';
    if (+_hm.max_height_px === 0)     _hmStyle += 'max-height:none;';
    else if (+_hm.max_height_px > 0)  _hmStyle += 'max-height:'+_hm.max_height_px+'px;';
    if (_hm.eyebrow_color)  _hmStyle += '--hero-eyebrow:'+_hm.eyebrow_color+';';
    if (_hm.heading_color)  _hmStyle += '--hero-h1:'+_hm.heading_color+';';
    if (_hm.h2_color)       _hmStyle += '--hero-h2:'+_hm.h2_color+';';
    if (_hm.subtext_color)  _hmStyle += '--hero-sub:'+_hm.subtext_color+';';
    if (_hm.sub2_color)     _hmStyle += '--hero-sub2:'+_hm.sub2_color+';';
    var _hmBoxClr = _hm.content_box_color || '#0f1f35';
    var _hmBoxOp  = (_hm.content_box_opacity !== undefined) ? _hm.content_box_opacity : 60;
    var _hmBoxHx  = String(_hmBoxClr).match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})/i);
    if (_hmBoxHx) _hmStyle += '--content-box-bg:rgba('+parseInt(_hmBoxHx[1],16)+','+parseInt(_hmBoxHx[2],16)+','+parseInt(_hmBoxHx[3],16)+','+(_hmBoxOp/100).toFixed(2)+');';
    if (+_hm.content_box_padding > 0)  _hmStyle += '--content-box-pad:'+_hm.content_box_padding+'px;';
    if (+_hm.content_box_radius  >= 0) _hmStyle += '--content-box-radius:'+_hm.content_box_radius+'px;';
    if (+_hm.content_max_width   > 0)  _hmStyle += '--content-max-w:'+_hm.content_max_width+'px;';
    if (_hm.content_v_offset !== undefined && _hm.content_v_offset !== '') _hmStyle += '--content-v-offset:'+_hm.content_v_offset+'%;';
    if (_hm.content_h_offset !== undefined && _hm.content_h_offset !== '') _hmStyle += '--content-h-offset:'+_hm.content_h_offset+'%;';
  }
  /* Image and video only. The text variables that used to live here —
     _hmEye, _hmH1, _hmH2, _hmSub, _hmSub2, _hmBadge, _hmC1T/_hmC1U,
     _hmC2T/_hmC2U — are gone. Each was `_hm.x || hero.x`, and since no
     editor field can set `_hm.x`, each resolved to the desktop value on
     every render. They existed only to fill a duplicate copy of the
     heading block. */
  var _hmImg   = _hm.image_url     || hero.image_url     || '';
  /* Derived ONCE, here, because two separate consumers need it and they sit
     on opposite sides of the template: the <style> block emits an
     aspect-ratio from it, and the <img> further down emits width/height
     from it. It used to be declared down beside the <img>; computing it
     there and reading it up here would silently yield `undefined` (var
     hoists the declaration, not the assignment) and the CSS rule would
     never be emitted — a failure with no error and no visible symptom
     until a phone hit a cold cache. One fact, one place. */
  var _hmBox   = _heroBox(_hmImg, _hm.image_aspect);
  var _hmAlt   = _hm.image_alt     || hero.image_alt     || 'Hero';
  var _hmVid   = _hm.video_url     || '';
  var _hmShad  = (_hm.text_shadow !== false);
%>
<%/* ══════════════════════════════════════════════════════════════════
     LCP PRELOAD — the hero image, requested from <head> instead of from
     the middle of the body.

     WHY

     Measured on production 2026-09-23: TTFB landed, then nothing was
     requested for ~490 ms, and the hero — the LCP element — did not start
     until ~677 ms. Nothing was slow. The browser simply did not know the
     image existed until the parser reached the <picture> below, behind
     264 KB of HTML and two render-blocking stylesheets. fetchpriority on
     the <img> does not help with that: it ranks a request that has not
     been discovered yet.

     WHY IT CAN LIVE HERE RATHER THAN IN THE LAYOUT

     server.js sets `layout extractStyles`, and express-ejs-layouts'
     extractor (lib/express-layouts.js:36) matches ANY <link ...>, not only
     rel=stylesheet. So these are lifted out of the body and emitted at the
     `style` slot in main.ejs line 168, which sits inside <head>. That keeps
     the srcset ladder in ONE place — recomputed from _heroSrcset() right
     here — instead of duplicating it into the controller or the layout.

     ⚠ THE MEDIA QUERIES MUST MATCH THE THREE LAYERS EXACTLY

     A preload whose media does not match what the page shows downloads a
     file the visitor never sees. That has already happened twice on this
     hero — see the comments at the desktop layer and the phone layer, both
     recording eager <img> tags that fetched on viewports where they were
     display:none. A mismatched preload is the same waste, moved earlier.

     What each viewport actually renders:

       <= 480px   .hero-layer--mobile   _hmImg                (when _hmEna)
       481-860    .hero-img-mobile      hero.mobile_image_url (CSS swap)
       >= 861     .hero-img-desktop     hero.image_url

     When mobile_image_url is unset the middle and top bands resolve to the
     same file, so the second and third links carry the same href. Only one
     media query can match, so the browser still fetches once.

     imagesizes MUST stay "100vw" to match the sizes= on every <source>. If
     they disagree the browser picks a different rung for the preload than
     for the image, and the page downloads the hero twice. */%>
<%
  /* Recomputed, not reused: _hsDesk/_hsMob are assigned further down the
     template and are still undefined at this point. */
  var _plPhone   = _hmEna ? _hmImg : '';
  var _plMid     = hero.mobile_image_url || hero.image_url || '';
  var _plWide    = hero.image_url || '';
  var _plPhoneSs = _heroSrcset(_plPhone);
  var _plMidSs   = _heroSrcset(_plMid);
  var _plWideSs  = _heroSrcset(_plWide);
%>
<% if (_plPhone) { %>
<link rel="preload" as="image" fetchpriority="high" media="(max-width: 480px)"
      href="<%= _plPhone %>"<% if (_plPhoneSs) { %> imagesrcset="<%= _plPhoneSs %>" imagesizes="100vw"<% } %>>
<% } %>
<% if (_plMid) { %>
<link rel="preload" as="image" fetchpriority="high" media="(min-width: 481px) and (max-width: 860px)"
      href="<%= _plMid %>"<% if (_plMidSs) { %> imagesrcset="<%= _plMidSs %>" imagesizes="100vw"<% } %>>
<% } %>
<% if (_plWide) { %>
<link rel="preload" as="image" fetchpriority="high" media="(min-width: 861px)"
      href="<%= _plWide %>"<% if (_plWideSs) { %> imagesrcset="<%= _plWideSs %>" imagesizes="100vw"<% } %>>
<% } %>
<% if (_hmEna) { %>
<style>
  /* Phone overrides for #hero-main. Scoped to the id so nothing else on the
     page can be caught by it. Inline styles are allowed by the CSP
     (styleSrc carries 'unsafe-inline', src/server.js:74) and index.ejs
     already ships inline <style> blocks.

     480px is not an arbitrary number — it is the breakpoint the two heroes
     used to swap at, so keeping it means the phone look changes at exactly
     the width it always did. Note it does NOT line up with the other hero
     breakpoints (519, 720, 860); that mismatch predates this change and is
     documented in HERO_CURRENT_STATE_2026-09-13.md §3. Do not "tidy" these
     numbers without testing the 481–519 band. */
  #hero-main .hero-layer--mobile{display:none}
  @media (max-width:480px){
    <%/* !important on every phone declaration: the desktop panel writes the
         same properties as an inline style="" on #hero-main, and inline beats
         any stylesheet rule without !important — so every phone field the
         desktop panel also sets (padding, offsets, max width, colours, box
         colour, heights) was silently ignored on phones. */%>
    #hero-main{<%= _hmStyle.split(';').filter(Boolean).map(function (d) { return d + ' !important;'; }).join('') %>}
    #hero-main .hero-layer--desktop{display:none}
    #hero-main .hero-layer--mobile{display:block}
    <%- _hmLayoutCss %>
    <%/* Alignment is NOT set here. It is the one declaration that must also
         cover the 481-860 tablet band, so it lives in its own block below,
         outside the _hmEna gate. */%>
    <%- _hmFont %>
    <% if (!_hmShad) { %>#hero-main .hero-h1,#hero-main .hero-h2,#hero-main .hero-sub,#hero-main .hero-sub2,#hero-main .hero-eyebrow{text-shadow:none}<% } %>
  }
</style>
<% } %>
<style>
  <%/* ── Mobile alignment — the single canonical control ───────────────
       Source: hero_mobile.text_align. Retired 2026-09-23:
       hero.text_align_mobile, which wrote --hero-mobile-align onto .hero
       and was read by a `.hero{text-align:…!important}` rule at <=860.

       Why that one lost, measured on the live page at 375px before the
       change: .hero-content carries an INLINE style="text-align:left"
       (the desktop value), and an inline declaration beats any stylesheet
       rule that is not !important — so the copy stayed left. Meanwhile
       .hero-ctas has no inline style, so the CTA rule DID apply and the
       buttons sat centred. Text left, buttons centred, on every phone.

       Two things fix it and both are required:
         1. !important, to beat the inline text-align on .hero-content.
         2. <=860 rather than <=480, so the tablet band is covered too —
            this is the one thing the retired setting did better.

       NOT gated on _hmEna. With the mobile hero switched off the desktop
       markup still renders on a phone and still needs aligning; the old
       setting covered that case and this must too.

       Deliberately outside the <=480 block above: that block carries the
       phone-only overrides and widening it to 860 would push padding,
       offsets, heights and box colours onto tablets. See the note at the
       top of that block about 480 being load-bearing. */%>
  <%/* Desktop alignment. This used to be an inline style="" on the element,
       which is what forced the !important below — inline beats any rule
       without one. As a scoped rule at (1,0,1) it beats everything in
       site-bundle.css, which carries no competing text-align for
       .hero-content (checked), and loses cleanly to the !important in the
       <=860 block. One declaration wins at every width, with no conflict
       to resolve after paint. */%>
  #hero-main .hero-content{text-align:<%= _heroAlign %>}
  <% if (_ctaAlign) { %>#hero-main .hero-ctas{<%= _ctaAlign %>}<% } %>
  <%/* Reserve the phone hero's box with a CSS aspect-ratio, not just the
       width/height attributes.

       WHY THE ATTRIBUTES ARE NOT ENOUGH. width/height set
       `aspect-ratio: auto W/H`, and the `auto` keyword means "defer to the
       intrinsic ratio whenever the image has one". This <img> carries a 1x1
       transparent GIF in src (deliberately — the real file comes from
       <source srcset>, and the blank keeps desktop from downloading the
       phone image). A data: URI resolves instantly, so the element HAS a
       real intrinsic ratio of 1:1 from the very first layout, and it beats
       the attributes.

       MEASURED on the live page at 412px, 2026-09-23:
           before the real image lands   img 412x412, .hero-content at y=412
           after                         img 412x329, .hero-content at y=329
       an 83px jump. A bare `aspect-ratio` (no `auto`) outranks the intrinsic
       ratio, so the box is correct from first paint. Re-measured with the
       rule applied: 412x329 both before and after, shift 0.

       This is why 4ba4897 changed nothing — the attributes it added were
       never going to win. Lighthouse calling this an "Unsized image
       element" despite visible width/height was correct.

       DERIVED, not hardcoded: same _hmBox as the attributes, read from
       ?crop= in the image URL with hero_mobile.image_aspect as the stated
       fallback. One fact, one source. */%>
  <%/* REWRITTEN 2026-09-23, second attempt. The first one did not work and
       the way it was verified is why.

       WHAT WAS WRONG. The rule was `aspect-ratio` on the <img>, scoped to
       480px. Two defects:

         1. WRONG BREAKPOINT. The stacked layout runs to 860px, not 480.
            Between 481 and 860 the image sits in flow with nothing holding
            its height — every tablet and landscape phone still shifted.
         2. WRONG ELEMENT. Above 480px the visible image is .hero-img-mobile
            (see the band table above), which that selector never reached and
            which carries no width/height either.

       WHY IT ALSO FAILED AT 412px, INSIDE ITS OWN BAND. `aspect-ratio` on
       the <img> has to beat the intrinsic ratio of whatever is currently
       loaded — and src is a 1x1 GIF that resolves instantly. That argument
       is won on a warm load and lost on a cold one.

       HOW IT SLIPPED THROUGH. It was verified in a browser where the hero
       image was already CACHED. With the image loaded the box is correct
       from its intrinsic size whether or not this rule does anything — the
       check proved the box is right when it cannot be wrong. The only state
       that matters, image absent, was never tested on the real page.

       THE FIX. Reserve on the WRAPPER, not the image. .hero-image is a
       plain block with a definite width from the 1fr grid track and no
       intrinsic size of its own, so nothing about image loading can defeat
       it. The <img> then fills a box that already exists.

       MEASURED, SpeedVitals, cold, 4G, twice:

         412x660   content 412x329 moved y=145 -> y=474
                   distance 329/660 = 0.4985
                   impact   (660-145)/660 = 0.780      score 0.389
                                                    reported 0.3892

         412x823   distance 329/823 = 0.400
                   impact   (803-145)/823 = 0.799      score 0.3196
                   (PSI, Moto G Power)              reported 0.321

       One cause, both viewports, to three decimals. The bimodal 0.321-or-0
       was simply cache hit versus cache miss, which is also why seven
       warm-running tools reported 0 and were believed over the two cold
       ones.

       TWO RATIOS, NOT ONE, because the bands show different files:
         <=480    _hmBox      from _hmImg  (hero_mobile.image_url or hero)
         481-860  _mbBox      from hero.mobile_image_url
       When mobile_image_url is unset both resolve to the same file and the
       two rules carry the same ratio. A ratio taken from the wrong file
       would be worse than none — it would shift twice. */%>
  <%/* FIXED 2026-09-23. The stated-aspect fallback must describe the SAME
       file the URL argument points at. It did not:

         url      hero.mobile_image_url   the uncropped hero, 1604x927
         aspect   hero_mobile.image_aspect  describes the ?crop= 1160x927

       Two different files. Because the uncropped URL carries no ?crop= and
       the aspect handed to it belonged to the other file, _heroBox returned
       null, no rule was emitted, and 481-860 reserved 1px. MEASURED cold
       with the hero image stripped: box 1px, .hero-content at y=146 instead
       of its settled position — the 0.3892 shift 45ff9c9 was meant to end.

       Returning null was luck, not safety. Had hero_mobile.image_aspect been
       set while mobile_image_url pointed at a differently-shaped file, this
       would have emitted a box of the WRONG shape, which shifts twice. So
       each URL is now paired with the aspect that describes it. */%>
  <% var _mbBox = hero.mobile_image_url
       ? _heroBox(hero.mobile_image_url, hero.mobile_image_aspect)
       : _heroBox(_hmImg, (_hm || {}).image_aspect); %>
  <%/* min-height ALONGSIDE aspect-ratio, added 2026-09-23.

       aspect-ratio can only produce a height once the element's own width
       is resolved. Until then it contributes nothing and the box is ZERO —
       not wrong, zero. That is the one state consistent with both of the
       measurements I have, which otherwise contradict each other:

         mine, warm, image stripped   box 329px   .hero-content y=474
         SpeedVitals, cold, 4G        box   0     .hero-content y=145 @1359ms

       min-height in vw does not depend on width resolution, so it holds a
       box in exactly the window where aspect-ratio cannot. Both express the
       same height, so once width resolves they agree and neither wins:

         100vw * 927/1160 = 329.1px at 412w   <- matches the measured box

       SCOPED TO <=480 ON PURPOSE. It is only safe where the wrapper really
       is viewport-width, and 412px is the only band where I measured that
       (wrapper width 412 = viewport 412). Applying it to 481-860 without
       measuring the width there could OVER-reserve, which shifts the other
       way and is worse than the bug. */%>
  <% if (_hmBox) { %>
  @media (max-width:480px){
    #hero-main .hero-image.hero-layer--mobile{
      aspect-ratio:<%= _hmBox.w %>/<%= _hmBox.h %>;
      min-height:calc(100vw * <%= _hmBox.h %> / <%= _hmBox.w %>)
    }
  }
  <% } %>
  <% if (_mbBox) { %>
  @media (min-width:481px) and (max-width:860px){
    #hero-main .hero-image.hero-layer--desktop{aspect-ratio:<%= _mbBox.w %>/<%= _mbBox.h %>}
  }
  <% } %>
  @media (max-width:860px){
    #hero-main .hero-content{text-align:<%= _hmAlign %>!important}
    <% if (_hmCtaAl) { %>#hero-main .hero-ctas{<%= _hmCtaAl %>!important}<% } %>
    <%/* The stacked layout also lives at <=860, per the same reasoning: the
         481-860 band is a phone-shaped viewport and wants the same one-column
         treatment. Emitted after the alignment rules so the padding override
         below wins over nothing — they touch different properties. */%>
    <%- _hmStackCss %>
  }
  <%/* THE ROW, not the item. Added 2026-09-23 on Sam's read of it, which
       was right where mine was not.

       _hmStackCss above sets grid-template-rows:auto auto. `auto` means the
       row is whatever its contents turn out to be — and until the image has
       resolved a height, that is ZERO. Everything reserved on .hero-image
       (aspect-ratio, min-height) only helps once the ITEM sizes itself; the
       ROW is what holds .hero-content down, and an auto row holds nothing.

       MEASURED, all CSS applied, 412x660:
           #hero-main  grid-template-rows: 329.234px 329.156px
                                           ^ image    ^ text
       SpeedVitals, cold, same viewport:
           .hero-content y=145  ->  y=474      145 = header + announcement
                                               474 = 145 + 329 (the row)
       Row 1 is 0 at first paint and 329 afterwards. That is the shift,
       and it is why every box I reserved on the item left it unchanged.

       An explicit row height exists before anything inside it resolves, so
       there is no window where the row is zero. Same number as the item's
       box, so the two never disagree.

       <=480 ONLY, on purpose: 100vw is correct only where the grid column
       is viewport-width, and 412px is the only band where that is measured
       (wrapper 412 = viewport 412). Emitted after _hmStackCss so it beats
       that rule's !important auto auto — same specificity, later wins. */%>
  <% if (_hmStackCss && _hmBox) { %>
  @media (max-width:480px){
    #hero-main{grid-template-rows:calc(100vw * <%= _hmBox.h %> / <%= _hmBox.w %>) auto!important}
  }
  <% } %>
  <%/* Same treatment for the tablet band. Held back on the first pass
       because 100vw is only correct where the grid column is
       viewport-width and I had measured that at 412px only. Now measured
       across the whole band, hero image stripped:

           width   hero width   full-bleed   image row   row/width
            500       500          yes          289        1.730
            650       650          yes          376        1.730
            768       768          yes          444        1.730
            820       820          yes          474        1.730
            860       860          yes          497        1.730

       Full-bleed at every width, so 100vw holds. 1.730 is 1604/927 — the
       UNCROPPED hero file, which is what this band shows; the <=480 band
       shows the ?crop=1160,927 version, which is why the two bands carry
       different ratios and why borrowing one for the other would shift
       twice.

       aspect-ratio reads `auto` at all five widths, so the row is
       unreserved here exactly as it was on the phone. Driven by _mbBox so
       it states the shape of the file this band actually shows. */%>
  <% if (_hmStackCss && _mbBox) { %>
  @media (min-width:481px) and (max-width:860px){
    #hero-main{grid-template-rows:calc(100vw * <%= _mbBox.h %> / <%= _mbBox.w %>) auto!important}
  }
  <% } %>
  <% if (_hmStackCss) { %>
  <%/* Line-length cap, stacked only, wide end of the band only.
       Full-bleed is right on a phone. At 860px it is not: the copy would
       run ~790px, roughly 120 characters a line, against the 60-75 that
       reads comfortably. So the text stretches with the screen up to
       600px and then stops, centred, at 680px.

       A SEPARATE @media rather than a nested one. The rule above lives in
       a max-width block and plain CSS cannot nest @media inside @media —
       only CSS Nesting can, and not everywhere. Two sibling blocks always
       work.

       margin-inline is not used: the box already carries margin
       declarations from the base sheet, and left/right auto is the pair
       that actually overrides them. */%>
  @media (min-width:601px) and (max-width:860px){
    #hero-main .hero-content-box{max-width:680px!important;margin-left:auto!important;margin-right:auto!important}
  }
  <% } %>
</style>
<%/* The phone background layer. Same section, no heading, no CTAs — those
    are in the single .hero-content block above and are shared by both
    viewports. display:none above 480px, so above that width this element
    takes no grid slot and the split layout keeps its two columns. */%>
<% if (_hmEna) { %>
  <div class="hero-image hero-layer--mobile">
    <div class="hero-overlay" aria-hidden="true"></div>
    <% if (_hmImg) { %>
    <% var _hsHm = _heroSrcset(_hmImg); %>
    <%/* <picture> so ONLY phones download this. As a plain eager <img> it was
         fetched on desktop too (display:none does not stop an eager image),
         at the 1604w rung ~158KB, competing with the real desktop LCP image.
         The <source> matches the 480px layer breakpoint above; wider screens
         fall through to the 1x1 GIF and fetch nothing. */%>
    <%/* _hmBox is derived once, up beside _hmImg — see the note there. */%>
    <%/* width/height go on the <img>, not the <source>. Per the HTML spec the
         img's attributes establish the default aspect ratio for the whole
         <picture>, and with CSS width:100%;height:auto that reserves a
         correctly-shaped box before the bytes land. Omitted entirely when
         neither the URL nor the setting states a shape — a wrong box is
         worse than none, because it shifts twice. */%>
    <picture>
      <source media="(max-width: 480px)" srcset="<%= _hsHm || _hmImg %>"<% if (_hsHm) { %> sizes="100vw"<% } %>>
      <img class="hero-poster" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
           <% if (_hmBox) { %>width="<%= _hmBox.w %>" height="<%= _hmBox.h %>" <% } %>alt="<%= _hmAlt %>" loading="eager" fetchpriority="high" decoding="async">
    </picture>
    <% } else { %>
    <div class="hero-img-placeholder" aria-hidden="true">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      <span>Upload mobile hero image</span>
    </div>
    <% } %>
    <% if (_hmVid) { %>
      <% if (_isYT(_hmVid)) { var _hmYtId = _ytId(_hmVid); %>
        <% if (_hmYtId) { %>
        <div class="hero-video-wrap">
          <iframe class="hero-video-iframe" data-hero-video="yt"
            data-src="https://www.youtube-nocookie.com/embed/<%= _hmYtId %>?autoplay=1&mute=1&loop=1&controls=0&playlist=<%= _hmYtId %>&rel=0&showinfo=0&modestbranding=1&playsinline=1&cc_load_policy=0&iv_load_policy=3&fs=0&disablekb=1"
            allow="autoplay; encrypted-media; picture-in-picture" frameborder="0" aria-hidden="true" tabindex="-1" title="Hero background video">
          </iframe>
        </div>
        <% } %>
      <% } else { %>
      <video class="hero-video-player" data-hero-video="mp4" autoplay muted loop playsinline preload="metadata">
        <source src="<%= _hmVid %>" type="video/mp4">
      </video>
      <% } %>
    <% } %>
  </div>
<% } /* end phone layer */ %>
</section>

