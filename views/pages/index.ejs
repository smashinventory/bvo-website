<%# ── CATEGORY CAROUSEL ──────────────────────────────────────────── %>
<%
/* _baseKey, not sectionKey — an exact-match on 'categories_section' meant a
   duplicated categories_section_2 sat in the order rendering nothing at
   all, silently. Same conversion applied to the two featured sections. */
%>
<% if (_baseKey === 'categories_section' && _d.enabled !== false && categories && categories.length) { %>
<%
  var _csTag   = _safeTag(_d.title_level, 'h2');
  var _csAlign = _d.text_align  || 'center';
  /* Categories have no brand of their own, so a brand here scopes where
     each card POINTS rather than which cards show. _qs appends it only
     when the target does not already carry a brand, so a hand-written URL
     in the Theme Editor still wins. */
  var _csBrand = (_d.brand || '').trim();
  var _csHref  = function (slug) {
    var u = '/collections/' + slug;
    return _csBrand ? u + '?brand=' + encodeURIComponent(_csBrand) : u;
  };
  var _csId = 'cat-heading-' + sectionKey;
%>
<section class="section" data-section="<%= sectionKey %>" data-section-label="Category Grid" aria-labelledby="<%= _csId %>">
  <div class="section-header" style="text-align:<%= _csAlign %>">
    <p class="section-eyebrow"><%= _d.eyebrow || 'Browse by Category' %></p>
    <<%- _csTag %> class="section-title" id="<%= _csId %>"><%= _d.title || 'Everything Your Bathroom Needs' %></<%- _csTag %>>
    <% if (_d.subtitle) { %><p class="section-sub"><%= _d.subtitle %></p><% } %>
  </div>

  <%# Bound by data attribute in /js/carousels.js. The old id="catCarouselTrack"
      is gone on purpose: getElementById returns one node, so a duplicated
      section's arrows were dead. See carousels.js for the full note. %>
  <div class="cat-carousel-outer" data-carousel data-carousel-card=".cat-card" data-carousel-per="1.5,2,4">
    <button class="fm-arrow fm-arrow--left" data-carousel-prev aria-label="Scroll left" hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>

    <div class="cat-carousel-track" data-carousel-track>
      <% categories.forEach(function(cat) { %>
      <a href="<%= _csHref(cat.slug) %>" class="cat-card">
        <div class="cat-img">
          <% if (cat.image_url) { %>
            <%/* ?width= only helps on the Bunny zone. Local /images/uploads paths
                 have no resizer, and the remaining gstatic URL already carries a
                 query string — appending a second "?" to it would corrupt it. */%>
            <%/* srcset: the image box is at most ~280 CSS px wide and always
                 180 tall; object-fit:cover on a 560x360 source means ~280 CSS px
                 of image is needed at every viewport, so sizes="280px" is exact.
                 1x screens take 280w (~1/3 the bytes), 2x/3x take 560w, the
                 source width (Bunny never upscales). */%>
            <% var _catRaw = String(cat.image_url || ''), _catSrc = _catRaw, _catSet = '';
               if (_catRaw.indexOf('images.bathroomvanitiesoutlet.com') !== -1) {
                 var _catJ = (_catRaw.indexOf('?') === -1 ? '?' : '&') + 'width=';
                 _catSrc = _catRaw + _catJ + '560';
                 if (_catRaw.indexOf('?') === -1) {
                   _catSet = [280, 420, 560].map(function (w) { return _catRaw + _catJ + w + ' ' + w + 'w'; }).join(', ');
                 }
               } %>
            <img src="<%= _catSrc %>"<% if (_catSet) { %> srcset="<%= _catSet %>" sizes="280px"<% } %> alt="Bathroom Vanities Outlet <%= cat.name %>" loading="lazy">
          <% } else { %>
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <% } %>
        </div>
        <div class="cat-body">
          <h3><%= cat.name %></h3>
          <p><%- cat.description %></p>
          <span class="cat-link">Shop Now →</span>
        </div>
      </a>
      <% }); %>
    </div>

    <button class="fm-arrow fm-arrow--right" data-carousel-next aria-label="Scroll right">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>
</section>
<% } /* end categories_section */ %>

<%# ── FEATURED PRODUCTS ─────────────────────────────────────────── %>
<%
/* Per-slot: _d is this slot's settings, _rows is this slot's OWN products.
   Both copies used to read the single module-scope `fs_` and the single
   `products` array, so two Featured Products bands could only ever show
   identical content no matter how they were filtered. */
%>
<% if (_baseKey === 'featured_section' && _d.enabled !== false) { %>
<%
  var _fsTag   = _safeTag(_d.title_level, 'h2');
  var _fsAlign = _d.text_align  || 'center';
  var _fsRows  = (typeof sectionData !== 'undefined' && sectionData && sectionData[sectionKey])
                 ? sectionData[sectionKey] : [];
  var _fsId    = 'feat-heading-' + sectionKey;
%>
<% if (_fsRows.length) { %>
<section class="section section-alt" data-section="<%= sectionKey %>" data-section-label="Featured Products" aria-labelledby="<%= _fsId %>">
  <div class="section-header" style="text-align:<%= _fsAlign %>">
    <p class="section-eyebrow"><%= _d.eyebrow || 'Staff Picks' %></p>
    <<%- _fsTag %> class="section-title" id="<%= _fsId %>"><%= _d.title || 'Featured Products' %></<%- _fsTag %>>
    <% if (_d.subtitle) { %><p class="section-sub"><%= _d.subtitle %></p><% } %>
  </div>
  <%
    /* Columns control — Theme Editor. Was a live dropdown that nothing read:
       .product-grid was hardcoded to repeat(4,1fr), so picking 2 or 3 saved
       happily and changed nothing.

       Driven by a CSS variable set INLINE here rather than by a class, so it
       is scoped to this section. .product-grid is also used by product.ejs,
       and a global rule would have silently restyled that page too.

       --fs-cols     desktop
       --fs-cols-md  tablet, capped at 3 — otherwise choosing 2 columns for
                     desktop would leave tablet showing MORE columns than
                     desktop, since the 1100px rule is a fixed 3.
       Phones stay at 2 regardless; that rule is untouched.
       Both CSS fallbacks equal the old hardcoded values, so an unset or
       malformed setting renders exactly as it does today. */
    const _fsColsRaw = parseInt(_d.columns, 10);
    const _fsCols    = [2, 3, 4].includes(_fsColsRaw) ? _fsColsRaw : 4;
    const _fsColsMd  = Math.min(_fsCols, 3);
  %>
  <div class="product-grid" style="--fs-cols:<%= _fsCols %>;--fs-cols-md:<%= _fsColsMd %>">
    <% _fsRows.forEach(function(product) { %>
    <%
      /* Element ids must be unique per SLOT as well as per product — two
         bands can legitimately feature the same product, and a duplicate
         id would make the swatch handler in site.js retarget the wrong
         card's image. */
      var _hpImgId = 'feat-img-' + sectionKey + '-' + product.id;
    %>
    <%
      var _fpSwatches     = (product.finishes || []).slice(0, 4);
      var _fpSwatchExtra  = (product.finishes || []).length > 4 ? product.finishes.length - 4 : 0;
      var _fpQtyRaw       = parseInt(product.qty_on_hand || 0, 10);
      var _fpQtyDisplay   = Math.min(_fpQtyRaw, 4);
    %>
    <%# HOMEPAGE ONLY — zoom on hover, never the second-image swap.

        has-hover-img is deliberately NOT applied here. The existing rule

          .product-card:not(.has-hover-img):hover .product-img-pri
            { transform: scale(1.04) }

        then applies, which is the SAME 1.04 the model cards use
        (.model-card:hover .model-card-img). Two card types sit side by side
        on this page and were behaving differently: one zoomed, the other
        cut to a second photo shot at a different distance and crop, so the
        row read as inconsistent.

        Collection pages keep the swap — there the second image is useful,
        because the visitor is comparing products rather than scanning a
        curated row.

        No CSS change was needed for this; the rule already existed. %>
    <article class="product-card<%= _fpQtyRaw === 0 ? ' product-card--no-stock' : '' %>">
      <a href="/products/<%= product.slug %>" class="product-img-link" aria-label="<%= product.name %>">
        <div class="product-img">
          <% if (product.primary_image) { %>
            <%/* Responsive card photo. Measured against the live page: the image is
       210px tall with a width that moves by breakpoint --
         1440 dpr1 -> 308x210 (needs 308 device px)
         1920 dpr1 -> 428x210 (needs 428)
          820 dpr2 -> 372x210 (needs 744)
          390 dpr3 -> 340x210 (needs 1020)
       and every card was hard-coded to ?width=800, so a dpr1 desktop pulled
       46 KB to paint 308 pixels. Off the pull zone:
         320w 12.4KB  400w 16.0KB  480w 20.3KB  640w 32.3KB  800w 46.4KB
       The ladder STOPS at 800 on purpose -- that is what every device gets
       today, so this can only remove bytes, never add them. A dpr3 phone
       wants 1020 and would take a 68.6 KB candidate if one existed, making
       the mobile CWV run worse to satisfy a desktop audit. It keeps 800.
       sizes is measured, not guessed: 340/390=87vw, 372/820=45vw,
       308/1440 and 428/1920 = 21-22vw.
       Guards match the hero and the category cards: Bunny only (nothing
       else has a resizer) and never touch a URL that already has a query. */%>
              <% var _pi = String(product.primary_image || '');
                 var _pcs = (_pi.indexOf('images.bathroomvanitiesoutlet.com') !== -1 && _pi.indexOf('?') === -1)
                   ? [320,400,480,640,800].map(function(w){ return _pi + '?width=' + w + ' ' + w + 'w'; }).join(', ')
                   : ''; %>
              <img class="product-img-pri" src="<%= product.primary_image %>?width=800"<% if (_pcs) { %> srcset="<%= _pcs %>" sizes="(max-width: 600px) 88vw, (max-width: 1024px) 46vw, 23vw"<% } %> alt="<%= product.name %>" loading="lazy"
                 id="<%= _hpImgId %>">
              <%# No hover image on the homepage. Leaving it in the DOM at
                  opacity:0 would cost a lazy image request per card for
                  something that can never be shown — hidden work is still
                  work. product.hover_image is untouched in the DB and is
                  still rendered on collection pages. %>
          <% } else { %>
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <% } %>
          <%# Only BEST wins outright — one card per section, and earned.
              Everything else, including Sale, comes from the rotation, so
              a row of discounted products no longer reads SALE four
              times. badge-sale is reused for its colour only. %>
          <% if (product.badge === 'best') { %>
          <span class="product-badge badge-best">BEST</span>
          <% } else if (product.cardBadge) { %>
          <span class="product-badge badge-sale"><%= product.cardBadge.toUpperCase() %></span>
          <% } %>
          <% if (product.video_url) { %>
          <span class="product-video-badge" data-video-url="<%= product.video_url %>" aria-label="Watch video">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </span>
          <% } %>
        </div>
      </a>
      <div class="product-body">
        <% if (product.brand) { %><p class="product-brand"><%= product.brand %></p><% } %>
        <h3 class="product-title"><a href="/products/<%= product.slug %>"><%= product.name %></a></h3>

        <% if (_fpSwatches.length) { %>
        <div class="model-card-swatches" role="group" aria-label="Available finishes">
          <span class="model-card-swatches-label">Finishes:</span>
          <% _fpSwatches.forEach(function(f, i) { %>
          <%
            var _fpLight  = f.hex && ['#f5f5f3','#f0f0ef','#f5f5f5','#fafafa','#ffffff','#e8d9b8'].indexOf(f.hex.toLowerCase()) !== -1;
            var _fpBorder = _fpLight ? '#ccc' : (f.border || f.hex);
            var _fpWood   = ['wood_l','wood_m','wood_d'].indexOf(f.color_family) !== -1;
          %>
          <button class="model-card-swatch<%= i === 0 ? ' is-active' : '' %><%= _fpWood ? ' swatch--wood-grain' : '' %>"
                  data-target-img="<%= _hpImgId %>"
                  data-finish="<%= f.color %>"
                  <% if (f.image_url) { %>data-image="<%= f.image_url %>"<% } %>
                  <% if (f.sizeImages && Object.keys(f.sizeImages).length) { %>data-size-images="<%= JSON.stringify(f.sizeImages) %>"<% } %>
                  style="background:<%= f.hex %>;border-color:<%= _fpBorder %>"
                  aria-label="<%= f.color %>" title="<%= f.color %>"></button>
          <% }); %>
          <% if (_fpSwatchExtra > 0) { %>
          <span class="model-card-swatch-more" aria-hidden="true">+<%= _fpSwatchExtra %></span>
          <% } %>
        </div>
        <% } %>

        <% if (product.sizes && product.sizes.length) { %>
        <div class="model-card-sizes-row">
          <span class="model-card-sizes-label">Sizes:</span>
          <div class="model-card-size-chips">
            <% product.sizes.forEach(function(sz, i) { %>
            <% var _fpSzImg = product.sizeImageMap && product.sizeImageMap[sz.key] ? product.sizeImageMap[sz.key] : null; %>
            <button type="button"
                    class="model-card-size-btn<%= i === 0 ? ' is-active' : '' %>"
                    data-target-img="<%= _hpImgId %>"
                    data-size="<%= sz.key %>"
                    <% if (_fpSzImg) { %>data-image="<%= _fpSzImg %>"<% } %>
                    aria-label="<%= sz.label %>&quot; wide"
                    title="<%= sz.label %>&quot; wide">
              <%= sz.label %>
            </button>
            <% }); %>
          </div>
        </div>
        <% } %>

        <div class="product-price-row">
          <span class="product-price">$<%= product.price.toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
          <% if (product.compare_price && product.compare_price > product.price) { %>
          <span class="product-was">$<%= product.compare_price.toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
          <span class="card-save-badge">Save $<%= Math.round(product.compare_price - product.price).toLocaleString('en-US') %></span>
          <% } %>
          <span class="card-qty<%= _fpQtyRaw === 0 ? ' card-qty--zero' : '' %>">QTY: <%= _fpQtyDisplay %></span>
        </div>
        <a href="/products/<%= product.slug %>" class="btn btn-sage">View Details<span class="sr-only"> — <%= product.name %></span></a>
      </div>
    </article>
    <% }) %>
  </div>
  <div class="section-cta">
    <a href="<%= _ctaWithBrand(_d.cta_url || '/collections/bathroom-vanities', _d.brand) %>" class="btn btn-outline"><%= _d.cta_text || 'View All Products' %></a>
  </div>
</section>
<% } /* end _fsRows.length */ %>
<% } /* end featured_section */ %>

<%# ── FEATURED MODELS ───────────────────────────────────────────── %>
<%
/* Per-slot, same conversion as the two sections above. `_carouselModels`
   comes from sectionData[sectionKey] so a JM band and an ER band each hold
   their own rows; it used to be the one shared `featuredModels` array. */
%>
<% if (_baseKey === 'featured_models' && _d.enabled !== false) { %>
<%
  var _carouselModels = (typeof sectionData !== 'undefined' && sectionData && sectionData[sectionKey])
                        ? sectionData[sectionKey] : [];
  var _fmId = 'feat-models-heading-' + sectionKey;
%>
<% if (_carouselModels.length) { %>
<section class="section section-alt" id="featured-models-<%= sectionKey %>" data-section="<%= sectionKey %>" data-section-label="Featured Models" aria-labelledby="<%= _fmId %>">
  <div class="section-header" style="text-align:<%= _d.text_align || 'center' %>">
    <p class="section-eyebrow"><%= _d.eyebrow || 'Shop by Collection' %></p>
    <h2 class="section-title" id="<%= _fmId %>"><%= _d.title || 'Featured Models' %></h2>
    <p class="section-sub"><%= _d.subtitle || 'Explore our most popular vanity collections — click a finish to see it in action.' %></p>
  </div>

  <%# data-carousel, not id="fmCarouselTrack" — see carousels.js. %>
  <div class="fm-carousel-outer" data-carousel data-carousel-card=".model-card" data-carousel-per="1.2,2,4">
    <button class="fm-arrow fm-arrow--left" data-carousel-prev aria-label="Scroll left" hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>

    <div class="fm-carousel-track" data-carousel-track>
      <% _carouselModels.forEach(function(m) { %>
      <%
        var _discPct         = m.compare_price_from ? Math.round((1 - m.price_from / m.compare_price_from) * 100) : 0;
        var _saveAmt         = (m.compare_price_from && m.price_from && m.compare_price_from > m.price_from)
                                 ? Math.round(m.compare_price_from - m.price_from) : 0;

        /* Starting-product figures, computed HERE rather than beside the
           price row, because the corner badge on the image renders first
           and would otherwise print undefined. All three follow the same
           product so the badge, the strike-through and the price agree. */
        var _mWas     = (m.defaultPrice != null) ? m.defaultCompare : m.compare_price_from;
        var _mSave    = (_mWas && m.defaultPrice != null && _mWas > m.defaultPrice)
                          ? Math.round(_mWas - m.defaultPrice)
                          : (m.defaultPrice != null ? 0 : _saveAmt);
        var _mIsRange = (m.defaultPrice == null) && !!(m.price_to && m.price_to > m.price_from);

        var _visibleSwatches = m.finishes.slice(0, 4);
        var _extraSwatches   = m.finishes.length > 4 ? m.finishes.length - 4 : 0;
        // Model card ids and links must carry BRAND, not just model.
        //
        // Two brands sell a "Bristol". With model alone both cards emitted
        // id="model-img-bristol", and site.js resolves a swatch click with
        // getElementById(dataset.targetImg) — which returns the FIRST match
        // in the document. Cards sort by brand, so clicking a swatch on the
        // James Martin card swapped the image and price on the ER Vanities
        // card. Duplicate ids are also invalid HTML.
        //
        // Not visible today only because page 1 holds 12 cards and JM's
        // Bristol falls to page 2 — any filter that thins the earlier JM
        // models puts them on one page and it fires.
        // SLOT is part of the id too, for the same reason brand is. Once
        // this section became duplicatable, two bands can legitimately
        // feature the same (model, brand) — a JM band and an "all brands"
        // band both showing Hudson — and the ids would collide again,
        // resurrecting exactly the cross-card swatch bug described above.
        var _mSlug           = function (v) { return String(v || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); };
        var _mId             = (m.model ? (_mSlug(m.model) + '-' + (_mSlug(m.brand) || 'nobrand')) : 'model')
                               + '-' + _mSlug(sectionKey);
        // Brand on the link too — without it the ER Bristol card led to a
        // grid holding both brands' Bristol products. getCollection already
        // parses req.query.brand, so this needs no controller change.
        var _mHref           = '/collections/bathroom-vanities?model=' + encodeURIComponent(m.model || '')
                               + (m.brand ? '&brand=' + encodeURIComponent(m.brand) : '');
        var _mImg            = m.image_url || '/images/placeholder-vanity.jpg';
      %>
      <article class="model-card" data-model="<%= m.model %>" data-sizes="<%= m.sizes.map(function(s){return s.key}).join(',') %>">

        <div class="model-card-img-wrap">
          <%# The corner badge used to read "Save $1,211" directly above a
              price row that also read "Save $1,211" — the same number
              twice on one card. It now carries a rotating label the card
              actually qualifies for. See src/utils/cardBadge.js. %>
          <% if (m.cardBadge) { %>
          <span class="model-card-badge"><%= m.cardBadge %></span>
          <% } %>
          <a href="<%= _mHref %>" class="model-card-img-link" tabindex="-1" aria-hidden="true">
            <img src="<%= _mImg %>"
                 alt="<%= m.model %> vanity"
                 class="model-card-img"
                 id="model-img-<%= _mId %>"
                 loading="lazy">
          </a>
          <% if (m.video_url) { %>
          <span class="product-video-badge" data-video-url="<%= m.video_url %>" aria-label="Watch video">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </span>
          <% } %>
        </div>

        <div class="model-card-body">
          <%
            /* A chosen starting product shows ITS price, exactly — not a
               range and not "From". The range is what the card falls back
               to when nobody has picked one. */
            var _mPriceDefault = (m.defaultPrice != null)
              ? ('$' + m.defaultPrice.toLocaleString('en-US'))
              : ((m.price_to && m.price_to > m.price_from)
                  ? ('$' + m.price_from.toLocaleString('en-US') + ' – $' + m.price_to.toLocaleString('en-US'))
                  : ('From $' + m.price_from.toLocaleString('en-US')));

          %>
          <div class="model-card-price-row">
            <span class="model-card-price" id="model-price-<%= _mId %>" data-default="<%= _mPriceDefault %>"><%= _mPriceDefault %></span>
            <% if (_mWas && !_mIsRange) { %>
            <span class="model-card-was">$<%= _mWas.toLocaleString('en-US') %></span>
            <% } %>
            <% if (_mSave > 0 && !_mIsRange) { %>
            <span class="card-save-badge">Save $<%= _mSave.toLocaleString('en-US') %></span>
            <% } %>
          </div>

          <h3 class="model-card-name">
            <a href="<%= _mHref %>">The <%= m.model %> Collection</a>
          </h3>
          <p class="model-card-brand">Brand: <%= m.brand %></p>

          <div class="model-card-swatches" role="group" aria-label="Available finishes">
            <span class="model-card-swatches-label">Finishes:</span>
            <% _visibleSwatches.forEach(function(f, i) { %>
            <%
              var _isLight      = ['#F0F0EF','#F5F5F5','#FAFAFA','#FFFFFF','#C4A882'].indexOf(f.hex) !== -1;
              var _swatchBorder = _isLight ? '#ccc' : (f.border || f.hex);
            %>
            <%# Preselect the starting product's finish. Falls back to the
                first swatch when no starting product is set, or when its
                colour is not among the visible four. %>
            <% var _swActive = m.defaultColor ? (f.color === m.defaultColor) : (i === 0); %>
            <button class="model-card-swatch<%= _swActive ? ' is-active' : '' %>"
                    data-target-img="model-img-<%= _mId %>"
                    data-target-price="model-price-<%= _mId %>"
                    data-finish="<%= f.color %>"
                    <% if (f.image_url) { %>data-image="<%= f.image_url %>"<% } %>
                    <% if (f.sizeImages && Object.keys(f.sizeImages).length) { %>data-size-images="<%= JSON.stringify(f.sizeImages) %>"<% } %>
                    <% if (f.sizePrices && Object.keys(f.sizePrices).length) { %>data-size-prices="<%= JSON.stringify(f.sizePrices) %>"<% } %>
                    style="background:<%= f.hex %>;border-color:<%= _swatchBorder %>"
                    aria-label="<%= f.color %>"
                    title="<%= f.color %>"></button>
            <% }); %>
            <% if (_extraSwatches > 0) { %>
            <span class="model-card-swatch-more" aria-hidden="true">+<%= _extraSwatches %></span>
            <% } %>
          </div>

          <div class="model-card-sizes-row">
            <span class="model-card-sizes-label">Sizes:</span>
            <% if (m.sizes && m.sizes.length) { %>
            <div class="model-card-size-chips">
              <% m.sizes.forEach(function(sz, i) { %>
              <% var _szImg = m.sizeImageMap && m.sizeImageMap[sz.key] ? m.sizeImageMap[sz.key] : null; %>
              <%# Same rule as the swatches — the starting product's size
                  bucket, else the first (smallest) chip. %>
              <% var _szActive = m.defaultSizeKey ? (sz.key === m.defaultSizeKey) : (i === 0); %>
              <button type="button"
                      class="model-card-size-btn<%= _szActive ? ' is-active' : '' %>"
                      data-target-img="model-img-<%= _mId %>"
                      data-target-price="model-price-<%= _mId %>"
                      data-size="<%= sz.key %>"
                      data-price-from="<%= sz.priceFrom != null ? sz.priceFrom : '' %>"
                      <% if (_szImg) { %>data-image="<%= _szImg %>"<% } %>
                      aria-label="<%= sz.label %>&quot; wide"
                      title="<%= sz.label %>&quot; wide">
                <%= sz.label %>
              </button>
              <% }); %>
            </div>
            <% } else { %>
            <span class="model-card-sizes-text">See details</span>
            <% } %>
          </div>

          <a href="<%= _mHref %>" class="btn btn-outline model-card-cta">
            Shop the <%= m.model %>
          </a>
        </div>
      </article>
      <% }); %>
    </div><!-- /.fm-carousel-track -->

    <button class="fm-arrow fm-arrow--right" data-carousel-next aria-label="Scroll right">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div><!-- /.fm-carousel-outer -->

  <div class="section-cta">
    <%# The reason for all of this: "See All Our JM Models" now lands on the
        JM-filtered list rather than the mixed one. %>
    <a href="<%= _ctaWithBrand(_d.cta_url || '/collections/vanity-models', _d.brand) %>" class="btn btn-navy"><%= _d.cta_text || 'See All Our Models' %></a>
  </div>
</section>
<% } /* end _carouselModels.length */ %>
<% } /* end featured_models */ %>

