<!-- ── THEME EDITOR INTEGRATION — click-to-edit + section scroll ──── -->
<style>
  /* Only active inside the theme editor preview iframe */
  body.te4-preview-mode [data-section] {
    cursor: pointer;
    position: relative;
    transition: outline .12s;
  }
  body.te4-preview-mode [data-section]:hover::after {
    content: 'Click to edit';
    position: absolute;
    top: 8px; left: 8px;
    background: #5A7A5A;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    font-family: system-ui, sans-serif;
    padding: 3px 8px;
    border-radius: 4px;
    pointer-events: none;
    z-index: 9999;
    letter-spacing: .02em;
  }
  body.te4-preview-mode [data-section]:hover {
    outline: 2px solid #5A7A5A;
    outline-offset: 2px;
  }
  [data-section].te4-preview-highlight {
    outline: 3px solid #5A7A5A;
    outline-offset: 3px;
    border-radius: 4px;
  }
</style>
<script nonce="<%= cspNonce %>">
/* ── Hero video — defer until after page paint to protect FCP ── */
(function () {
  function initHeroVideo() {
    /* YouTube iframe: inject src from data-src so it never blocks initial render */
    var ytIframe = document.querySelector('.hero-video-iframe[data-hero-video="yt"]');
    if (ytIframe && ytIframe.dataset.src) {
      ytIframe.addEventListener('load', function () {
        setTimeout(function () {
          ytIframe.classList.add('is-ready');
          var poster = document.querySelector('.hero-poster');
          if (poster) poster.classList.add('is-hidden');
        }, 800); /* brief delay so YouTube has rendered its first frame */
      });
      ytIframe.src = ytIframe.dataset.src; /* triggers load */
    }
    /* Direct <video>: fade in on canplay */
    var mp4Vid = document.querySelector('.hero-video-player[data-hero-video="mp4"]');
    if (mp4Vid) {
      mp4Vid.addEventListener('canplay', function () {
        mp4Vid.classList.add('is-ready');
        var poster = document.querySelector('.hero-poster');
        if (poster) poster.classList.add('is-hidden');
      }, { once: true });
    }
  }
  /* Wait until after the browser has painted the page */
  if (document.readyState === 'complete') {
    initHeroVideo();
  } else {
    window.addEventListener('load', initHeroVideo);
  }
}());
</script>

<script nonce="<%= cspNonce %>">
(function () {
  var isPreview = window.location.search.indexOf('te_preview') !== -1;
  if (isPreview) document.body.classList.add('te4-preview-mode');

  var _lastHighlight = null;

  /* ── Receive messages from the editor ── */
  window.addEventListener('message', function (e) {
    var d = e.data;
    if (!d || typeof d !== 'object') return;
    if ('te4_scroll' in d) {
      if (_lastHighlight) { _lastHighlight.classList.remove('te4-preview-highlight'); _lastHighlight = null; }
      var key = d.te4_scroll;
      if (!key) return;
      var target = document.querySelector('[data-section="' + key + '"]');
      if (!target) return;
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.classList.add('te4-preview-highlight');
      _lastHighlight = target;
      setTimeout(function () {
        if (_lastHighlight === target) { target.classList.remove('te4-preview-highlight'); _lastHighlight = null; }
      }, 2500);
    }
  });

  /* ── Send click-to-edit messages to the editor ── */
  if (isPreview) {
    document.addEventListener('click', function (e) {
      var el = e.target.closest('[data-section]');
      if (!el) return;
      e.preventDefault();
      e.stopPropagation();
      var key = el.dataset.section;
      var label = el.dataset.sectionLabel || key;
      window.parent.postMessage({ te4_open: key, te4_label: label }, '*');
    }, true);
  }
}());
</script>
