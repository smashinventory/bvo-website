<link rel="stylesheet" href="/css/site3.css?v=16"><!-- site3: injected per-page (perf) -->
<%
const S    = settings || {};
const hero = S.hero               || {};
const tick = S.scrolling_ticker   || {};
const bl   = S.brand_logos        || {};
const cs   = S.categories_section || {};
const fs_  = S.featured_section   || {};
const fm_  = S.featured_models    || {};
const bt_  = S.bundle_teaser       || {};
const iwt  = S.image_with_text    || {};
const iwt2  = S.image_with_text_2  || {};
const vt2   = S.video_text_2       || {};
const tb2   = S.trust_band_2       || {};
const par2  = S.parallax_2         || {};
const test2 = S.testimonials_2     || {};
const vt   = S.video_text         || {};
const ba   = S.before_after       || {};
const ba2  = S.before_after_2     || {};
const tb   = S.trust_band         || {};
const par  = S.parallax           || {};
const test = S.testimonials       || {};
const news = S.newsletter         || {};

/* Video helpers — extract YouTube ID, detect source type */
function _ytId(url) {
  if (!url) return null;
  var m = String(url).match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?.*?v=|shorts\/))([a-zA-Z0-9_-]{11})/);
  return m ? m[1] : null;
}
function _isYT(url) { return !!(url && /youtu\.be|youtube\.com/.test(String(url))); }

/* Security: whitelist heading tag values so theme settings can't inject arbitrary HTML
   via raw EJS output tags (e.g. _heroTag, _csTag) used to emit heading elements. */
const _ALLOWED_TAGS = new Set(['h1','h2','h3','h4','h5','h6']);
function _safeTag(val, def) { return _ALLOWED_TAGS.has(val) ? val : (def || 'h2'); }

/* Salsify (Cloudinary) on-the-fly resize — inserts transform params into CDN URL.
   Reduces 2–4 MB hero/featured images to ~30–60 KB at the displayed size.
   If images ever 403, remove the transform call and they fall back to originals. */
function _salsifyImg(url, w, h) {
  if (!url || !url.includes('images.salsify.com/image/upload/')) return url;
  return url.replace('/image/upload/', '/image/upload/w_' + w + ',h_' + h + ',c_fill,f_auto,q_auto/');
}

const _DEFAULT_ORDER = ['scrolling_ticker','hero','hero_mobile','brand_logos','categories_section','bundle_teaser',
  'featured_section','featured_models','inspiration','image_with_text','video_text','before_after','trust_band','parallax','testimonials','newsletter'];
const _STATIC_SET  = new Set(_DEFAULT_ORDER);
const _DUPL_BASES  = new Set(['image_with_text','before_after','video_text','trust_band','parallax','testimonials']);

// Accept any _N copy of a duplicatable base type (image_with_text_2, _3, _4, …)
function _isValidKey(k) {
  if (_STATIC_SET.has(k)) return true;
  var m = k.match(/^(.+?)_(\d+)$/);
  return !!(m && _DUPL_BASES.has(m[1]));
}

// Use saved order from DB; backfill any new static sections that were added
// after the order was last saved (e.g. bundle_teaser added in a later deploy).
const _rawOrder = (Array.isArray(S.homepage_section_order) && S.homepage_section_order.length)
  ? S.homepage_section_order
  : _DEFAULT_ORDER;
const _sectionOrder = _rawOrder.slice(); // mutable copy
_DEFAULT_ORDER.forEach(function(k) {
  if (_sectionOrder.indexOf(k) === -1) {
    // Insert after its left-neighbour in _DEFAULT_ORDER, or append
    var prevKey = _DEFAULT_ORDER[_DEFAULT_ORDER.indexOf(k) - 1];
    var insertAt = prevKey ? _sectionOrder.indexOf(prevKey) + 1 : _sectionOrder.length;
    if (insertAt <= 0) insertAt = _sectionOrder.length;
    _sectionOrder.splice(insertAt, 0, k);
  }
});
%>

<% _sectionOrder.forEach(function(sectionKey) { %>
<% if (!_isValidKey(sectionKey)) { return; } %>
<% var _baseKey = sectionKey.replace(/_\d+$/, ''); var _d = S[sectionKey] || {}; %>
<%
  var _showOn   = (_d && _d.show_on) || 'all';
  var _visClass = _showOn === 'desktop' ? 'sec--desktop-only'
                : _showOn === 'mobile'  ? 'sec--mobile-only'
                : '';
%>
<% if (_visClass) { %><div class="<%= _visClass %>"><% } %>

<!-- ── SCROLLING TICKER ──────────────────────────────────────────── -->
<% if (sectionKey === 'scrolling_ticker' && tick.enabled !== false && tick.items && tick.items.length) { %>
<%
  var _tickStyle = '';
  if (tick.bg_color)       _tickStyle += 'background:' + tick.bg_color + ';';
  if (tick.text_color)     _tickStyle += 'color:' + tick.text_color + ';';
  if (+tick.font_size > 0) _tickStyle += 'font-size:' + tick.font_size + 'px;';
%>
<div class="scrolling-ticker" data-section="scrolling_ticker" data-section-label="Announcement Bar" aria-label="Announcements"<%= _tickStyle ? ' style="' + _tickStyle + '"' : '' %>>
  <div class="ticker-track" style="animation-duration:<%= tick.speed_seconds || 40 %>s">
    <% var _tickItems = tick.items; %>
    <% ;[..._tickItems, ..._tickItems].forEach(function(item) { %>
    <span class="ticker-item"><%= item %></span>
    <% }) %>
  </div>
</div>
<% } /* end scrolling_ticker */ %>

<!-- ── HERO ──────────────────────────────────────────────────────── -->
<% if (sectionKey === 'hero') { %>
<%
  var _heroTag    = _safeTag(hero.heading_level, 'h1');
  var _heroAlign  = hero.text_align    || 'left';
  var _heroHSize  = hero.heading_size  ? 'font-size:'+hero.heading_size+'px;' : '';
  var _heroSSize  = hero.subtext_size  ? 'font-size:'+hero.subtext_size+'px;' : '';
  var _heroH2Size = (+hero.h2_size > 0) ? 'font-size:'+hero.h2_size+'px;' : '';
  var _heroESize  = (+hero.eyebrow_size > 0 && hero.eyebrow_size != 11) ? 'font-size:'+hero.eyebrow_size+'px;' : '';
  var _heroS2Size = (+hero.sub2_size > 0 && hero.sub2_size != 14) ? 'font-size:'+hero.sub2_size+'px;' : '';
  var _heroBSize  = (+hero.badge_size > 0 && hero.badge_size != 10) ? 'font-size:'+hero.badge_size+'px;' : '';
  var _heroLayout = hero.layout || 'split';
  // Auto-switch to bg layout when video is present in split mode — Option 2 (2026-08-09)
  if (hero.video_url && _heroLayout === 'split') _heroLayout = 'bg';
  var _textPct    = parseInt(hero.text_col_pct) || 45;
  var _imgPct     = 100 - _textPct;
  var _ovColor    = hero.overlay_color || '#0f1f35';
  var _ovOp       = (hero.overlay_opacity !== undefined && hero.overlay_opacity !== '') ? (+hero.overlay_opacity / 100).toFixed(2) : '0.55';
  /* Build section inline style — CSS custom props + layout/height overrides */
  var _heroStyle  = '--ov-clr:'+_ovColor+';--ov-op:'+_ovOp+';';
  if (_heroLayout === 'split') _heroStyle += 'grid-template-columns:'+_textPct+'% '+_imgPct+'%;';
  if (+hero.height_vh > 0)           _heroStyle += 'height:'+hero.height_vh+'vh;';
  if (+hero.min_height_px > 0)       _heroStyle += 'min-height:'+hero.min_height_px+'px;';
  if (+hero.max_height_px === 0)     _heroStyle += 'max-height:none;';
  else if (+hero.max_height_px > 0)  _heroStyle += 'max-height:'+hero.max_height_px+'px;';
  /* Per-section text color CSS custom properties */
  if (hero.eyebrow_color)    _heroStyle += '--hero-eyebrow:'+hero.eyebrow_color+';';
  if (hero.heading_color)    _heroStyle += '--hero-h1:'+hero.heading_color+';';
  if (hero.h2_color)         _heroStyle += '--hero-h2:'+hero.h2_color+';';
  if (hero.subtext_color)    _heroStyle += '--hero-sub:'+hero.subtext_color+';';
  if (hero.sub2_color)       _heroStyle += '--hero-sub2:'+hero.sub2_color+';';
  if (hero.text_align_mobile && hero.text_align_mobile !== 'center') _heroStyle += '--hero-mobile-align:'+hero.text_align_mobile+';';
  /* Content box CSS vars (bg-video layout) */
  var _boxColor = hero.content_box_color || '#0f1f35';
  var _boxOp    = hero.content_box_opacity !== undefined ? hero.content_box_opacity : 60;
  var _boxHex   = _boxColor.match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})/i);
  if (_boxHex) _heroStyle += '--content-box-bg:rgba('+parseInt(_boxHex[1],16)+','+parseInt(_boxHex[2],16)+','+parseInt(_boxHex[3],16)+','+(_boxOp/100).toFixed(2)+');';
  if (+hero.content_box_padding > 0)  _heroStyle += '--content-box-pad:'+hero.content_box_padding+'px;';
  if (+hero.content_box_radius  >= 0) _heroStyle += '--content-box-radius:'+hero.content_box_radius+'px;';
  if (+hero.content_max_width   > 0)  _heroStyle += '--content-max-w:'+hero.content_max_width+'px;';
  if (hero.content_v_offset !== undefined && hero.content_v_offset !== '') _heroStyle += '--content-v-offset:'+hero.content_v_offset+'%;';
  if (hero.content_h_offset !== undefined && hero.content_h_offset !== '') _heroStyle += '--content-h-offset:'+hero.content_h_offset+'%;';
  var _ctaAlign = _heroAlign==='center'?'justify-content:center':_heroAlign==='right'?'justify-content:flex-end':'';
%>
<section class="hero hero--<%= _heroLayout %> hero--desktop-version<%= hero.video_on_mobile === false ? ' hero--no-mobile-video' : '' %><%= hero.mobile_image_url ? ' hero--has-mobile-img' : '' %><%= hero.text_shadow !== false ? ' hero--text-shadow' : '' %>" data-section="hero" data-section-label="Hero Banner" aria-label="Hero" style="<%= _heroStyle %>">
  <div class="hero-content" style="text-align:<%= _heroAlign %>">
    <div class="hero-content-box">
      <p class="hero-eyebrow" style="<%= _heroESize %>"><%= hero.eyebrow || 'Curated for Your Bathroom Renovation' %></p>
      <<%- _heroTag %> class="hero-h1" style="<%= _heroHSize %>"><%= hero.heading_line1 || 'Premium Vanities.' %></<%- _heroTag %>>
      <p class="hero-h2" style="<%= _heroH2Size %>"><%= hero.heading_line2 || 'Outlet Prices.' %></p>
      <div class="hero-rule" aria-hidden="true"></div>
      <p class="hero-sub" style="<%= _heroSSize %>"><%= hero.subtext || 'Top brands, delivered free to your door.' %></p>
      <p class="hero-sub2" style="<%= _heroS2Size %>"><%= hero.sub2_text || 'James Martin · Kohler · Moen · Delta and more' %></p>
      <div class="hero-ctas" style="<%= _ctaAlign %>">
        <a href="<%= hero.cta1_url || '/collections/bathroom-vanities' %>" class="btn btn-navy"><%= hero.cta1_text || 'Shop Vanities' %></a>
        <% if (hero.cta2_text || hero.cta2_url) { %>
        <a href="<%= hero.cta2_url || '/collections/sale' %>" class="btn btn-sage"><%= hero.cta2_text || 'View Sale' %></a>
        <% } %>
      </div>
    </div>
  </div>
  <div class="hero-image">
    <div class="hero-overlay" aria-hidden="true"></div>
    <%/* Desktop image — always rendered with hero-poster class for consistent mobile CSS targeting.
        Gets hero-img-desktop class only when a separate mobile image is set, so CSS can swap them. */%>
    <% if (hero.image_url) { %>
    <img class="hero-poster<%= hero.mobile_image_url ? ' hero-img-desktop' : '' %>"
         src="<%= hero.image_url %>"
         alt="<%= hero.image_alt || (S.global || {}).site_name || 'Bathroom Vanities Outlet - Quality Bath Vanity Cabinets and More' %>"
         loading="eager">
    <% } %>
    <%/* Mobile image — hidden on desktop, swaps in at ≤860px when set */%>
    <% if (hero.mobile_image_url) { %>
    <img class="hero-img-mobile"
         src="<%= hero.mobile_image_url %>"
         alt="<%= hero.mobile_image_alt || hero.image_alt || (S.global || {}).site_name || 'Bathroom Vanities Outlet - Quality Bath Vanity Cabinets and More' %>"
         loading="eager">
    <% } %>
    <%/* Video — only when video_url is set */%>
    <% if (hero.video_url) { %>
      <% if (_isYT(hero.video_url)) { var _ytVid = _ytId(hero.video_url); %>
        <% if (_ytVid) { %>
        <div class="hero-video-wrap">
          <%/* data-src instead of src — JS injects after window.load so YouTube never blocks FCP */%>
          <iframe class="hero-video-iframe" data-hero-video="yt"
            data-src="https://www.youtube-nocookie.com/embed/<%= _ytVid %>?autoplay=1&mute=1&loop=1&controls=0&playlist=<%= _ytVid %>&rel=0&showinfo=0&modestbranding=1&playsinline=1&cc_load_policy=0&iv_load_policy=3&fs=0&disablekb=1"
            allow="autoplay; encrypted-media; picture-in-picture" frameborder="0" aria-hidden="true" tabindex="-1" title="Hero background video">
          </iframe>
        </div>
        <% } %>
      <% } else { %>
      <video class="hero-video-player" data-hero-video="mp4" autoplay muted loop playsinline preload="metadata">
        <source src="<%= hero.video_url %>" type="video/mp4">
      </video>
      <% } %>
    <% } %>
    <% if (!hero.image_url && !hero.mobile_image_url && !hero.video_url) { %>
    <div class="hero-img-placeholder" aria-hidden="true">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      <span>Hero image</span>
    </div>
    <% } %>
  </div>
</section>

<!-- ── MOBILE HERO (phone-only ≤480px) ──────────────────────────── -->
<%
  var _hm       = S.hero_mobile || {};
  var _hmEna    = (_hm.enabled !== false);
  var _hmLayout = _hm.layout || 'bg';
  var _hmTag    = _safeTag(_hm.heading_level, 'h1');
  var _hmAlign  = _hm.text_align || 'center';
  var _hmHSize  = _hm.heading_size  ? 'font-size:'+_hm.heading_size+'px;'  : '';
  var _hmSSize  = _hm.subtext_size  ? 'font-size:'+_hm.subtext_size+'px;'  : '';
  var _hmH2Size = (+_hm.h2_size  > 0) ? 'font-size:'+_hm.h2_size+'px;'  : '';
  var _hmESize  = (+_hm.eyebrow_size > 0 && _hm.eyebrow_size != 11) ? 'font-size:'+_hm.eyebrow_size+'px;' : '';
  var _hmS2Size = (+_hm.sub2_size > 0 && _hm.sub2_size != 14) ? 'font-size:'+_hm.sub2_size+'px;' : '';
  var _hmBdSize = (+_hm.badge_size > 0 && _hm.badge_size != 10) ? 'font-size:'+_hm.badge_size+'px;' : '';
  var _hmStyle  = '';
  var _hmCtaAl  = '';
  if (_hmEna) {
    var _hmOvClr  = _hm.overlay_color || '#0f1f35';
    var _hmOvOp   = (_hm.overlay_opacity !== undefined) ? (+_hm.overlay_opacity / 100).toFixed(2) : '0.55';
    _hmStyle = '--ov-clr:'+_hmOvClr+';--ov-op:'+_hmOvOp+';';
    if (_hmLayout === 'split') {
      var _hmTxtPct = parseInt(_hm.text_col_pct) || 50;
      _hmStyle += 'grid-template-columns:'+_hmTxtPct+'% '+(100-_hmTxtPct)+'%;';
    }
    if (+_hm.height_vh > 0)           _hmStyle += 'height:'+_hm.height_vh+'vh;';
    if (+_hm.min_height_px > 0)       _hmStyle += 'min-height:'+_hm.min_height_px+'px;';
    if (+_hm.max_height_px === 0)     _hmStyle += 'max-height:none;';
    else if (+_hm.max_height_px > 0)  _hmStyle += 'max-height:'+_hm.max_height_px+'px;';
    if (_hm.eyebrow_color)  _hmStyle += '--hero-eyebrow:'+_hm.eyebrow_color+';';
    if (_hm.heading_color)  _hmStyle += '--hero-h1:'+_hm.heading_color+';';
    if (_hm.h2_color)       _hmStyle += '--hero-h2:'+_hm.h2_color+';';
    if (_hm.subtext_color)  _hmStyle += '--hero-sub:'+_hm.subtext_color+';';
    if (_hm.sub2_color)     _hmStyle += '--hero-sub2:'+_hm.sub2_color+';';
    var _hmBoxClr = _hm.content_box_color || '#0f1f35';
    var _hmBoxOp  = (_hm.content_box_opacity !== undefined) ? _hm.content_box_opacity : 60;
    var _hmBoxHx  = String(_hmBoxClr).match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})/i);
    if (_hmBoxHx) _hmStyle += '--content-box-bg:rgba('+parseInt(_hmBoxHx[1],16)+','+parseInt(_hmBoxHx[2],16)+','+parseInt(_hmBoxHx[3],16)+','+(_hmBoxOp/100).toFixed(2)+');';
    if (+_hm.content_box_padding > 0)  _hmStyle += '--content-box-pad:'+_hm.content_box_padding+'px;';
    if (+_hm.content_box_radius  >= 0) _hmStyle += '--content-box-radius:'+_hm.content_box_radius+'px;';
    if (+_hm.content_max_width   > 0)  _hmStyle += '--content-max-w:'+_hm.content_max_width+'px;';
    if (_hm.content_v_offset !== undefined && _hm.content_v_offset !== '') _hmStyle += '--content-v-offset:'+_hm.content_v_offset+'%;';
    if (_hm.content_h_offset !== undefined && _hm.content_h_offset !== '') _hmStyle += '--content-h-offset:'+_hm.content_h_offset+'%;';
    _hmCtaAl = _hmAlign==='center'?'justify-content:center':_hmAlign==='right'?'justify-content:flex-end':'';
  }
  /* Text/CTAs fall back to desktop hero when blank */
  var _hmImg   = _hm.image_url     || hero.image_url     || '';
  var _hmAlt   = _hm.image_alt     || hero.image_alt     || 'Hero';
  var _hmVid   = _hm.video_url     || '';
  if (_hmVid && _hmLayout === 'split') _hmLayout = 'bg';
  var _hmEye   = _hm.eyebrow       || hero.eyebrow       || '';
  var _hmH1    = _hm.heading_line1  || hero.heading_line1 || 'Premium Vanities.';
  var _hmH2    = _hm.heading_line2  || hero.heading_line2 || 'Outlet Prices.';
  var _hmSub   = _hm.subtext        || hero.subtext       || '';
  var _hmSub2  = _hm.sub2_text      || hero.sub2_text     || '';
  var _hmBadge = _hm.badge_text     || '';
  var _hmC1T   = _hm.cta1_text      || hero.cta1_text     || 'Shop Vanities';
  var _hmC1U   = _hm.cta1_url       || hero.cta1_url      || '/collections/bathroom-vanities';
  var _hmC2T   = _hm.cta2_text      || hero.cta2_text     || '';
  var _hmC2U   = _hm.cta2_url       || hero.cta2_url      || '';
  var _hmShad  = (_hm.text_shadow !== false);
%>
<% if (_hmEna) { %>
<section class="hero hero--<%= _hmLayout %> hero--mobile-version<%= _hmShad ? ' hero--text-shadow' : '' %>" data-section="hero_mobile" data-section-label="Hero (Mobile)" aria-label="Hero" style="<%= _hmStyle %>">
  <div class="hero-content" style="text-align:<%= _hmAlign %>">
    <div class="hero-content-box">
      <% if (_hmEye) { %><p class="hero-eyebrow" style="<%= _hmESize %>"><%= _hmEye %></p><% } %>
      <<%- _hmTag %> class="hero-h1" style="<%= _hmHSize %>"><%= _hmH1 %></<%- _hmTag %>>
      <p class="hero-h2" style="<%= _hmH2Size %>"><%= _hmH2 %></p>
      <div class="hero-rule" aria-hidden="true"></div>
      <% if (_hmSub) { %><p class="hero-sub" style="<%= _hmSSize %>"><%= _hmSub %></p><% } %>
      <% if (_hmSub2) { %><p class="hero-sub2" style="<%= _hmS2Size %>"><%= _hmSub2 %></p><% } %>
      <% if (_hmBadge) { %><span class="hero-badge" style="<%= _hmBdSize %>"><%= _hmBadge %></span><% } %>
      <div class="hero-ctas" style="<%= _hmCtaAl %>">
        <a href="<%= _hmC1U %>" class="btn btn-navy"><%= _hmC1T %></a>
        <% if (_hmC2T) { %><a href="<%= _hmC2U %>" class="btn btn-sage"><%= _hmC2T %></a><% } %>
      </div>
    </div>
  </div>
  <div class="hero-image">
    <div class="hero-overlay" aria-hidden="true"></div>
    <% if (_hmImg) { %>
    <img class="hero-poster" src="<%= _hmImg %>" alt="<%= _hmAlt %>" loading="eager" fetchpriority="high" decoding="async">
    <% } else { %>
    <div class="hero-img-placeholder" aria-hidden="true">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      <span>Upload mobile hero image</span>
    </div>
    <% } %>
    <% if (_hmVid) { %>
      <% if (_isYT(_hmVid)) { var _hmYtId = _ytId(_hmVid); %>
        <% if (_hmYtId) { %>
        <div class="hero-video-wrap">
          <iframe class="hero-video-iframe" data-hero-video="yt"
            data-src="https://www.youtube-nocookie.com/embed/<%= _hmYtId %>?autoplay=1&mute=1&loop=1&controls=0&playlist=<%= _hmYtId %>&rel=0&showinfo=0&modestbranding=1&playsinline=1&cc_load_policy=0&iv_load_policy=3&fs=0&disablekb=1"
            allow="autoplay; encrypted-media; picture-in-picture" frameborder="0" aria-hidden="true" tabindex="-1" title="Hero background video">
          </iframe>
        </div>
        <% } %>
      <% } else { %>
      <video class="hero-video-player" data-hero-video="mp4" autoplay muted loop playsinline preload="metadata">
        <source src="<%= _hmVid %>" type="video/mp4">
      </video>
      <% } %>
    <% } %>
  </div>
</section>
<% } %>

<!-- ── VALUE PROPS (always follows hero) ────────────────────────── -->
<div class="value-bar" aria-label="Why shop with us">
  <div class="value-item">
    <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
    <p class="vb-title">Free Shipping</p><p>On every order, every time — no minimums</p>
  </div>
  <div class="value-item">
    <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    <p class="vb-title">Secure Checkout</p><p>256-bit SSL encryption on every transaction</p>
  </div>
  <div class="value-item">
    <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
    <p class="vb-title">Easy Returns</p><p>30-day hassle-free returns on all items</p>
  </div>
  <div class="value-item">
    <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.77a16 16 0 0 0 6 6l.86-.86a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    <p class="vb-title">Expert Support</p><p>Live chat &amp; phone help from bath specialists</p>
  </div>
</div>
<% } /* end hero */ %>

<!-- ── BRAND LOGOS ───────────────────────────────────────────────── -->
<% if (sectionKey === 'brand_logos' && bl.enabled !== false && bl.logos && bl.logos.length) { %>
<section class="brand-logos-section" data-section="brand_logos" data-section-label="Brand Logos" aria-label="Brands we carry">
  <% if (bl.eyebrow) { %><p class="brand-logos-eyebrow"><%= bl.eyebrow %></p><% } %>
  <div class="brand-logos-marquee">
    <div class="brand-logos-track" aria-hidden="false">
      <% ;[...bl.logos, ...bl.logos, ...bl.logos].forEach(function(logo) { %>
      <a href="<%= logo.url || '#' %>" class="brand-logo-item" aria-label="<%= logo.name %>">
        <% if (logo.image_url) { %>
        <img src="<%= logo.image_url %>" alt="<%= logo.name %>" loading="eager" decoding="async">
        <% } %>
        <span class="brand-logo-text"><%= logo.name %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } /* end brand_logos */ %>

<!-- ── CATEGORY CAROUSEL ──────────────────────────────────────────── -->
<% if (sectionKey === 'categories_section' && cs.enabled !== false && categories && categories.length) { %>
<%
  var _csTag   = _safeTag(cs.title_level, 'h2');
  var _csAlign = cs.text_align  || 'center';
%>
<section class="section" data-section="categories_section" data-section-label="Category Grid" aria-labelledby="cat-heading">
  <div class="section-header" style="text-align:<%= _csAlign %>">
    <p class="section-eyebrow"><%= cs.eyebrow || 'Browse by Category' %></p>
    <<%- _csTag %> class="section-title" id="cat-heading"><%= cs.title || 'Everything Your Bathroom Needs' %></<%- _csTag %>>
    <% if (cs.subtitle) { %><p class="section-sub"><%= cs.subtitle %></p><% } %>
  </div>

  <div class="cat-carousel-outer">
    <button class="fm-arrow fm-arrow--left" id="catArrowLeft" aria-label="Scroll left" hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>

    <div class="cat-carousel-track" id="catCarouselTrack">
      <% categories.forEach(function(cat) { %>
      <a href="/collections/<%= cat.slug %>" class="cat-card">
        <div class="cat-img">
          <% if (cat.image_url) { %>
            <img src="<%= cat.image_url %>" alt="<%= cat.name %>" loading="lazy">
          <% } else { %>
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <% } %>
        </div>
        <div class="cat-body">
          <h3><%= cat.name %></h3>
          <p><%- cat.description %></p>
          <span class="cat-link">Shop Now →</span>
        </div>
      </a>
      <% }); %>
    </div>

    <button class="fm-arrow fm-arrow--right" id="catArrowRight" aria-label="Scroll right">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>
</section>
<% } /* end categories_section */ %>

<!-- ── FEATURED PRODUCTS ─────────────────────────────────────────── -->
<% if (sectionKey === 'featured_section' && fs_.enabled !== false) { %>
<%
  var _fsTag   = _safeTag(fs_.title_level, 'h2');
  var _fsAlign = fs_.text_align  || 'center';
%>
<section class="section section-alt" data-section="featured_section" data-section-label="Featured Products" aria-labelledby="feat-heading">
  <div class="section-header" style="text-align:<%= _fsAlign %>">
    <p class="section-eyebrow"><%= fs_.eyebrow || 'Staff Picks' %></p>
    <<%- _fsTag %> class="section-title" id="feat-heading"><%= fs_.title || 'Featured Products' %></<%- _fsTag %>>
    <% if (fs_.subtitle) { %><p class="section-sub"><%= fs_.subtitle %></p><% } %>
  </div>
  <div class="product-grid">
    <% products.forEach(function(product) { %>
    <%
      var _hpImgId = 'feat-img-' + product.id;
    %>
    <%
      var _fpSwatches     = (product.finishes || []).slice(0, 4);
      var _fpSwatchExtra  = (product.finishes || []).length > 4 ? product.finishes.length - 4 : 0;
      var _fpQtyRaw       = parseInt(product.qty_on_hand || 0, 10);
      var _fpQtyDisplay   = Math.min(_fpQtyRaw, 4);
    %>
    <%# HOMEPAGE ONLY — zoom on hover, never the second-image swap.

        has-hover-img is deliberately NOT applied here. The existing rule

          .product-card:not(.has-hover-img):hover .product-img-pri
            { transform: scale(1.04) }

        then applies, which is the SAME 1.04 the model cards use
        (.model-card:hover .model-card-img). Two card types sit side by side
        on this page and were behaving differently: one zoomed, the other
        cut to a second photo shot at a different distance and crop, so the
        row read as inconsistent.

        Collection pages keep the swap — there the second image is useful,
        because the visitor is comparing products rather than scanning a
        curated row.

        No CSS change was needed for this; the rule already existed. %>
    <article class="product-card<%= _fpQtyRaw === 0 ? ' product-card--no-stock' : '' %>">
      <a href="/products/<%= product.slug %>" class="product-img-link" aria-label="<%= product.name %>">
        <div class="product-img">
          <% if (product.primary_image) { %>
            <img class="product-img-pri" src="<%= product.primary_image %>" alt="<%= product.name %>" loading="lazy"
                 id="<%= _hpImgId %>">
              <%# No hover image on the homepage. Leaving it in the DOM at
                  opacity:0 would cost a lazy image request per card for
                  something that can never be shown — hidden work is still
                  work. product.hover_image is untouched in the DB and is
                  still rendered on collection pages. %>
          <% } else { %>
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <% } %>
          <% if (product.badge) { %>
          <span class="product-badge badge-<%= product.badge %>"><%= product.badge.toUpperCase() %></span>
          <% } %>
          <% if (product.video_url) { %>
          <span class="product-video-badge" data-video-url="<%= product.video_url %>" aria-label="Watch video">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </span>
          <% } %>
        </div>
      </a>
      <div class="product-body">
        <% if (product.brand) { %><p class="product-brand"><%= product.brand %></p><% } %>
        <h3 class="product-title"><a href="/products/<%= product.slug %>"><%= product.name %></a></h3>

        <% if (_fpSwatches.length) { %>
        <div class="model-card-swatches" role="group" aria-label="Available finishes">
          <span class="model-card-swatches-label">Finishes:</span>
          <% _fpSwatches.forEach(function(f, i) { %>
          <%
            var _fpLight  = f.hex && ['#f5f5f3','#f0f0ef','#f5f5f5','#fafafa','#ffffff','#e8d9b8'].indexOf(f.hex.toLowerCase()) !== -1;
            var _fpBorder = _fpLight ? '#ccc' : (f.border || f.hex);
            var _fpWood   = ['wood_l','wood_m','wood_d'].indexOf(f.color_family) !== -1;
          %>
          <button class="model-card-swatch<%= i === 0 ? ' is-active' : '' %><%= _fpWood ? ' swatch--wood-grain' : '' %>"
                  data-target-img="<%= _hpImgId %>"
                  data-finish="<%= f.color %>"
                  <% if (f.image_url) { %>data-image="<%= f.image_url %>"<% } %>
                  <% if (f.sizeImages && Object.keys(f.sizeImages).length) { %>data-size-images="<%= JSON.stringify(f.sizeImages) %>"<% } %>
                  style="background:<%= f.hex %>;border-color:<%= _fpBorder %>"
                  aria-label="<%= f.color %>" title="<%= f.color %>"></button>
          <% }); %>
          <% if (_fpSwatchExtra > 0) { %>
          <span class="model-card-swatch-more" aria-hidden="true">+<%= _fpSwatchExtra %></span>
          <% } %>
        </div>
        <% } %>

        <% if (product.sizes && product.sizes.length) { %>
        <div class="model-card-sizes-row">
          <span class="model-card-sizes-label">Sizes:</span>
          <div class="model-card-size-chips">
            <% product.sizes.forEach(function(sz, i) { %>
            <% var _fpSzImg = product.sizeImageMap && product.sizeImageMap[sz.key] ? product.sizeImageMap[sz.key] : null; %>
            <button type="button"
                    class="model-card-size-btn<%= i === 0 ? ' is-active' : '' %>"
                    data-target-img="<%= _hpImgId %>"
                    data-size="<%= sz.key %>"
                    <% if (_fpSzImg) { %>data-image="<%= _fpSzImg %>"<% } %>
                    aria-label="<%= sz.label %>&quot; wide"
                    title="<%= sz.label %>&quot; wide">
              <%= sz.label %>
            </button>
            <% }); %>
          </div>
        </div>
        <% } %>

        <div class="product-price-row">
          <span class="product-price">$<%= product.price.toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
          <% if (product.compare_price && product.compare_price > product.price) { %>
          <span class="product-was">$<%= product.compare_price.toLocaleString('en-US',{minimumFractionDigits:2}) %></span>
          <span class="card-save-badge">Save $<%= Math.round(product.compare_price - product.price).toLocaleString('en-US') %></span>
          <% } %>
          <span class="card-qty<%= _fpQtyRaw === 0 ? ' card-qty--zero' : '' %>">QTY: <%= _fpQtyDisplay %></span>
        </div>
        <a href="/products/<%= product.slug %>" class="btn btn-sage">View Details</a>
      </div>
    </article>
    <% }) %>
  </div>
  <div class="section-cta">
    <a href="<%= fs_.cta_url || '/collections/bathroom-vanities' %>" class="btn btn-outline"><%= fs_.cta_text || 'View All Products' %></a>
  </div>
</section>
<% } /* end featured_section */ %>

<!-- ── FEATURED MODELS ───────────────────────────────────────────── -->
<% if (sectionKey === 'featured_models' && fm_.enabled !== false && typeof featuredModels !== 'undefined' && featuredModels && featuredModels.length) { %>
<% var _carouselModels = featuredModels; %>
<section class="section section-alt" id="featured-models-section" data-section="featured_models" data-section-label="Featured Models" aria-labelledby="feat-models-heading">
  <div class="section-header" style="text-align:<%= fm_.text_align || 'center' %>">
    <p class="section-eyebrow"><%= fm_.eyebrow || 'Shop by Collection' %></p>
    <h2 class="section-title" id="feat-models-heading"><%= fm_.title || 'Featured Models' %></h2>
    <p class="section-sub"><%= fm_.subtitle || 'Explore our most popular vanity collections — click a finish to see it in action.' %></p>
  </div>

  <div class="fm-carousel-outer">
    <button class="fm-arrow fm-arrow--left" id="fmArrowLeft" aria-label="Scroll left" hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>

    <div class="fm-carousel-track" id="fmCarouselTrack">
      <% _carouselModels.forEach(function(m) { %>
      <%
        var _discPct         = m.compare_price_from ? Math.round((1 - m.price_from / m.compare_price_from) * 100) : 0;
        var _saveAmt         = (m.compare_price_from && m.price_from && m.compare_price_from > m.price_from)
                                 ? Math.round(m.compare_price_from - m.price_from) : 0;
        var _visibleSwatches = m.finishes.slice(0, 4);
        var _extraSwatches   = m.finishes.length > 4 ? m.finishes.length - 4 : 0;
        // Model card ids and links must carry BRAND, not just model.
        //
        // Two brands sell a "Bristol". With model alone both cards emitted
        // id="model-img-bristol", and site.js resolves a swatch click with
        // getElementById(dataset.targetImg) — which returns the FIRST match
        // in the document. Cards sort by brand, so clicking a swatch on the
        // James Martin card swapped the image and price on the ER Vanities
        // card. Duplicate ids are also invalid HTML.
        //
        // Not visible today only because page 1 holds 12 cards and JM's
        // Bristol falls to page 2 — any filter that thins the earlier JM
        // models puts them on one page and it fires.
        var _mSlug           = function (v) { return String(v || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); };
        var _mId             = m.model ? (_mSlug(m.model) + '-' + (_mSlug(m.brand) || 'nobrand')) : 'model';
        // Brand on the link too — without it the ER Bristol card led to a
        // grid holding both brands' Bristol products. getCollection already
        // parses req.query.brand, so this needs no controller change.
        var _mHref           = '/collections/bathroom-vanities?model=' + encodeURIComponent(m.model || '')
                               + (m.brand ? '&brand=' + encodeURIComponent(m.brand) : '');
        var _mImg            = m.image_url || '/images/placeholder-vanity.jpg';
      %>
      <article class="model-card" data-model="<%= m.model %>" data-sizes="<%= m.sizes.map(function(s){return s.key}).join(',') %>">

        <div class="model-card-img-wrap">
          <% if (_saveAmt > 0) { %>
          <span class="model-card-badge">Save $<%= _saveAmt.toLocaleString('en-US') %></span>
          <% } %>
          <a href="<%= _mHref %>" class="model-card-img-link" tabindex="-1" aria-hidden="true">
            <img src="<%= _mImg %>"
                 alt="<%= m.model %> vanity"
                 class="model-card-img"
                 id="model-img-<%= _mId %>"
                 loading="lazy">
          </a>
          <% if (m.video_url) { %>
          <span class="product-video-badge" data-video-url="<%= m.video_url %>" aria-label="Watch video">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </span>
          <% } %>
        </div>

        <div class="model-card-body">
          <%
            var _mPriceDefault = (m.price_to && m.price_to > m.price_from)
              ? ('$' + m.price_from.toLocaleString('en-US') + ' – $' + m.price_to.toLocaleString('en-US'))
              : ('From $' + m.price_from.toLocaleString('en-US'));
          %>
          <div class="model-card-price-row">
            <span class="model-card-price" id="model-price-<%= _mId %>" data-default="<%= _mPriceDefault %>"><%= _mPriceDefault %></span>
            <% if (m.compare_price_from && !(m.price_to && m.price_to > m.price_from)) { %>
            <span class="model-card-was">$<%= m.compare_price_from.toLocaleString('en-US') %></span>
            <% } %>
            <% if (_saveAmt > 0 && !(m.price_to && m.price_to > m.price_from)) { %>
            <span class="card-save-badge">Save $<%= _saveAmt.toLocaleString('en-US') %></span>
            <% } %>
          </div>

          <h3 class="model-card-name">
            <a href="<%= _mHref %>">The <%= m.model %> Collection</a>
          </h3>
          <p class="model-card-brand">Brand: <%= m.brand %></p>

          <div class="model-card-swatches" role="group" aria-label="Available finishes">
            <span class="model-card-swatches-label">Finishes:</span>
            <% _visibleSwatches.forEach(function(f, i) { %>
            <%
              var _isLight      = ['#F0F0EF','#F5F5F5','#FAFAFA','#FFFFFF','#C4A882'].indexOf(f.hex) !== -1;
              var _swatchBorder = _isLight ? '#ccc' : (f.border || f.hex);
            %>
            <button class="model-card-swatch<%= i === 0 ? ' is-active' : '' %>"
                    data-target-img="model-img-<%= _mId %>"
                    data-target-price="model-price-<%= _mId %>"
                    data-finish="<%= f.color %>"
                    <% if (f.image_url) { %>data-image="<%= f.image_url %>"<% } %>
                    <% if (f.sizeImages && Object.keys(f.sizeImages).length) { %>data-size-images="<%= JSON.stringify(f.sizeImages) %>"<% } %>
                    <% if (f.sizePrices && Object.keys(f.sizePrices).length) { %>data-size-prices="<%= JSON.stringify(f.sizePrices) %>"<% } %>
                    style="background:<%= f.hex %>;border-color:<%= _swatchBorder %>"
                    aria-label="<%= f.color %>"
                    title="<%= f.color %>"></button>
            <% }); %>
            <% if (_extraSwatches > 0) { %>
            <span class="model-card-swatch-more" aria-hidden="true">+<%= _extraSwatches %></span>
            <% } %>
          </div>

          <div class="model-card-sizes-row">
            <span class="model-card-sizes-label">Sizes:</span>
            <% if (m.sizes && m.sizes.length) { %>
            <div class="model-card-size-chips">
              <% m.sizes.forEach(function(sz, i) { %>
              <% var _szImg = m.sizeImageMap && m.sizeImageMap[sz.key] ? m.sizeImageMap[sz.key] : null; %>
              <button type="button"
                      class="model-card-size-btn<%= i === 0 ? ' is-active' : '' %>"
                      data-target-img="model-img-<%= _mId %>"
                      data-target-price="model-price-<%= _mId %>"
                      data-size="<%= sz.key %>"
                      data-price-from="<%= sz.priceFrom != null ? sz.priceFrom : '' %>"
                      <% if (_szImg) { %>data-image="<%= _szImg %>"<% } %>
                      aria-label="<%= sz.label %>&quot; wide"
                      title="<%= sz.label %>&quot; wide">
                <%= sz.label %>
              </button>
              <% }); %>
            </div>
            <% } else { %>
            <span class="model-card-sizes-text">See details</span>
            <% } %>
          </div>

          <a href="<%= _mHref %>" class="btn btn-outline model-card-cta">
            Shop the <%= m.model %>
          </a>
        </div>
      </article>
      <% }); %>
    </div><!-- /#fmCarouselTrack -->

    <button class="fm-arrow fm-arrow--right" id="fmArrowRight" aria-label="Scroll right">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div><!-- /.fm-carousel-outer -->

  <div class="section-cta">
    <a href="<%= fm_.cta_url || '/collections/vanity-models' %>" class="btn btn-navy"><%= fm_.cta_text || 'See All Our Models' %></a>
  </div>
</section>
<% } /* end featured_models */ %>

<!-- ── INSPIRATION GUIDES ────────────────────────────────────────── -->
<% if (sectionKey === 'inspiration' && typeof inspirationPages !== 'undefined' && inspirationPages && inspirationPages.length) { %>
<section class="hp-inspo" id="inspiration-section" data-section="inspiration" data-section-label="Style Guides">
  <div class="hp-inspo-inner">
    <div class="hp-inspo-header">
      <div>
        <p class="hp-inspo-eyebrow">Style Guides</p>
        <h2 class="hp-inspo-title">Bathroom Vanity Ideas &amp; Inspiration</h2>
      </div>
      <a href="/inspiration" class="hp-inspo-all-link">Browse All Guides →</a>
    </div>
    <div class="hp-inspo-grid">
      <% inspirationPages.forEach(function(p) { %>
      <a href="/inspiration/<%= p.slug %>" class="hp-inspo-card">
        <div class="hp-inspo-card-img-wrap">
          <% if (p.og_image) { %>
          <img src="<%= p.og_image %>" alt="<%= p.title %>" class="hp-inspo-card-img" loading="lazy" width="400" height="225">
          <% } else { %>
          <div class="hp-inspo-card-placeholder">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
          <% } %>
        </div>
        <div class="hp-inspo-card-body">
          <span class="hp-inspo-card-label">Style Guide</span>
          <h3 class="hp-inspo-card-title"><%= p.title %></h3>
          <% if (p.meta_desc) { %><p class="hp-inspo-card-desc"><%= p.meta_desc.substring(0, 100) + (p.meta_desc.length > 100 ? '…' : '') %></p><% } %>
          <span class="hp-inspo-card-cta">Read guide →</span>
        </div>
      </a>
      <% }) %>
    </div>
    <div class="hp-inspo-footer">
      <a href="/inspiration" class="hp-inspo-browse-btn">Browse All Style Guides</a>
    </div>
  </div>
</section>
<% } /* end inspiration */ %>

<!-- ── IMAGE WITH TEXT ───────────────────────────────────────────── -->
<!-- ── IMAGE WITH TEXT (any copy) ────────────────────────────────── -->
<% if (_baseKey === 'image_with_text' && _d.enabled !== false) { %>
<%
  var _iwtTag       = _safeTag(_d.heading_level, 'h2');
  var _iwtHSize     = _d.heading_size ? 'font-size:'+_d.heading_size+'px;' : '';
  var _iwtBSize     = _d.body_size    ? 'font-size:'+_d.body_size+'px;'    : '';
  var _iwtImgW      = _d.image_width    || '50%';
  var _iwtIsOverlay = _d.image_position === 'center';
  var _iwtIsRight   = _d.image_position === 'right';
  var _iwtTextAlign = _d.text_align     || 'left';
  var _iwtGridCls   = 'iwt-grid'
                    + (_iwtIsRight && !_iwtIsOverlay ? ' iwt-reverse' : '')
                    + (_iwtIsOverlay                 ? ' iwt-overlay-mode' : '');
  var _iwtDefault   = sectionKey === 'image_with_text' ? 'The Bathroom Renovation Experts' : '';
%>
<section class="section iwt-section" data-section="<%= sectionKey %>" data-section-label="Image with Text" aria-labelledby="iwt-heading-<%= sectionKey %>">
  <div class="container">
    <div class="<%= _iwtGridCls %>">
      <div class="iwt-image-col"<%= !_iwtIsOverlay ? ' style="flex:0 0 '+_iwtImgW+'; max-width:'+_iwtImgW+'"' : '' %>>
        <% if (_d.image_url) { %>
        <img src="<%= _d.image_url %>" alt="<%= _d.image_alt || '' %>" loading="lazy" class="iwt-img" width="380" height="285">
        <% } %>
      </div>
      <div class="iwt-text-col" style="text-align:<%= _iwtIsOverlay ? 'center' : _iwtTextAlign %>">
