<div class="account-page">
  <div class="account-sidebar">
    <nav class="account-nav" aria-label="Account navigation">
      <a href="/account" class="account-nav-item">Dashboard</a>
      <a href="/account/orders" class="account-nav-item">Orders</a>
      <a href="/account/favorites" class="account-nav-item">Saved Items</a>
      <a href="/account/bundles" class="account-nav-item active">Saved Bundles</a>
      <a href="/account/addresses" class="account-nav-item">Addresses</a>
      <form action="/account/logout" method="POST" style="margin:0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="account-nav-item account-nav-logout">Sign Out</button>
      </form>
    </nav>
  </div>

  <div class="account-main">
    <h1 class="account-title">Saved Bundles</h1>

    <% if (!bundles || bundles.length === 0) { %>
    <div class="favorites-empty">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto 16px;display:block;stroke:var(--muted)" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
      </svg>
      <p style="font-size:1rem;margin-bottom:8px">No saved bundles yet.</p>
      <p style="font-size:.875rem;margin-bottom:24px">Build a vanity, top, mirror and faucet together, then save it to come back to.</p>
      <a href="/bundle" class="btn btn-sage">Open the Bundle Builder</a>
    </div>
    <% } else { %>

    <%# Prices are read LIVE from products on every view — never from a
        snapshot taken when the bundle was saved. A shortlist that quietly
        showed a three-week-old price would be a figure the customer could
        reasonably expect us to honour. %>
    <p class="sb-note">Prices update with the current catalogue, so what you see here is what you'd pay today.</p>

    <% bundles.forEach(function (b) { %>
    <article class="sb-card">
      <div class="sb-card-head">
        <span class="sb-date">Saved <%= new Date(b.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
        <form action="/account/bundles/<%= b.id %>/delete" method="POST" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="sb-remove">Remove</button>
        </form>
      </div>

      <div class="sb-items">
        <% b.items.forEach(function (it) { %>
        <div class="sb-item">
          <a href="/products/<%= it.product.slug %>" class="sb-item-img" aria-label="<%= it.product.name %>">
            <% if (it.product.primary_image_url) { %>
            <img src="<%= it.product.primary_image_url %>" alt="<%= (it.product.brand ? it.product.brand + ' ' : '') + it.product.name %>" loading="lazy">
            <% } %>
          </a>
          <div class="sb-item-body">
            <span class="sb-slot"><%= it.slot %><% if (it.qty > 1) { %> &times;<%= it.qty %><% } %></span>
            <a href="/products/<%= it.product.slug %>" class="sb-item-name"><%= it.product.name %></a>
            <span class="sb-item-price">$<%= (parseFloat(it.product.price) * it.qty).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
          </div>
        </div>
        <% }) %>
      </div>

      <%# Said plainly rather than hidden. A bundle silently one item lighter
          than when it was saved is worse than one that explains itself. %>
      <% if (b.missing > 0) { %>
      <p class="sb-missing"><%= b.missing %> item<%= b.missing > 1 ? 's are' : ' is' %> no longer available and <%= b.missing > 1 ? 'have' : 'has' %> been left out of this total.</p>
      <% } %>

      <div class="sb-card-foot">
        <span class="sb-total">Total today: <strong>$<%= b.total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></span>
        <% if (b.items.length) { %>
        <button type="button" class="btn btn-navy sb-add" data-bundle-id="<%= b.id %>"
                data-items="<%= JSON.stringify(b.items.map(function (i) { return { id: i.product.id, slug: i.product.slug, name: i.product.name, price: i.product.price, compare_price: i.product.compare_price, image: i.product.primary_image_url, qty: i.qty }; })) %>">
          Add to Cart
        </button>
        <% } %>
      </div>
    </article>
    <% }) %>
    <% } %>
  </div>
</div>

<script nonce="<%= cspNonce %>">
/* Add a saved bundle to the cart. Sequential, NOT Promise.all — the cart
   lives in the session, so parallel adds each read the same cart, add one
   item and save, with the last write winning. Same reasoning and the same
   failure already fixed once in the bundle builder itself. */
document.addEventListener('click', function (e) {
  var btn = e.target.closest('.sb-add');
  if (!btn) return;
  var items;
  try { items = JSON.parse(btn.dataset.items || '[]'); } catch (err) { return; }
  if (!items.length) return;

  btn.disabled = true;
  var original = btn.textContent;
  btn.textContent = 'Adding…';

  var flat = [];
  items.forEach(function (it) { for (var i = 0; i < (it.qty || 1); i++) flat.push(it); });

  flat.reduce(function (chain, it) {
    return chain.then(function () {
      var fd = new URLSearchParams();
      fd.append('product_id',     it.id);
      fd.append('slug',           it.slug);
      fd.append('name',           it.name);
      fd.append('price',          it.price);
      fd.append('image',          it.image || '');
      fd.append('original_price', it.price);
      fd.append('compare_price',  it.compare_price || '');
      fd.append('qty', '1');
      return fetch('/cart/add', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
        body: fd
      }).then(function (r) {
        if (!r.ok) return r.json().catch(function () { return {}; }).then(function (d) {
          throw new Error(d.error || ('Server error ' + r.status));
        });
      });
    });
  }, Promise.resolve())
  .then(function () { window.location.href = '/cart'; })
  .catch(function (err) {
    btn.disabled = false;
    btn.textContent = original;
    alert('Could not add this bundle to the cart. ' + (err.message || ''));
  });
});
</script>
