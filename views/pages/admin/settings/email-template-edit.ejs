<%- layout('layouts/admin') %>

<!-- ══ Toolbar ══════════════════════════════════════════════════════ -->
<div class="adm-toolbar">
  <div class="adm-back-wrap">
    <a href="/admin/settings/email-templates" class="adm-back-link">← Email Templates</a>
    <span class="adm-toolbar-title"><%= pageTitle %></span>
  </div>
  <button id="saveBtn" class="btn btn-primary">Save Template</button>
</div>

<div class="tpl-edit-grid">

  <!-- Editor -->
  <div class="tpl-edit-main">
    <div class="admin-card">
      <label class="adm-label">Subject Line</label>
      <input type="text" id="tplSubject" class="adm-input" value="<%= tpl.subject %>" placeholder="Email subject…">

      <label class="adm-label">Email Body (HTML)</label>
      <p style="font-size:12px;color:var(--text-muted);margin:0 0 8px">Use <code>{{variable_name}}</code> placeholders. Basic HTML supported.</p>
      <textarea id="tplBody" class="adm-textarea tpl-body-editor" rows="20"><%= tpl.body_html %></textarea>
    </div>

    <!-- Preview -->
    <div class="admin-card" style="margin-top:16px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <h3 class="admin-card-title" style="margin:0">Preview</h3>
        <button class="btn btn-outline btn-sm" onclick="refreshPreview()">Refresh Preview</button>
      </div>
      <div class="tpl-preview-subject">
        <strong>Subject:</strong> <span id="previewSubject"><%= preview.subject %></span>
      </div>
      <iframe id="previewFrame" class="tpl-preview-frame" srcdoc="<%= preview.body_html.replace(/"/g, '&quot;') %>"></iframe>
    </div>
  </div>

  <!-- Variable Reference -->
  <div class="tpl-edit-sidebar">
    <div class="admin-card">
      <h3 class="admin-card-title">Available Variables</h3>
      <p style="font-size:12px;color:var(--text-muted);margin:0 0 12px">Click any variable to copy it.</p>
      <ul class="var-list">
        <% Object.entries(previewVars).forEach(([key, val]) => { %>
          <li class="var-item" onclick="copyVar('{{<%= key %>')">
            <code class="var-code">{{<%= key %>}}</code>
            <span class="var-example"><%= val %></span>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="admin-card" style="margin-top:16px">
      <h3 class="admin-card-title">Template Info</h3>
      <div class="detail-meta">
        <div class="detail-meta-row"><span>Trigger</span><code style="font-size:12px"><%= tpl.trigger_key %></code></div>
        <div class="detail-meta-row"><span>Last saved</span><span><%= new Date(tpl.updated_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></span></div>
      </div>
    </div>
  </div>
</div>

<div id="saveMsg" style="display:none;position:fixed;bottom:24px;right:24px;background:var(--color-sage,#5a7a5a);color:#fff;padding:12px 20px;border-radius:8px;font-size:14px;font-weight:600;box-shadow:0 4px 12px rgba(0,0,0,.2)">
  ✓ Template saved
</div>

<script>
const PREVIEW_VARS = <%- JSON.stringify(previewVars) %>;

function substituteVars(str) {
  return str.replace(/\{\{(\w+)\}\}/g, (_, k) => PREVIEW_VARS[k] !== undefined ? PREVIEW_VARS[k] : '');
}

function refreshPreview() {
  const subject = document.getElementById('tplSubject').value;
  const body    = document.getElementById('tplBody').value;
  document.getElementById('previewSubject').textContent = substituteVars(subject);
  document.getElementById('previewFrame').srcdoc = substituteVars(body);
}

let _debounce;
['tplSubject','tplBody'].forEach(id => {
  document.getElementById(id).addEventListener('input', () => {
    clearTimeout(_debounce);
    _debounce = setTimeout(refreshPreview, 600);
  });
});

document.getElementById('saveBtn').addEventListener('click', async () => {
  const btn = document.getElementById('saveBtn');
  btn.disabled = true; btn.textContent = 'Saving…';
  const r = await fetch(window.location.pathname.replace('/edit',''), {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    body: JSON.stringify({
      subject:   document.getElementById('tplSubject').value,
      body_html: document.getElementById('tplBody').value,
    })
  });
  const d = await r.json();
  btn.disabled = false; btn.textContent = 'Save Template';
  if (d.ok) {
    const msg = document.getElementById('saveMsg');
    msg.style.display = 'block';
    setTimeout(() => { msg.style.display = 'none'; }, 3000);
  } else {
    alert('Save failed: ' + d.error);
  }
});

function copyVar(text) {
  navigator.clipboard.writeText(text + '}}').then(() => {
    const items = document.querySelectorAll('.var-item');
    items.forEach(el => { if (el.onclick.toString().includes(text.replace('{{',''))) el.classList.add('copied'); });
    setTimeout(() => document.querySelectorAll('.var-item.copied').forEach(el => el.classList.remove('copied')), 1200);
  });
}
</script>
