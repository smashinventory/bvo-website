<%
/* ── Computed vars ───────────────────────────────────────────── */
const noteEvents = events.filter(e => e.event_type === 'note_added');

/* ── Build fraud checklist ───────────────────────────────────── */
const checks = [];

/* Stripe card checks.
   Values are pass | fail | unavailable | unchecked — NOT Authorize.net's
   letter codes (Y/X/A/Z/W for AVS, M/N/P/S/U for CVV), which this panel
   decoded until 2026-09-25. Mapping the old letters onto these would read
   every check as a failure.

   'unavailable' and 'unchecked' are NOT warnings: plenty of issuers
   simply do not return a result, and treating silence as a red flag
   trains staff to ignore the panel. */
const CHECK_OK   = 'pass';
const CHECK_BAD  = 'fail';

if (order.payment_check_zip) {
  const v = order.payment_check_zip;
  checks.push({
    icon:  v === CHECK_OK ? 'ok' : v === CHECK_BAD ? 'warn' : 'info',
    label: v === CHECK_OK  ? 'Billing ZIP matches the card on file'
         : v === CHECK_BAD ? 'Billing ZIP did NOT match the card on file'
                           : 'Billing ZIP was not verified by the issuer',
  });
} else if (order.payment_status) {
  checks.push({ icon: 'info', label: 'Billing ZIP verification not available' });
}

if (order.payment_check_line1) {
  const v = order.payment_check_line1;
  checks.push({
    icon:  v === CHECK_OK ? 'ok' : v === CHECK_BAD ? 'warn' : 'info',
    label: v === CHECK_OK  ? 'Billing street address matches the card on file'
         : v === CHECK_BAD ? 'Billing street address did NOT match the card on file'
                           : 'Billing street address was not verified by the issuer',
  });
}

if (order.payment_check_cvc) {
  const v = order.payment_check_cvc;
  checks.push({
    icon:  v === CHECK_OK ? 'ok' : v === CHECK_BAD ? 'warn' : 'info',
    label: v === CHECK_OK  ? 'Card security code (CVC) matched'
         : v === CHECK_BAD ? 'Card security code (CVC) did not match'
                           : 'Card security code (CVC) was not verified',
  });
} else if (order.payment_status) {
  checks.push({ icon: 'info', label: 'Card security code (CVC) not available' });
}

const orderAmt = parseFloat(order.total || 0);
checks.push({
  icon:  orderAmt > 5000 ? 'info' : 'ok',
  label: orderAmt > 5000
    ? `High-value order ($${orderAmt.toFixed(2)}) — verify before capturing`
    : `Order amount within normal range ($${orderAmt.toFixed(2)})`,
});

if (order.customer_ip) {
  checks.push({ icon: 'info', label: `Order placed from IP ${order.customer_ip}` });
}

/* ── Stripe Radar ────────────────────────────────────────────────
   Replaced FraudLabs Pro on 2026-09-25.

   payment_risk_score is 0-99 and is ONLY populated on Radar Plus/Pro.
   On Lite and Standard it is null — which is not the same as zero. Zero
   would be a perfect score; null means the tier does not provide one, so
   the row is skipped rather than shown as a flawless result.

   Thresholds are Stripe's own defaults: 65+ elevated, 75+ high. */
if (order.payment_risk_level) {
  const lvl = order.payment_risk_level;
  const scoreStr = order.payment_risk_score != null
    ? ` (score ${order.payment_risk_score}/99)` : '';
  checks.push({
    icon:  lvl === 'highest' ? 'warn' : lvl === 'elevated' ? 'warn' : 'ok',
    label: lvl === 'highest'  ? `Stripe Radar: HIGH risk${scoreStr}`
         : lvl === 'elevated' ? `Stripe Radar: elevated risk${scoreStr}`
         : lvl === 'normal'   ? `Stripe Radar: normal risk${scoreStr}`
                              : `Stripe Radar: ${lvl}${scoreStr}`,
  });
} else if (order.payment_transaction_id) {
  /* A payment exists but Radar returned nothing. Worth surfacing: it
     usually means the tier has no scoring, and staff should not read an
     empty panel as "screened and clean". */
  checks.push({ icon: 'info', label: 'Stripe Radar: no risk assessment returned for this payment' });
}

if (order.payment_seller_message) {
  checks.push({ icon: 'info', label: order.payment_seller_message });
}

/* ── 3DS outcome ─────────────────────────────────────────────────
   Only rendered when Stripe actually returned a result.

   All three 3DS columns are null whenever 3DS was not invoked, which is
   the NORMAL case under request_three_d_secure 'automatic' — most
   low-risk cards never see it. Adding a row for the absence would put an
   'info' on almost every order and flip the whole panel to Medium, which
   is precisely how a panel stops being read.

   Never described as shifting liability. Stripe's own documentation is
   explicit that successful 3DS does not guarantee a liability shift, so
   this says what was authenticated and nothing about who pays. */
if (order.payment_3ds_result) {
  const r    = order.payment_3ds_result;
  const flow = order.payment_3ds_flow
    ? ` (${order.payment_3ds_flow})` : '';
  checks.push({
    icon:  r === 'authenticated'         ? 'ok'
         : r === 'attempt_acknowledged'  ? 'info'
         : r === 'exempted'              ? 'info'
                                         : 'warn',
    label: r === 'authenticated'        ? `Cardholder passed 3-D Secure${flow}`
         : r === 'attempt_acknowledged' ? `3-D Secure attempted; the issuer did not complete it${flow}`
         : r === 'exempted'             ? `3-D Secure exempted by the issuer${flow}`
         : r === 'not_authenticated'    ? `Cardholder FAILED 3-D Secure${flow}`
         : r === 'failed'               ? `3-D Secure failed${flow}`
                                        : `3-D Secure: ${r}${flow}`,
  });
}

/* ── Ship-to vs bill-to ──────────────────────────────────────────
   'info', deliberately not 'warn'.

   Shipping somewhere other than the cardholder's address is ordinary —
   gifts, job sites, second homes, a contractor buying for a client. It is
   the strongest single correlate of card-not-present fraud, so it must be
   visible, but on its own it is not evidence of anything and must not
   turn the panel red by itself. Combined with a failed check or an
   elevated Radar level it will. */
if (order.ship_bill_mismatch) {
  checks.push({
    icon:  'info',
    label: 'Delivering to a different address than the cardholder’s '
         + '— normal for a gift or job site, worth a call on a first order',
  });
}

/* ── Early Fraud Warning ─────────────────────────────────────────
   The issuer has told us this card was used fraudulently. Nothing else on
   this page outranks it, and it also gets a full-width banner above the
   page — a row in a sidebar card is not enough for the one signal that
   should stop a shipment. */
if (order.payment_efw_at) {
  const reasonMap = {
    made_with_stolen_card:      'the card was reported stolen',
    made_with_counterfeit_card: 'the card was counterfeit',
    unauthorized_use_of_card:   'the cardholder did not authorise it',
    misc:                       'reason not specified by the issuer',
  };
  checks.push({
    icon:  'warn',
    label: 'EARLY FRAUD WARNING from the card issuer — '
         + (reasonMap[order.payment_efw_reason] || order.payment_efw_reason || 'reason not given'),
  });
}

if (order.dispute_id) {
  checks.push({
    icon:  'warn',
    label: `Chargeback ${order.dispute_status === 'won' ? 'WON' : order.dispute_status === 'lost' ? 'LOST' : 'open'}`
         + (order.dispute_reason ? ` — ${String(order.dispute_reason).replace(/_/g, ' ')}` : ''),
  });
}

const hasWarn  = checks.some(c => c.icon === 'warn');
const infoOnly = !hasWarn && checks.some(c => c.icon === 'info');
const riskPct   = hasWarn ? 90 : infoOnly ? 45 : 18;
const riskColor = hasWarn ? 'var(--red)' : infoOnly ? '#F59E0B' : 'var(--green)';
const riskLabel = hasWarn ? 'High' : infoOnly ? 'Medium' : 'Low';
const riskPill  = hasWarn ? 'red'  : infoOnly ? 'yellow' : 'green';

/* ── Payment status helpers ──────────────────────────────────── */
const isAuthOnly    = order.payment_status === 'auth_only';
const isCaptured    = order.payment_status === 'captured';
const hasPayment    = !!order.payment_transaction_id;
%>

<%
/* ══ Issuer alerts ═══════════════════════════════════════════════
   Above the toolbar, full width, before anything else on the page.

   A row in the sidebar risk card is not sufficient for these two. An
   Early Fraud Warning is the issuer stating the card was used
   fraudulently, and the whole value of it under manual capture is that
   someone sees it BEFORE pressing Capture. If it can be scrolled past,
   it will be. */
const efwAt = order.payment_efw_at ? new Date(order.payment_efw_at) : null;
const dueAt = order.dispute_evidence_due_at ? new Date(order.dispute_evidence_due_at) : null;
/* FLOOR, not ceil, and "passed" decided by the clock rather than by the
   day count.

   ceil() rounds a deadline 2 days and 1 hour away up to "3 days left",
   which overstates the time remaining on the one field where running out
   loses the money by default. floor() understates it, which is the safe
   direction. floor() alone would then report 0 for anything inside the
   last 24 hours, so "passed" is tested against the actual timestamp and
   0 is rendered as "due today" rather than as already lost. */
const duePassed = dueAt ? dueAt.getTime() <= Date.now() : false;
const dueDays   = dueAt ? Math.floor((dueAt.getTime() - Date.now()) / 86400000) : null;
const disputeOpen = order.dispute_id
  && !['won','lost','warning_closed'].includes(order.dispute_status || '');
%>

<% if (efwAt) { %>
<div style="border:2px solid var(--red);background:#fff5f5;border-radius:6px;padding:14px 18px;margin-bottom:16px">
  <p style="margin:0 0 6px;font-weight:700;color:var(--red);font-size:15px">
    Early Fraud Warning from the card issuer
  </p>
  <p style="margin:0 0 8px;font-size:13px">
    Reported <%= efwAt.toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' }) %><%
    if (order.payment_efw_reason) { %> &mdash; <%=
      String(order.payment_efw_reason).replace(/_/g, ' ') %><% } %>.
    The issuer is saying this card was used without authority.
  </p>
  <% if (isAuthOnly) { %>
    <%/* The whole point of manual capture. Nothing has been taken yet, so
         releasing costs nothing and there is no chargeback to defend. */%>
    <p style="margin:0;font-size:13px;font-weight:600">
      Funds are still only held. Release the hold rather than capturing &mdash;
      do not ship.
    </p>
  <% } else if (isCaptured) { %>
    <p style="margin:0;font-size:13px;font-weight:600">
      This order was already captured. Expect a chargeback. Refunding now is
      usually cheaper than losing a dispute, and stops the shipment if it has
      not gone out.
    </p>
  <% } %>
</div>
<% } %>

<%/* ── EMAIL VERIFICATION — context for the verification call ─────────
     Owner-approved 2026-09-28: "an additional indicator for fraud for us
     (internal indicator - not a deal breaker)."

     ⛔ ADVISORY ONLY, like the address panel below. Nothing here gates
     Capture. Verification is OPTIONAL for the buyer by design — the
     order completes whether or not they ever click — so treating an
     unconfirmed address as a blocker would punish customers for a
     choice we deliberately gave them.

     ALWAYS RENDERS, unlike the address panel. A missing flag and an
     absent panel are indistinguishable at a glance, and "did they
     confirm?" is a question the rep asks on every call — so it has to
     have a visible answer every time, including "no".

     THE TIMING IS THE INTERESTING PART. Verified is stored on the
     customer, so it can predate this order. "Confirmed two minutes
     after ordering" and "confirmed eight months ago" are very different
     stories, and neither is visible from a tick alone. */%>
<div class="adm-card" style="margin-bottom:1rem">
  <h2 class="adm-card-title" style="margin-bottom:.5rem">Email address</h2>
  <% if (order.email_verified_at) {
       const vAt  = new Date(order.email_verified_at);
       const oAt  = order.created_at ? new Date(order.created_at) : null;
       const good = !isNaN(vAt.getTime());
       /* Before/after THIS order, not an absolute date the reader has to
          diff in their head against the order date further up the page. */
       const rel  = (good && oAt && !isNaN(oAt.getTime()))
         ? (vAt < oAt ? 'before this order was placed' : 'after this order was placed')
         : '';
       const when = good
         ? vAt.toLocaleString('en-US', { timeZone: 'America/New_York',
             year: 'numeric', month: 'short', day: 'numeric',
             hour: 'numeric', minute: '2-digit' })
         : '—';
  %>
    <p style="margin:0;font-size:.9rem">
      <span class="email-vflag email-vflag--yes">&#10003; confirmed</span>
      <span style="color:var(--text-muted,#687281)">
        <%= when %><%= rel ? ' — ' + rel : '' %>
        <% if (order.email_verified_method === 'code') { %>
          &middot; signed in with a code
        <% } else if (order.email_verified_method === 'order_link') { %>
          &middot; clicked the link in an order email
        <% } %>
      </span>
    </p>
    <% if (order.email_verified_method === 'order_link') { %>
      <%/* Said plainly because the two are NOT equal evidence: a code is
           typed by a human within twenty minutes, where an order link
           lives seven days in a mailbox and confirmations get
           forwarded. Worth a shade more care on the call. */%>
      <p style="margin:.4rem 0 0;font-size:.82rem;color:var(--text-muted,#687281)">
        Weaker proof than a code sign-in — an order email can be forwarded.
      </p>
    <% } %>
  <% } else { %>
    <p style="margin:0;font-size:.9rem">
      <span class="email-vflag email-vflag--no">email unconfirmed</span>
      <span style="color:var(--text-muted,#687281)">
        This customer has never proven they can read mail at this address.
      </span>
    </p>
    <p style="margin:.4rem 0 0;font-size:.82rem;color:var(--text-muted,#687281)">
      Common and usually harmless — confirming is optional. Worth noting
      on the verification call alongside anything else on this screen,
      not on its own.
    </p>
  <% } %>
</div>

<%/* ── ADDRESS HISTORY — items 6/9 ────────────────────────────────────
     Context for the verification call that already happens before
     capture.

     ⛔ ADVISORY ONLY. Nothing here gates the Capture button. That is
     item 4, a separate mechanism with a separate decision. The moment
     an advisory flag starts blocking money, someone starts suppressing
     it.

     FACTS, NOT A VERDICT. There is deliberately no score, no red
     "FRAUD RISK" badge and no threshold that "fires". A badge trains
     people to ignore the panel; a list of places and dates lets a rep
     ask "I see this is going somewhere different from last time — is
     this a jobsite?" and get an answer in five seconds.

     Shown whenever there is more than one address, NOT at 3+. An
     automated rule needs a high threshold to survive noise; advisory
     context inverts that, because the cost of showing something
     unremarkable is one glance.

     NO TRADE EXEMPTION. Fraudsters open trade accounts too. A
     contractor shipping to many jobsites is a false positive that costs
     nothing — the call happens anyway. */%>
<%
  /* Defaulted per-ARRAY, not per-object. `addressHistory` being a
     truthy object is not a promise that both arrays exist — a partial
     object would throw on .length and take the whole order screen down
     over a fraud hint. */
  const _ah = (typeof addressHistory !== 'undefined' && addressHistory) || {};
  const ah = {
    shipping: Array.isArray(_ah.shipping) ? _ah.shipping : [],
    billing:  Array.isArray(_ah.billing)  ? _ah.billing  : [],
  };
  const shipCount = ah.shipping.length;
  const billCount = ah.billing.length;
  /* The ship-to vs bill-to flag was recorded AT AUTHORISATION (item 5)
     so a later edit to either address cannot rewrite what was true then.
     Shown here beside the history because it is the same question. */
  const mismatch  = order.ship_bill_mismatch ? true : false;
  const worthShowing = shipCount > 1 || billCount > 1 || mismatch;
  /* ⚠️ DATE-ONLY STRINGS ARE PARSED AS UTC MIDNIGHT, and rendered in
     America/New_York that is the PREVIOUS DAY. "last used Sep 19" for
     an address used on the 20th is a small error that derails a
     verification call.

     mysql2 returns DATETIME as a Date object, so production does not
     hit it — but the panel must not depend on that, and a gate fixture
     passing a plain 'YYYY-MM-DD' string found it immediately. Date-only
     strings are split and built in LOCAL time; anything else is handed
     to Date unchanged. */
  const fmtDate = (d) => {
    if (!d) return '—';
    let dt;
    if (typeof d === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(d)) {
      const [y, m, day] = d.split('-').map(Number);
      dt = new Date(y, m - 1, day);
    } else {
      dt = new Date(d);
    }
    return isNaN(dt) ? '—'
      : dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  };
%>
<% if (worthShowing) { %>
<%/* Light red, matching the risk and dispute blocks above. Beige read
     as decoration rather than a flag — owner, 2026-09-28. The border
     is 1px not 2px on purpose: this is CONTEXT, and it should not
     shout as loudly as an actual dispute. */%>
<div style="border:1px solid var(--red);background:#fff5f5;border-radius:6px;padding:14px 18px;margin-bottom:16px">
  <p style="margin:0 0 4px;font-weight:700;font-size:14px;color:var(--red)">Before the verification call</p>
  <p style="margin:0 0 12px;font-size:12px;color:#7a7264">
    Context only — none of this blocks capture. Ask, do not assume.
  </p>

  <% if (shipCount > 1) { %>
    <p style="margin:0 0 4px;font-size:13px;font-weight:600">
      <%= shipCount %> delivery addresses in the last 90 days
    </p>
    <ul style="margin:0 0 12px;padding-left:18px;font-size:13px;line-height:1.7">
      <% ah.shipping.forEach(function (a) { %>
        <%/* THE STREET, not just the city. Two orders to different
             addresses in one town render as "Roswell, GA" twice —
             indistinguishable, so the rep cannot form a question. Seen
             live on order 00108, 2026-09-28. */%>
        <li>
          <strong><%= a.address1 || '(no street recorded)' %></strong><%
          %><%= a.address2 ? ' ' + a.address2 : '' %><br>
          <%= a.city %><%= a.state ? ', ' + a.state : '' %><%= a.zip ? ' ' + a.zip : '' %>
          <span style="color:#7a7264">
            — last used <%= fmtDate(a.last_used_at) %><%
            %><%= a.times_used > 1 ? ', ' + a.times_used + ' times' : '' %>
          </span>
        </li>
      <% }); %>
    </ul>
  <% } %>

  <% if (billCount > 1) { %>
    <p style="margin:0 0 4px;font-size:13px;font-weight:600">
      <%= billCount %> billing addresses in the last 90 days
    </p>
    <ul style="margin:0 0 12px;padding-left:18px;font-size:13px;line-height:1.7">
      <% ah.billing.forEach(function (a) { %>
        <li><strong><%= a.address1 || '(no street recorded)' %></strong><br>
          <%= a.city %><%= a.state ? ', ' + a.state : '' %><%= a.zip ? ' ' + a.zip : '' %>
          <span style="color:#7a7264">— last used <%= fmtDate(a.last_used_at) %></span>
        </li>
      <% }); %>
    </ul>
  <% } %>

  <% if (mismatch) { %>
    <p style="margin:0;font-size:13px">
      <strong>Delivery address does not match the billing address</strong>
      on the card. Recorded at authorisation.
    </p>
  <% } %>
</div>
<% } %>

<% if (order.dispute_id) { %>
<div style="border:2px solid <%= disputeOpen ? 'var(--red)' : '#7a7264' %>;background:<%= disputeOpen ? '#fff5f5' : '#faf9f7' %>;border-radius:6px;padding:14px 18px;margin-bottom:16px">
  <p style="margin:0 0 6px;font-weight:700;font-size:15px;color:<%= disputeOpen ? 'var(--red)' : 'inherit' %>">
    Chargeback &mdash;
    <%= order.dispute_status === 'won'  ? 'WON'
      : order.dispute_status === 'lost' ? 'LOST'
      : String(order.dispute_status || 'open').replace(/_/g, ' ') %>
  </p>
  <div class="detail-meta" style="margin:0">
    <% if (order.dispute_reason) { %>
    <div class="detail-meta-row"><span>Reason</span><span><%= String(order.dispute_reason).replace(/_/g, ' ') %></span></div>
    <% } %>
    <% if (order.dispute_amount != null) { %>
    <div class="detail-meta-row"><span>Amount</span><span>$<%= parseFloat(order.dispute_amount).toFixed(2) %></span></div>
    <% } %>
    <% if (order.dispute_opened_at) { %>
    <div class="detail-meta-row"><span>Opened</span><span><%= new Date(order.dispute_opened_at).toLocaleDateString('en-US') %></span></div>
    <% } %>
    <%/* The deadline is the only field here that costs money on its own.
         Stripe closes a dispute as LOST when it passes with nothing
         submitted, and a default loss cannot be appealed. */%>
    <% if (dueAt && disputeOpen) { %>
    <div class="detail-meta-row">
      <span>Evidence due</span>
      <% if (duePassed) { %>
        <span style="color:var(--red);font-weight:700">
          PASSED <%= dueAt.toLocaleDateString('en-US') %> &mdash; lost by default if nothing was submitted
        </span>
      <% } else if (dueDays === 0) { %>
        <span style="color:var(--red);font-weight:700">
          <%= dueAt.toLocaleDateString('en-US') %> &mdash; DUE TODAY, under 24 hours left
        </span>
      <% } else if (dueDays <= 3) { %>
        <span style="color:var(--red);font-weight:700">
          <%= dueAt.toLocaleDateString('en-US') %> &mdash; <%= dueDays %> day<%= dueDays === 1 ? '' : 's' %> left
        </span>
      <% } else { %>
        <span><%= dueAt.toLocaleDateString('en-US') %> (<%= dueDays %> days)</span>
      <% } %>
    </div>
    <% } %>
    <div class="detail-meta-row">
      <span>Dispute</span>
      <span style="font-family:monospace;font-size:12px"><%= order.dispute_id %></span>
    </div>
  </div>
  <% if (disputeOpen) { %>
  <p style="margin:10px 0 0;font-size:12px;color:var(--text-muted)">
    Evidence is submitted in the Stripe Dashboard, not here. This panel
    exists so the deadline is visible next to the order it belongs to.
  </p>
  <% } %>
</div>
<% } %>

<!-- ══ Toolbar ══════════════════════════════════════════════════════ -->
<div class="adm-toolbar" style="flex-wrap:wrap">
  <div class="adm-back-wrap">
    <a href="/admin/orders" class="adm-back-link">← Orders</a>
    <h1 class="adm-toolbar-title" style="display:flex;align-items:center;gap:8px">
      <span class="rag-dot rag-dot--<%= rag %>"></span>
      <%= order.order_number %>
    </h1>
  </div>
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <%# Hover on the badge or any option explains what the status means.
        Definitions: src/config/orderStatuses.js %>
    <span class="order-status order-status--<%= order.status %>" style="font-size:14px;cursor:help"
          title="<%= (ORDER_STATUSES.find(s => s.value === order.status) || {}).tip || '' %>"><%= order.status %></span>
    <select id="statusSelect" class="adm-search-select"
            title="<%= (ORDER_STATUSES.find(s => s.value === order.status) || {}).tip || '' %>"
            onchange="this.title = (this.options[this.selectedIndex] || {}).title || ''">
      <% ORDER_STATUSES.forEach(s => { %>
        <option value="<%= s.value %>" title="<%= s.tip %>" <%= order.status === s.value ? 'selected' : '' %>><%= s.label %></option>
      <% }) %>
    </select>
    <button id="saveStatusBtn" class="btn btn-primary btn-sm">Save Status</button>
    <% if (isAuthOnly) { %>
    <button class="btn btn-sage btn-sm" onclick="doCapture()">
      💳 Capture $<%= parseFloat(order.total).toFixed(2) %>
    </button>
    <% } %>
  </div>
</div>

<!-- Two-column grid -->
<div style="display:grid;grid-template-columns:1fr 360px;gap:20px;align-items:start">

  <!-- ── LEFT COLUMN ─────────────────────────────────────────── -->
  <div>

    <!-- Items + Totals -->
    <div class="admin-card">
      <h3 class="admin-card-title">Items Ordered</h3>
      <table class="adm-table">
        <thead><tr><th>SKU</th><th>Item</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead>
        <tbody>
          <% items.forEach(item => { %>
          <tr>
            <td class="adm-meta"><%= item.sku %></td>
            <td>
              <div style="display:flex;align-items:center;gap:8px">
                <% if (item.thumb) { %><img src="<%= item.thumb %>" alt="" style="width:40px;height:40px;object-fit:cover;border-radius:4px"><% } %>
                <% if (item.product_slug) { %><a href="/products/<%= item.product_slug %>" target="_blank" style="color:var(--color-navy);font-weight:600"><%= item.name %></a><% } else { %><%= item.name %><% } %>
              </div>
            </td>
            <td><%= item.qty %></td>
            <td>$<%= parseFloat(item.unit_price).toFixed(2) %></td>
            <td><strong>$<%= parseFloat(item.line_total).toFixed(2) %></strong></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="order-totals">
        <div class="order-total-row"><span>Subtotal</span><span>$<%= parseFloat(order.subtotal).toFixed(2) %></span></div>
        <% if (order.shipping_cost > 0) { %><div class="order-total-row"><span>Shipping</span><span>$<%= parseFloat(order.shipping_cost).toFixed(2) %></span></div><% } %>
        <% if (order.tax > 0) { %><div class="order-total-row"><span>Tax</span><span>$<%= parseFloat(order.tax).toFixed(2) %></span></div><% } %>
        <% if (order.discount > 0) { %><div class="order-total-row order-total-row--discount"><span>Discount</span><span>−$<%= parseFloat(order.discount).toFixed(2) %></span></div><% } %>
        <div class="order-total-row order-total-row--grand"><span><strong>Total</strong></span><span><strong>$<%= parseFloat(order.total).toFixed(2) %></strong></span></div>
      </div>
    </div>

    <!-- Payment card (with capture button) -->
    <% if (hasPayment) { %>
    <div class="admin-card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <h3 class="admin-card-title" style="margin:0">Payment</h3>
        <% if (isAuthOnly) { %>
        <div style="display:flex;gap:8px">
          <button class="btn btn-sage btn-sm" onclick="doCapture()">
            Capture $<%= parseFloat(order.total).toFixed(2) %>
          </button>
          <%/* Release, not refund. Before capture there is no charge to
               refund — cancelling the PaymentIntent gives the money back
               without one ever leaving the customer's account. */%>
          <button class="btn btn-outline btn-sm" style="color:#c53030;border-color:#c53030"
                  onclick="doReleaseAuth()">Release Hold</button>
        </div>
        <% } else if (isCaptured) { %>
        <span class="rag-pill rag-pill--green">Captured</span>
        <% } else if (order.payment_status === 'canceled') { %>
        <span class="rag-pill rag-pill--red">Authorization Released</span>
        <% } %>
      </div>
      <div class="detail-meta">
        <% if (isAuthOnly) { %>
        <div class="detail-meta-row">
          <span>Status</span>
          <span style="color:#F59E0B;font-weight:600">⏳ Auth Hold — pending capture</span>
        </div>
        <%
          /* Authorisation expiry countdown.
             Cards hold for 7 days. Capture normally happens within 48
             hours, so an order still sitting here on day 5 has stalled
             and needs attention — after day 7 the hold lapses, the money
             is released, and it cannot be captured at all.

             Computed from payment_authorized_at rather than created_at:
             they are the same today, but reading the payment's own
             timestamp means this stays correct if that ever changes. */
          const authAt = order.payment_authorized_at ? new Date(order.payment_authorized_at) : null;
          const ageDays = authAt ? Math.floor((Date.now() - authAt.getTime()) / 86400000) : null;
          const daysLeft = ageDays == null ? null : 7 - ageDays;
        %>
        <% if (daysLeft != null) { %>
        <div class="detail-meta-row">
          <span>Authorization</span>
          <% if (daysLeft <= 0) { %>
            <span style="color:var(--red);font-weight:700">EXPIRED — cannot be captured</span>
          <% } else if (daysLeft <= 2) { %>
            <span style="color:var(--red);font-weight:700">Expires in <%= daysLeft %> day<%= daysLeft === 1 ? '' : 's' %> — capture now</span>
          <% } else { %>
            <span style="color:var(--text-muted)">Expires in <%= daysLeft %> days</span>
          <% } %>
        </div>
        <% } %>
        <% } %>
        <% if (order.payment_brand || order.payment_last4) { %>
        <div class="detail-meta-row">
          <span>Card</span>
          <span><%= order.payment_brand || '' %> ····<%= order.payment_last4 || '' %></span>
        </div>
        <% } %>
        <div class="detail-meta-row"><span>PaymentIntent</span><span style="font-family:monospace;font-size:12px"><%= order.payment_transaction_id %></span></div>
        <%/* Sales tax is NOT repeated here — the order totals block above
             (~line 171) already renders order.tax. Two copies of one figure
             on one page is how they come to disagree after an edit. */%>
        <% if (order.stripe_charge_id) { %><div class="detail-meta-row"><span>Charge</span><span style="font-family:monospace;font-size:12px"><%= order.stripe_charge_id %></span></div><% } %>
      </div>
      <% if (isAuthOnly) { %>
      <p style="margin:10px 0 0;font-size:12px;color:var(--text-muted)">Funds are held on the customer's card but not taken. Capture once the buyer, delivery access and stock are confirmed.</p>
      <% } %>
    </div>
    <% } %>

    <!-- Vendor PO -->
    <div class="admin-card">
      <h3 class="admin-card-title">
        <% if (!vendorPo) { %><span class="rag-dot rag-dot--red"></span>
        <% } else if (vendorPo.status === 'confirmed') { %><span class="rag-dot rag-dot--green"></span>
        <% } else { %><span class="rag-dot rag-dot--yellow"></span><% } %>
        Vendor Order — James Martin
      </h3>
      <% if (!vendorPo) { %>
        <p class="admin-card-hint">No PO sent yet.</p>
        <button class="btn btn-primary" id="sendPoBtn">Send Order to JM</button>
      <% } else { %>
        <div class="detail-meta">
          <div class="detail-meta-row"><span>Status</span><span class="rag-pill rag-pill--<%= vendorPo.status === 'confirmed' ? 'green' : 'yellow' %>"><%= vendorPo.status %></span></div>
          <div class="detail-meta-row"><span>PO#</span><span><%= vendorPo.po_number || '—' %></span></div>
          <div class="detail-meta-row"><span>Sent</span><span><%= vendorPo.sent_at ? new Date(vendorPo.sent_at).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) : '—' %></span></div>
          <div class="detail-meta-row"><span>Confirmation#</span><span><%= vendorPo.confirmation_number || '—' %></span></div>
          <div class="detail-meta-row"><span>Est. Ship</span><span><%= vendorPo.expected_ship_date || '—' %></span></div>
        </div>
        <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
          <button class="btn btn-outline btn-sm" id="sendPoBtn">Resend PO</button>
          <% if (vendorPo.status !== 'confirmed') { %>
          <button class="btn btn-sage btn-sm" onclick="showConfirmPoModal()">Log Confirmation</button>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Shipment -->
    <div class="admin-card">
      <h3 class="admin-card-title">
        <% if (!shipment) { %><span class="rag-dot rag-dot--grey"></span>
        <% } else if (shipment.status === 'delivered') { %><span class="rag-dot rag-dot--green"></span>
        <% } else if (shipment.status === 'exception') { %><span class="rag-dot rag-dot--red"></span>
        <% } else { %><span class="rag-dot rag-dot--yellow"></span><% } %>
        Shipment (WWEX)
        <% if (wwexMode === 'stub') { %><span class="admin-badge admin-badge--warn">Stub Mode</span><% } %>
      </h3>
      <% if (!shipment || shipment.status === 'quote_pending') { %>
        <p class="admin-card-hint">No shipment booked yet.</p>
        <a href="/admin/shipping/create?orderId=<%= order.id %>"
           class="btn btn-primary"
           style="display:inline-flex;align-items:center;gap:6px">
          🚚 Ship This Order
        </a>
        <p style="margin-top:8px;font-size:.78rem;color:#718096">
          Opens the WWEX shipping form pre-filled with this order's items, dimensions, and delivery address.
        </p>
      <% } else { %>
        <div class="detail-meta">
          <div class="detail-meta-row"><span>Status</span><span class="rag-pill rag-pill--<%= shipment.status === 'delivered' ? 'green' : shipment.status === 'exception' ? 'red' : 'yellow' %>"><%= shipment.status.replace(/_/g,' ') %></span></div>
          <div class="detail-meta-row"><span>Carrier</span><span><%= shipment.carrier || '—' %></span></div>
          <div class="detail-meta-row"><span>Tracking#</span><span>
            <% if (shipment.tracking_number) { %><a href="https://wwex.com/track/<%= shipment.tracking_number %>" target="_blank" style="color:var(--color-amber)"><%= shipment.tracking_number %></a><% } else { %>—<% } %>
          </span></div>
          <div class="detail-meta-row"><span>BOL#</span><span><%= shipment.bol_number || '—' %></span></div>
          <div class="detail-meta-row"><span>Est. Delivery</span><span><%= shipment.estimated_delivery ? new Date(shipment.estimated_delivery).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) : '—' %></span></div>
          <div class="detail-meta-row"><span>Freight Cost</span><span><%= shipment.rate_charged ? '$'+parseFloat(shipment.rate_charged).toFixed(2) : '—' %></span></div>
        </div>
        <% if (shipment.bol_url) { %>
        <a href="<%= shipment.bol_url %>" target="_blank" class="btn btn-outline btn-sm" style="margin-top:12px">Download BOL</a>
        <% } %>
      <% } %>
    </div>

    <!-- Documents -->
    <div class="admin-card">
      <h3 class="admin-card-title">Documents</h3>
      <% if (documents.length === 0) { %>
        <p class="admin-card-hint">No documents uploaded.</p>
      <% } else { %>
        <ul class="doc-list">
          <% documents.forEach(doc => { %>
          <li class="doc-list-item">
            <a href="<%= doc.file_url %>" target="_blank" style="color:var(--color-navy);font-weight:600">📄 <%= doc.label || doc.doc_type %></a>
            <span class="adm-meta"><%= new Date(doc.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %></span>
          </li>
          <% }) %>
        </ul>
      <% } %>
      <form id="docUploadForm" style="margin-top:12px;display:flex;flex-wrap:wrap;gap:8px;align-items:center">
        <select name="doc_type" class="adm-search-select" style="font-size:.82rem;padding:.38rem .75rem">
          <option value="bol">BOL</option>
          <option value="invoice">Invoice</option>
          <option value="return_label">Return Label</option>
          <option value="damage_photo">Damage Photo</option>
          <option value="other">Other</option>
        </select>
        <input type="text" name="label" placeholder="Label (optional)" style="border:1.5px solid var(--border-input,#d0d5dd);border-radius:6px;padding:.38rem .75rem;font-size:.82rem;outline:0">
        <input type="file" name="doc_file" required style="font-size:.82rem">
        <button type="submit" class="btn btn-outline btn-sm">Upload</button>
      </form>
    </div>

  </div><!-- /left column -->

  <!-- ── RIGHT COLUMN ────────────────────────────────────────── -->
  <div>

    <!-- Notes -->
    <div class="admin-card">
      <h3 class="admin-card-title">Notes</h3>
      <% if (noteEvents.length > 0) { %>
      <ul style="margin:0 0 12px;padding:0;list-style:none">
        <% noteEvents.forEach(ev => { %>
        <li style="padding:8px 0;border-bottom:1px solid var(--border);font-size:13px">
          <p style="margin:0 0 4px"><%= ev.notes %></p>
          <span class="adm-meta"><%= ev.actor %> · <%= new Date(ev.created_at).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) %></span>
        </li>
        <% }) %>
      </ul>
      <% } else { %>
      <p class="admin-card-hint">No notes yet.</p>
      <% } %>
      <textarea id="noteText" rows="3" placeholder="Internal note (visible to admin only)…" style="width:100%;border:1.5px solid var(--border-input,#d0d5dd);border-radius:6px;padding:.5rem .75rem;font-family:var(--font-sans);font-size:.85rem;resize:vertical;outline:0"></textarea>
      <button class="btn btn-outline btn-sm" style="margin-top:8px" onclick="addNote()">Save Note</button>
    </div>

    <!-- Customer -->
    <div class="admin-card">
      <h3 class="admin-card-title">Customer</h3>
      <div class="detail-meta">
        <div class="detail-meta-row"><span>Name</span><span><strong><%= order.customer_name %></strong></span></div>
        <% if (order.customer_email || order.guest_email) { %>
        <div class="detail-meta-row"><span>Email</span><span><a href="mailto:<%= order.customer_email || order.guest_email %>" style="color:var(--color-amber)"><%= order.customer_email || order.guest_email %></a></span></div>
        <% } %>
        <%/* ship_phone, not customer_phone — there has never been a
             customer_phone column, so this row simply never rendered. */%>
        <% if (order.ship_phone) { %>
        <%/* tel: carries the extension as a ,, pause then digits, which is
             what a softphone or mobile dialler expects. The visible text
             stays human-readable. */%>
        <div class="detail-meta-row"><span>Phone Number</span><span><a href="tel:<%= order.ship_phone %><%= order.ship_phone_ext ? ',,' + order.ship_phone_ext : '' %>" style="color:var(--color-amber)"><%= order.ship_phone %><% if (order.ship_phone_ext) { %> ext. <%= order.ship_phone_ext %><% } %></a></span></div>
        <% } %>
      </div>

      <% if (order.ship_address1 || order.ship_city) { %>
      <h4 style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin:14px 0 6px">Shipping Address</h4>
      <p style="margin:0;font-size:13px;line-height:1.6">
        <%= order.ship_first_name %> <%= order.ship_last_name %><br>
        <%= order.ship_address1 %>
        <% if (order.ship_address2) { %><br><%= order.ship_address2 %><% } %><br>
        <%= order.ship_city %>, <%= order.ship_state %> <%= order.ship_zip %>
      </p>
      <%/* Drives what the carrier quotes and sends. Shown here because it
           is checked when booking, and "not asked" has to be visible as
           itself rather than defaulting silently to either answer. */%>
      <p style="margin:6px 0 0;font-size:12px;color:var(--text-muted)">
        <% if (order.ship_address_type === 'residential') { %>
          Residential delivery
        <% } else if (order.ship_address_type === 'commercial') { %>
          Commercial delivery
        <% } else { %>
          <span style="color:var(--color-amber)">Delivery type not captured — confirm before booking</span>
        <% } %>
        <% if (!order.ship_address_confirmed) { %>
          &middot; copied from billing
        <% } %>
      </p>

      <%
      /* ── Delivery view — aerial + Street View ──────────────────────
         Scope 5A.7. Both modes come from the Maps Embed API, which is
         free and UNLIMITED — no per-view cost, no quota to watch.

         Why it earns the space: before booking freight, whoever dispatches
         can see whether there is a driveway, whether a 53-foot trailer can
         turn around, whether the approach is steep, and whether there are
         steps from the curb. Those are the conditions that turn into
         refused deliveries and redelivery surcharges on a 300 lb crate.

         Centred on ship_lat/ship_lng from the free US Census geocoder,
         written at authorisation. No Google geocoding call, no Places
         call — just the embed.

         NOT rendered when coordinates are missing: an embed centred on
         a null pair silently shows the middle of the Atlantic, which
         looks like a real answer. */
      const hasGeo  = order.ship_lat != null && order.ship_lng != null;
      const geoPt   = hasGeo ? `${order.ship_lat},${order.ship_lng}` : '';
      const canMap  = hasGeo && mapsKey;
      %>

      <% if (canMap) { %>
      <h4 style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin:14px 0 6px">
        Delivery View
      </h4>

      <div style="border:1px solid var(--border);border-radius:6px;overflow:hidden">
        <div style="display:flex;border-bottom:1px solid var(--border)">
          <button type="button" id="dv-tab-aerial" class="dv-tab dv-tab--on"
                  onclick="dvShow('aerial')">Aerial</button>
          <button type="button" id="dv-tab-street" class="dv-tab"
                  onclick="dvShow('street')">Street view</button>
        </div>

        <%/* loading="lazy" so the iframe is not fetched until the panel is
             scrolled to. An order page that is opened and closed without
             looking costs nothing. */%>
        <iframe id="dv-aerial" width="100%" height="220" style="border:0;display:block"
                loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                title="Aerial view of the delivery address"
                src="https://www.google.com/maps/embed/v1/view?key=<%= encodeURIComponent(mapsKey) %>&center=<%= encodeURIComponent(geoPt) %>&zoom=19&maptype=satellite"></iframe>

        <%/* Street View is NOT rendered until the tab is clicked. Its src is
             held in a data attribute: an iframe with a src loads whether or
             not it is visible, so building both up front would fetch a
             panorama nobody asked to see. */%>
        <iframe id="dv-street" width="100%" height="220" style="border:0;display:none"
                loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                title="Street view of the delivery address"
                data-src="https://www.google.com/maps/embed/v1/streetview?key=<%= encodeURIComponent(mapsKey) %>&location=<%= encodeURIComponent(geoPt) %>&heading=0&pitch=0&fov=90"></iframe>
      </div>

      <p style="margin:6px 0 0;font-size:11px;color:var(--text-muted);line-height:1.5">
        Point from the US Census geocoder, not a confirmed rooftop &mdash;
        treat it as the right street, not the right doorstep.
        <%/* Street View coverage is patchy on rural and new-build
             addresses. Saying so here is cheaper than someone deciding the
             panel is broken. */%>
        Street view is blank where Google has no imagery.
      </p>
      <% } else if (hasGeo && !mapsKey) { %>
      <p style="margin:10px 0 0;font-size:12px;color:var(--color-amber)">
        Delivery view unavailable &mdash; GOOGLE_MAPS_API_KEY is not set.
      </p>
      <% } else if (order.ship_address1) { %>
      <%/* Address but no coordinates: the geocode either failed or has not
           run. Orders placed before the geocoder shipped are the common
           case and are not a fault. */%>
      <p style="margin:10px 0 0;font-size:12px;color:var(--text-muted)">
        No delivery view &mdash; this address has no coordinates.
        <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent([order.ship_address1, order.ship_city, order.ship_state, order.ship_zip].filter(Boolean).join(', ')) %>"
           target="_blank" rel="noopener" style="color:var(--color-amber)">Look it up &rarr;</a>
      </p>
      <% } %>
      <% } %>

      <% if (order.bill_address1) { %>
      <h4 style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin:14px 0 6px">Billing Address</h4>
      <p style="margin:0;font-size:13px;line-height:1.6">
        <%= order.bill_address1 %><br>
        <%= order.bill_city %>, <%= order.bill_state %> <%= order.bill_zip %>
      </p>
      <% } %>
    </div>

    <!-- Order Risk -->
    <div class="admin-card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <h3 class="admin-card-title" style="margin:0">Order Risk</h3>
        <span class="rag-pill rag-pill--<%= riskPill %>"><%= riskLabel %></span>
      </div>
      <div style="height:6px;border-radius:3px;background:var(--border);overflow:hidden;margin-bottom:6px">
        <div style="height:100%;border-radius:3px;width:<%= riskPct %>%;background:<%= riskColor %>"></div>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text-muted);margin-bottom:12px">
        <span>Low</span><span>Medium</span><span>High</span>
      </div>
      <% if (checks.length > 0) { %>
      <ul style="margin:0;padding:0;list-style:none">
        <% checks.forEach(function(c) {
          var isOk   = c.icon === 'ok';
          var isWarn = c.icon === 'warn';
          var iconColor = isOk ? 'var(--green)' : isWarn ? 'var(--red)' : 'var(--text-muted)';
        %>
        <li style="display:flex;align-items:flex-start;gap:8px;padding:5px 0;font-size:12px;border-bottom:1px solid var(--border)">
          <% if (isOk) { %>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="var(--green)" stroke-width="2.5" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
          <% } else if (isWarn) { %>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="var(--red)" stroke-width="2.5" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><circle cx="12" cy="16" r=".5" fill="var(--red)"/></svg>
          <% } else { %>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="var(--text-muted)" stroke-width="2" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><circle cx="12" cy="16" r=".5" fill="var(--text-muted)"/></svg>
          <% } %>
          <span style="color:<%= isWarn ? 'var(--text)' : 'var(--text-muted)' %>;font-weight:<%= isWarn ? '500' : '400' %>"><%= c.label %></span>
        </li>
        <% }); %>
      </ul>
      <% } else { %>
      <p class="admin-card-hint">No payment data to analyze.</p>
      <% } %>
      <% if (hasWarn) { %>
      <p style="margin:10px 0 0;font-size:12px;color:var(--red);font-weight:500">⚠️ Review carefully before capturing payment.</p>
      <% } %>
    </div>

    <!-- Returns -->
    <div class="admin-card">
      <h3 class="admin-card-title">Returns</h3>
      <% const openReturn = returns.find(r => !['resolved','denied'].includes(r.status)); %>
      <% if (openReturn) { %>
      <div style="background:var(--bg-warn,#FEF3C7);border:1px solid #FDE68A;border-radius:6px;padding:10px;margin-bottom:12px;font-size:13px">
        <strong><%= openReturn.return_number %></strong> — <%= openReturn.status %> — <%= openReturn.reason.replace(/_/g,' ') %>
        <% if (openReturn.customer_notes) { %><p style="margin:4px 0 0;color:var(--text-muted)"><%= openReturn.customer_notes %></p><% } %>
        <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap">
          <% if (openReturn.status === 'requested') { %>
          <button class="btn btn-sage btn-sm" onclick="approveReturn(<%= openReturn.id %>)">Approve + RA</button>
          <button class="btn btn-outline btn-sm" style="color:#c53030;border-color:#c53030" onclick="denyReturn(<%= openReturn.id %>)">Deny</button>
          <% } %>
          <% if (['approved','in_transit'].includes(openReturn.status)) { %>
          <button class="btn btn-primary btn-sm" onclick="receiveReturn(<%= openReturn.id %>)">Mark Received</button>
          <% } %>
          <% if (['received','inspected'].includes(openReturn.status)) { %>
          <button class="btn btn-primary btn-sm" onclick="resolveReturn(<%= openReturn.id %>)">Resolve</button>
          <% } %>
        </div>
      </div>
      <% } %>
      <% if (returns.length === 0) { %>
      <p class="admin-card-hint">No returns on this order.</p>
      <% } else if (!openReturn) { %>
      <ul style="margin:0 0 12px;padding:0;list-style:none">
        <% returns.forEach(r => { %>
        <li style="padding:5px 0;border-bottom:1px solid var(--border);font-size:13px">
          <strong><%= r.return_number %></strong> — <%= r.reason.replace(/_/g,' ') %>
          <span class="rag-pill rag-pill--<%= r.status === 'resolved' ? 'green' : 'yellow' %>" style="margin-left:6px"><%= r.status %></span>
        </li>
        <% }) %>
      </ul>
      <% } %>
      <button class="btn btn-outline btn-sm" onclick="openReturnModal()">+ Open Return</button>
    </div>

    <!-- Conversion Summary -->
    <% if (order.order_source || order.order_referrer || order.order_utm_campaign) { %>
    <div class="admin-card">
      <h3 class="admin-card-title">Conversion Summary</h3>
      <div class="detail-meta">
        <% if (order.order_source) { %>
        <div class="detail-meta-row"><span>Source</span><span><%= order.order_source %></span></div>
        <% } %>
        <% if (order.order_utm_campaign) { %>
        <div class="detail-meta-row"><span>Campaign</span><span><%= order.order_utm_campaign %></span></div>
        <% } %>
        <% if (order.order_utm_medium) { %>
        <div class="detail-meta-row"><span>Medium</span><span><%= order.order_utm_medium %></span></div>
        <% } %>
        <% if (order.order_utm_source) { %>
        <div class="detail-meta-row"><span>UTM Source</span><span><%= order.order_utm_source %></span></div>
        <% } %>
        <% if (order.order_referrer) { %>
        <div class="detail-meta-row"><span>Referrer</span>
          <span style="font-size:11px;word-break:break-all;max-width:190px"><%= (order.order_referrer||'').slice(0,80) %><%= (order.order_referrer||'').length > 80 ? '…' : '' %></span>
        </div>
        <% } %>
        <% if (order.customer_ip) { %>
        <div class="detail-meta-row"><span>IP Address</span><span style="font-family:monospace;font-size:12px"><%= order.customer_ip %></span></div>
        <% } %>
      </div>
    </div>
    <% } %>

  </div><!-- /right column -->
</div><!-- /grid -->

<!-- Timeline (full width) -->
<div class="admin-card" style="margin-top:20px">
  <h3 class="admin-card-title">Order Timeline</h3>
  <% if (events.length === 0) { %>
  <p class="admin-card-hint">No events yet.</p>
  <% } else { %>
  <ul class="event-timeline">
    <% events.forEach(ev => { %>
    <li class="event-timeline-item">
      <span class="event-dot"></span>
      <div class="event-content">
        <div class="event-header">
          <strong><%= ev.event_type.replace(/_/g,' ') %></strong>
          <% if (ev.from_status && ev.to_status) { %>
          <span class="event-transition"><%= ev.from_status %> → <%= ev.to_status %></span>
          <% } %>
          <span class="event-actor"><%= ev.actor %></span>
        </div>
        <% if (ev.notes) { %><p class="event-notes"><%= ev.notes %></p><% } %>
        <span class="event-time"><%= new Date(ev.created_at).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) %></span>
      </div>
    </li>
    <% }) %>
  </ul>
  <% } %>
</div>

<!-- Modals -->
<div id="confirmPoModal" class="modal-overlay" style="display:none">
  <div class="modal-box">
    <h3>Log Vendor Confirmation</h3>
    <label style="display:block;font-size:.78rem;font-weight:700;margin:10px 0 4px;text-transform:uppercase;letter-spacing:.04em;color:var(--text-muted)">Confirmation Number</label>
    <input type="text" id="confirmPoNum" placeholder="JM confirmation #" style="width:100%;border:1.5px solid var(--border-input,#d0d5dd);border-radius:6px;padding:.5rem .75rem;font-size:.9rem;outline:0;margin-bottom:8px">
    <label style="display:block;font-size:.78rem;font-weight:700;margin:10px 0 4px;text-transform:uppercase;letter-spacing:.04em;color:var(--text-muted)">Expected Ship Date</label>
    <input type="date" id="confirmPoDate" style="width:100%;border:1.5px solid var(--border-input,#d0d5dd);border-radius:6px;padding:.5rem .75rem;font-size:.9rem;outline:0;margin-bottom:8px">
    <div class="modal-actions">
      <button class="btn btn-primary" onclick="saveVendorConfirm()">Save</button>
      <button class="btn btn-outline" onclick="closeModal('confirmPoModal')">Cancel</button>
    </div>
  </div>
</div>

<div id="returnModal" class="modal-overlay" style="display:none">
  <div class="modal-box">
    <h3>Open Return</h3>
    <label style="display:block;font-size:.78rem;font-weight:700;margin:10px 0 4px;text-transform:uppercase;letter-spacing:.04em;color:var(--text-muted)">Reason</label>
    <select id="returnReason" class="adm-search-select" style="width:100%;margin-bottom:8px">
      <option value="damaged">Damaged in Transit</option>
      <option value="defective">Defective / Malfunction</option>
      <option value="wrong_item">Wrong Item Received</option>
      <option value="changed_mind">Changed Mind</option>
      <option value="not_as_described">Not as Described</option>
      <option value="other">Other</option>
    </select>
    <label style="display:block;font-size:.78rem;font-weight:700;margin:10px 0 4px;text-transform:uppercase;letter-spacing:.04em;color:var(--text-muted)">Customer Notes</label>
    <textarea id="returnNotes" rows="3" placeholder="Describe the issue…" style="width:100%;border:1.5px solid var(--border-input,#d0d5dd);border-radius:6px;padding:.5rem .75rem;font-family:var(--font-sans);font-size:.85rem;resize:vertical;outline:0;margin-bottom:8px"></textarea>
    <div class="modal-actions">
      <button class="btn btn-primary" onclick="submitOpenReturn()">Open Return</button>
      <button class="btn btn-outline" onclick="closeModal('returnModal')">Cancel</button>
    </div>
  </div>
</div>

<script>
const ORDER_ID = '<%= order.id %>';

/* ── Delivery view tabs ──────────────────────────────────────────
   Street View's iframe carries its URL in data-src, not src, and is
   promoted on first click. An iframe with a src loads even while
   display:none, so wiring both up front would fetch a panorama nobody
   asked to see. Promoted once, then left alone. */
function dvShow(which) {
  var aerial = document.getElementById('dv-aerial');
  var street = document.getElementById('dv-street');
  if (!aerial || !street) return;

  var showStreet = which === 'street';
  if (showStreet && !street.src && street.dataset.src) {
    street.src = street.dataset.src;
  }
  aerial.style.display = showStreet ? 'none'  : 'block';
  street.style.display = showStreet ? 'block' : 'none';

  var ta = document.getElementById('dv-tab-aerial');
  var ts = document.getElementById('dv-tab-street');
  if (ta) ta.className = 'dv-tab' + (showStreet ? '' : ' dv-tab--on');
  if (ts) ts.className = 'dv-tab' + (showStreet ? ' dv-tab--on' : '');
}

/* ── Status ── */
document.getElementById('saveStatusBtn').addEventListener('click', async () => {
  const status = document.getElementById('statusSelect').value;
  const r = await fetch(`/admin/orders/${ORDER_ID}/status`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ status })
  });
  const d = await r.json();
  if (d.ok) location.reload(); else alert('Error: ' + d.error);
});

/* ── Capture Payment ── */
async function doCapture() {
  const note = prompt(
    'Add a verification note before capturing (required):\n\n' +
    'Examples:\n' +
    '• Called customer, verified identity and out-of-state delivery\n' +
    '• AVS mismatch — confirmed billing address by phone\n' +
    '• Reviewed and approved — shipping to construction site\n\n' +
    'Note:'
  );
  if (note === null) return; // cancelled
  if (!note.trim()) {
    alert('A note is required before capturing payment. Please describe your verification.');
    return;
  }
  // Save note first
  const nr = await fetch(`/admin/orders/${ORDER_ID}/notes`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ notes: `[Pre-capture review] ${note.trim()}` })
  });
  const nd = await nr.json();
  if (!nd.ok) { alert('Failed to save note: ' + nd.error); return; }

  // Then capture
  const r = await fetch(`/admin/orders/${ORDER_ID}/capture`, { method:'POST' });
  const d = await r.json();
  if (d.ok) { alert(d.message); location.reload(); }
  else alert('Capture error: ' + d.error);
}

/* ── Release the authorization ──
   For an order rejected during validation. This is NOT a refund: no
   charge exists yet, so the hold is simply cancelled and the customer
   is never debited. Irreversible — a released hold cannot be
   re-captured, the customer would have to pay again — hence the
   explicit confirm and the required reason. */
async function doReleaseAuth() {
  const reason = prompt(
    'Release the authorization and cancel this order?\n\n' +
    'The customer will NOT be charged. This cannot be undone — taking\n' +
    'payment again means asking them for their card a second time.\n\n' +
    'Reason (required):'
  );
  if (reason === null) return;
  if (!reason.trim()) {
    alert('A reason is required before releasing an authorization.');
    return;
  }

  const r = await fetch(`/admin/orders/${ORDER_ID}/cancel-authorization`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ reason: reason.trim() })
  });
  const d = await r.json();
  if (d.ok) { alert(d.message); location.reload(); }
  else alert('Could not release the hold: ' + d.error);
}

/* ── Vendor PO ── */
document.getElementById('sendPoBtn')?.addEventListener('click', async () => {
  if (!confirm('Send purchase order email to James Martin?')) return;
  const btn = document.getElementById('sendPoBtn');
  btn.disabled = true; btn.textContent = 'Sending…';
  const r = await fetch(`/admin/orders/${ORDER_ID}/vendor-order`, { method:'POST' });
  const d = await r.json();
  if (d.ok) { alert(d.message); location.reload(); }
  else { alert('Error: ' + d.error); btn.disabled = false; btn.textContent = 'Send Order to JM'; }
});

function showConfirmPoModal() { document.getElementById('confirmPoModal').style.display='flex'; }
async function saveVendorConfirm() {
  const r = await fetch(`/admin/orders/${ORDER_ID}/vendor-confirm`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      confirmation_number: document.getElementById('confirmPoNum').value,
      expected_ship_date:  document.getElementById('confirmPoDate').value,
    })
  });
  const d = await r.json();
  if (d.ok) location.reload(); else alert('Error: ' + d.error);
}

/* ── WWEX shipping: handled via /admin/shipping/create?orderId= ── */

/* ── Add Note ── */
async function addNote() {
  const notes = document.getElementById('noteText').value.trim();
  if (!notes) return;
  const r = await fetch(`/admin/orders/${ORDER_ID}/notes`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ notes })
  });
  const d = await r.json();
  if (d.ok) location.reload(); else alert('Error: ' + d.error);
}

/* ── Document upload ── */
document.getElementById('docUploadForm')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const fd = new FormData(e.target);
  const r  = await fetch(`/admin/orders/${ORDER_ID}/documents`, { method:'POST', body: fd });
  const d  = await r.json();
  if (d.ok) location.reload(); else alert('Upload error: ' + d.error);
});

/* ── Returns ── */
function openReturnModal() { document.getElementById('returnModal').style.display='flex'; }
async function submitOpenReturn() {
  const r = await fetch(`/admin/orders/${ORDER_ID}/returns`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      reason:         document.getElementById('returnReason').value,
      customer_notes: document.getElementById('returnNotes').value,
    })
  });
  const d = await r.json();
  if (d.ok) location.reload(); else alert('Error: ' + d.error);
}
async function approveReturn(id) {
  const notes = prompt('Admin notes (optional):') || '';
  const r = await fetch(`/admin/returns/${id}/approve`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ admin_notes: notes })
  });
  const d = await r.json();
  if (d.ok) { alert('Return approved — RA#: ' + d.ra_number + '. Customer notified.'); location.reload(); }
  else alert('Error: ' + d.error);
}
async function denyReturn(id) {
  const notes = prompt('Reason for denial:') || '';
  const r = await fetch(`/admin/returns/${id}/deny`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ admin_notes: notes })
  });
  const d = await r.json();
  if (d.ok) location.reload(); else alert('Error: ' + d.error);
}
async function receiveReturn(id) {
  const condition = prompt('Condition on receipt:\n1. good\n2. minor_damage\n3. major_damage\n4. missing_parts\n\nEnter condition:');
  if (!condition) return;
  const r = await fetch(`/admin/returns/${id}/receive`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ condition_on_receipt: condition })
  });
  const d = await r.json();
  if (d.ok) location.reload(); else alert('Error: ' + d.error);
}
async function resolveReturn(id) {
  const resolution = prompt('Resolution:\n1. full_refund\n2. partial_refund\n3. replacement\n4. denied\n\nEnter resolution:');
  if (!resolution) return;
  const refund = ['full_refund','partial_refund'].includes(resolution) ? prompt('Refund amount ($):') : null;
  const r = await fetch(`/admin/returns/${id}/resolve`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ resolution, refund_amount: refund })
  });
  const d = await r.json();
  if (d.ok) { alert('Return resolved. Customer notified.'); location.reload(); }
  else alert('Error: ' + d.error);
}

function closeModal(id) { document.getElementById(id).style.display='none'; }
document.querySelectorAll('.modal-overlay').forEach(m => m.addEventListener('click', e => { if(e.target===m) m.style.display='none'; }));
</script>
