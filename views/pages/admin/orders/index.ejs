<!-- ══ Toolbar ══════════════════════════════════════════════════════ -->
<div class="adm-toolbar">
  <span class="adm-toolbar-title">Orders</span>

  <form method="GET" action="/admin/orders" class="adm-search-form" id="orderSearchForm">
    <input type="text" name="search" value="<%= search %>" placeholder="Search order #, customer, email…" class="adm-search-input">
    <%# Status definitions come from src/config/orderStatuses.js so the filter,
        the badges and the detail-page dropdown can never drift apart. %>
    <select name="status" class="adm-search-select" data-act="submitForm" data-on="change" data-a1="orderSearchForm">
      <option value="">All Statuses</option>
      <% ORDER_STATUSES.forEach(s => { %>
        <option value="<%= s.value %>" title="<%= s.tip %>" <%= status === s.value ? 'selected' : '' %>><%= s.label %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-primary">Search</button>
    <% if (status || search) { %>
      <a href="/admin/orders" class="btn btn-outline">Clear</a>
    <% } %>
  </form>

  <div style="display:flex;gap:8px;flex-shrink:0">
    <a href="/admin/orders/shipments" class="btn btn-outline">🚚 Shipments</a>
    <a href="/admin/orders/reports"   class="btn btn-outline">📊 Reports</a>
  </div>
</div>

<!-- RAG Summary Bar -->
<div class="rag-summary">
  <div class="rag-badge rag-badge--red">
    <span class="rag-dot rag-dot--red"></span>
    <strong><%= ragCounts.red %></strong> Need Attention
  </div>
  <div class="rag-badge rag-badge--yellow">
    <span class="rag-dot rag-dot--yellow"></span>
    <strong><%= ragCounts.yellow %></strong> Watch
  </div>
  <div class="rag-badge rag-badge--green">
    <span class="rag-dot rag-dot--green"></span>
    <strong><%= ragCounts.green %></strong> On Track
  </div>
</div>

<%#  ── INVENTORY RISK ─────────────────────────────────────────────────
     Which SKUs on open orders need the vendor call from SOP §2, worst
     first. Severity, labels and the threshold all come from
     config/inventoryRisk.js — nothing here decides what counts as a risk,
     so the page cannot disagree with the rule or invent a fourth state.

     ⚠️ SCOPE IS EVERY OPEN ORDER, NOT THIS PAGE OF THE LIST. The strip
     answers "what do I work first", which is a question about the whole
     queue; page 3 must not report a different picture from page 1.

     ⚠️ THE AS-OF TIME IS NOT DECORATION. Every number here is a nightly
     snapshot of stock held at the VENDOR, allocated first-come-first-
     served across resellers we cannot see. It was stale when it was
     written. Showing the age is what keeps this an aid to the call rather
     than a substitute for it.  %>
<% if (typeof inventoryRisk !== 'undefined' && (inventoryRisk.skus.length || inventoryRisk.stale)) { %>
  <div class="inv-risk">
    <div class="inv-risk-head">
      <strong>Stock watch</strong>
      <span class="inv-risk-asof">
        <% if (inventoryRisk.stale) { %>
          <%# A feed that has not run is louder than any single SKU: every
              figure below is yesterday's or older, and nothing else on
              this page would say so. %>
          <span class="inv-risk-stale">⚠ stock data is stale<%
            %><% if (inventoryRisk.lastSyncedAt) { %> — last sync <%= new Date(inventoryRisk.lastSyncedAt).toLocaleString() %><% } else { %> — never synced<% } %></span>
        <% } else { %>
          stock as of <%= new Date(inventoryRisk.lastSyncedAt).toLocaleString() %>
        <% } %>
      </span>
    </div>

    <% if (!inventoryRisk.skus.length) { %>
      <p class="inv-risk-none">No SKUs below the threshold on open orders.</p>
    <% } else { %>
      <table class="inv-risk-table">
        <thead>
          <tr><th>SKU</th><th>Product</th><th>On hand</th><th>Ordered</th><th>Orders</th><th></th></tr>
        </thead>
        <tbody>
        <% inventoryRisk.skus.forEach(function (r) { var L = INV.LABELS[r.severity]; %>
          <tr class="inv-risk-row inv-risk-row--<%= L.tone %>">
            <td class="inv-risk-sku"><%= r.sku %></td>
            <td><%= r.name || '—' %></td>
            <%# ⚠️ 'unknown' PRINTS A DASH, NEVER 0. There is no inventory
                row for this SKU; absence of data is not evidence of stock,
                and a 0 here would read as a fact we do not have. %>
            <td><%= r.severity === 'unknown' ? '—' : r.qty_on_hand %></td>
            <td><%= r.demand %></td>
            <td><%= r.order_count %></td>
            <td><span class="inv-pill inv-pill--<%= L.tone %>" title="<%= L.hint %>"><%= L.text %></span></td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
<% } %>

<!-- Orders Table -->
<div class="adm-table-wrap">
  <table class="adm-table">
    <thead>
      <tr>
        <%# Select column for bulk delete. Header checkbox selects only the
            rows currently rendered — it is NOT "select all orders matching
            the filter", because a checkbox that silently reaches past what
            you can see is how you delete page 7 of something. %>
        <th style="width:28px">
          <input type="checkbox" id="ord-select-all" title="Select all on this page">
        </th>
        <th style="width:28px"></th>
        <th>Order</th>
        <th>Customer</th>
        <th>Total</th>
        <th>Status</th>
        <th>Vendor PO</th>
        <th>Shipment</th>
        <th>Date</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (orders.length === 0) { %>
        <tr><td colspan="10" class="adm-empty" style="border-radius:0">No orders found.</td></tr>
      <% } %>
      <% orders.forEach(o => { %>
        <tr class="order-row order-row--<%= o.rag %>" data-order-number="<%= o.order_number %>">
          <td>
            <input type="checkbox" class="ord-select" value="<%= o.id %>"
                   data-number="<%= o.order_number %>"
                   <%# A captured order can still be ticked, but the confirm
                       step names it separately — see the bulk handler.

                       ⚠️ BOTH COLUMNS ARE NOW EXPLICITLY SELECTED by the list
                       query. They were not until 2026-10-19, so this rendered
                       data-captured="" on every row and the red banner never
                       fired. The server-side refusal caught it regardless —
                       the UI degraded quiet, exactly as the old note here
                       speculated it might. Quiet is not the same as correct,
                       and "simply undefined" is how three separate bugs on
                       this project stayed invisible. If you add a warning
                       that reads a column, add the column to the SELECT. %>
                   data-captured="<%= o.payment_captured_at ? '1' : '' %>"
                   <%# An uncaptured hold. Deleting without releasing it
                       leaves money on the customer's card with no local
                       record — see deleteOneOrder. %>
                   data-auth="<%= o.payment_status === 'auth_only' ? '1' : '' %>"
                   data-total="<%= o.total || 0 %>">
          </td>
          <td>
            <span class="rag-dot rag-dot--<%= o.rag %>" title="<%= o.rag === 'red' ? 'Needs attention' : o.rag === 'yellow' ? 'Watch' : 'On track' %>"></span>
            <%# ⚠️ A SEPARATE SIGNAL FROM RAG, deliberately not folded into it.
                RAG is about the order's own progress — paid, sent, shipped.
                This is about whether the GOODS will be there, which is a fact
                about a SKU shared across other orders and other resellers. An
                order can be perfectly green on process and still be the one
                whose vanity is about to be sold out from under it. Merging
                them would lose exactly that. %>
            <% if (o.inventoryRisk) { %><span class="inv-flag" title="A SKU on this order is low or oversold — see Stock watch above">▲</span><% } %>
          </td>
          <td><a href="/admin/orders/<%= o.id %>" style="font-weight:700;color:var(--color-navy)"><%= o.order_number %></a></td>
          <%# Email verification badge. CONFIRMED is green; UNCONFIRMED is
              NEUTRAL GREY, never red — every brand-new order is
              unconfirmed for its first few minutes, and a red flag that
              fires on all of them is wallpaper. Red stays reserved for
              the address-velocity panel and the ship/bill mismatch,
              which actually mean something. %>
          <td>
            <%= o.customer_name || '—' %>
            <% if (o.email_verified_at) { %>
              <span class="email-vflag email-vflag--yes" title="Email address confirmed by this customer">&#10003; email</span>
            <% } else { %>
              <span class="email-vflag email-vflag--no" title="This customer has never confirmed their email address — worth asking about on the verification call">email unconfirmed</span>
            <% } %>
          </td>
          <td style="font-weight:700">$<%= parseFloat(o.total || 0).toFixed(2) %></td>
          <%# Hover explains what the status means — definitions live in
              src/config/orderStatuses.js %>
          <td><span class="order-status order-status--<%= o.status %>"
                    title="<%= (ORDER_STATUSES.find(s => s.value === o.status) || {}).tip || '' %>"
                    style="cursor:help"><%= o.status %></span></td>
          <td>
            <% if (!o.vpo_status) { %>
              <span class="rag-pill rag-pill--red">Not Sent</span>
            <% } else if (o.vpo_status === 'sent') { %>
              <span class="rag-pill rag-pill--yellow">Awaiting Confirm</span>
            <% } else if (o.vpo_status === 'confirmed') { %>
              <span class="rag-pill rag-pill--green">Confirmed</span>
            <% } else { %>
              <span class="rag-pill rag-pill--yellow"><%= o.vpo_status %></span>
            <% } %>
          </td>
          <td>
            <% if (!o.ship_status) { %>
              <span class="rag-pill rag-pill--grey">—</span>
            <% } else if (o.ship_status === 'delivered') { %>
              <span class="rag-pill rag-pill--green">Delivered</span>
            <% } else if (o.ship_status === 'exception') { %>
              <span class="rag-pill rag-pill--red">Exception</span>
            <% } else { %>
              <span class="rag-pill rag-pill--yellow"><%= o.ship_status.replace('_',' ') %></span>
            <% } %>
          </td>
          <td class="adm-meta"><%= new Date(o.created_at).toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'}) %></td>
          <td>
            <div style="display:flex;gap:4px">
              <a href="/admin/orders/<%= o.id %>" class="btn btn-outline btn-sm">View</a>
              <%# Row-level delete. The bulk path still exists for clearing a
                  batch, but having to open an order and scroll to the bottom to
                  remove one is the wrong shape for the job this was built for. %>
              <button type="button" class="btn btn-sm ord-del-one"
                      data-id="<%= o.id %>" data-number="<%= o.order_number %>"
                      data-captured="<%= o.payment_captured_at ? '1' : '' %>"
                      style="background:transparent;color:var(--red,#dc2626);border:1px solid var(--red,#dc2626)"
                      title="Delete this order">Delete</button>
              <%# Ship button visibility — TWO independent gates, both required.

                  1. Order status. in_transit added 2026-08-31: freight already
                     moving, must not offer to book a second shipment for it.

                  2. Shipment presence. ADDED 2026-09-02. Gate 1 alone was not
                     enough: an order can carry a live booked shipment while its
                     own status lags behind (seen on BVO-20260004 — shipment
                     ATE34769491 Booked, order still Confirmed). The button
                     showed, one click from booking real freight twice.
                     o.ship_status was already loaded for the badge above; it
                     just was not consulted here.

                  A voided shipment deliberately does NOT block the button —
                  the whole point of the void revert is to allow re-shipping. %>
              <%
                const _orderBlocks = ['shipped','in_transit','delivered','cancelled','refunded']
                                       .includes(o.status);
                const _hasLiveShipment = !!o.ship_status && o.ship_status !== 'voided';
              %>
              <% if (!_orderBlocks && !_hasLiveShipment) { %>
              <a href="/admin/shipping/create?orderId=<%= o.id %>" class="btn btn-sm btn-ship" title="Create shipment for this order">Ship</a>
              <% } else if (_hasLiveShipment && !_orderBlocks) { %>
              <%# Mismatch: shipment exists but the order never advanced. Say so
                  rather than silently hiding the button, which would look like
                  a missing feature. %>
              <span class="adm-meta" style="font-size:.72rem;color:#b45309;white-space:nowrap"
                    title="This order already has a <%= o.ship_status %> shipment, but its status is still &quot;<%= o.status %>&quot;. The Ship button is hidden to prevent double-booking. Open the order to reconcile.">⚠ status lag</span>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- Pagination -->
<% if (pages > 1) { %>
  <div style="display:flex;gap:6px;margin-top:16px;flex-wrap:wrap">
    <% for (let i = 1; i <= pages; i++) { %>
      <a href="/admin/orders?page=<%= i %><%= status ? '&status='+status : '' %><%= search ? '&search='+encodeURIComponent(search) : '' %>"
         class="adm-page-btn <%= i === page ? 'active' : '' %>"><%= i %></a>
    <% } %>
  </div>
<% } %>
<p class="adm-count" style="margin-top:10px"><%= total %> order<%= total !== 1 ? 's' : '' %> total</p>

<style>
.btn-ship { background:#1a2e4a;color:#fff;border:1px solid #1a2e4a;border-radius:4px;padding:3px 10px;font-size:.78rem;font-weight:600;text-decoration:none;white-space:nowrap }
.btn-ship:hover { background:#2b4a78;border-color:#2b4a78;color:#fff }
</style>

<%# ── Bulk delete bar ─────────────────────────────────────────────────────
    Hidden until something is ticked, so the dashboard does not carry a
    permanent destructive affordance for people who came here to read it. %>
<div id="ord-bulk-bar"
     style="display:none;position:sticky;bottom:0;z-index:20;margin-top:12px;
            padding:12px 16px;background:#fff;border:1px solid var(--color-border,#e5e7eb);
            border-radius:10px;box-shadow:0 -2px 12px rgba(0,0,0,.08);
            align-items:center;gap:14px;justify-content:space-between">
  <span><strong id="ord-bulk-count">0</strong> order(s) selected</span>
  <div style="display:flex;gap:8px;align-items:center">
    <button type="button" id="ord-bulk-clear" class="btn btn-outline btn-sm">Clear</button>
    <button type="button" id="ord-bulk-delete" class="btn btn-sm"
            style="background:var(--red,#dc2626);color:#fff;border-color:var(--red,#dc2626)">
      Delete selected
    </button>
  </div>
</div>

<%# ── Delete modal ────────────────────────────────────────────────────────
    REPLACES a chain of window.prompt() dialogs. Those failed three times in a
    row in real use: the first asked for the selection count typed back, the
    second for a twenty-character order number, and the third read as a free
    text box so a note got typed where a confirmation was expected. The note
    was the right instinct — a prompt is simply the wrong control for a choice.

    A dropdown fixes all three at once: the reasons are the ones that actually
    occur, picking one IS the confirmation, and the result is a code that can
    be grouped later rather than four spellings of "test". %>
<div id="ord-del-modal" class="modal-overlay" style="display:none">
  <div class="modal-box" style="max-width:460px">
    <h3 id="ord-del-title">Delete order</h3>

    <p id="ord-del-what" class="adm-meta" style="margin:0 0 12px"></p>

    <div id="ord-del-captured"
         style="display:none;margin:0 0 12px;padding:10px 12px;border-radius:8px;
                background:rgba(220,38,38,.07);border:1px solid var(--red,#dc2626);
                color:var(--red,#dc2626);font-size:.85rem;font-weight:600"></div>

    <%# ── UNCAPTURED HOLDS ───────────────────────────────────────────────
        Amber, not red: this is money that WILL be released on the way out,
        not money already taken. Red is reserved for the captured case
        directly above, which is genuinely irreversible from here.

        There is no opt-out. Leaving a hold on a customer's card while
        deleting the only record of it is never a thing to offer as a
        choice — the ticket exists to make the operator aware, not to let
        them decline. %>
    <div id="ord-del-auth"
         style="display:none;margin:0 0 12px;padding:10px 12px;border-radius:8px;
                background:#FFF8E6;border:1px solid #E8D9A8;
                color:#6B5A24;font-size:.85rem;line-height:1.5"></div>

    <label for="ord-del-reason"
           style="display:block;font-size:.78rem;font-weight:700;margin:0 0 4px;
                  text-transform:uppercase;letter-spacing:.04em;color:var(--text-muted)">
      Reason
    </label>
    <select id="ord-del-reason" class="adm-search-select" style="width:100%">
      <% ORDER_DELETE_REASONS.forEach(function (r) { %>
        <option value="<%= r.code %>" data-requires-note="<%= r.requiresNote ? '1' : '' %>"><%= r.label %></option>
      <% }); %>
    </select>

    <div id="ord-del-note-wrap" style="margin-top:10px">
      <label for="ord-del-note"
             style="display:block;font-size:.78rem;font-weight:700;margin:0 0 4px;
                    text-transform:uppercase;letter-spacing:.04em;color:var(--text-muted)">
        Note <span id="ord-del-note-req" style="color:var(--red,#dc2626);display:none">(required)</span>
      </label>
      <textarea id="ord-del-note" rows="2" placeholder="Anything worth knowing later…"
                style="width:100%;border:1.5px solid var(--border-input,#d0d5dd);border-radius:6px;
                       padding:.5rem .75rem;font-family:var(--font-sans);font-size:.85rem;resize:vertical;outline:0"></textarea>
      <div id="ord-del-err" style="display:none;color:var(--red,#dc2626);font-size:.8rem;margin-top:4px"></div>
    </div>

    <p class="adm-meta" style="margin:12px 0 0;font-size:.8rem">
      Permanent. A snapshot is written to <code>order_deletions</code> first.
    </p>

    <div class="modal-actions">
      <button type="button" id="ord-del-go" class="btn btn-sm"
              style="background:var(--red,#dc2626);color:#fff;border-color:var(--red,#dc2626)">Delete</button>
      <button type="button" id="ord-del-cancel" class="btn btn-outline btn-sm">Cancel</button>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
(function () {
  const MIN_NOTE = <%= MIN_DELETE_NOTE %>;

  const bar     = document.getElementById('ord-bulk-bar');
  const countEl = document.getElementById('ord-bulk-count');
  const selAll  = document.getElementById('ord-select-all');
  const boxes   = () => Array.from(document.querySelectorAll('.ord-select'));
  const picked  = () => boxes().filter(b => b.checked);

  function sync() {
    const n = picked().length;
    countEl.textContent = n;
    bar.style.display = n ? 'flex' : 'none';
    if (selAll) {
      selAll.checked = n > 0 && n === boxes().length;
      selAll.indeterminate = n > 0 && n < boxes().length;
    }
  }
  boxes().forEach(b => b.addEventListener('change', sync));
  if (selAll) selAll.addEventListener('change', () => {
    boxes().forEach(b => { b.checked = selAll.checked; }); sync();
  });
  document.getElementById('ord-bulk-clear').addEventListener('click', () => {
    boxes().forEach(b => { b.checked = false; }); sync();
  });

  /* ── the modal ──────────────────────────────────────────────────────── */
  const modal   = document.getElementById('ord-del-modal');
  const elTitle = document.getElementById('ord-del-title');
  const elWhat  = document.getElementById('ord-del-what');
  const elCap   = document.getElementById('ord-del-captured');
  const elAuth  = document.getElementById('ord-del-auth');
  const elSel   = document.getElementById('ord-del-reason');
  const elNote  = document.getElementById('ord-del-note');
  const elReq   = document.getElementById('ord-del-note-req');
  const elErr   = document.getElementById('ord-del-err');
  const elGo    = document.getElementById('ord-del-go');

  let pending = null;   // { ids:[], label:'', captured:n, auth:n, authTotal:n }

  function noteRequired() {
    const o = elSel.options[elSel.selectedIndex];
    return !!(o && o.dataset.requiresNote);
  }
  function refreshNote() {
    elReq.style.display = noteRequired() ? '' : 'none';
    elErr.style.display = 'none';
  }
  elSel.addEventListener('change', refreshNote);

  function open(ids, label, captured, auth, authTotal) {
    pending = { ids, label, captured, auth, authTotal };
    elTitle.textContent = ids.length > 1 ? 'Delete ' + ids.length + ' orders' : 'Delete order';
    elWhat.textContent  = label;
    if (captured) {
      elCap.textContent = captured > 1
        ? captured + ' of these have captured payments. Stripe keeps its own record; this removes yours.'
        : 'This order has a captured payment. Stripe keeps its own record; this removes yours.';
      elCap.style.display = '';
    } else { elCap.style.display = 'none'; }

    /* The hold warning. Stated as what WILL happen, not as a question —
       the release is not optional, because leaving a hold on a card while
       deleting the record of it is not a defensible outcome. The amount is
       named so the operator is reading a number, not a category. */
    if (auth) {
      const money = authTotal
        ? ' totalling $' + authTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        : '';
      elAuth.textContent = (auth > 1
        ? auth + ' of these are holding uncaptured authorizations' + money
        : 'This order is holding an uncaptured authorization' + money) +
        ' on the customer\'s card. The hold will be RELEASED before the ' +
        'record is removed. If Stripe refuses, that order is left alone.';
      elAuth.style.display = '';
    } else { elAuth.style.display = 'none'; }
    elSel.selectedIndex = 0; elNote.value = ''; refreshNote();
    elGo.disabled = false; elGo.textContent = 'Delete';
    modal.style.display = 'flex';
    elSel.focus();
  }
  function close() { modal.style.display = 'none'; pending = null; }
  document.getElementById('ord-del-cancel').addEventListener('click', close);
  modal.addEventListener('click', e => { if (e.target === modal) close(); });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && modal.style.display !== 'none') close();
  });

  elGo.addEventListener('click', async () => {
    if (!pending) return;
    const note = elNote.value.trim();

    /* Validated here AND on the server. This half is for the person; the
       server half is because a prompt-enforced rule is only a suggestion. */
    if (noteRequired() && note.length < MIN_NOTE) {
      elErr.textContent = 'A note of at least ' + MIN_NOTE + ' characters is required for this reason.';
      elErr.style.display = ''; elNote.focus(); return;
    }
    if (note && note.length < MIN_NOTE) {
      elErr.textContent = 'Either leave the note empty or write at least ' + MIN_NOTE + ' characters.';
      elErr.style.display = ''; elNote.focus(); return;
    }

    elGo.disabled = true; elGo.textContent = 'Deleting…';
    try {
      const res = await fetch('/admin/orders/bulk-delete', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ids: pending.ids,
          reason_code: elSel.value,
          reason_note: note,
          /* The captured-payment refusal is the server's, not the UI's. The
             banner above is the warning; THIS is the acknowledgement. */
          confirm_captured: pending.captured > 0,
          /* Same model for uncaptured holds: the server refuses to delete
             one without this flag, and releases the hold before the row
             when it is set. Sent only when the modal actually warned about
             holds, so a stale page cannot authorise a release it never
             showed the operator. */
          release_auth: pending.auth > 0,
        }),
      });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'Delete failed');
      /* x.detail is a sentence; x.reason is the machine code behind it.
         The sentence is what gets shown — 'authorization_pending' told an
         operator nothing about why their order survived the delete. */
      if (data.skipped && data.skipped.length) {
        alert('Deleted ' + data.deleted +
              (data.authReleased ? ' (' + data.authReleased + ' authorization(s) released)' : '') +
              '. Skipped ' + data.skipped.length + ':\n\n' +
              data.skipped.map(x =>
                '• ' + (x.orderNumber || x.id) + ' — ' + (x.detail || x.reason)).join('\n'));
      } else if (data.authReleased) {
        alert('Deleted ' + data.deleted + '. ' + data.authReleased +
              ' uncaptured authorization(s) were released first.');
      }
      window.location.reload();
    } catch (err) {
      elErr.textContent = 'Delete failed: ' + err.message;
      elErr.style.display = '';
      elGo.disabled = false; elGo.textContent = 'Delete';
    }
  });

  /* row

     ⚠️ The per-row delete button carries data-captured but NOT data-auth or
     data-total — those live on the row CHECKBOX, which is a different
     element. Rather than duplicate the attributes onto a second element and
     create two places to forget, the checkbox for this id is looked up. */
  document.querySelectorAll('.ord-del-one').forEach(btn => {
    btn.addEventListener('click', () => {
      const cb = document.querySelector('.ord-select[value="' + btn.dataset.id + '"]');
      open([btn.dataset.id], btn.dataset.number,
           btn.dataset.captured ? 1 : 0,
           (cb && cb.dataset.auth) ? 1 : 0,
           (cb && cb.dataset.auth) ? Number(cb.dataset.total || 0) : 0);
    });
  });

  /* bulk */
  document.getElementById('ord-bulk-delete').addEventListener('click', () => {
    const chosen = picked();
    if (!chosen.length) return;
    const nums = chosen.map(b => b.dataset.number);
    const held = chosen.filter(b => b.dataset.auth);
    open(chosen.map(b => b.value),
         nums.slice(0, 6).join(', ') + (nums.length > 6 ? ', …and ' + (nums.length - 6) + ' more' : ''),
         chosen.filter(b => b.dataset.captured).length,
         held.length,
         held.reduce((a, b) => a + Number(b.dataset.total || 0), 0));
  });

  sync();
})();
</script>
