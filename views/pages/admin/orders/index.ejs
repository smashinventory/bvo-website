<!-- ══ Toolbar ══════════════════════════════════════════════════════ -->
<div class="adm-toolbar">
  <span class="adm-toolbar-title">Orders</span>

  <form method="GET" action="/admin/orders" class="adm-search-form" id="orderSearchForm">
    <input type="text" name="search" value="<%= search %>" placeholder="Search order #, customer, email…" class="adm-search-input">
    <%# Status definitions come from src/config/orderStatuses.js so the filter,
        the badges and the detail-page dropdown can never drift apart. %>
    <select name="status" class="adm-search-select" onchange="document.getElementById('orderSearchForm').submit()">
      <option value="">All Statuses</option>
      <% ORDER_STATUSES.forEach(s => { %>
        <option value="<%= s.value %>" title="<%= s.tip %>" <%= status === s.value ? 'selected' : '' %>><%= s.label %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-primary">Search</button>
    <% if (status || search) { %>
      <a href="/admin/orders" class="btn btn-outline">Clear</a>
    <% } %>
  </form>

  <div style="display:flex;gap:8px;flex-shrink:0">
    <a href="/admin/orders/shipments" class="btn btn-outline">🚚 Shipments</a>
    <a href="/admin/orders/reports"   class="btn btn-outline">📊 Reports</a>
  </div>
</div>

<!-- RAG Summary Bar -->
<div class="rag-summary">
  <div class="rag-badge rag-badge--red">
    <span class="rag-dot rag-dot--red"></span>
    <strong><%= ragCounts.red %></strong> Need Attention
  </div>
  <div class="rag-badge rag-badge--yellow">
    <span class="rag-dot rag-dot--yellow"></span>
    <strong><%= ragCounts.yellow %></strong> Watch
  </div>
  <div class="rag-badge rag-badge--green">
    <span class="rag-dot rag-dot--green"></span>
    <strong><%= ragCounts.green %></strong> On Track
  </div>
</div>

<!-- Orders Table -->
<div class="adm-table-wrap">
  <table class="adm-table">
    <thead>
      <tr>
        <th style="width:28px"></th>
        <th>Order</th>
        <th>Customer</th>
        <th>Total</th>
        <th>Status</th>
        <th>Vendor PO</th>
        <th>Shipment</th>
        <th>Date</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (orders.length === 0) { %>
        <tr><td colspan="9" class="adm-empty" style="border-radius:0">No orders found.</td></tr>
      <% } %>
      <% orders.forEach(o => { %>
        <tr class="order-row order-row--<%= o.rag %>">
          <td><span class="rag-dot rag-dot--<%= o.rag %>" title="<%= o.rag === 'red' ? 'Needs attention' : o.rag === 'yellow' ? 'Watch' : 'On track' %>"></span></td>
          <td><a href="/admin/orders/<%= o.id %>" style="font-weight:700;color:var(--color-navy)"><%= o.order_number %></a></td>
          <td><%= o.customer_name || '—' %></td>
          <td style="font-weight:700">$<%= parseFloat(o.total || 0).toFixed(2) %></td>
          <%# Hover explains what the status means — definitions live in
              src/config/orderStatuses.js %>
          <td><span class="order-status order-status--<%= o.status %>"
                    title="<%= (ORDER_STATUSES.find(s => s.value === o.status) || {}).tip || '' %>"
                    style="cursor:help"><%= o.status %></span></td>
          <td>
            <% if (!o.vpo_status) { %>
              <span class="rag-pill rag-pill--red">Not Sent</span>
            <% } else if (o.vpo_status === 'sent') { %>
              <span class="rag-pill rag-pill--yellow">Awaiting Confirm</span>
            <% } else if (o.vpo_status === 'confirmed') { %>
              <span class="rag-pill rag-pill--green">Confirmed</span>
            <% } else { %>
              <span class="rag-pill rag-pill--yellow"><%= o.vpo_status %></span>
            <% } %>
          </td>
          <td>
            <% if (!o.ship_status) { %>
              <span class="rag-pill rag-pill--grey">—</span>
            <% } else if (o.ship_status === 'delivered') { %>
              <span class="rag-pill rag-pill--green">Delivered</span>
            <% } else if (o.ship_status === 'exception') { %>
              <span class="rag-pill rag-pill--red">Exception</span>
            <% } else { %>
              <span class="rag-pill rag-pill--yellow"><%= o.ship_status.replace('_',' ') %></span>
            <% } %>
          </td>
          <td class="adm-meta"><%= new Date(o.created_at).toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'}) %></td>
          <td>
            <div style="display:flex;gap:4px">
              <a href="/admin/orders/<%= o.id %>" class="btn btn-outline btn-sm">View</a>
              <%# Ship button visibility — TWO independent gates, both required.

                  1. Order status. in_transit added 2026-08-31: freight already
                     moving, must not offer to book a second shipment for it.

                  2. Shipment presence. ADDED 2026-09-02. Gate 1 alone was not
                     enough: an order can carry a live booked shipment while its
                     own status lags behind (seen on BVO-20260004 — shipment
                     ATE34769491 Booked, order still Confirmed). The button
                     showed, one click from booking real freight twice.
                     o.ship_status was already loaded for the badge above; it
                     just was not consulted here.

                  A voided shipment deliberately does NOT block the button —
                  the whole point of the void revert is to allow re-shipping. %>
              <%
                const _orderBlocks = ['shipped','in_transit','delivered','cancelled','refunded']
                                       .includes(o.status);
                const _hasLiveShipment = !!o.ship_status && o.ship_status !== 'voided';
              %>
              <% if (!_orderBlocks && !_hasLiveShipment) { %>
              <a href="/admin/shipping/create?orderId=<%= o.id %>" class="btn btn-sm btn-ship" title="Create shipment for this order">Ship</a>
              <% } else if (_hasLiveShipment && !_orderBlocks) { %>
              <%# Mismatch: shipment exists but the order never advanced. Say so
                  rather than silently hiding the button, which would look like
                  a missing feature. %>
              <span class="adm-meta" style="font-size:.72rem;color:#b45309;white-space:nowrap"
                    title="This order already has a <%= o.ship_status %> shipment, but its status is still &quot;<%= o.status %>&quot;. The Ship button is hidden to prevent double-booking. Open the order to reconcile.">⚠ status lag</span>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- Pagination -->
<% if (pages > 1) { %>
  <div style="display:flex;gap:6px;margin-top:16px;flex-wrap:wrap">
    <% for (let i = 1; i <= pages; i++) { %>
      <a href="/admin/orders?page=<%= i %><%= status ? '&status='+status : '' %><%= search ? '&search='+encodeURIComponent(search) : '' %>"
         class="adm-page-btn <%= i === page ? 'active' : '' %>"><%= i %></a>
    <% } %>
  </div>
<% } %>
<p class="adm-count" style="margin-top:10px"><%= total %> order<%= total !== 1 ? 's' : '' %> total</p>

<style>
.btn-ship { background:#1a2e4a;color:#fff;border:1px solid #1a2e4a;border-radius:4px;padding:3px 10px;font-size:.78rem;font-weight:600;text-decoration:none;white-space:nowrap }
.btn-ship:hover { background:#2b4a78;border-color:#2b4a78;color:#fff }
</style>
