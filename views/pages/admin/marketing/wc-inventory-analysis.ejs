<%
/* ═══════════════════════════════════════════════════════════════════
   WC Inventory Analysis

   SOURCE NOTE (required on every chart and table on this page):
     "Water Creation national wholesale shipments — not BVO sales, not
      RFL sales."

   A reader who mistakes this for our own sales draws the exact opposite
   conclusion about our performance, so the labelling is not decoration.

   AGGREGATION — stated accurately.
   Every model/collection/colour/size/top figure is MAX(demand_min) per
   base_sku per day, then summed. A TRUE base collapse, unlike the JMV
   dashboard's variant-level collapse. WC publishes one cabinet as many
   SKUs (one per mirror/faucet permutation) against one stock pool, so
   SUMMING ACROSS CONFIGS OVERSTATES BY 3.8–6.0x. Measured, not assumed.

   COVERAGE. Attribute cuts are only as complete as the coverage strip at
   the top of this page says — which is computed live, so trust the strip
   over any number written in prose.

   As of 2026-11-25 coverage is ~100% for collection, colour, top material
   and sink count, because attributes are now decoded from the base SKU
   (src/data/wcCodebook.js) rather than looked up in the 2021 supplier
   catalogue, which only ever described ~22%. Earlier versions of this
   comment said a fifth, and that is no longer true.

   Every attribute card still carries its undescribed count, and those must
   stay. Coverage is high today but a new WC collection arrives as an
   unresolved code, and the card must show that rather than quietly shrink
   its own denominator. TOP FINISH IS THE STANDING EXCEPTION: it cannot be
   derived from the SKU (the same QZ code is Whitebrook on Sequoia and
   Carrara on Palace), so that card is expected to read as undescribed.

   NO PRICING. Units only. There is no revenue figure on this page by
   design; do not add one.

   NEVER add the express-ejs-layouts script-block helper to this file. It
   wipes every <script> on the page. See PROJECT_BRIEF §9 for the mechanism
   and the four admin pages it already broke. (The helper's literal name is
   deliberately not written here, so a grep-based gate counts zero.)
═══════════════════════════════════════════════════════════════════ */
const fmt  = n => (n === null || n === undefined || n === '') ? '—' : Number(n).toLocaleString();
const fmt1 = n => (n === null || n === undefined || n === '') ? '—' : Number(n).toFixed(1);
const pct  = n => (n === null || n === undefined) ? '—' : Number(n).toFixed(1) + '%';
const MONTHS = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const c = (k) => (cards && cards[k]) ? cards[k] : { rows: [], error: null };
const rows = (k) => c(k).rows || [];
const sizeLabel = v => (v === null || v === undefined || v === '') ? '—' : (Number(v) + '"');
%>

<div class="adm-toolbar">
  <h1 class="adm-toolbar-title">WC Inventory Analysis</h1>
  <div class="adm-meta">
    <% if (!empty && status && status.last_date) { %>
      Data through <strong><%= status.last_date %></strong>
      · <%= fmt(status.valid_days) %> of <%= fmt(status.days) %> days valid
      · from <%= status.first_date %>
    <% } %>
  </div>
</div>

<p class="adm-label" style="margin:0 0 14px">
  <strong>Water Creation national wholesale shipments</strong> — inferred from daily
  inventory snapshots across all WC dealers. <strong>Not BVO sales. Not RFL sales.</strong>
  Units only. Figures are <em>observed drawdown (minimum demand)</em>, never units sold:
  restock days hide real demand.
</p>

<%
const _scopes = locals.scopes || {};
const _scopeKey = locals.scopeKey || 'vanity';
const _fams = locals.families || [];
const _famTotal = _fams.reduce((s,f)=>s+Number(f.skus||0),0);
const _inScope = (_scopes[_scopeKey] && _scopes[_scopeKey].families) || null;
%>
<div class="admin-card">
  <h3 class="admin-card-title">Product scope</h3>
  <p class="adm-label">
    The WC feed is not all bathroom vanities — it also carries faucets, kitchen
    sinks, wash stands, mirrors, linen cabinets and accessories. Everything below
    is restricted to the scope selected here.
  </p>
  <div class="adm-toolbar" style="gap:8px;flex-wrap:wrap;margin:8px 0 4px">
    <% Object.keys(_scopes).forEach(function(k){ %>
      <a class="btn <%= k === _scopeKey ? 'btn-outline jmv-sort--active' : 'btn-outline' %>"
         href="?scope=<%= k %>&days=<%= windowDays %>"><%= _scopes[k].label %></a>
    <% }) %>
  </div>
  <% if (_fams.length) { %>
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead><tr><th>Family</th><th>SKUs</th><th>Models</th><th>In this scope?</th></tr></thead>
        <tbody>
        <% _fams.forEach(function(f){
             const inScope = !_inScope || _inScope.indexOf(f.family) >= 0; %>
          <tr class="<%= f.family === 'unclassified' && Number(f.skus) > 1 ? 'jmv-row--warn' : '' %>">
            <td><%= f.family %></td>
            <td><%= fmt(f.skus) %></td>
            <td><%= fmt(f.models) %></td>
            <td><%= inScope ? 'yes' : '—' %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <p class="adm-label">
      <strong>Vanity tops are not a family and cannot be.</strong> The top is part of
      the vanity SKU — <code>CH24CW03GK</code> <em>is</em> the cabinet-and-top. Top
      demand is therefore read from the <strong>top material</strong> and
      <strong>top finish</strong> breakdowns below, within the vanity scope.
    </p>
    <% const _unc = _fams.find(f => f.family === 'unclassified'); %>
    <% if (_unc && Number(_unc.skus) > 1) { %>
      <p class="adm-label">
        <strong><%= fmt(_unc.skus) %> SKUs could not be classified.</strong> That is
        usually a new WC product line rather than noise — worth a look before
        trusting the scope split. (One known benign case: a 2024 phantom listing
        that never carried stock.)
      </p>
    <% } %>
  <% } %>
</div>

<% if (typeof fatal !== 'undefined' && fatal) { %>
  <div class="admin-card kpi-card kpi-card--warn">
    <h3 class="admin-card-title">Dashboard failed to load</h3>
    <p class="adm-label"><%= fatal %></p>
    <p class="adm-label">If this mentions a missing table, migration 030 has not been run.</p>
  </div>
<% } %>

<% if (empty) { %>
  <div class="admin-card">
    <h3 class="admin-card-title">No snapshots ingested yet</h3>
    <p class="adm-label">
      The four <code>wc_*</code> tables exist but hold no data. Put the daily snapshot
      CSVs (named <code>wc_YYYY-MM-DD.csv</code>) in
      <code>&lt;domain root&gt;/wc_sync/snapshots/</code>, then run the rollup.
    </p>
    <p class="adm-label">
      Ingestion is <strong>resumable</strong>: each run skips dates it has already
      evaluated. With ~1,628 snapshots the backlog will not clear in one pass, so
      press this repeatedly until it reports 0 processed.
    </p>
    <button type="button" class="btn btn-outline" id="wc-run-rollup">Run rollup</button>
    <span class="adm-label" id="wc-rollup-status"></span>
    <div class="adm-label" id="wc-rollup-diag"></div>
  </div>
<% } else { %>

<!-- ══ COVERAGE ════════════════════════════════════════════════════ -->
<div class="admin-card">
  <h3 class="admin-card-title">Catalogue coverage — read this before trusting any attribute cut</h3>
  <p class="adm-label">
    <%= fmt(coverage.skus) %> SKUs collapse to <strong><%= fmt(coverage.bases) %> models</strong>
    (base SKUs). Attributes come from the 2021 supplier catalogue, which does not
    describe the whole feed.
  </p>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr><th>Attribute</th><th>Described</th><th>Coverage</th><th>Undescribed</th></tr></thead>
      <tbody>
        <tr><td>Collection</td><td><%= fmt(coverage.with_collection) %></td><td><%= pct(coverage.collection_pct) %></td><td><%= fmt(Number(coverage.skus) - Number(coverage.with_collection||0)) %></td></tr>
        <tr><td>Size</td><td><%= fmt(coverage.with_size) %></td><td><%= pct(coverage.size_pct) %></td><td><%= fmt(Number(coverage.skus) - Number(coverage.with_size||0)) %></td></tr>
        <tr class="<%= Number(coverage.colour_pct) < 50 ? 'jmv-row--warn' : '' %>"><td>Cabinet colour</td><td><%= fmt(coverage.with_colour) %></td><td><%= pct(coverage.colour_pct) %></td><td><%= fmt(Number(coverage.skus) - Number(coverage.with_colour||0)) %></td></tr>
        <tr class="<%= Number(coverage.top_pct) < 50 ? 'jmv-row--warn' : '' %>"><td>Top material</td><td><%= fmt(coverage.with_top) %></td><td><%= pct(coverage.top_pct) %></td><td><%= fmt(Number(coverage.skus) - Number(coverage.with_top||0)) %></td></tr>
      </tbody>
    </table>
  </div>
  <p class="adm-label">
    Attributes are decoded from the base SKU itself &mdash; <code>PA</code>&middot;<code>60</code>&middot;<code>QZ</code>&middot;<code>05</code>&middot;<code>PW</code>
    is Palace, 60&quot;, Quartz, Polished Nickel, Pure White &mdash; against a codebook verified
    from the supplier catalogues and the vendor&rsquo;s own product copy. Where the 2021
    catalogue describes a SKU directly, <strong>it wins</strong>; the decode only fills gaps.
    <strong>Undescribed rows are the ones to watch</strong>: a non-zero count means WC has
    shipped a code we have not verified yet, not that the card is broken.
    There is deliberately no <em>top finish</em> or <em>mounting</em> cut &mdash; neither can be
    sourced honestly today, so they were removed rather than left permanently empty.
  </p>
</div>

<!-- ══ ROW 1 — ALERT STRIP ════════════════════════════════════════ -->
<h2 class="report-section-title">Stock position — as of <%= status.last_date %></h2>
<% const ss = rows('stockoutSummary')[0] || {}; %>
<div class="admin-card kpi-card kpi-card--<%= Number(ss.no_eta||0) > 0 ? 'warn' : 'ok' %>">
  <h3 class="admin-card-title">Out of stock</h3>
  <p class="adm-label">
    <strong><%= fmt(ss.bases_out) %> models</strong> fully out —
    <strong><%= fmt(ss.no_eta) %> with no restock date</strong>,
    <%= fmt(ss.with_eta) %> with an ETA.
  </p>
  <p class="adm-label">
    Counted at model level. A model is "out" only when every one of its
    configurations is at zero.
  </p>
</div>

<div class="admin-card">
  <h3 class="admin-card-title">Models at zero — no ETA first</h3>
  <% if (c('stockouts').error) { %>
    <p class="adm-label">Could not load: <%= c('stockouts').error %></p>
  <% } else if (!rows('stockouts').length) { %>
    <p class="adm-empty">Nothing out of stock in the latest snapshot.</p>
  <% } else { %>
  <div class="adm-table-wrap jmv-scroll-wrap">
    <table class="adm-table">
      <thead><tr><th>Model</th><th>Collection</th><th>Colour</th><th>Size</th><th>Restock ETA</th></tr></thead>
      <tbody>
      <% rows('stockouts').forEach(r => { %>
        <tr class="<%= Number(r.has_eta) === 0 ? 'jmv-row--critical' : '' %>">
          <td><code><%= r.base_sku %></code><% if (r.product_name) { %><br><span class="adm-label"><%= r.product_name %></span><% } %></td>
          <td><%= r.collection || '—' %></td>
          <td><%= r.cabinet_color || '—' %></td>
          <td><%= sizeLabel(r.size_nominal) %></td>
          <td><%= Number(r.has_eta) === 0 ? 'NO ETA' : r.eta %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<!-- ══ ROW 2 — HEADLINE MOVERS ════════════════════════════════════ -->
<h2 class="report-section-title" style="margin-top:28px">
  Headline movers — last <%= windowDays %> days
  · <%= (locals.scopes && locals.scopes[locals.scopeKey] && locals.scopes[locals.scopeKey].label) || 'Vanities' %>
</h2>

<div class="admin-card">
  <h3 class="admin-card-title">Top collections by observed drawdown</h3>
  <p class="adm-label">Scope: <strong><%= (locals.scopes && locals.scopes[locals.scopeKey] && locals.scopes[locals.scopeKey].label) || 'Vanities' %></strong></p>
  <% if (!rows('topCollections').length) { %>
    <p class="adm-empty">No movement in this window<%= c('topCollections').error ? ' — ' + c('topCollections').error : '' %>.</p>
  <% } else { %>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr><th>Collection</th><th>Drawdown</th><th>Units/observed day</th><th>Models</th><th>Days seen</th></tr></thead>
      <tbody>
      <% rows('topCollections').forEach(r => { %>
        <tr><td><%= r.collection %></td><td><%= fmt(r.drawdown) %></td>
            <td><%= fmt1(r.units_per_day) %></td><td><%= fmt(r.models) %></td>
            <td><%= fmt(r.observed_days) %></td></tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <p class="adm-label">MAX per model per day, then summed. Never SUM across configurations.</p>
  <% } %>
</div>

<div class="admin-card">
  <h3 class="admin-card-title">Top models</h3>
  <% if (!rows('topModels').length) { %>
    <p class="adm-empty">No movement in this window.</p>
  <% } else { %>
  <div class="adm-table-wrap jmv-scroll-wrap">
    <table class="adm-table">
      <thead><tr><th>Model</th><th>Collection</th><th>Colour</th><th>Size</th><th>Drawdown</th><th>Units/day</th></tr></thead>
      <tbody>
      <% rows('topModels').forEach(r => { %>
        <tr><td><code><%= r.base_sku %></code></td>
            <td><%= r.collection || '—' %></td>
            <td><%= r.cabinet_color || '—' %></td>
            <td><%= sizeLabel(r.size_nominal) %></td>
            <td><%= fmt(r.drawdown) %></td>
            <td><%= fmt1(r.units_per_day) %></td></tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<!-- ══ ROW 3 — DIMENSION BREAKDOWNS ═══════════════════════════════ -->
<h2 class="report-section-title" style="margin-top:28px">Dimension breakdowns</h2>

<%
/* ⚠️ TOP FINISH AND MOUNTING TYPE WERE REMOVED (2026-11-25). DO NOT RE-ADD
   THEM WITHOUT A NEW DATA SOURCE — they were not forgotten, they were cut
   because neither can be populated honestly, and a permanently empty card
   makes a working report look broken.

   MOUNTING. The obvious source is the 2020 catalogue's "Installation Type"
   column. It is a FAUCET attribute, not a vanity one: its values are
   "Deck mount" and "Freestanding", Potenza carries BOTH at once (12 and 20),
   and only 7 of 30 collections have any value at all. Filling the vanity's
   mounting from it would have put faucet installation data under a vanity
   label — correct-looking and wrong. Separately, every WC vanity in the
   vendor's own copy is free-standing, so even a correct card would read
   "Freestanding 100%" and carry no information.

   TOP FINISH. It cannot be derived from the SKU: the same QZ code is
   Whitebrook on Sequoia and Westin but Carrara on Palace. The 2020
   catalogue only ever says "Carrara White", and only for the 7 CW
   collections, which merely restates top_material. Real coverage needs a
   current WC product-data export, or a (collection + top code) table built
   by hand from vendor copy — roughly a third coverage for ~20 lookups.

   The wc_dimensions.top_finish and .mounting COLUMNS are deliberately left
   in place so a future source can fill them without a migration. */
const dimCards = [
  ['byColour',      'Cabinet colours',  'cabinet colour', coverage.colour_pct],
  ['bySize',        'Sizes',            'size',           coverage.size_pct],
  ['byTopMaterial', 'Top material',     'top material',   coverage.top_pct],
  ['bySinks',       'Sink count',       'sink count',     coverage.top_pct],
];
%>
<% dimCards.forEach(([key, title, noun, covPct]) => { %>
  <div class="admin-card">
    <h3 class="admin-card-title"><%= title %></h3>
    <% if (!rows(key).length) { %>
      <p class="adm-empty">No described rows for <%= noun %> in this window.</p>
    <% } else { %>
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead><tr><th><%= title %></th><th>Drawdown</th><th>Models</th></tr></thead>
        <tbody>
        <% rows(key).forEach(r => { %>
          <tr><td><%= key === 'bySize' ? sizeLabel(r.label) : (r.label || '—') %></td>
              <td><%= fmt(r.drawdown) %></td><td><%= fmt(r.models) %></td></tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <%# "described" = resolved from the SKU codebook OR the supplier catalogue.
        This used to say "the catalogue describes", which stopped being true on
        2026-11-25 when the decode became the primary source — the catalogue
        only ever covered ~22%. Keep this wording source-agnostic so it does
        not go stale again the next time the source changes. %>
    <p class="adm-label">
      Covers the <strong><%= pct(covPct) %></strong> of SKUs we can describe for
      <%= noun %>. The remainder are not represented here at all.
    </p>
    <% } %>
  </div>
<% }) %>

<div class="admin-card">
  <h3 class="admin-card-title">Collection × size</h3>
  <% if (!rows('collectionBySize').length) { %>
    <p class="adm-empty">No described rows in this window.</p>
  <% } else { %>
  <div class="adm-table-wrap jmv-scroll-wrap">
    <table class="adm-table">
      <thead><tr><th>Collection</th><th>Size</th><th>Drawdown</th></tr></thead>
      <tbody>
      <% rows('collectionBySize').forEach(r => { %>
        <tr><td><%= r.collection %></td><td><%= sizeLabel(r.size_nominal) %></td><td><%= fmt(r.drawdown) %></td></tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<!-- ══ TREND — INTERACTIVE ════════════════════════════════════════
     Granularity (day/week/month/quarter/year) and two period selectors, so
     any year can be compared against any other. All of it runs client-side
     off one daily series — see the script block for why, and for the
     observed-day normalisation that makes the comparison honest. -->
<h2 class="report-section-title" style="margin-top:28px">Trend — units per observed day</h2>
<div class="admin-card">
  <% const series = rows('dailySeries'); %>
  <% if (!series.length) { %>
    <p class="adm-empty">Not enough history yet.</p>
  <% } else { %>
    <div class="wc-trend-ctl">
      <div class="wc-fld">
        <label class="adm-label" for="wc-gran">Granularity</label>
        <div class="wc-seg" id="wc-gran">
          <button type="button" data-g="D">Daily</button>
          <button type="button" data-g="W">Weekly</button>
          <button type="button" data-g="M" class="on">Monthly</button>
          <button type="button" data-g="Q">Quarterly</button>
          <button type="button" data-g="Y">Annual</button>
        </div>
      </div>
      <div class="wc-fld">
        <label class="adm-label" for="wc-p1">Period</label>
        <select id="wc-p1" class="adm-input"></select>
      </div>
      <div class="wc-fld">
        <label class="adm-label" for="wc-p2">Compare to</label>
        <select id="wc-p2" class="adm-input"></select>
      </div>
    </div>

    <p id="wc-trend-legend" class="adm-label" style="margin:10px 0 6px"></p>
    <canvas id="wcTrendChart" height="110"></canvas>
    <p class="adm-label" style="margin-top:9px">
      Every point is drawdown divided by the days actually observed in that bucket.
      The feed skips days, so a raw total would make a sparsely-observed period look
      weak — and in a year-on-year read that error lands on the number you act on.
      The comparison line is aligned by <strong>position within the period</strong>,
      not by date, so Jan sits above Jan.
    </p>

    <details style="margin-top:10px">
      <summary class="adm-label" style="cursor:pointer">Monthly table — rate, drawdown and days observed</summary>
      <div class="adm-table-wrap jmv-scroll-wrap" style="margin-top:9px">
        <table class="adm-table">
          <thead><tr><th>Month</th><th>Units/observed day</th><th>Drawdown</th><th>Days observed</th></tr></thead>
          <tbody>
          <% trend.slice().reverse().forEach(r => { %>
            <tr><td><%= r.yr %>-<%= String(r.mo).padStart(2,'0') %></td>
                <td><%= fmt1(r.units_per_day) %></td>
                <td><%= fmt(r.drawdown) %></td>
                <td class="<%= Number(r.observed_days) < 10 ? 'jmv-row--warn' : '' %>"><%= fmt(r.observed_days) %></td></tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </details>
  <% } %>
</div>

<div class="admin-card">
  <h3 class="admin-card-title">Seasonality — year-normalised index</h3>
  <% if (!seasonality.length) { %>
    <p class="adm-empty">Needs at least one year with 8+ observed months.</p>
  <% } else { %>
    <canvas id="wcSeasonChart" height="90"></canvas>
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead><tr><th>Month</th><th>Index (100 = that year's average)</th><th>Years in sample</th></tr></thead>
        <tbody>
        <% seasonality.forEach(r => { %>
          <tr><td><%= MONTHS[r.mo] %></td><td><%= fmt1(r.index) %></td><td><%= r.years %></td></tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <p class="adm-label">
      Each month is indexed against its own year's mean before averaging across years,
      so the multi-year decline cannot leak into the seasonal shape.
    </p>
  <% } %>
</div>

<!-- ══ ONBOARDING PRIORITY ════════════════════════════════════════ -->
<h2 class="report-section-title" style="margin-top:28px">Onboarding priority</h2>
<div class="admin-card">
  <h3 class="admin-card-title">Selling nationally — we don't carry it</h3>
  <p class="adm-label">
    BVO carries no Water Creation today, so this is currently the whole moving
    catalogue ranked by national drawdown. Rows drop off by themselves as SKUs are
    onboarded — the link is resolved from our own product records, not maintained by hand.
  </p>
  <% if (!rows('onboarding').length) { %>
    <p class="adm-empty">No movement in this window.</p>
  <% } else { %>
  <div class="adm-table-wrap jmv-scroll-wrap">
    <table class="adm-table">
      <thead><tr><th>#</th><th>Model</th><th>Collection</th><th>Colour</th><th>Size</th><th>Drawdown</th></tr></thead>
      <tbody>
      <% rows('onboarding').forEach((r, i) => { %>
        <tr><td><%= i + 1 %></td>
            <td><code><%= r.base_sku %></code><% if (r.product_name) { %><br><span class="adm-label"><%= r.product_name %></span><% } %></td>
            <td><%= r.collection || '—' %></td>
            <td><%= r.cabinet_color || '—' %></td>
            <td><%= sizeLabel(r.size_nominal) %></td>
            <td><%= fmt(r.drawdown) %></td></tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<!-- ══ SNAPSHOT HISTORY ═══════════════════════════════════════════ -->
<h2 class="report-section-title" style="margin-top:28px">Snapshot history</h2>
<div class="admin-card">
  <h3 class="admin-card-title">Ingestion audit — last 60 days evaluated</h3>
  <button type="button" class="btn btn-outline" id="wc-run-rollup">Run rollup</button>
  <span class="adm-label" id="wc-rollup-status"></span>
  <div class="adm-label" id="wc-rollup-diag"></div>
  <div class="adm-table-wrap jmv-scroll-wrap">
    <table class="adm-table">
      <thead><tr><th>Date</th><th>Rows</th><th>Valid</th><th>Schema</th><th>Notes</th></tr></thead>
      <tbody>
      <% rows('history').forEach(r => { %>
        <tr class="<%= Number(r.is_valid) === 0 ? 'jmv-row--critical' : '' %>">
          <td><%= r.d %></td><td><%= fmt(r.row_count) %></td>
          <td><%= Number(r.is_valid) ? 'yes' : 'NO' %></td>
          <td><%= r.schema_variant || '—' %></td>
          <td><span class="adm-label"><%= r.notes || '' %></span></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<% } %>

<script nonce="<%= cspNonce %>" src="/js/vendor/chart.umd.4.4.1.js"></script>
<script nonce="<%= cspNonce %>">
(function () {
  'use strict';

  /* Rollup trigger. Delegated listener, never an inline onclick — the admin
     CSP forbids inline handlers (see the 2026 CSP sweep). */
  document.addEventListener('click', function (ev) {
    var btn = ev.target.closest('#wc-run-rollup');
    if (!btn) return;
    var out = document.getElementById('wc-rollup-status');
    btn.disabled = true;
    if (out) out.textContent = ' Running — this can take several minutes…';
    fetch('/admin/marketing/wc/run-rollup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: '{}',
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        btn.disabled = false;
        if (!out) return;
        if (!d.ok) { out.textContent = ' Failed: ' + (d.error || 'unknown'); return; }
        out.textContent = ' Processed ' + d.processed + ' date(s), ' + d.errors +
          ' error(s). ' + (d.processed ? 'Press again to continue.' : 'Backlog clear.');

        /* 0 processed with files on disk is ambiguous from outside the
           process — wrong path, unreadable directory and unmatched filenames
           all look identical. Show what the job actually saw. */
        var diag = document.getElementById('wc-rollup-diag');
        if (diag && d.disk) {
          if (d.processed === 0 && d.disk.matchedSnapshots === 0) {
            diag.innerHTML =
              '<strong>Found no snapshots.</strong> This is what the job can see:' +
              '<pre style="white-space:pre-wrap;font-size:12px;margin:6px 0">' +
              'resolved path : ' + (d.disk.resolved || '(none)')   + '\n' +
              'exists        : ' + d.disk.exists                    + '\n' +
              'entries in it : ' + d.disk.entryCount                + '\n' +
              'matching wc_* : ' + d.disk.matchedSnapshots          + '\n' +
              'sample        : ' + (d.disk.sample || []).join(', ') + '\n' +
              'WC_SNAPSHOTS_PATH : ' + (d.disk.configured || '(not set)') + '\n' +
              '__dirname     : ' + d.disk.dirname                   + '\n' +
              'cwd           : ' + d.disk.cwd                       +
              (d.disk.error ? '\nerror         : ' + d.disk.error : '') +
              '</pre>';
          } else {
            diag.textContent = '';
          }
        }
        if (d.processed) setTimeout(function () { location.reload(); }, 1200);
      })
      .catch(function (e) {
        btn.disabled = false;
        if (out) out.textContent = ' Failed: ' + e.message;
      });
  });

  var TREND  = <%- JSON.stringify(trend || []) %>;
  var SEASON = <%- JSON.stringify(seasonality || []) %>;
  var MONTH  = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  /* ══ INTERACTIVE TREND ════════════════════════════════════════════
   *
   * One daily series from the server; the browser re-buckets it. Changing
   * granularity or period is instant and costs no round trip, which matters
   * because comparing periods is an exploratory act — you try several.
   *
   * ⚠️ THE ONE RULE: PLOT units ÷ observedDays, NEVER raw units.
   * Each row carries `span` (span_days) because the feed skips days — a
   * single observation can cover several. Summing raw units makes a
   * sparsely-observed bucket look weak, and that error is worst exactly
   * where it matters most: a year-over-year comparison where the two years
   * have different observation density. 2026 has 315 observed days against
   * 2025's 363, so the raw totals are not comparable and the rates are.
   *
   * Buckets are compared BY POSITION, not by date — index 0 against index 0.
   * That is what lets "2026 vs 2024", or "last 90 days vs 2025", line up
   * instead of running off the end of the axis.
   */
  var DAILY = <%- JSON.stringify((rows('dailySeries') || []).map(function (r) {
                   return [r.d, Number(r.units) || 0, Number(r.span) || 1];
                 })) %>;

  var trendEl = document.getElementById('wcTrendChart');
  if (trendEl && DAILY.length && window.Chart) {
    var wcChart = null;

    function bucketOf(iso, g) {
      var y = iso.slice(0, 4), m = +iso.slice(5, 7);
      if (g === 'D') return iso;
      if (g === 'M') return iso.slice(0, 7);
      if (g === 'Q') return y + '-Q' + Math.ceil(m / 3);
      if (g === 'Y') return y;
      var t = new Date(iso + 'T00:00:00Z');          // ISO week start (Mon)
      t.setUTCDate(t.getUTCDate() - ((t.getUTCDay() + 6) % 7));
      return t.toISOString().slice(0, 10);
    }

    function subset(sel) {
      if (sel === 'NONE') return null;
      if (sel === 'ALL')  return DAILY;
      var last = DAILY[DAILY.length - 1][0];
      if (sel === 'L90' || sel === 'L12') {
        var c = new Date(last + 'T00:00:00Z');
        if (sel === 'L90') c.setUTCDate(c.getUTCDate() - 90);
        else               c.setUTCMonth(c.getUTCMonth() - 12);
        var cut = c.toISOString().slice(0, 10);
        return DAILY.filter(function (r) { return r[0] >= cut; });
      }
      return DAILY.filter(function (r) { return r[0].slice(0, 4) === sel; });
    }

    /* → [{k, units, days, rate}] in calendar order. */
    function bucketise(rowsIn, g) {
      if (!rowsIn) return null;
      var map = {}, order = [];
      rowsIn.forEach(function (r) {
        var k = bucketOf(r[0], g);
        if (!map[k]) { map[k] = { k: k, units: 0, days: 0 }; order.push(k); }
        map[k].units += r[1];
        map[k].days  += r[2];               // span_days, not a day count
      });
      return order.sort().map(function (k) {
        var e = map[k];
        e.rate = e.days ? e.units / e.days : 0;
        return e;
      });
    }

    var SEL_G = 'M';
    var p1 = document.getElementById('wc-p1');
    var p2 = document.getElementById('wc-p2');

    var yearSet = {}, years = [];
    DAILY.forEach(function (r) {
      var y = r[0].slice(0, 4);
      if (!yearSet[y]) { yearSet[y] = 1; years.push(y); }
    });
    years.sort().reverse();

    function opt(v, t) { return '<option value="' + v + '">' + t + '</option>'; }
    p1.innerHTML = opt('L90', 'Last 90 days') + opt('L12', 'Last 12 months')
      + years.map(function (y) { return opt(y, y); }).join('') + opt('ALL', 'All time');
    p2.innerHTML = opt('NONE', '— none —')
      + years.map(function (y) { return opt(y, y); }).join('') + opt('L90', 'Last 90 days');
    /* Default to the most useful question: this year against last year. */
    p1.value = years[0] || 'L12';
    p2.value = years[1] || 'NONE';

    function render() {
      var a = bucketise(subset(p1.value), SEL_G) || [];
      var b = bucketise(subset(p2.value), SEL_G);
      var labels = a.map(function (e) {
        return SEL_G === 'M' ? e.k.slice(5) : SEL_G === 'Y' ? e.k : e.k.replace(/^\d{4}-/, '');
      });
      var sets = [{
        label: p1.options[p1.selectedIndex].text,
        data: a.map(function (e) { return Math.round(e.rate * 10) / 10; }),
        borderColor: '#8a6a3b', backgroundColor: 'transparent',
        borderWidth: 2.4, tension: 0.25, pointRadius: 2, spanGaps: true,
      }];
      if (b) sets.push({
        label: p2.options[p2.selectedIndex].text,
        data: b.map(function (e) { return Math.round(e.rate * 10) / 10; }),
        borderColor: '#5b7fa6', backgroundColor: 'transparent',
        borderWidth: 2, borderDash: [5, 4], tension: 0.25, pointRadius: 0, spanGaps: true,
      });

      var sum = function (s, f) { return s.reduce(function (q, e) { return q + e[f]; }, 0); };
      var ra = sum(a, 'days') ? sum(a, 'units') / sum(a, 'days') : 0;
      var txt = '<strong>' + ra.toFixed(1) + '</strong> units/day · '
              + sum(a, 'units').toLocaleString() + ' units over '
              + sum(a, 'days').toLocaleString() + ' observed days';
      if (b && sum(b, 'days')) {
        var rb = sum(b, 'units') / sum(b, 'days');
        var dp = rb ? (ra - rb) / rb * 100 : 0;
        txt += ' &nbsp;·&nbsp; vs <strong>' + rb.toFixed(1) + '</strong> units/day ('
             + sum(b, 'days').toLocaleString() + ' days) &nbsp;·&nbsp; <strong>'
             + (dp >= 0 ? '+' : '') + dp.toFixed(1) + '%</strong>';
      }
      document.getElementById('wc-trend-legend').innerHTML = txt;

      if (wcChart) { wcChart.destroy(); }
      wcChart = new Chart(trendEl, {
        type: 'line',
        data: { labels: labels, datasets: sets },
        options: {
          responsive: true, maintainAspectRatio: true, aspectRatio: 3,
          interaction: { mode: 'index', intersect: false },
          plugins: { legend: { position: 'bottom' } },
          scales: { y: { beginAtZero: true,
            title: { display: true, text: 'units / observed day' } } },
        },
      });
    }

    document.getElementById('wc-gran').addEventListener('click', function (ev) {
      var b = ev.target.closest('button[data-g]');
      if (!b) return;
      this.querySelectorAll('button').forEach(function (z) { z.classList.remove('on'); });
      b.classList.add('on');
      SEL_G = b.dataset.g;
      render();
    });
    p1.addEventListener('change', render);
    p2.addEventListener('change', render);
    render();
  }

  var seasonEl = document.getElementById('wcSeasonChart');
  if (seasonEl && SEASON.length && window.Chart) {
    new Chart(seasonEl, {
      type: 'bar',
      data: {
        labels: SEASON.map(function (r) { return MONTH[r.mo]; }),
        datasets: [{
          label: 'Seasonal index',
          data: SEASON.map(function (r) { return r.index; }),
          backgroundColor: SEASON.map(function (r) {
            return r.index >= 110 ? '#2f6f6b' : (r.index <= 90 ? '#9c5b3f' : '#8c6b4f');
          }),
        }],
      },
      options: {
        responsive: true, maintainAspectRatio: true, aspectRatio: 3,
        plugins: { legend: { display: false },
          title: { display: true, text: '100 = that year’s own average' } },
        scales: { y: { beginAtZero: false, suggestedMin: 60, suggestedMax: 130 } },
      },
    });
  }
})();
</script>
