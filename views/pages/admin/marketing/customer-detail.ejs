<%
/**
 * Admin — one customer.
 *
 * Locals: customer, sourceLabel, orders, addresses, favorites, bundles, spent,
 *         templates, messages, messagesTableMissing, msgOk, msgErr
 *
 * This screen is deliberately NOT filtered by is_test. The list is analytics;
 * this is the record. Being able to open a test account is how it gets
 * recognised as one — and how the flag gets set.
 */
%>

<style>
.cd-top{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.25rem}
.cd-top h1{font-size:1.25rem;font-weight:700;color:var(--navy);margin:0;word-break:break-all}
.cd-back{font-size:.8rem;color:var(--text-muted);text-decoration:none}
.cd-back:hover{text-decoration:underline}
.cd-testbar{background:#FFF8E6;border:1px solid #E8D9A8;border-radius:8px;padding:.7rem .9rem;margin-bottom:1.25rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.cd-testbar p{margin:0;font-size:.8rem;color:#6B5A24;line-height:1.5}
.cd-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1rem;margin-bottom:1.25rem}
.cd-panel{background:#fff;border:1px solid var(--line,#E6E1D8);border-radius:8px;padding:1rem}
.cd-panel h2{font-size:.9rem;font-weight:700;color:var(--navy);margin:0 0 .7rem}
.cd-dl{display:grid;grid-template-columns:auto 1fr;gap:.4rem .9rem;font-size:.82rem;margin:0}
.cd-dl dt{color:var(--text-muted);white-space:nowrap}
.cd-dl dd{margin:0;color:var(--navy)}
.cd-table{width:100%;border-collapse:collapse;font-size:.82rem}
.cd-table th{text-align:left;font-size:.68rem;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);padding:.45rem .5rem;border-bottom:1px solid var(--line,#E6E1D8)}
.cd-table td{padding:.5rem;border-bottom:1px solid #F2F0EB}
.cd-pill{display:inline-block;font-size:.66rem;padding:.12rem .45rem;border-radius:10px;background:#EFEDE8;color:#5A5243}
.cd-pill--test{background:#F6E3E3;color:#8A3A3A}
.cd-empty{font-size:.8rem;color:var(--text-muted);margin:0}
.cd-item{display:flex;gap:.6rem;align-items:center;padding:.4rem 0;border-bottom:1px solid #F2F0EB;font-size:.82rem}
.cd-item img{width:40px;height:40px;object-fit:cover;border-radius:4px;background:#F4F2EE;flex-shrink:0}
/* ── outreach ── */
.cd-flash{border-radius:8px;padding:.7rem .9rem;margin-bottom:1rem;font-size:.82rem;line-height:1.5}
.cd-flash--ok{background:#E9F5EC;border:1px solid #BFE0C8;color:#1F5B32}
.cd-flash--err{background:#FBEAEA;border:1px solid #E6C2C2;color:#8A3A3A}
.cd-oc{display:none;margin-top:.9rem}
.cd-oc.is-open{display:block}
.cd-field{margin-bottom:.7rem}
.cd-field label{display:block;font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);margin-bottom:.25rem}
.cd-field input[type=text],.cd-field input[type=email],.cd-field select,.cd-field textarea{
  width:100%;box-sizing:border-box;font:inherit;font-size:.84rem;padding:.45rem .55rem;
  border:1px solid var(--line,#E6E1D8);border-radius:6px;background:#fff;color:var(--navy)}
.cd-field textarea{min-height:190px;resize:vertical;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.76rem;line-height:1.5}
.cd-hint{font-size:.72rem;color:var(--text-muted);margin:.25rem 0 0;line-height:1.45}
.cd-actions{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin-top:.3rem}
.cd-warn{background:#FFF8E6;border:1px solid #E8D9A8;color:#6B5A24;border-radius:6px;padding:.5rem .65rem;font-size:.76rem;margin:.5rem 0 0;line-height:1.45;display:none}
.cd-warn.is-open{display:block}
.cd-msg-ok{color:#1F5B32;font-weight:700}
.cd-msg-no{color:#8A3A3A;font-weight:700}
</style>

<a class="cd-back" href="/admin/marketing/customers">&larr; All customers</a>

<div class="cd-top">
  <div>
    <h1><%= customer.email %></h1>
    <% if (customer.first_name || customer.last_name) { %>
    <p style="margin:.2rem 0 0;color:var(--text-muted);font-size:.85rem"><%= [customer.first_name, customer.last_name].filter(Boolean).join(' ') %></p>
    <% } %>
  </div>
</div>

<%# The toggle exists because the next round of testing will create more
    rows, and a flag nobody can set is a flag that rots. Flipping it also
    flips this customer's orders — a test customer with real-looking orders
    is the same poisoned metric by another route. %>
<div class="cd-testbar">
  <p>
    <% if (String(customer.is_test) === '1') { %>
    <strong>Flagged as a test account.</strong> Excluded from every figure on the Customers dashboard, along with their orders.
    <% } else { %>
    Counted as a real customer in all analytics.
    <% } %>
  </p>
  <form method="POST" action="/admin/marketing/customers/<%= customer.id %>/test" style="margin:0">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="is_test" value="<%= String(customer.is_test) === '1' ? '0' : '1' %>">
    <button type="submit" class="btn btn-sm">
      <%= String(customer.is_test) === '1' ? 'Count as real' : 'Mark as test' %>
    </button>
  </form>
</div>

<%# ── CONTACT CUSTOMER ───────────────────────────────────────────────────
    WHY THIS PANEL EXISTS. Order 16 failed at checkout on 2026-10-05 and
    the customer sat unreachable for fourteen days, because this screen had
    no way to email anyone. Whatever was eventually sent went from
    someone's own Outlook and left no record here at all.

    TEMPLATE RESPONSE vs BLANK RESPONSE is only a question of what the box
    contains when it opens. Picking a template fetches it, renders its
    {{placeholders}} against this customer, and drops the result in — fully
    editable. Both then go out through the same POST, so there is one send
    path and one place the log can be forgotten.

    ⚠️ NO INLINE HANDLERS (Rule 15). scriptSrcAttr is 'none', so an
    onclick= here would silently do nothing. Everything is data-act,
    dispatched by views/partials/admin/action-dispatch.ejs. %>
<div class="cd-panel" style="margin-bottom:1.25rem">
  <h2 style="margin-bottom:.4rem">Contact customer</h2>

  <% if (msgOk) { %><div class="cd-flash cd-flash--ok"><%= msgOk %></div><% } %>
  <% if (msgErr) { %><div class="cd-flash cd-flash--err"><%= msgErr %></div><% } %>

  <%# Consent state, stated before anyone writes. It does NOT block a send:
      these are one-to-one replies to a customer about their own order, not
      marketing, and transactional mail does not require an opt-in. It is
      shown because an operator about to write something promotional should
      know which of those two they are doing. %>
  <p class="cd-hint" style="margin:0 0 .6rem">
    Marketing consent:
    <strong><%= String(customer.accepts_marketing) === '1' ? 'opted in' : 'NOT opted in' %></strong>.
    Replies about an order are transactional and fine either way — anything
    promotional needs the opt-in.
  </p>

  <div class="cd-actions">
    <button type="button" class="btn btn-sm" data-act="ocOpen" data-a1="template">Template response</button>
    <button type="button" class="btn btn-sm" data-act="ocOpen" data-a1="blank">Blank response</button>
  </div>

  <form class="cd-oc" id="oc-form" method="POST"
        action="/admin/marketing/customers/<%= customer.id %>/message">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="template_key" id="oc-key" value="">

    <div class="cd-field" id="oc-pick" style="display:none">
      <label for="oc-template">Start from a template</label>
      <select id="oc-template" data-act="ocLoad" data-on="change">
        <option value="">— choose —</option>
        <% (templates || []).forEach(function (t) { %>
        <option value="<%= t.trigger_key %>"><%= t.label %><%= String(t.is_active) === '1' ? '' : ' (inactive)' %></option>
        <% }) %>
      </select>
      <p class="cd-hint">Loads the template with this customer's details filled in. Edit it freely — what you send is what is in the boxes below.</p>
    </div>

    <div class="cd-field">
      <label for="oc-to">To</label>
      <input type="email" id="oc-to" name="to_email" value="<%= customer.email %>">
      <p class="cd-hint">Changing this sends elsewhere <strong>without</strong> altering the record. To fix a typo permanently, use <em>Correct email</em> on the order.</p>
    </div>

    <div class="cd-field">
      <label for="oc-subject">Subject</label>
      <input type="text" id="oc-subject" name="subject" maxlength="300">
    </div>

    <div class="cd-field">
      <label for="oc-body">Message (HTML)</label>
      <textarea id="oc-body" name="body_html"></textarea>
      <p class="cd-hint">Sent as HTML. A plain-text alternative is derived automatically — a message with no text part gets filtered as spam.</p>
    </div>

    <% if (orders && orders.length) { %>
    <div class="cd-field">
      <label for="oc-order">About an order (optional)</label>
      <select id="oc-order" name="order_id">
        <option value="">— not about a specific order —</option>
        <% orders.forEach(function (o) { %>
        <option value="<%= o.id %>"><%= o.order_number || ('#' + o.id) %> — <%= o.status %></option>
        <% }) %>
      </select>
      <p class="cd-hint">Files the message against that order as well as this customer.</p>
    </div>
    <% } %>

    <div class="cd-actions">
      <button type="submit" class="btn btn-sm btn-primary">Send</button>
      <button type="button" class="btn btn-sm" data-act="ocClose">Cancel</button>
    </div>
  </form>
</div>

<%# ── WHAT WE HAVE SENT ─────────────────────────────────────────────────
    Failures are listed alongside successes, deliberately. A log that shows
    only what worked hides the rows worth reading — and the next operator
    re-sends into the same blocklist. %>
<div class="cd-panel" style="margin-bottom:1.25rem">
  <h2>Messages sent (<%= (messages || []).length %>)</h2>
  <% if (messagesTableMissing) { %>
  <p class="cd-empty">The message log table does not exist yet — run
    <code>migrations/2026-10-19_customer_outreach_RUNME.sql</code>. Sending
    still works; nothing will be recorded until it is run.</p>
  <% } else if (!(messages || []).length) { %>
  <p class="cd-empty">Nothing has been sent to this customer from here.</p>
  <% } else { %>
  <table class="cd-table">
    <thead><tr><th>When</th><th>To</th><th>Subject</th><th>Kind</th><th>Result</th><th>By</th></tr></thead>
    <tbody>
      <% messages.forEach(function (m) { %>
      <tr>
        <td style="white-space:nowrap"><%= new Date(m.created_at).toLocaleString('en-US') %></td>
        <td><%= m.to_email %></td>
        <td><%= m.subject %>
          <% if (m.order_id) { %><br><a href="/admin/orders/<%= m.order_id %>" style="font-size:.74rem">order</a><% } %></td>
        <td><span class="cd-pill"><%= m.kind %></span></td>
        <td>
          <% if (String(m.sent_ok) === '1') { %>
          <span class="cd-msg-ok">sent</span>
          <% } else { %>
          <span class="cd-msg-no">failed</span>
          <% if (m.error) { %><div style="font-size:.72rem;color:#8A3A3A;line-height:1.4"><%= m.error %></div><% } %>
          <% } %>
        </td>
        <td style="font-size:.74rem"><%= m.actor %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<div class="cd-grid">
  <div class="cd-panel">
    <h2>Account</h2>
    <dl class="cd-dl">
      <dt>Signed up</dt><dd><%= new Date(customer.created_at).toLocaleString('en-US') %></dd>
      <dt>Source</dt><dd><%= sourceLabel %></dd>
      <dt>Email verified</dt>
      <dd><%= customer.email_verified_at ? new Date(customer.email_verified_at).toLocaleDateString('en-US') : 'No' %></dd>
      <dt>Last sign-in</dt>
      <dd><%= customer.last_login_at ? new Date(customer.last_login_at).toLocaleString('en-US') : 'Never' %></dd>
      <dt>Phone</dt><dd><%= customer.phone || '—' %></dd>
      <dt>Total spent</dt><dd>$<%= Math.round(spent).toLocaleString('en-US') %></dd>
    </dl>
  </div>

  <%# Consent shown with its evidence, not as a tick. Source, timestamp and
      IP are what make it defensible if it is ever questioned. %>
  <div class="cd-panel">
    <h2>Marketing consent</h2>
    <dl class="cd-dl">
      <dt>Email</dt><dd><%= String(customer.accepts_marketing) === '1' ? 'Opted in' : 'Not opted in' %></dd>
      <dt>Recorded</dt>
      <dd><%= customer.marketing_consent_at ? new Date(customer.marketing_consent_at).toLocaleString('en-US') : '—' %></dd>
      <dt>Source</dt><dd><%= customer.marketing_consent_source || '—' %></dd>
      <dt>IP</dt><dd><%= customer.marketing_consent_ip || '—' %></dd>
      <dt>SMS</dt><dd><%= String(customer.delivery_sms_consent) === '1' ? 'Opted in' : 'Not opted in' %></dd>
    </dl>
  </div>
</div>

<div class="cd-panel" style="margin-bottom:1rem">
  <h2>Orders (<%= orders.length %>)</h2>
  <% if (!orders.length) { %>
  <p class="cd-empty">No orders.</p>
  <% } else { %>
  <table class="cd-table">
    <thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th></tr></thead>
    <tbody>
      <% orders.forEach(function (o) { %>
      <tr>
        <td><a href="/admin/orders/<%= o.id %>"><%= o.order_number || ('#' + o.id) %></a>
          <% if (String(o.is_test) === '1') { %> <span class="cd-pill cd-pill--test">test</span><% } %></td>
        <td><%= new Date(o.created_at).toLocaleDateString('en-US') %></td>
        <td><span class="cd-pill"><%= o.status %></span></td>
        <td>$<%= Number(o.total).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<div class="cd-grid">
  <div class="cd-panel">
    <h2>Saved items (<%= favorites.length %>)</h2>
    <% if (!favorites.length) { %>
    <p class="cd-empty">Nothing saved.</p>
    <% } else { favorites.forEach(function (f) { %>
    <div class="cd-item">
      <% if (f.primary_image_url) { %><img src="<%= f.primary_image_url %>" alt=""><% } %>
      <div>
        <a href="/products/<%= f.slug %>"><%= f.name %></a>
        <div style="color:var(--text-muted);font-size:.74rem">$<%= Number(f.price).toLocaleString('en-US') %></div>
      </div>
    </div>
    <% }) } %>
  </div>

  <div class="cd-panel">
    <h2>Saved bundles (<%= bundles.length %>)</h2>
    <% if (!bundles.length) { %>
    <p class="cd-empty">No saved bundles.</p>
    <% } else { bundles.forEach(function (b) { %>
    <div class="cd-item">
      <div>
        Bundle #<%= b.id %>
        <div style="color:var(--text-muted);font-size:.74rem">
          Saved <%= new Date(b.created_at).toLocaleDateString('en-US') %>
        </div>
      </div>
    </div>
    <% }) } %>
  </div>

  <div class="cd-panel">
    <h2>Addresses (<%= addresses.length %>)</h2>
    <% if (!addresses.length) { %>
    <p class="cd-empty">No saved addresses.</p>
    <% } else { addresses.forEach(function (a) { %>
    <p style="font-size:.8rem;margin:0 0 .6rem;line-height:1.5">
      <%= [a.address1, a.address2].filter(Boolean).join(', ') %><br>
      <%= [a.city, a.state, a.zip].filter(Boolean).join(' ') %>
    </p>
    <% }) } %>
  </div>
</div>

<%# ── the three handlers this page's controls need ──────────────────────
    Registered onto window.BVO_ACTIONS, which the shared dispatcher reads
    at EVENT time — so it does not matter that this script runs after the
    dispatcher's. See views/partials/admin/action-dispatch.ejs.

    Nonce'd, because scriptSrcAttr is 'none' and script-src requires the
    nonce on the block. %>
<script nonce="<%= cspNonce %>">
(function () {
  'use strict';

  var form = document.getElementById('oc-form');
  var pick = document.getElementById('oc-pick');

  Object.assign(window.BVO_ACTIONS, {

    /* data-a1 is 'template' or 'blank'. The only difference is whether the
       template dropdown is shown — a blank response is the same form with
       nothing in it, which is why there is one form and not two. */
    ocOpen: function (el, mode) {
      form.classList.add('is-open');
      pick.style.display = (mode === 'template') ? 'block' : 'none';
      if (mode === 'blank') {
        document.getElementById('oc-key').value = '';
        document.getElementById('oc-template').value = '';
      }
      (mode === 'template' ? document.getElementById('oc-template')
                           : document.getElementById('oc-subject')).focus();
    },

    ocClose: function () { form.classList.remove('is-open'); },

    /* Fetches over AJAX rather than reloading, so switching templates to
       compare them cannot throw away something half-written. */
    ocLoad: function (el) {
      var key = el.value;
      document.getElementById('oc-key').value = key;
      if (!key) return;

      var url = '/admin/marketing/outreach/template?key=' + encodeURIComponent(key) +
                '&customer_id=<%= customer.id %>';
      var ord = document.getElementById('oc-order');
      if (ord && ord.value) url += '&order_id=' + encodeURIComponent(ord.value);

      fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d || !d.ok) {
            window.alert((d && d.error) || 'Could not load that template.');
            return;
          }
          document.getElementById('oc-subject').value = d.subject || '';
          document.getElementById('oc-body').value    = d.body_html || '';
          if (d.inactive) {
            /* Said out loud: the automated trigger for this template is
               switched off, which is worth knowing before assuming the
               customer has already had it. */
            window.alert('Note: "' + d.label + '" is inactive, so it is not ' +
                         'sent automatically. Sending it by hand here is fine.');
          }
        })
        .catch(function () { window.alert('Could not reach the server.'); });
    },
  });
})();
</script>
