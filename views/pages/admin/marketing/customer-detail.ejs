<%
/**
 * Admin — one customer.
 *
 * Locals: customer, sourceLabel, orders, addresses, favorites, bundles, spent
 *
 * This screen is deliberately NOT filtered by is_test. The list is analytics;
 * this is the record. Being able to open a test account is how it gets
 * recognised as one — and how the flag gets set.
 */
%>

<style>
.cd-top{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.25rem}
.cd-top h1{font-size:1.25rem;font-weight:700;color:var(--navy);margin:0;word-break:break-all}
.cd-back{font-size:.8rem;color:var(--text-muted);text-decoration:none}
.cd-back:hover{text-decoration:underline}
.cd-testbar{background:#FFF8E6;border:1px solid #E8D9A8;border-radius:8px;padding:.7rem .9rem;margin-bottom:1.25rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.cd-testbar p{margin:0;font-size:.8rem;color:#6B5A24;line-height:1.5}
.cd-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1rem;margin-bottom:1.25rem}
.cd-panel{background:#fff;border:1px solid var(--line,#E6E1D8);border-radius:8px;padding:1rem}
.cd-panel h2{font-size:.9rem;font-weight:700;color:var(--navy);margin:0 0 .7rem}
.cd-dl{display:grid;grid-template-columns:auto 1fr;gap:.4rem .9rem;font-size:.82rem;margin:0}
.cd-dl dt{color:var(--text-muted);white-space:nowrap}
.cd-dl dd{margin:0;color:var(--navy)}
.cd-table{width:100%;border-collapse:collapse;font-size:.82rem}
.cd-table th{text-align:left;font-size:.68rem;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);padding:.45rem .5rem;border-bottom:1px solid var(--line,#E6E1D8)}
.cd-table td{padding:.5rem;border-bottom:1px solid #F2F0EB}
.cd-pill{display:inline-block;font-size:.66rem;padding:.12rem .45rem;border-radius:10px;background:#EFEDE8;color:#5A5243}
.cd-pill--test{background:#F6E3E3;color:#8A3A3A}
.cd-empty{font-size:.8rem;color:var(--text-muted);margin:0}
.cd-item{display:flex;gap:.6rem;align-items:center;padding:.4rem 0;border-bottom:1px solid #F2F0EB;font-size:.82rem}
.cd-item img{width:40px;height:40px;object-fit:cover;border-radius:4px;background:#F4F2EE;flex-shrink:0}
</style>

<a class="cd-back" href="/admin/marketing/customers">&larr; All customers</a>

<div class="cd-top">
  <div>
    <h1><%= customer.email %></h1>
    <% if (customer.first_name || customer.last_name) { %>
    <p style="margin:.2rem 0 0;color:var(--text-muted);font-size:.85rem"><%= [customer.first_name, customer.last_name].filter(Boolean).join(' ') %></p>
    <% } %>
  </div>
</div>

<%# The toggle exists because the next round of testing will create more
    rows, and a flag nobody can set is a flag that rots. Flipping it also
    flips this customer's orders — a test customer with real-looking orders
    is the same poisoned metric by another route. %>
<div class="cd-testbar">
  <p>
    <% if (String(customer.is_test) === '1') { %>
    <strong>Flagged as a test account.</strong> Excluded from every figure on the Customers dashboard, along with their orders.
    <% } else { %>
    Counted as a real customer in all analytics.
    <% } %>
  </p>
  <form method="POST" action="/admin/marketing/customers/<%= customer.id %>/test" style="margin:0">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="is_test" value="<%= String(customer.is_test) === '1' ? '0' : '1' %>">
    <button type="submit" class="btn btn-sm">
      <%= String(customer.is_test) === '1' ? 'Count as real' : 'Mark as test' %>
    </button>
  </form>
</div>

<div class="cd-grid">
  <div class="cd-panel">
    <h2>Account</h2>
    <dl class="cd-dl">
      <dt>Signed up</dt><dd><%= new Date(customer.created_at).toLocaleString('en-US') %></dd>
      <dt>Source</dt><dd><%= sourceLabel %></dd>
      <dt>Email verified</dt>
      <dd><%= customer.email_verified_at ? new Date(customer.email_verified_at).toLocaleDateString('en-US') : 'No' %></dd>
      <dt>Last sign-in</dt>
      <dd><%= customer.last_login_at ? new Date(customer.last_login_at).toLocaleString('en-US') : 'Never' %></dd>
      <dt>Phone</dt><dd><%= customer.phone || '—' %></dd>
      <dt>Total spent</dt><dd>$<%= Math.round(spent).toLocaleString('en-US') %></dd>
    </dl>
  </div>

  <%# Consent shown with its evidence, not as a tick. Source, timestamp and
      IP are what make it defensible if it is ever questioned. %>
  <div class="cd-panel">
    <h2>Marketing consent</h2>
    <dl class="cd-dl">
      <dt>Email</dt><dd><%= String(customer.accepts_marketing) === '1' ? 'Opted in' : 'Not opted in' %></dd>
      <dt>Recorded</dt>
      <dd><%= customer.marketing_consent_at ? new Date(customer.marketing_consent_at).toLocaleString('en-US') : '—' %></dd>
      <dt>Source</dt><dd><%= customer.marketing_consent_source || '—' %></dd>
      <dt>IP</dt><dd><%= customer.marketing_consent_ip || '—' %></dd>
      <dt>SMS</dt><dd><%= String(customer.delivery_sms_consent) === '1' ? 'Opted in' : 'Not opted in' %></dd>
    </dl>
  </div>
</div>

<div class="cd-panel" style="margin-bottom:1rem">
  <h2>Orders (<%= orders.length %>)</h2>
  <% if (!orders.length) { %>
  <p class="cd-empty">No orders.</p>
  <% } else { %>
  <table class="cd-table">
    <thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th></tr></thead>
    <tbody>
      <% orders.forEach(function (o) { %>
      <tr>
        <td><a href="/admin/orders/<%= o.id %>"><%= o.order_number || ('#' + o.id) %></a>
          <% if (String(o.is_test) === '1') { %> <span class="cd-pill cd-pill--test">test</span><% } %></td>
        <td><%= new Date(o.created_at).toLocaleDateString('en-US') %></td>
        <td><span class="cd-pill"><%= o.status %></span></td>
        <td>$<%= Number(o.total).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<div class="cd-grid">
  <div class="cd-panel">
    <h2>Saved items (<%= favorites.length %>)</h2>
    <% if (!favorites.length) { %>
    <p class="cd-empty">Nothing saved.</p>
    <% } else { favorites.forEach(function (f) { %>
    <div class="cd-item">
      <% if (f.primary_image_url) { %><img src="<%= f.primary_image_url %>" alt=""><% } %>
      <div>
        <a href="/products/<%= f.slug %>"><%= f.name %></a>
        <div style="color:var(--text-muted);font-size:.74rem">$<%= Number(f.price).toLocaleString('en-US') %></div>
      </div>
    </div>
    <% }) } %>
  </div>

  <div class="cd-panel">
    <h2>Saved bundles (<%= bundles.length %>)</h2>
    <% if (!bundles.length) { %>
    <p class="cd-empty">No saved bundles.</p>
    <% } else { bundles.forEach(function (b) { %>
    <div class="cd-item">
      <div>
        Bundle #<%= b.id %>
        <div style="color:var(--text-muted);font-size:.74rem">
          Saved <%= new Date(b.created_at).toLocaleDateString('en-US') %>
        </div>
      </div>
    </div>
    <% }) } %>
  </div>

  <div class="cd-panel">
    <h2>Addresses (<%= addresses.length %>)</h2>
    <% if (!addresses.length) { %>
    <p class="cd-empty">No saved addresses.</p>
    <% } else { addresses.forEach(function (a) { %>
    <p style="font-size:.8rem;margin:0 0 .6rem;line-height:1.5">
      <%= [a.address1, a.address2].filter(Boolean).join(', ') %><br>
      <%= [a.city, a.state, a.zip].filter(Boolean).join(' ') %>
    </p>
    <% }) } %>
  </div>
</div>
