<%- contentFor('title') %>JMV New Arrivals — Admin<% end %>
<%- contentFor('body') %>
<div class="adm-toolbar">
  <div class="adm-toolbar__left">
    <a href="/admin/marketing/jmv" class="adm-btn adm-btn--ghost">← Back to JMV Reports</a>
  </div>
  <div class="adm-toolbar__title">New Arrivals</div>
  <% if (earliest && latest) { %>
  <div class="adm-toolbar__right" style="font-size:12px;color:#666">
    SKUs present in <%= latest %> but not <%= earliest %>
  </div>
  <% } %>
</div>

<div class="admin-card" style="margin:24px">
  <div class="admin-card__header">
    <%= rows.length %> New SKU<%= rows.length !== 1 ? 's' : '' %> since <%= earliest || '—' %>
  </div>
  <div class="admin-card__body">
    <% if (!rows || !rows.length) { %>
      <p class="adm-empty">No new arrivals detected in this window. More history needed as daily snapshots accumulate.</p>
    <% } else { %>
    <table class="adm-table">
      <thead>
        <tr>
          <th>SKU</th>
          <th>Collection</th>
          <th>Type</th>
          <th>Size</th>
          <th>Finish</th>
          <th>Qty on Hand</th>
          <th>MAP</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(r) { %>
        <tr>
          <td><code><%= r.sku %></code></td>
          <td><%= r.collection || '—' %></td>
          <td><%= r.product_type || '—' %></td>
          <td><%= r.size_nominal ? r.size_nominal + '"' : '—' %></td>
          <td><%= r.base_finish || '—' %></td>
          <td><%= r.qty %></td>
          <td><%= r.map_price ? '$' + parseFloat(r.map_price).toLocaleString('en-US',{minimumFractionDigits:0}) : '—' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <p class="adm-note" style="margin-top:12px;font-size:11px;color:#888">
      Source: Depletion from James Martin warehouse — industry-wide demand, not RFL sales.
    </p>
    <% } %>
  </div>
</div>
<% end %>
