<%# NO layout() call — the layout is set by the controller via ...LAYOUT.
    Calling layout() here overwrites the injected function with a string and
    throws "layout is not a function" at runtime. CLAUDE.md, EJS LAYOUT RULE. %>

<div class="adm-toolbar">
  <span class="adm-toolbar-title">Trade Applications</span>
  <div style="display:flex;gap:8px;flex-shrink:0">
    <% ['pending','approved','declined'].forEach(function(s){ %>
    <a href="/admin/trade?status=<%= s %>"
       class="btn <%= status === s ? 'btn-primary' : 'btn-outline' %> btn-sm"><%= s %></a>
    <% }); %>
  </div>
</div>

<% if (typeof flash !== 'undefined' && flash && flash.msg) { %>
<div class="admin-card" style="margin-bottom:16px"><%= flash.msg %></div>
<% } %>

<%# ⚠️ UPLOADS ARE NOT SURVIVING DEPLOYS. Shown until TRADE_DOCS_PATH is
    set. Hostinger deploys into a UUID-named folder and the default docs
    directory lives inside it, so each push orphans every document
    uploaded since the last one. Found 2026-10-22 when the first real
    application's business card returned "Refused" — the row was fine, the
    file was in a release folder that no longer existed. %>
<% if (typeof docsEphemeral !== 'undefined' && docsEphemeral) { %>
<div class="admin-card" style="margin-bottom:16px;border-left:4px solid #C2410C;background:#FFF7ED">
  <strong style="color:#9A3412">Uploaded documents will be lost on the next deploy.</strong>
  <p style="margin:6px 0 0;font-size:.9rem;line-height:1.5">
    <code>TRADE_DOCS_PATH</code> is not set, so business cards and resale
    certificates are being written inside the deployment folder, which is
    replaced on every push. Set it in the Hostinger environment panel to a
    directory outside that folder — for example
    <code>/home/u222311468/domains/bathroomvanitiesoutlet.com/trade-docs</code>
    — and restart the app. It must not be under <code>public_html</code>:
    these documents are deliberately not reachable over the web.
  </p>
</div>
<% } %>

<div class="adm-table-wrap">
  <table class="adm-table">
    <thead>
      <tr>
        <th>Received</th><th>Business</th><th>Contact</th>
        <th>Documents</th><th>Tax</th><th>Marketing</th><th>Decision</th>
      </tr>
    </thead>
    <tbody>
      <% if (!applications || applications.length === 0) { %>
      <tr><td colspan="7" class="adm-empty" style="border-radius:0">No <%= status %> applications.</td></tr>
      <% } %>
      <% (applications || []).forEach(function(a){ %>
      <tr>
        <td class="adm-meta"><%= new Date(a.created_at).toLocaleDateString('en-US') %></td>
        <td>
          <span style="font-weight:700;color:var(--color-navy)"><%= a.business_name %></span>
          <% if (a.business_type) { %><br><span class="adm-meta"><%= a.business_type %></span><% } %>
          <% if (a.intended_use) { %>
          <br><span class="adm-meta" style="font-style:italic"><%= a.intended_use %></span>
          <% } %>
        </td>
        <td>
          <a href="mailto:<%= a.email %>" style="color:var(--color-amber)"><%= a.email %></a>
          <% if (a.phone) { %><br><span class="adm-meta"><%= a.phone %></span><% } %>
          <% if (!a.customer_id) { %>
          <%# No account yet. They applied before signing in, so approval
              cannot set a tier — there is no row to set it on. %>
          <br><span class="adm-meta" style="color:#c53030">no account linked</span>
          <% } %>
        </td>
        <td>
          <%# ⚠️ THESE LINKS STREAM FROM OUTSIDE public/. The files are not
              reachable by URL — adminDoc reads them off disk behind
              requireAdmin and sends them as attachments. Never turn these
              into static paths. %>
          <% if (a.card_doc_path) { %>
          <a href="/admin/trade/<%= a.id %>/doc/card" style="color:var(--color-amber)">Business card</a>
          <% } else { %><span class="adm-meta">none</span><% } %>
          <% if (a.resale_doc_path) { %>
          <br><a href="/admin/trade/<%= a.id %>/doc/resale" style="color:var(--color-amber)">Resale cert</a>
          <% } %>
        </td>
        <td>
          <% if (a.wants_tax_exempt) { %>
          <strong>Exempt</strong><% if (a.tax_id) { %><br><span class="adm-meta"><%= a.tax_id %></span><% } %>
          <% } else { %><span class="adm-meta">Taxable</span><% } %>
        </td>
        <td><span class="adm-meta"><%= a.accepts_marketing ? 'Opted in' : '—' %></span></td>
        <td>
          <% if (a.status === 'pending') { %>
          <form method="post" action="/admin/trade/<%= a.id %>/decide" style="display:flex;gap:6px;flex-wrap:wrap">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="review_note" class="adm-input" placeholder="Note (optional)" style="width:150px">
            <button type="submit" name="decision" value="approve" class="btn btn-sage btn-sm">Approve</button>
            <button type="submit" name="decision" value="decline" class="btn btn-outline btn-sm"
                    style="color:#c53030;border-color:#c53030">Decline</button>
          </form>
          <% } else { %>
          <span class="adm-meta">
            <%= a.status %><% if (a.reviewed_by) { %> &middot; <%= a.reviewed_by %><% } %>
            <% if (a.review_note) { %><br><em><%= a.review_note %></em><% } %>
          </span>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<p class="adm-count"><%= (applications || []).length %> <%= status %></p>

<div class="admin-card" style="margin-top:20px">
  <h3 class="admin-card-title">What approving does</h3>
  <p style="font-size:.86rem;line-height:1.6;color:#5E584E;margin:0">
    Approving sets the customer to <strong>Platinum Trade</strong> — 15% off, applied in
    the cart when they are signed in. It never sets Elite Trade: that is 20% at
    $20,000 of captured spend in a rolling 12 months, computed at price time and
    able to fall back if their spend ages out. You cannot grant it by hand, and
    nothing here will.
  </p>
  <p style="font-size:.86rem;line-height:1.6;color:#5E584E;margin:10px 0 0">
    Trade pricing never renders to a logged-out visitor. That is a James Martin
    MAP requirement, not a preference — advertising below MAP risks a written
    warning and withheld shipments.
  </p>
</div>
