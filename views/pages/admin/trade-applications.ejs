<%# NO layout() call — the layout is set by the controller via ...LAYOUT.
    Calling layout() here overwrites the injected function with a string and
    throws "layout is not a function" at runtime. CLAUDE.md, EJS LAYOUT RULE. %>

<div class="adm-toolbar">
  <span class="adm-toolbar-title">Trade Applications</span>
  <div style="display:flex;gap:8px;flex-shrink:0">
    <%# ⚠️ FROM THE CONTROLLER'S LIST, NOT A LITERAL. Hardcoding three
        statuses here while the model has five makes 'fraud' and 'closed'
        rows unviewable — the controller falls back to 'pending' for any
        status it does not recognise, so a missing tab is a missing filter
        is a missing row. Exactly how the whole queue stayed invisible
        until it got a nav link. %>
    <% (typeof queueStatuses !== 'undefined' ? queueStatuses
         : ['pending','approved','declined']).forEach(function(s){ %>
    <a href="/admin/trade?status=<%= s %>"
       class="btn <%= status === s ? 'btn-primary' : 'btn-outline' %> btn-sm"><%= s %></a>
    <% }); %>
  </div>
</div>

<% if (typeof flash !== 'undefined' && flash && flash.msg) { %>
<div class="admin-card" style="margin-bottom:16px"><%= flash.msg %></div>
<% } %>

<%# ⚠️ UPLOADS ARE NOT SURVIVING DEPLOYS. Shown until TRADE_DOCS_PATH is
    set. Hostinger deploys into a UUID-named folder and the default docs
    directory lives inside it, so each push orphans every document
    uploaded since the last one. Found 2026-10-22 when the first real
    application's business card returned "Refused" — the row was fine, the
    file was in a release folder that no longer existed. %>
<% if (typeof docsEphemeral !== 'undefined' && docsEphemeral) { %>
<div class="admin-card" style="margin-bottom:16px;border-left:4px solid #C2410C;background:#FFF7ED">
  <strong style="color:#9A3412">Uploaded documents will be lost on the next deploy.</strong>
  <p style="margin:6px 0 0;font-size:.9rem;line-height:1.5">
    <code>TRADE_DOCS_PATH</code> is not set, so business cards and resale
    certificates are being written inside the deployment folder, which is
    replaced on every push. Set it in the Hostinger environment panel to a
    directory outside that folder — for example
    <code>/home/u222311468/domains/bathroomvanitiesoutlet.com/trade-docs</code>
    — and restart the app. It must not be under <code>public_html</code>:
    these documents are deliberately not reachable over the web.
  </p>
</div>
<% } %>

<div class="adm-table-wrap">
  <table class="adm-table">
    <thead>
      <tr>
        <th>Received</th><th>Business</th><th>Contact</th>
        <th>Documents</th><th>Tax</th><th>Marketing</th><th>Decision</th>
      </tr>
    </thead>
    <tbody>
      <% if (!applications || applications.length === 0) { %>
      <tr><td colspan="7" class="adm-empty" style="border-radius:0">No <%= status %> applications.</td></tr>
      <% } %>
      <% (applications || []).forEach(function(a){ %>
      <tr>
        <td class="adm-meta"><%= new Date(a.created_at).toLocaleDateString('en-US') %></td>
        <td>
          <span style="font-weight:700;color:var(--color-navy)"><%= a.business_name %></span>
          <% if (a.business_type) { %><br><span class="adm-meta"><%= a.business_type %></span><% } %>
          <% if (a.intended_use) { %>
          <br><span class="adm-meta" style="font-style:italic"><%= a.intended_use %></span>
          <% } %>
        </td>
        <td>
          <a href="mailto:<%= a.email %>" style="color:var(--color-amber)"><%= a.email %></a>
          <% if (a.phone) { %><br><span class="adm-meta"><%= a.phone %></span><% } %>
          <% if (!a.customer_id) { %>
          <%# No account yet. They applied before signing in, so approval
              cannot set a tier — there is no row to set it on. %>
          <br><span class="adm-meta" style="color:#c53030">no account linked</span>
          <% } %>
        </td>
        <td>
          <%# ⚠️ THESE LINKS STREAM FROM OUTSIDE public/. The files are not
              reachable by URL — adminDoc reads them off disk behind
              requireAdmin and sends them as attachments. Never turn these
              into static paths. %>
          <%# ⚠️ STILL NOT A STATIC PATH. adminDoc streams these from
              outside public/ behind requireAdmin. What changed on
              2026-10-23 is the disposition: images and PDFs now open
              INLINE (correct content-type from the extension, nosniff,
              and a CSP sandbox on the response) instead of forcing a
              download. Reviewing a business card should not mean saving
              a stranger's document onto your laptop first.

              HEIC has no inline type, so adminDoc falls back to download
              for it — no browser renders HEIC, and a blank tab would be
              worse than a file. %>
          <% var _docs = [
               { key: 'card',   label: 'Business card',     p: a.card_doc_path,   n: a.card_doc_name },
               { key: 'resale', label: 'Resale certificate', p: a.resale_doc_path, n: a.resale_doc_name }
             ]; %>
          <% var _any = false; _docs.forEach(function (d) { if (!d.p) return; _any = true;
               var _ext = String(d.n || d.p).toLowerCase().split('.').pop();
               var _img = ['jpg','jpeg','png','webp'].indexOf(_ext) !== -1; %>
            <div style="margin-bottom:10px">
              <% if (_img) { %>
              <%# A thumbnail answers "is this a real business card?" without
                  any click at all. Same guarded route; the browser just
                  renders it in an <img>, where a CSP-sandboxed response
                  with an image content-type can do nothing else. %>
              <a href="/admin/trade/<%= a.id %>/doc/<%= d.key %>" target="_blank" rel="noopener">
                <img src="/admin/trade/<%= a.id %>/doc/<%= d.key %>" alt="<%= d.label %>"
                     loading="lazy"
                     style="display:block;max-width:150px;max-height:96px;width:auto;height:auto;
                            border:1px solid #E8E4DC;border-radius:4px;background:#FAF7F2;margin-bottom:3px">
              </a>
              <% } %>
              <a href="/admin/trade/<%= a.id %>/doc/<%= d.key %>" target="_blank" rel="noopener"
                 style="color:var(--color-amber)"><%= d.label %><%= _ext === 'pdf' ? ' (PDF)' : '' %></a>
              <a href="/admin/trade/<%= a.id %>/doc/<%= d.key %>?download=1"
                 class="adm-meta" style="margin-left:8px" download>download</a>
            </div>
          <% }); %>
          <% if (!_any) { %><span class="adm-meta">none</span><% } %>

          <%# ⚠️ REPLACE, NOT ADD. One current card and one current
              certificate — adminReplaceDoc deletes the file it supersedes,
              so copies of personal documents do not accumulate.

              Hidden on a closed account: those documents were purged at
              the customer's request, and re-uploading them would quietly
              undo the thing they asked for. %>
          <% if (a.status !== 'closed') { %>
          <details style="margin-top:8px">
            <summary class="adm-meta" style="cursor:pointer">Replace a document</summary>
            <% ['card','resale'].forEach(function(w){ %>
            <form method="post" enctype="multipart/form-data"
                  action="/admin/trade/<%= a.id %>/doc/<%= w %>/replace"
                  style="margin-top:6px;display:flex;gap:4px;align-items:center;flex-wrap:wrap">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="back_status" value="<%= status %>">
              <input type="file" name="<%= w %>" required
                     accept=".jpg,.jpeg,.png,.webp,.heic,.pdf"
                     style="font-size:.75rem;max-width:140px">
              <button type="submit" class="btn btn-outline btn-sm"
                      style="font-size:.72rem"><%= w === 'card' ? 'Card' : 'Cert' %></button>
            </form>
            <% }); %>
          </details>
          <% } %>
        </td>
        <td>
          <% if (a.wants_tax_exempt) { %>
          <strong>Exempt</strong><% if (a.tax_id) { %><br><span class="adm-meta"><%= a.tax_id %></span><% } %>
          <% } else { %><span class="adm-meta">Taxable</span><% } %>
        </td>
        <td><span class="adm-meta"><%= a.accepts_marketing ? 'Opted in' : '—' %></span></td>
        <td>
          <% if (a.status === 'pending') { %>
          <form method="post" action="/admin/trade/<%= a.id %>/decide" style="display:flex;gap:6px;flex-wrap:wrap">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="review_note" class="adm-input" placeholder="Note (optional)" style="width:150px">
            <button type="submit" name="decision" value="approve" class="btn btn-sage btn-sm">Approve</button>
            <button type="submit" name="decision" value="decline" class="btn btn-outline btn-sm"
                    style="color:#c53030;border-color:#c53030">Decline</button>
          </form>
          <% } %>

          <%# ⚠️ FRAUD AND CLOSE ARE SEPARATE VERBS, DELIBERATELY.
              Fraud KEEPS the documents — they are the evidence, and
              destroying them on our own say-so leaves nothing to show if
              the applicant disputes a charge or reappears under another
              name. Close PURGES them, because a customer asking to close
              their account is asking us to stop holding their business
              card and resale certificate.

              One "Delete" button would have to pick one of those
              behaviours and be wrong half the time, in whichever
              direction hurts more that day.

              Already-closed rows get neither: the documents are gone and
              the account is revoked, so there is nothing left to do. %>
          <% if (a.status !== 'closed' && a.status !== 'fraud') { %>
          <details style="margin-top:8px">
            <summary class="adm-meta" style="cursor:pointer;color:#c53030">Fraud / close account</summary>
            <form method="post" action="/admin/trade/<%= a.id %>/revoke" style="margin-top:6px">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="text" name="review_note" class="adm-input"
                     placeholder="Reason (recorded)" style="width:100%;margin-bottom:6px">
              <div style="display:flex;gap:6px;flex-wrap:wrap">
                <%# ⚠️ data-act + data-confirm, THE HOUSE PATTERN — NOT onclick.
                    server.js sets scriptSrcAttr: ['none'], so an inline
                    handler is refused outright: a `return confirm(...)`
                    guard on a DESTRUCTIVE button would silently do nothing
                    and the first click would be the action. I shipped
                    exactly that in c1bb354 and caught it on review.

                    views/partials/admin/action-dispatch.ejs is the shared
                    dispatcher, included by the admin layout. It resolves
                    closest('[data-act]'), so putting data-act on each
                    BUTTON lets the two actions carry different warnings —
                    which matters here, because one keeps the documents and
                    the other deletes them. 'noop' is registered there and
                    does nothing: the confirm is the whole point, and the
                    form submits normally once accepted. %>
                <button type="submit" name="action" value="fraud" class="btn btn-outline btn-sm"
                        style="color:#9A3412;border-color:#9A3412;font-size:.72rem"
                        data-act="noop"
                        data-confirm="Flag as fraudulent?&#10;&#10;Trade pricing is revoked and they cannot reapply.&#10;Documents are KEPT as evidence.">
                  Fraudulent
                </button>
                <button type="submit" name="action" value="closed" class="btn btn-outline btn-sm"
                        style="color:#c53030;border-color:#c53030;font-size:.72rem"
                        data-act="noop"
                        data-confirm="Close at the customer's request?&#10;&#10;Uploaded documents are PERMANENTLY DELETED.&#10;The application record and order history are kept.&#10;This cannot be undone.">
                  Customer closed
                </button>
              </div>
            </form>
          </details>
          <% } %>

          <% if (a.status !== 'pending') { %>
          <span class="adm-meta">
            <%= a.status %><% if (a.reviewed_by) { %> &middot; <%= a.reviewed_by %><% } %>
            <% if (a.review_note) { %><br><em><%= a.review_note %></em><% } %>
          </span>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<p class="adm-count"><%= (applications || []).length %> <%= status %></p>

<div class="admin-card" style="margin-top:20px">
  <h3 class="admin-card-title">What approving does</h3>
  <p style="font-size:.86rem;line-height:1.6;color:#5E584E;margin:0">
    Approving sets the customer to <strong>Platinum Trade</strong> — 15% off, applied in
    the cart when they are signed in. It never sets Elite Trade: that is 20% at
    $20,000 of captured spend in a rolling 12 months, computed at price time and
    able to fall back if their spend ages out. You cannot grant it by hand, and
    nothing here will.
  </p>
  <p style="font-size:.86rem;line-height:1.6;color:#5E584E;margin:10px 0 0">
    Trade pricing never renders to a logged-out visitor. That is a James Martin
    MAP requirement, not a preference — advertising below MAP risks a written
    warning and withheld shipments.
  </p>
</div>
