.adm-form-grid { display:grid;grid-template-columns:1fr 1fr;gap:10px }
.adm-field     { display:flex;flex-direction:column;gap:3px }
.adm-field label { font-size:.78rem;font-weight:600;color:#4a5568 }
.adm-field--full { grid-column:1/-1 }

.ship-check { display:flex;align-items:center;gap:6px;font-size:.85rem;cursor:pointer }

.ship-item-row    { display:flex;align-items:flex-start;gap:8px;padding:10px;background:#f7fafc;border:1px solid #e2e8f0;border-radius:6px;margin-bottom:8px }
.ship-item-fields { display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:8px;flex:1 }
.ship-item-remove { background:none;border:none;color:#c53030;font-size:1rem;cursor:pointer;padding:0 4px;line-height:1;margin-top:20px }

.ship-rate-card   { padding:14px 16px;border:2px solid #e2e8f0;border-radius:8px;margin-bottom:10px;cursor:pointer;transition:border-color .15s,box-shadow .15s;display:flex;align-items:center;justify-content:space-between;gap:12px }
.ship-rate-card:hover   { border-color:#2b6cb0;box-shadow:0 0 0 3px rgba(43,108,176,.08) }
.ship-rate-card.selected{ border-color:#1a2e4a;background:#EBF8FF }
.ship-rate-carrier { font-size:.9rem }
