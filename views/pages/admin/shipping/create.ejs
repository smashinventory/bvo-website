<%
/* ═══════════════════════════════════════════════════════════════════
   Admin — Create Shipment  (/admin/shipping/create)
   3-step flow: 1) Addresses & items  2) Rate shop  3) Book & confirm
   Supports LTL and SMALLPACK. Pre-fills from order if orderId passed.
═══════════════════════════════════════════════════════════════════ */
const pre  = prefill             || {};
const hus  = prefillHandlingUnits || [];
const meta = orderMeta           || null;
%>

<!-- ══ Toolbar ══════════════════════════════════════════════════════ -->
<div class="adm-toolbar">
  <div class="adm-back-wrap">
    <a href="/admin/shipping" class="adm-back-link">← Shipments</a>
    <span class="adm-toolbar-title">New Shipment<%= orderId ? ' — Order #'+orderId : '' %></span>
  </div>
</div>

<% if (meta) { %>
<!-- ══ Order Info Banner ═════════════════════════════════════════════ -->
<div class="ship-order-banner">
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <span style="font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#2b6cb0">Linked Order</span>
    <a href="/admin/orders/<%= meta.id %>" style="font-weight:700;color:#1a2e4a"><%= pre.orderNum %></a>
    <span style="color:#718096;font-size:.85rem"><%= meta.customer_name || '' %></span>
    <% if (meta.email) { %><span style="color:#718096;font-size:.8rem">· <%= meta.email %></span><% } %>
    <% if (meta.phone) { %><span style="color:#718096;font-size:.8rem">· <%= meta.phone %></span><% } %>
    <span style="margin-left:auto;font-size:.8rem;color:#718096">$<%= parseFloat(meta.total||0).toFixed(2) %> · <span style="text-transform:capitalize"><%= meta.status %></span></span>
  </div>
  <% if (hus.length) { %>
  <div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap">
    <% /* Show one chip per unique product (dedupe by productName+sku) */ %>
    <% const seen = {}; hus.forEach(function(hu){ const k = (hu.productName||'')+'|'+(hu.sku||''); if (!seen[k]) { seen[k]=true; %>
    <span style="background:#EBF8FF;color:#2b6cb0;border-radius:4px;padding:2px 8px;font-size:.75rem">
      <%= hu.count > 1 ? hu.count+'× ' : '' %><%= hu.productName || '' %>
      <% if (hu.sku) { %><span style="opacity:.65">(<%= hu.sku %>)</span><% } %>
    </span>
    <% } }); %>
  </div>
  <% } %>
</div>
<% } %>

<!-- ══ Step indicator ════════════════════════════════════════════════ -->
<div class="ship-steps">
  <div class="ship-step active" id="step-ind-1"><span class="ship-step-num">1</span> Addresses &amp; Cargo</div>
  <div class="ship-step" id="step-ind-2"><span class="ship-step-num">2</span> Rate Shop</div>
  <div class="ship-step" id="step-ind-3"><span class="ship-step-num">3</span> Confirm &amp; Book</div>
</div>

<!-- ═══ STEP 1: Addresses & Cargo ═══════════════════════════════════ -->
<div id="step1" class="ship-panel">
  <div class="ship-panel-grid">

    <!-- Product type -->
    <div class="admin-card ship-full-col">
      <h3 class="admin-card-title">Shipment Type</h3>
      <div style="display:flex;gap:12px">
        <label class="ship-type-opt">
          <input type="radio" name="productType" value="LTL" checked>
          <span class="ship-type-label">
            <strong>LTL Freight</strong>
            <small>Vanities, tops, cabinets — pallet shipments</small>
          </span>
        </label>
        <label class="ship-type-opt">
          <input type="radio" name="productType" value="SMALLPACK">
          <span class="ship-type-label">
            <strong>Small Package (UPS)</strong>
            <small>Accessories, samples, hardware</small>
          </span>
        </label>
      </div>
    </div>

    <!-- Origin -->
    <div class="admin-card">
      <h3 class="admin-card-title">Origin (Ship From)</h3>
      <div class="adm-form-grid">
        <div class="adm-field"><label>Company</label><input id="orig_company" type="text" class="adm-input" value="Bathroom Vanities Outlet"></div>
        <div class="adm-field"><label>Phone</label><input id="orig_phone" type="text" class="adm-input" value="7706352030"></div>
        <div class="adm-field adm-field--full"><label>Address</label><input id="orig_address1" type="text" class="adm-input" value="50 Ernest W Barrett Pkwy NW"></div>
        <div class="adm-field"><label>City</label><input id="orig_city" type="text" class="adm-input" value="Marietta"></div>
        <div class="adm-field"><label>State</label><input id="orig_state" type="text" class="adm-input" value="GA" maxlength="2" style="text-transform:uppercase"></div>
        <div class="adm-field"><label>ZIP</label><input id="orig_zip" type="text" class="adm-input" value="30066"></div>
        <input type="hidden" id="orig_country" value="US">
      </div>
    </div>

    <!-- Destination -->
    <div class="admin-card">
      <h3 class="admin-card-title">Destination (Ship To)</h3>
      <div class="adm-form-grid">
        <div class="adm-field"><label>Company / Business</label><input id="dest_company" type="text" class="adm-input" value="<%= pre.company || '' %>"></div>
        <div class="adm-field"><label>Contact Name</label><input id="dest_name" type="text" class="adm-input" value="<%= pre.name || '' %>"></div>
        <div class="adm-field"><label>Phone</label><input id="dest_phone" type="text" class="adm-input" value="<%= pre.phone || '' %>"></div>
        <div class="adm-field"><label>Email</label><input id="dest_email" type="text" class="adm-input" value="<%= pre.email || '' %>"></div>
        <div class="adm-field adm-field--full"><label>Address</label><input id="dest_address1" type="text" class="adm-input" value="<%= pre.address1 || '' %>"></div>
        <div class="adm-field"><label>City</label><input id="dest_city" type="text" class="adm-input" value="<%= pre.city || '' %>"></div>
        <div class="adm-field"><label>State</label><input id="dest_state" type="text" class="adm-input" value="<%= pre.state || '' %>" maxlength="2" style="text-transform:uppercase"></div>
        <div class="adm-field"><label>ZIP</label><input id="dest_zip" type="text" class="adm-input" value="<%= pre.zip || '' %>"></div>
        <div class="adm-field"><label>Country</label><input id="dest_country" type="text" class="adm-input" value="US" maxlength="2" style="text-transform:uppercase"></div>
        <div class="adm-field">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
            <input type="checkbox" id="dest_residential"> Residential address
          </label>
        </div>
      </div>
    </div>

    <!-- Handling Units -->
    <div class="admin-card ship-full-col">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <h3 class="admin-card-title" style="margin:0">Handling Units &amp; Commodities</h3>
        <button class="btn btn-sm btn-outline" onclick="addHandlingUnit()">+ Add Handling Unit</button>
      </div>
      <div id="huList"></div>
    </div>

    <!-- LTL Additional Services -->
    <div class="admin-card ship-full-col" id="ltlOptions">
      <h3 class="admin-card-title">LTL Additional Services</h3>

      <div class="ship-acc-grid">

        <!-- Insurance -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Insurance</div>
          <label class="ship-check"><input type="radio" name="ltl_insure" value="no" checked> No — accept carrier limited liability</label>
          <label class="ship-check" style="margin-top:4px"><input type="radio" name="ltl_insure" value="yes" onchange="toggleInsureVal(this.value)"> Yes — insure my shipment</label>
          <div id="ltl_insure_val" style="display:none;margin-top:6px">
            <div class="adm-field"><label>Declared Value ($)</label><input id="acc_declaredValue" type="number" class="adm-input" min="0" placeholder="0.00"></div>
          </div>
        </div>

        <!-- Handling Charge -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Handling Charge</div>
          <label class="ship-check"><input type="radio" name="ltl_handling" value="no" checked> No, thanks</label>
          <label class="ship-check" style="margin-top:4px"><input type="radio" name="ltl_handling" value="yes"> Yes, add a handling charge</label>
        </div>

        <!-- Pickup Services -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Pickup Services</div>
          <label class="ship-check"><input type="checkbox" id="acc_insidePickup"> Inside Pickup</label>
          <label class="ship-check"><input type="checkbox" id="acc_liftgatePickup"> Liftgate Pickup</label>
          <label class="ship-check"><input type="checkbox" id="acc_residentialPickup"> Residential Pickup</label>
          <label class="ship-check"><input type="checkbox" id="acc_tradeshowPickup"> Tradeshow Pickup</label>
          <label class="ship-check"><input type="checkbox" id="acc_constructionPickup"> Construction Site Pickup</label>
          <label class="ship-check"><input type="checkbox" id="acc_dropAtTerminal"> Drop Shipment at Terminal</label>
          <label class="ship-check"><input type="checkbox" id="acc_groceryPickup"> Grocery Consolidation Pickup</label>
        </div>

        <!-- Delivery Services -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Delivery Services</div>
          <label class="ship-check"><input type="checkbox" id="acc_insideDelivery"> Inside Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_liftgateDelivery" checked> Liftgate Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_residentialDelivery"> Residential Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_tradeshowDelivery"> Tradeshow Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_groceryDelivery"> Grocery Consolidation Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_constructionDelivery"> Construction Site Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_notifyBeforeDelivery"> Notify Me Before Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_holdAtTerminal"> Hold Shipment at Terminal</label>
          <label class="ship-check"><input type="checkbox" id="acc_appointment"> Appointment Delivery</label>
        </div>

        <!-- Shipment Services -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Shipment Services</div>
          <label class="ship-check"><input type="checkbox" id="acc_sortAndSegregate"> Sort and Segregate</label>
          <label class="ship-check"><input type="checkbox" id="acc_protectFromFreeze"> Protect from Freeze</label>
        </div>

        <!-- Billing Details -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Billing Details</div>
          <div class="adm-field">
            <select id="ltl_billing" class="adm-input">
              <option value="BILL_SHIPPER">Bill My Account</option>
              <option value="BILL_RECIPIENT">Bill Recipient</option>
              <option value="BILL_THIRD_PARTY">Bill Third Party</option>
            </select>
          </div>
        </div>

      </div><!-- /ship-acc-grid -->
    </div>

    <!-- SMALLPACK Additional Services (hidden by default) -->
    <div class="admin-card ship-full-col" id="spOptions" style="display:none">
      <h3 class="admin-card-title">Additional Services</h3>
      <div class="ship-acc-grid">

        <!-- Insurance -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Insure Shipment</div>
          <label class="ship-check"><input type="radio" name="sp_insure" value="no" checked> No — accept carrier limited liability</label>
          <label class="ship-check" style="margin-top:4px"><input type="radio" name="sp_insure" value="yes" onchange="toggleSpInsureVal(this.value)"> Yes, insure my shipment</label>
          <div id="sp_insure_val" style="display:none;margin-top:6px">
            <div class="adm-field"><label>Declared Value ($)</label><input id="sp_declaredValue" type="number" class="adm-input" min="0" placeholder="0.00"></div>
          </div>
        </div>

        <!-- UPS Services -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">UPS Services</div>
          <label class="ship-check"><input type="checkbox" id="sp_handlingCharge"> Handling Charge</label>
          <label class="ship-check"><input type="checkbox" id="sp_carbonNeutral"> UPS Carbon Neutral</label>
          <label class="ship-check"><input type="checkbox" id="sp_returnLabel"> Return Label</label>
          <label class="ship-check"><input type="checkbox" id="sp_shipmentAlerts"> Shipment Alerts</label>
          <label class="ship-check"><input type="checkbox" id="sp_upsNotifications"> UPS Notifications</label>
          <label class="ship-check"><input type="checkbox" id="sp_senderReceipt"> Include Sender's Receipt</label>
          <label class="ship-check"><input type="checkbox" id="sp_emailLabel"> Email Label</label>
        </div>

        <!-- Signature -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Signature Options</div>
          <div class="adm-field">
            <select id="sp_signature" class="adm-input">
              <option value="">No Signature Option</option>
              <option value="SIGNATURE_REQUIRED">Signature Required</option>
              <option value="ADULT_SIGNATURE_REQUIRED">Adult Signature Required</option>
            </select>
          </div>
        </div>

        <!-- Billing -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Billing Details</div>
          <div class="adm-field">
            <select id="sp_billing" class="adm-input">
              <option value="BILL_SHIPPER">Bill My Account</option>
              <option value="BILL_RECIPIENT">Bill Recipient</option>
              <option value="BILL_THIRD_PARTY">Bill Third Party</option>
            </select>
          </div>
        </div>

      </div>
    </div>

    <!-- References -->
    <div class="admin-card">
      <h3 class="admin-card-title">References</h3>
      <div class="adm-form-grid">
        <div class="adm-field"><label>Reference 1</label><input id="ref1" type="text" class="adm-input" value="<%= pre.reference1 || '' %>" placeholder="Order # or PO #"></div>
        <div class="adm-field"><label>Reference 2</label><input id="ref2" type="text" class="adm-input" placeholder="Optional"></div>
      </div>
    </div>

  </div><!-- /ship-panel-grid -->

  <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
    <button class="btn btn-primary" onclick="goToRates()">Get Rates →</button>
  </div>
</div><!-- /step1 -->

<!-- ═══ STEP 2: Rate Shop ══════════════════════════════════════════ -->
<div id="step2" class="ship-panel" style="display:none">
  <div class="admin-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <h3 class="admin-card-title" style="margin:0">Available Rates</h3>
      <button class="btn btn-sm btn-outline" onclick="showStep(1)">← Edit Details</button>
    </div>

    <div id="rateLoading" style="text-align:center;padding:32px;color:#718096">
      <div class="ship-spinner"></div>
      <p style="margin-top:8px">Fetching carrier rates…</p>
    </div>
    <div id="rateError" style="display:none" class="adm-alert adm-alert--error"></div>
    <div id="rateList" style="display:none"></div>
  </div>
</div>

<!-- ═══ STEP 3: Confirm & Book ════════════════════════════════════ -->
<div id="step3" class="ship-panel" style="display:none">
  <div class="ship-panel-grid">

    <div class="admin-card">
      <h3 class="admin-card-title">Selected Rate</h3>
      <div id="selectedRateDisplay"></div>
    </div>

    <div class="admin-card">
      <h3 class="admin-card-title">Shipment Summary</h3>
      <div id="shipSummary"></div>
    </div>

    <!-- UPS Pickup (SMALLPACK only) -->
    <div class="admin-card" id="pickupSection" style="display:none">
      <h3 class="admin-card-title">Schedule UPS Pickup</h3>
      <div class="adm-form-grid">
        <div class="adm-field">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
            <input type="checkbox" id="schedulePickup" onchange="togglePickup(this.checked)"> Schedule a UPS pickup
          </label>
          <small style="color:#718096">Uncheck if dropping off at a UPS store or on daily route.</small>
        </div>
        <div id="pickupFields" style="display:none;grid-column:1/-1">
          <div class="adm-form-grid">
            <div class="adm-field"><label>Pickup Date</label><input id="pickupDate" type="date" class="adm-input"></div>
            <div class="adm-field"><label>Ready Time</label><input id="pickupReady" type="time" class="adm-input" value="08:00"></div>
            <div class="adm-field"><label>Close Time</label><input id="pickupClose" type="time" class="adm-input" value="17:00"></div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <div style="display:flex;justify-content:space-between;margin-top:16px;gap:8px">
    <button class="btn btn-outline" onclick="showStep(2)">← Back to Rates</button>
    <button class="btn btn-primary" id="bookBtn" onclick="bookShipment()">Book Shipment</button>
  </div>
</div>

<!-- ═══ SUCCESS ══════════════════════════════════════════════════ -->
<div id="stepSuccess" class="ship-panel" style="display:none">
  <div class="admin-card" style="text-align:center;padding:40px">
    <div style="font-size:3rem;margin-bottom:12px">✅</div>
    <h2 style="margin:0 0 8px">Shipment Booked</h2>
    <div id="successDetails" style="color:#4a5568;margin-bottom:24px"></div>
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap">
      <a id="bolLink" href="#" target="_blank" class="btn btn-primary" style="display:none">Download BOL</a>
      <a href="/admin/shipping" class="btn btn-outline">Back to Shipments</a>
      <a href="/admin/shipping/create" class="btn btn-outline">New Shipment</a>
    </div>
  </div>
</div>

<!-- ═══ Commodity Picker Modal ══════════════════════════════════ -->
<div id="commodityModal" style="display:none;position:fixed;inset:0;z-index:1200;background:rgba(0,0,0,.45);align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:10px;width:min(680px,95vw);max-height:80vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.3)">
    <div style="padding:16px 20px;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between">
      <strong style="font-size:1rem">My Commodities</strong>
      <button onclick="closeCommodityPicker()" style="background:none;border:none;font-size:1.3rem;cursor:pointer;color:#718096;line-height:1">×</button>
    </div>
    <div style="padding:12px 20px;border-bottom:1px solid #e2e8f0">
      <input id="commoditySearch" type="text" class="adm-input" placeholder="Search by name or NMFC…" oninput="filterCommodities()" style="width:100%;box-sizing:border-box">
    </div>
    <div style="overflow-y:auto;flex:1">
      <table style="width:100%;border-collapse:collapse;font-size:.88rem">
        <thead>
          <tr style="background:#f7fafc">
            <th style="text-align:left;padding:8px 16px;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#4a5568">Name</th>
            <th style="text-align:left;padding:8px 12px;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#4a5568">Class</th>
            <th style="text-align:left;padding:8px 12px;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#4a5568">NMFC</th>
            <th style="padding:8px 16px"></th>
          </tr>
        </thead>
        <tbody id="commodityList"></tbody>
      </table>
    </div>
    <div style="padding:10px 20px;border-top:1px solid #e2e8f0;font-size:.75rem;color:#718096">
      Matches your saved commodities in WWEX SpeedShip. Select to auto-fill the cargo row.
    </div>
  </div>
</div>

<script>
/* ── State ────────────────────────────────────────────────────── */
var _rates    = [];
var _selected = null;
var _txnId    = null;
var _orderId  = '<%= orderId || "" %>';

/* ── Prefill Handling Units from server ───────────────────────── */
var _prefillHUs = <%- JSON.stringify(prefillHandlingUnits || []) %>;

/* ── Seed HU rows on load ─────────────────────────────────────── */
window.addEventListener('DOMContentLoaded', function() {
  if (_prefillHUs && _prefillHUs.length) {
    _prefillHUs.forEach(function(hu) { addHandlingUnit(hu); });
  } else {
    addHandlingUnit();
  }
  document.getElementById('commodityModal').addEventListener('click', function(e) {
    if (e.target === this) closeCommodityPicker();
  });
});

/* ── Step navigation ──────────────────────────────────────────── */
function showStep(n) {
  [1,2,3,'Success'].forEach(function(s) {
    var el = document.getElementById('step' + s);
    if (el) el.style.display = 'none';
    var ind = document.getElementById('step-ind-' + s);
    if (ind) { ind.classList.remove('active','done'); if (s < n) ind.classList.add('done'); }
  });
  var el = document.getElementById('step' + n);
  if (el) el.style.display = '';
  var ind = document.getElementById('step-ind-' + n);
  if (ind) ind.classList.add('active');
}

/* ── Handling Units ───────────────────────────────────────────── */
var _huCount = 0;
var FREIGHT_CLASSES = ['50','55','60','65','70','77.5','85','92.5','100','110','125','150','175','200','250','300','400','500'];
var HU_TYPES = [
  { value:'BOX', label:'Box / Carton' },
  { value:'PLT', label:'Pallet' },
  { value:'CRT', label:'Crate' },
  { value:'SKD', label:'Skid' },
  { value:'BND', label:'Bundle' },
];
var PIECE_TYPES = [
  { value:'CTN', label:'Carton' },
  { value:'PLT', label:'Pallet' },
  { value:'CRT', label:'Crate' },
  { value:'SKD', label:'Skid' },
  { value:'BND', label:'Bundle' },
  { value:'PCS', label:'Pieces' },
];

function addHandlingUnit(d) {
  d = d || {};
  _huCount++;
  var n = _huCount;

  var huTypeOpts = HU_TYPES.map(function(t) {
    return '<option value="' + t.value + '"' + ((d.huType || 'BOX') === t.value ? ' selected' : '') + '>' + t.label + '</option>';
  }).join('');

  var label = d.productName
    ? (d.productName + (d.componentType ? ' — ' + d.componentType : '') + (d.sku ? ' <span class="hu-sku-badge">(' + d.sku + ')</span>' : ''))
    : ('Handling Unit #' + n);

  var comms = (d.commodities && d.commodities.length) ? d.commodities : [{}];

  var html = '<div class="ship-hu-row" id="hu-' + n + '">'
    + '<div class="ship-hu-header">'
    +   '<span class="ship-hu-label">' + label + '</span>'
    +   '<button class="ship-item-remove" onclick="removeHU(' + n + ')" title="Remove">✕</button>'
    + '</div>'
    + '<div class="ship-hu-dims">'
    +   '<div class="adm-field"><label>Type</label><select class="adm-input hu-type">' + huTypeOpts + '</select></div>'
    +   '<div class="adm-field"><label>Count</label><input type="number" class="adm-input hu-count" min="1" value="' + (d.count || 1) + '"></div>'
    +   '<div class="adm-field"><label>Stackable</label><select class="adm-input hu-stackable"><option value="N"' + (!d.stackable ? ' selected' : '') + '>No</option><option value="Y"' + (d.stackable ? ' selected' : '') + '>Yes</option></select></div>'
    +   '<div class="adm-field"><label>Length (in)</label><input type="number" class="adm-input hu-length" min="1" value="' + (d.length || '') + '" placeholder="in"></div>'
    +   '<div class="adm-field"><label>Width (in)</label><input type="number" class="adm-input hu-width" min="1" value="' + (d.width || '') + '" placeholder="in"></div>'
    +   '<div class="adm-field"><label>Height (in)</label><input type="number" class="adm-input hu-height" min="1" value="' + (d.height || '') + '" placeholder="in"></div>'
    +   '<div class="adm-field"><label>Gross Weight (lbs)</label><input type="number" class="adm-input hu-weight" min="1" value="' + (d.grossWeight || '') + '" placeholder="lbs"></div>'
    + '</div>'
    + '<div class="ship-hu-commodities">'
    +   '<div class="ship-comm-header"><span class="ship-comm-title">Commodity</span></div>'
    +   '<div class="ship-comm-list" id="comm-list-' + n + '">'
    +   buildCommodityHTML(n, 1, comms[0])
    +   '</div>'
    + '</div>'
    + '</div>';

  document.getElementById('huList').insertAdjacentHTML('beforeend', html);
}

function buildCommodityHTML(huN, commN, c) {
  c = c || {};
  var fcOpts = '<option value="">Auto</option>' + FREIGHT_CLASSES.map(function(fc) {
    return '<option' + (String(c.freightClass) === fc ? ' selected' : '') + '>' + fc + '</option>';
  }).join('');
  var ptOpts = PIECE_TYPES.map(function(t) {
    return '<option value="' + t.value + '"' + ((c.pieceType || 'CTN') === t.value ? ' selected' : '') + '>' + t.label + '</option>';
  }).join('');
  return '<div class="ship-comm-row" id="comm-' + huN + '-' + commN + '">'
    + '<div class="adm-field" style="grid-column:span 3">'
    +   '<label>Commodity</label>'
    +   '<div style="display:flex;gap:4px">'
    +   '<input type="text" class="adm-input comm-desc" placeholder="e.g. Top, Sink or Bathroom Vanity" value="' + (c.description || '') + '" style="flex:1">'
    +   '<button type="button" onclick="openCommodityPicker(' + huN + ',' + commN + ')" class="comm-search-btn" title="Browse saved commodities">&#128269;</button>'
    +   '</div>'
    + '</div>'
    + '<div class="adm-field"><label>NMFC Code</label><input type="text" class="adm-input comm-nmfc" placeholder="e.g. 159530-2" value="' + (c.nmfcCode || '') + '"></div>'
    + '<div class="adm-field"><label>Class</label><select class="adm-input comm-class">' + fcOpts + '</select></div>'
    + '<div class="adm-field"><label>Pieces</label><input type="number" class="adm-input comm-pieces" min="1" value="' + (c.pieces || 1) + '"></div>'
    + '<div class="adm-field"><label>Piece Type</label><select class="adm-input comm-ptype">' + ptOpts + '</select></div>'
    + '</div>';
}

function removeHU(n) {
  var el = document.getElementById('hu-' + n);
  if (el) el.remove();
}

function getProductType() {
  var sel = document.querySelector('input[name="productType"]:checked');
  return sel ? sel.value : 'LTL';
}

function getHandlingUnits() {
  return Array.from(document.querySelectorAll('.ship-hu-row')).map(function(hu) {
    var commodities = Array.from(hu.querySelectorAll('.ship-comm-row')).map(function(cr) {
      return {
        description:  (cr.querySelector('.comm-desc')   || {}).value || '',
        nmfcCode:     (cr.querySelector('.comm-nmfc')   || {}).value || null,
        freightClass: (cr.querySelector('.comm-class')  || {}).value || null,
        pieces:       parseInt((cr.querySelector('.comm-pieces') || {}).value)  || 1,
        pieceType:    (cr.querySelector('.comm-ptype')  || {}).value || 'CTN',
        weight:       parseFloat((hu.querySelector('.hu-weight') || {}).value)  || null,
      };
    });
    return {
      huType:      (hu.querySelector('.hu-type')      || {}).value || 'BOX',
      count:       parseInt((hu.querySelector('.hu-count')   || {}).value) || 1,
      stackable:   (hu.querySelector('.hu-stackable') || {}).value === 'Y',
      length:      parseFloat((hu.querySelector('.hu-length') || {}).value) || null,
      width:       parseFloat((hu.querySelector('.hu-width')  || {}).value) || null,
      height:      parseFloat((hu.querySelector('.hu-height') || {}).value) || null,
      grossWeight: parseFloat((hu.querySelector('.hu-weight') || {}).value) || null,
      commodities: commodities,
    };
  });
}

/* ── Product type visibility ──────────────────────────────────── */
document.querySelectorAll('input[name="productType"]').forEach(function(r) {
  r.addEventListener('change', function() {
    var isLTL = r.value === 'LTL';
    document.getElementById('ltlOptions').style.display = isLTL ? '' : 'none';
    document.getElementById('spOptions').style.display  = isLTL ? 'none' : '';
  });
});

function toggleInsureVal(v) {
  document.getElementById('ltl_insure_val').style.display = v === 'yes' ? '' : 'none';
}
function toggleSpInsureVal(v) {
  document.getElementById('sp_insure_val').style.display = v === 'yes' ? '' : 'none';
}
function chk(id) { var el = document.getElementById(id); return el ? el.checked : false; }
function val(id) { var el = document.getElementById(id); return el ? el.value : ''; }
function rval(name) { var el = document.querySelector('input[name="'+name+'"]:checked'); return el ? el.value : ''; }

/* ── Step 1 → 2: Get Rates ────────────────────────────────────── */
function goToRates() {
  var hus = getHandlingUnits();
  if (!hus.length) { alert('Add at least one handling unit.'); return; }
  if (!document.getElementById('dest_zip').value) { alert('Destination ZIP is required.'); return; }

  showStep(2);
  document.getElementById('rateLoading').style.display = '';
  document.getElementById('rateError').style.display   = 'none';
  document.getElementById('rateList').style.display    = 'none';

  var productType = getProductType();

  var body = {
    productType: productType,
    insure:              rval('ltl_insure') === 'yes',
    declaredValue:       parseFloat(val('acc_declaredValue')) || 0,
    handlingCharge:      rval('ltl_handling') === 'yes',
    insidePickup:        chk('acc_insidePickup'),
    liftgatePickup:      chk('acc_liftgatePickup'),
    residentialPickup:   chk('acc_residentialPickup'),
    tradeshowPickup:     chk('acc_tradeshowPickup'),
    constructionPickup:  chk('acc_constructionPickup'),
    dropAtTerminal:      chk('acc_dropAtTerminal'),
    groceryPickup:       chk('acc_groceryPickup'),
    insideDelivery:      chk('acc_insideDelivery'),
    liftgateDelivery:    chk('acc_liftgateDelivery'),
    residentialDelivery: chk('acc_residentialDelivery'),
    tradeshowDelivery:   chk('acc_tradeshowDelivery'),
    groceryDelivery:     chk('acc_groceryDelivery'),
    constructionDelivery:chk('acc_constructionDelivery'),
    notifyBeforeDelivery:chk('acc_notifyBeforeDelivery'),
    holdAtTerminal:      chk('acc_holdAtTerminal'),
    appointment:         chk('acc_appointment'),
    sortAndSegregate:    chk('acc_sortAndSegregate'),
    protectFromFreeze:   chk('acc_protectFromFreeze'),
    billingType:         val('ltl_billing') || 'BILL_SHIPPER',
    sp_insure:           rval('sp_insure') === 'yes',
    sp_declaredValue:    parseFloat(val('sp_declaredValue')) || 0,
    sp_handlingCharge:   chk('sp_handlingCharge'),
    sp_carbonNeutral:    chk('sp_carbonNeutral'),
    sp_returnLabel:      chk('sp_returnLabel'),
    sp_shipmentAlerts:   chk('sp_shipmentAlerts'),
    sp_upsNotifications: chk('sp_upsNotifications'),
    sp_senderReceipt:    chk('sp_senderReceipt'),
    sp_emailLabel:       chk('sp_emailLabel'),
    sp_signature:        val('sp_signature') || '',
    sp_billingType:      val('sp_billing') || 'BILL_SHIPPER',
    residential: document.getElementById('dest_residential').checked,
    origin: {
      company:  val('orig_company'),
      address1: val('orig_address1'),
      city:     val('orig_city'),
      state:    document.getElementById('orig_state').value.toUpperCase(),
      zip:      val('orig_zip'),
      phone:    val('orig_phone'),
      country:  'US',
    },
    destination: {
      company:  val('dest_company'),
      name:     val('dest_name'),
      address1: val('dest_address1'),
      city:     val('dest_city'),
      state:    document.getElementById('dest_state').value.toUpperCase(),
      zip:      val('dest_zip'),
      phone:    val('dest_phone'),
      email:    val('dest_email'),
      country:  document.getElementById('dest_country').value.toUpperCase() || 'US',
    },
    handlingUnits: hus,
  };

  fetch('/admin/shipping/rates', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  })
  .then(function(r){ return r.json(); })
  .then(function(d) {
    document.getElementById('rateLoading').style.display = 'none';
    if (!d.ok || !d.rates || !d.rates.length) {
      document.getElementById('rateError').style.display = '';
      document.getElementById('rateError').textContent   = d.error || 'No rates returned. Check origin/destination details.';
      return;
    }
    _rates = d.rates;
    _txnId = d.productTransactionId;
    renderRates(d.rates, d.stub);
  })
  .catch(function(e) {
    document.getElementById('rateLoading').style.display = 'none';
    document.getElementById('rateError').style.display   = '';
    document.getElementById('rateError').textContent     = 'Request failed: ' + e.message;
  });
}

/* Safely stringify a field that might be an object (live WWEX API returns objects) */
function strField(v) {
  if (!v) return '';
  if (typeof v === 'string') return v;
  if (typeof v === 'object') return v.name || v.description || v.code || JSON.stringify(v);
  return String(v);
}

function renderRates(rates, isStub) {
  var html = '';
  if (isStub) html += '<p style="font-size:.8rem;color:#975a16;margin:0 0 12px">⚠ Stub rates — connect WWEX credentials to get live pricing.</p>';
  rates.forEach(function(r, i) {
    var carrier = strField(r.carrier) || '—';
    var service = strField(r.serviceLevel) || strField(r.service) || '';
    html += '<div class="ship-rate-card" onclick="selectRate(' + i + ')" id="rate-card-' + i + '">'
      + '<div class="ship-rate-carrier"><strong>' + carrier + '</strong>'
      + ' <span class="ship-rate-service">' + service + '</span></div>'
      + '<div class="ship-rate-meta">'
      + (r.transitDays ? '<span>🕒 ' + r.transitDays + ' days transit</span>' : '')
      + (r.estimatedDelivery ? '<span>📅 ' + r.estimatedDelivery + '</span>' : '')
      + '</div>'
      + '<div class="ship-rate-price">$' + Number(r.totalCharge||0).toLocaleString('en-US',{minimumFractionDigits:2}) + '</div>'
      + '</div>';
  });
  document.getElementById('rateList').innerHTML = html;
  document.getElementById('rateList').style.display = '';
}

function selectRate(i) {
  document.querySelectorAll('.ship-rate-card').forEach(function(c) { c.classList.remove('selected'); });
  document.getElementById('rate-card-' + i).classList.add('selected');
  _selected = _rates[i];
  buildConfirmStep();
  showStep(3);
}

/* ── Step 3: Confirm ──────────────────────────────────────────── */
function buildConfirmStep() {
  var r  = _selected;
  var pt = getProductType();
  document.getElementById('selectedRateDisplay').innerHTML =
    '<table style="width:100%;font-size:.9rem;border-collapse:collapse">'
    + '<tr><td style="color:#718096;padding:4px 0">Carrier</td><td style="font-weight:700">' + (strField(r.carrier)||'—') + '</td></tr>'
    + '<tr><td style="color:#718096;padding:4px 0">Service</td><td>' + (strField(r.serviceLevel)||strField(r.service)||'—') + '</td></tr>'
    + '<tr><td style="color:#718096;padding:4px 0">Transit</td><td>' + (r.transitDays ? r.transitDays+' days' : '—') + '</td></tr>'
    + '<tr><td style="color:#718096;padding:4px 0">Est. Delivery</td><td>' + (r.estimatedDelivery||'—') + '</td></tr>'
    + '<tr><td style="color:#718096;padding:4px 0;font-weight:700">Total Charge</td><td style="font-weight:700;color:#1a2e4a;font-size:1.2rem">$' + Number(r.totalCharge||0).toLocaleString('en-US',{minimumFractionDigits:2}) + '</td></tr>'
    + '</table>';

  document.getElementById('shipSummary').innerHTML =
    '<table style="width:100%;font-size:.85rem;border-collapse:collapse">'
    + '<tr><td style="color:#718096;padding:3px 0">From</td><td>' + val('orig_city') + ', ' + document.getElementById('orig_state').value.toUpperCase() + '</td></tr>'
    + '<tr><td style="color:#718096;padding:3px 0">To</td><td>' + val('dest_company') + ' — ' + val('dest_city') + ', ' + document.getElementById('dest_state').value.toUpperCase() + ' ' + val('dest_zip') + '</td></tr>'
    + '<tr><td style="color:#718096;padding:3px 0">HUs</td><td>' + getHandlingUnits().length + ' handling unit(s)</td></tr>'
    + '<tr><td style="color:#718096;padding:3px 0">Ref 1</td><td>' + (val('ref1')||'—') + '</td></tr>'
    + '</table>';

  document.getElementById('pickupSection').style.display = pt === 'SMALLPACK' ? '' : 'none';
}

function togglePickup(checked) {
  document.getElementById('pickupFields').style.display = checked ? '' : 'none';
}

/* ── Book ─────────────────────────────────────────────────────── */
function bookShipment() {
  if (!_selected || !_txnId) { alert('Select a rate first.'); return; }
  var btn = document.getElementById('bookBtn');
  btn.disabled    = true;
  btn.textContent = 'Booking…';

  var pt   = getProductType();
  var dest = {
    addressLineList: [val('dest_address1')],
    locality:    val('dest_city'),
    region:      document.getElementById('dest_state').value.toUpperCase(),
    postalCode:  val('dest_zip'),
    countryCode: document.getElementById('dest_country').value.toUpperCase() || 'US',
    companyName: val('dest_company'),
    phone:       val('dest_phone'),
    contactList: [{ firstName:'', lastName:val('dest_name'), phone:val('dest_phone'), email:val('dest_email') }],
  };
  var orig = {
    addressLineList: [val('orig_address1')],
    locality:    val('orig_city'),
    region:      document.getElementById('orig_state').value.toUpperCase(),
    postalCode:  val('orig_zip'),
    countryCode: 'US',
    companyName: val('orig_company'),
    phone:       val('orig_phone'),
    contactList: [{ firstName:'', lastName:'', phone:val('orig_phone') }],
  };

  var schedPick  = document.getElementById('schedulePickup') && document.getElementById('schedulePickup').checked;
  var pickupDate = document.getElementById('pickupDate') ? document.getElementById('pickupDate').value : '';

  fetch('/admin/shipping/book', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      productType:          pt,
      productTransactionId: _txnId,
      offerId:              _selected.offerId,
      carrier:              strField(_selected.carrier),
      serviceLevel:         strField(_selected.serviceLevel) || strField(_selected.service),
      totalCharge:          _selected.totalCharge,
      orderId:              _orderId || null,
      schedulePickup:       schedPick,
      pickupDate:           pickupDate,
      pickupReadyTime:      document.getElementById('pickupReady') ? document.getElementById('pickupReady').value + ':00' : '08:00:00',
      pickupCloseTime:      document.getElementById('pickupClose') ? document.getElementById('pickupClose').value + ':00' : '17:00:00',
      shipment: {
        originAddress:      { address: orig },
        destinationAddress: { address: dest },
        referenceList: [
          { type:'Reference 1', value:val('ref1'), isPrintAsBarCode:false },
          { type:'Reference 2', value:val('ref2'), isPrintAsBarCode:false },
        ].filter(function(r){ return r.value; }),
      },
    }),
  })
  .then(function(r){ return r.json(); })
  .then(function(d) {
    if (!d.ok) {
      btn.disabled    = false;
      btn.textContent = 'Book Shipment';
      alert('Booking failed: ' + (d.error || 'Unknown error'));
      return;
    }
    var details = '';
    if (d.bolNumber) details += '<p><strong>BOL #:</strong> ' + d.bolNumber + '</p>';
    if (d.proNumber) details += '<p><strong>PRO #:</strong> ' + d.proNumber + '</p>';
    if (d.pickupConfirmation) details += '<p><strong>Pickup Confirmation:</strong> ' + d.pickupConfirmation + '</p>';
    if (d.stub) details += '<p style="color:#975a16;font-size:.8rem">⚠ Stub booking — no actual shipment created.</p>';
    document.getElementById('successDetails').innerHTML = details;
    if (d.bolUrl) {
      var link = document.getElementById('bolLink');
      link.href = d.bolUrl;
      link.style.display = '';
    }
    showStep('Success');
  })
  .catch(function(e) {
    btn.disabled    = false;
    btn.textContent = 'Book Shipment';
    alert('Error: ' + e.message);
  });
}

/* ── Commodity Picker ─────────────────────────────────────────── */
var COMMODITY_PRESETS = [
  { name:'Top, Sink or Bathroom Vanity W/O', nmfc:'159530-2', cls:'70'   },
  { name:'Top, Sink or Bathroom Vanity',     nmfc:'159530-1', cls:'92.5' },
  { name:'Bathtub PCF Less than 4',          nmfc:'158260',   cls:'300'  },
  { name:'Toilet (1 Unit)',                  nmfc:'158880-1', cls:'300'  },
  { name:'Toilets (More Than 1 Unit)',        nmfc:'158880-3', cls:'250'  },
];
var _activeHU   = null;
var _activeComm = null;
var _filteredPresets = [];

function openCommodityPicker(huN, commN) {
  _activeHU   = huN;
  _activeComm = commN;
  document.getElementById('commoditySearch').value = '';
  renderCommodityList('');
  document.getElementById('commodityModal').style.display = 'flex';
  setTimeout(function(){ document.getElementById('commoditySearch').focus(); }, 50);
}
function closeCommodityPicker() {
  document.getElementById('commodityModal').style.display = 'none';
  _activeHU = _activeComm = null;
}
function filterCommodities() {
  renderCommodityList(document.getElementById('commoditySearch').value);
}
function renderCommodityList(q) {
  _filteredPresets = COMMODITY_PRESETS.filter(function(p) {
    var s = q.toLowerCase();
    return !s || p.name.toLowerCase().indexOf(s) !== -1 || p.nmfc.indexOf(s) !== -1 || p.cls.indexOf(s) !== -1;
  });
  var html = _filteredPresets.map(function(p, i) {
    return '<tr class="comm-row" onclick="applyCommodity(' + i + ')">'
      + '<td class="comm-td">' + p.name + '</td>'
      + '<td class="comm-td comm-td--num">' + p.cls + '</td>'
      + '<td class="comm-td comm-td--num">' + p.nmfc + '</td>'
      + '<td class="comm-td" style="text-align:right"><button type="button" class="btn btn-sm btn-outline" style="font-size:.75rem;pointer-events:none">Select</button></td>'
      + '</tr>';
  }).join('');
  document.getElementById('commodityList').innerHTML = html
    || '<tr><td colspan="4" style="text-align:center;color:#718096;padding:24px">No matches</td></tr>';
}
function applyCommodity(i) {
  var preset = _filteredPresets[i];
  if (!preset || _activeHU === null) return;
  var commRow = document.getElementById('comm-' + _activeHU + '-' + _activeComm);
  if (!commRow) return;
  var descEl = commRow.querySelector('.comm-desc');
  var nmfcEl = commRow.querySelector('.comm-nmfc');
  var clsEl  = commRow.querySelector('.comm-class');
  if (descEl) descEl.value = preset.name;
  if (nmfcEl) nmfcEl.value = preset.nmfc;
  if (clsEl) {
    for (var j = 0; j < clsEl.options.length; j++) {
      if (clsEl.options[j].value === preset.cls || clsEl.options[j].text === preset.cls) {
        clsEl.selectedIndex = j; break;
      }
    }
  }
  closeCommodityPicker();
}

</script>

