.ship-type-opt   { display:flex;align-items:flex-start;gap:8px;padding:12px;border:1px solid #e2e8f0;border-radius:6px;cursor:pointer;flex:1 }
.ship-type-opt:has(input:checked) { border-color:#1a2e4a;background:#EBF8FF }
.ship-type-label { display:flex;flex-direction:column;gap:2px }
.ship-type-label strong { font-size:.9rem }
