<%
/* ═══════════════════════════════════════════════════════════════════
   Admin — Create Shipment  (/admin/shipping/create)
   3-step flow: 1) Addresses & items  2) Rate shop  3) Book & confirm
   Supports LTL and SMALLPACK. Pre-fills from order if orderId passed.
═══════════════════════════════════════════════════════════════════ */
const pre  = prefill             || {};
const hus  = prefillHandlingUnits || [];
const meta = orderMeta           || null;
%>

<%- include('../../../partials/wwex-env-banner') %>

<!-- ══ Toolbar ══════════════════════════════════════════════════════ -->
<div class="adm-toolbar">
  <div class="adm-back-wrap">
    <a href="/admin/shipping" class="adm-back-link">← Shipments</a>
    <span class="adm-toolbar-title">New Shipment<%= orderId ? ' — Order #'+orderId : '' %></span>
  </div>
</div>

<% if (meta) { %>
<!-- ══ Order Info Banner ═════════════════════════════════════════════ -->
<div class="ship-order-banner">
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <span style="font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#2b6cb0">Linked Order</span>
    <a href="/admin/orders/<%= meta.id %>" style="font-weight:700;color:#1a2e4a"><%= pre.orderNum %></a>
    <span style="color:#718096;font-size:.85rem"><%= meta.customer_name || '' %></span>
    <% if (meta.email) { %><span style="color:#718096;font-size:.8rem">· <%= meta.email %></span><% } %>
    <% if (meta.phone) { %><span style="color:#718096;font-size:.8rem">· <%= meta.phone %></span><% } %>
    <span style="margin-left:auto;font-size:.8rem;color:#718096">$<%= parseFloat(meta.total||0).toFixed(2) %> · <span style="text-transform:capitalize"><%= meta.status %></span></span>
  </div>
  <% if (hus.length) { %>
  <div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap">
    <% /* Show one chip per unique product (dedupe by productName+sku) */ %>
    <% const seen = {}; hus.forEach(function(hu){ const k = (hu.productName||'')+'|'+(hu.sku||''); if (!seen[k]) { seen[k]=true; %>
    <span style="background:#EBF8FF;color:#2b6cb0;border-radius:4px;padding:2px 8px;font-size:.75rem">
      <%= hu.count > 1 ? hu.count+'× ' : '' %><%= hu.productName || '' %>
      <% if (hu.sku) { %><span style="opacity:.65">(<%= hu.sku %>)</span><% } %>
    </span>
    <% } }); %>
  </div>
  <% } %>
</div>
<% } %>

<!-- ══ Step indicator ════════════════════════════════════════════════ -->
<div class="ship-steps">
  <div class="ship-step active" id="step-ind-1"><span class="ship-step-num">1</span> Addresses &amp; Cargo</div>
  <div class="ship-step" id="step-ind-2"><span class="ship-step-num">2</span> Rate Shop</div>
  <div class="ship-step" id="step-ind-3"><span class="ship-step-num">3</span> Confirm &amp; Book</div>
</div>

<!-- ═══ STEP 1: Addresses & Cargo ═══════════════════════════════════ -->
<div id="step1" class="ship-panel">
  <div class="ship-panel-grid">

    <!-- Product type -->
    <div class="admin-card ship-full-col">
      <h3 class="admin-card-title">Shipment Type</h3>
      <div style="display:flex;gap:12px">
        <label class="ship-type-opt">
          <input type="radio" name="productType" value="LTL" checked>
          <span class="ship-type-label">
            <strong>LTL Freight</strong>
            <small>Vanities, tops, cabinets — pallet shipments</small>
          </span>
        </label>
        <label class="ship-type-opt">
          <input type="radio" name="productType" value="SMALLPACK">
          <span class="ship-type-label">
            <strong>Small Package (UPS)</strong>
            <small>Accessories, samples, hardware</small>
          </span>
        </label>
      </div>
    </div>

    <!-- Origin -->
    <div class="admin-card">
      <h3 class="admin-card-title">Origin (Ship From)</h3>
      <div class="adm-form-grid">
        <div class="adm-field"><label>Company</label><input id="orig_company" type="text" class="adm-input" value="Bathroom Vanities Outlet"></div>
        <div class="adm-field"><label>Phone <span class="req-star">*</span></label><input id="orig_phone" type="text" class="adm-input" value="7706352030"></div>
        <div class="adm-field adm-field--full"><label>Address</label><input id="orig_address1" type="text" class="adm-input" value="50 Ernest W Barrett Pkwy NW"></div>
        <div class="adm-field"><label>City</label><input id="orig_city" type="text" class="adm-input" value="Marietta"></div>
        <div class="adm-field"><label>State</label><input id="orig_state" type="text" class="adm-input" value="GA" maxlength="2" style="text-transform:uppercase"></div>
        <div class="adm-field"><label>ZIP</label><input id="orig_zip" type="text" class="adm-input" value="30066"></div>
        <div class="adm-field adm-field--full"><label>Address 2 <small style="color:#718096;font-weight:400">(optional)</small></label><input id="orig_address2" type="text" class="adm-input" placeholder="Suite, dock, building"></div>
        <div class="adm-field"><label>Shipment Date</label><input id="shipmentDate" type="date" class="adm-input" value="<%= new Date().toISOString().split('T')[0] %>"></div>
        <div class="adm-field">
          <label>Pickup / Limited Access Location Type</label>
          <%# ADDED 2026-08-31 — SpeedShip has a separate location type for pickup
              and delivery. BVO previously had none for origin (hardcoded null). %>
          <select id="orig_locationType" class="adm-input">
            <option value="">Standard commercial (default)</option>
            <option value="RESIDENTIAL">Residential</option>
            <option value="LIMITED_ACCESS">Limited Access</option>
            <option value="CONSTRUCTION">Construction Site</option>
            <option value="DISTRIBUTION_CENTER">Distribution Center</option>
            <option value="TRADESHOW">Tradeshow</option>
          </select>
        </div>
        <input type="hidden" id="orig_country" value="US">
      </div>
    </div>

    <!-- Destination -->
    <div class="admin-card">
      <h3 class="admin-card-title">Destination (Ship To)</h3>
      <div class="adm-form-grid">
        <div class="adm-field"><label>Company / Business</label><input id="dest_company" type="text" class="adm-input" value="<%= pre.company || '' %>"></div>
        <div class="adm-field"><label>Contact Name</label><input id="dest_name" type="text" class="adm-input" value="<%= pre.name || '' %>"></div>
        <div class="adm-field"><label>Phone <span class="req-star">*</span></label><input id="dest_phone" type="text" class="adm-input" value="<%= pre.phone || '' %>" placeholder="Required by carrier"></div>
        <div class="adm-field"><label>Email</label><input id="dest_email" type="text" class="adm-input" value="<%= pre.email || '' %>"></div>
        <div class="adm-field adm-field--full"><label>Address</label><input id="dest_address1" type="text" class="adm-input" value="<%= pre.address1 || '' %>"></div>
        <div class="adm-field adm-field--full"><label>Address 2 <small style="color:#718096;font-weight:400">(optional)</small></label><input id="dest_address2" type="text" class="adm-input" value="<%= pre.address2 || '' %>" placeholder="Apt, suite, unit"></div>
        <div class="adm-field"><label>City</label><input id="dest_city" type="text" class="adm-input" value="<%= pre.city || '' %>"></div>
        <div class="adm-field"><label>State</label><input id="dest_state" type="text" class="adm-input" value="<%= pre.state || '' %>" maxlength="2" style="text-transform:uppercase"></div>
        <div class="adm-field"><label>ZIP</label><input id="dest_zip" type="text" class="adm-input" value="<%= pre.zip || '' %>"></div>
        <div class="adm-field"><label>Country</label><input id="dest_country" type="text" class="adm-input" value="US" maxlength="2" style="text-transform:uppercase"></div>
        <div class="adm-field">
          <label>Delivery / Limited Access Location Type</label>
          <%# CORRECTED 2026-08-31 — the previous options (BUSINESS_WITH_DOCKS,
              BUSINESS_WITHOUT_DOCKS, CONSTRUCTION_SITE) were not valid WWEX
              values and were silently ignored. Curated from the real enum:
              COMMERCIAL, AIRPORT, CONTAINER_FREIGHT_STATION, CONSTRUCTION,
              DISTRIBUTION_CENTER, PIER_PORT_WARF, LIMITED_ACCESS,
              GOVERNMENT_FACILITY, SECURED_LOCATION, RESIDENTIAL, TRADESHOW.
              This is also how residential DELIVERY is signalled — there is no
              residentialDeliveryFlag in the API. %>
          <select id="dest_locationType" class="adm-input">
            <option value="">Standard commercial (default)</option>
            <option value="RESIDENTIAL">Residential</option>
            <option value="LIMITED_ACCESS">Limited Access</option>
            <option value="CONSTRUCTION">Construction Site</option>
            <option value="DISTRIBUTION_CENTER">Distribution Center</option>
            <option value="TRADESHOW">Tradeshow</option>
          </select>
        </div>
        <div class="adm-field">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;margin-top:6px">
            <input type="checkbox" id="dest_residential" onchange="onResidentialChange(this.checked)"> Residential address
          </label>
          <small style="color:#718096;font-size:.75rem">Auto-sets Residential + Liftgate Delivery</small>
        </div>
      </div>
    </div>

    <!-- Handling Units -->
    <div class="admin-card ship-full-col">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <h3 class="admin-card-title" style="margin:0">Handling Units &amp; Commodities</h3>
        <button class="btn btn-sm btn-outline" onclick="addHandlingUnit()">+ Add Handling Unit</button>
      </div>
      <div id="huList"></div>
    </div>

    <!-- LTL Additional Services -->
    <div class="admin-card ship-full-col" id="ltlOptions">
      <h3 class="admin-card-title">LTL Additional Services</h3>

      <div class="ship-acc-grid">

        <!-- Insurance -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Insurance</div>
          <label class="ship-check"><input type="radio" name="ltl_insure" value="no" checked> No — accept carrier limited liability</label>
          <label class="ship-check" style="margin-top:4px"><input type="radio" name="ltl_insure" value="yes" onchange="toggleInsureVal(this.value)"> Yes — insure my shipment</label>
          <div id="ltl_insure_val" style="display:none;margin-top:6px">
            <div class="adm-field"><label>Declared Value ($)</label><input id="acc_declaredValue" type="number" class="adm-input" min="0" placeholder="0.00"></div>
          </div>
        </div>

        <!-- Handling Charge -->
        <%# WWEX takes handlingCharge as { value, unit } where unit is
            AMOUNT or PERCENT. Previously the Yes/No answer was collected
            but no amount was ever asked for, and nothing was transmitted. %>
        <div class="ship-acc-section">
          <div class="ship-acc-label">Handling Charge</div>
          <label class="ship-check"><input type="radio" name="ltl_handling" value="no" checked onchange="toggleHandlingVal(this.value)"> No, thanks</label>
          <label class="ship-check" style="margin-top:4px"><input type="radio" name="ltl_handling" value="yes" onchange="toggleHandlingVal(this.value)"> Yes, add a handling charge</label>
          <div id="ltl_handling_val" style="display:none;margin-top:6px">
            <div class="adm-form-grid">
              <div class="adm-field"><label>Amount</label><input id="acc_handlingChargeValue" type="number" class="adm-input" min="0" step="0.01" placeholder="0.00"></div>
              <div class="adm-field"><label>Type</label>
                <select id="acc_handlingChargeUnit" class="adm-input">
                  <option value="AMOUNT">$ Flat amount</option>
                  <option value="PERCENT">% Percent</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- Pickup Services -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Pickup Services</div>
          <label class="ship-check"><input type="checkbox" id="acc_insidePickup"> Inside Pickup</label>
          <label class="ship-check"><input type="checkbox" id="acc_liftgatePickup"> Liftgate Pickup</label>
          <label class="ship-check"><input type="checkbox" id="acc_residentialPickup"> Residential Pickup</label>
          <label class="ship-check"><input type="checkbox" id="acc_tradeshowPickup"> Tradeshow Pickup</label>
          <label class="ship-check"><input type="checkbox" id="acc_constructionPickup"> Construction Site Pickup</label>
          <label class="ship-check"><input type="checkbox" id="acc_dropAtTerminal"> Drop Shipment at Terminal</label>
          <label class="ship-check"><input type="checkbox" id="acc_groceryPickup"> Grocery Consolidation Pickup</label>
        </div>

        <!-- Delivery Services -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Delivery Services</div>
          <label class="ship-check"><input type="checkbox" id="acc_insideDelivery"> Inside Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_liftgateDelivery" checked> Liftgate Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_residentialDelivery"> Residential Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_tradeshowDelivery"> Tradeshow Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_groceryDelivery"> Grocery Consolidation Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_constructionDelivery"> Construction Site Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_notifyBeforeDelivery"> Notify Me Before Delivery</label>
          <label class="ship-check"><input type="checkbox" id="acc_holdAtTerminal"> Hold Shipment at Terminal</label>
          <label class="ship-check"><input type="checkbox" id="acc_appointment"> Appointment Delivery</label>
        </div>

        <!-- Shipment Services -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Shipment Services</div>
          <label class="ship-check"><input type="checkbox" id="acc_sortAndSegregate"> Sort and Segregate</label>
          <label class="ship-check"><input type="checkbox" id="acc_protectFromFreeze"> Protect from Freeze</label>
        </div>

        <!-- Billing Details -->
        <%# CHANGED 2026-08-31 — WWEX support confirmed freight terms are NOT a
            request field. They are ALWAYS "Bill Third Party" with a fixed
            remit-to address. The previous dropdown offered a choice that does
            not exist and was never transmitted. Shown as fixed text instead. %>
        <div class="ship-acc-section">
          <div class="ship-acc-label">Billing Details</div>
          <div style="font-size:.85rem;color:#4a5568;line-height:1.6">
            <div style="font-weight:600">Bill Third Party</div>
            <div style="color:#718096;font-size:.78rem">
              Carrier Payment Processing<br>
              P O Box 192629, Dallas, TX 75219<br>
              Customer #W0002746112
            </div>
            <div style="color:#a0aec0;font-size:.72rem;margin-top:4px">
              Set by WWEX — not selectable per shipment.
            </div>
          </div>
          <input type="hidden" id="ltl_billing" value="BILL_THIRD_PARTY">
        </div>

      </div><!-- /ship-acc-grid -->
    </div>

    <!-- SMALLPACK Additional Services (hidden by default) -->
    <div class="admin-card ship-full-col" id="spOptions" style="display:none">
      <h3 class="admin-card-title">Additional Services</h3>
      <div class="ship-acc-grid">

        <!-- Insurance -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Insure Shipment</div>
          <label class="ship-check"><input type="radio" name="sp_insure" value="no" checked> No — accept carrier limited liability</label>
          <label class="ship-check" style="margin-top:4px"><input type="radio" name="sp_insure" value="yes" onchange="toggleSpInsureVal(this.value)"> Yes, insure my shipment</label>
          <div id="sp_insure_val" style="display:none;margin-top:6px">
            <div class="adm-field"><label>Declared Value ($)</label><input id="sp_declaredValue" type="number" class="adm-input" min="0" placeholder="0.00"></div>
          </div>
        </div>

        <!-- UPS Services -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">UPS Services</div>
          <label class="ship-check"><input type="checkbox" id="sp_handlingCharge"> Handling Charge</label>
          <label class="ship-check"><input type="checkbox" id="sp_carbonNeutral"> UPS Carbon Neutral</label>
          <label class="ship-check"><input type="checkbox" id="sp_returnLabel"> Return Label</label>
          <label class="ship-check"><input type="checkbox" id="sp_shipmentAlerts"> Shipment Alerts</label>
          <label class="ship-check"><input type="checkbox" id="sp_upsNotifications"> UPS Notifications</label>
          <label class="ship-check"><input type="checkbox" id="sp_senderReceipt"> Include Sender's Receipt</label>
          <label class="ship-check"><input type="checkbox" id="sp_emailLabel"> Email Label</label>
        </div>

        <!-- Signature -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Signature Options</div>
          <div class="adm-field">
            <select id="sp_signature" class="adm-input">
              <option value="">No Signature Option</option>
              <option value="SIGNATURE_REQUIRED">Signature Required</option>
              <option value="ADULT_SIGNATURE_REQUIRED">Adult Signature Required</option>
            </select>
          </div>
        </div>

        <!-- Billing -->
        <div class="ship-acc-section">
          <div class="ship-acc-label">Billing Details</div>
          <div class="adm-field">
            <select id="sp_billing" class="adm-input">
              <option value="BILL_SHIPPER">Bill My Account</option>
              <option value="BILL_RECIPIENT">Bill Recipient</option>
              <option value="BILL_THIRD_PARTY">Bill Third Party</option>
            </select>
          </div>
        </div>

      </div>
    </div>

    <!-- References -->
    <div class="admin-card">
      <h3 class="admin-card-title">References</h3>
      <div class="adm-form-grid">
        <div class="adm-field"><label>Reference 1</label><input id="ref1" type="text" class="adm-input" value="<%= pre.reference1 || '' %>" placeholder="Order # or PO #"></div>
        <div class="adm-field"><label>Reference 2</label><input id="ref2" type="text" class="adm-input" placeholder="Optional"></div>
      </div>
    </div>

  </div><!-- /ship-panel-grid -->

  <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
    <button class="btn btn-primary" onclick="goToRates()">Get Rates →</button>
  </div>
</div><!-- /step1 -->

<!-- ═══ STEP 2: Rate Shop ══════════════════════════════════════════ -->
<div id="step2" class="ship-panel" style="display:none">
  <div class="admin-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <h3 class="admin-card-title" style="margin:0">Available Rates</h3>
      <button class="btn btn-sm btn-outline" onclick="showStep(1)">← Edit Details</button>
    </div>

    <div id="rateLoading" style="text-align:center;padding:32px;color:#718096">
      <div class="ship-spinner"></div>
      <p style="margin-top:8px">Fetching carrier rates…</p>
    </div>
    <div id="rateError" style="display:none" class="adm-alert adm-alert--error"></div>
    <div id="rateList" style="display:none"></div>
  </div>
</div>

<!-- ═══ STEP 3: Confirm & Book ════════════════════════════════════ -->
<div id="step3" class="ship-panel" style="display:none">
  <!-- Filled by buildConfirmStep() -->
  <div id="confirmBody"></div>

  <!-- UPS Pickup (SMALLPACK only) -->
  <div class="admin-card" id="pickupSection" style="display:none;margin-top:12px">
    <h3 class="admin-card-title">Schedule UPS Pickup</h3>
    <div class="adm-form-grid">
      <div class="adm-field">
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
          <input type="checkbox" id="schedulePickup" onchange="togglePickup(this.checked)"> Schedule a UPS pickup
        </label>
        <small style="color:#718096">Uncheck if dropping off at a UPS store or on daily route.</small>
      </div>
      <div id="pickupFields" style="display:none;grid-column:1/-1">
        <div class="adm-form-grid">
          <div class="adm-field"><label>Pickup Date</label><input id="pickupDate" type="date" class="adm-input"></div>
          <div class="adm-field"><label>Ready Time</label><input id="pickupReady" type="time" class="adm-input" value="08:00"></div>
          <div class="adm-field"><label>Close Time</label><input id="pickupClose" type="time" class="adm-input" value="17:00"></div>
        </div>
      </div>
    </div>
  </div>

  <div style="display:flex;justify-content:space-between;margin-top:16px;gap:8px">
    <button class="btn btn-outline" onclick="showStep(2)">← Back to Rates</button>
    <button class="btn btn-primary" id="bookBtn" onclick="openNotifyPanel()">Confirm &amp; Book Shipment</button>
  </div>
</div>

<!-- ═══ SUCCESS ══════════════════════════════════════════════════ -->
<div id="stepSuccess" class="ship-panel" style="display:none">
  <div class="admin-card" style="text-align:center;padding:40px">
    <div style="font-size:3rem;margin-bottom:12px">✅</div>
    <h2 style="margin:0 0 8px">Shipment Booked</h2>
    <div id="successDetails" style="color:#4a5568;margin-bottom:24px"></div>
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap">
      <a id="bolLink" href="#" target="_blank" class="btn btn-primary" style="display:none">Download BOL</a>
      <a href="/admin/shipping" class="btn btn-outline">Back to Shipments</a>
      <a href="/admin/shipping/create" class="btn btn-outline">New Shipment</a>
    </div>
  </div>
</div>

<!-- ═══ Additional Services / Alerts Modal ═════════════════════════
     Mirrors the "Additional Services" panel on SpeedShip's review page.
     Opens on Confirm & Book; the booking fires from inside it, because
     the alert preferences travel WITH the quoteOrderFlow request — there
     is no endpoint to attach them to an already-booked shipment.
══════════════════════════════════════════════════════════════════ -->
<div id="notifyModal" style="display:none;position:fixed;inset:0;z-index:1200;background:rgba(0,0,0,.45);align-items:center;justify-content:center"
     onclick="if(event.target===this)closeNotifyPanel()">
  <div style="background:#fff;border-radius:10px;width:min(520px,95vw);max-height:85vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.3)">
    <div style="padding:16px 20px;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between">
      <strong style="font-size:1rem">Additional Services</strong>
      <button onclick="closeNotifyPanel()" style="background:none;border:none;font-size:1.3rem;cursor:pointer;color:#718096;line-height:1">×</button>
    </div>
    <div id="notifyBody" style="padding:18px 20px;overflow-y:auto;flex:1"></div>
    <div style="padding:12px 20px;border-top:1px solid #e2e8f0;display:flex;gap:8px;justify-content:flex-end">
      <button class="btn btn-outline" onclick="closeNotifyPanel()">Cancel</button>
      <button class="btn btn-primary" id="notifyBookBtn" onclick="bookShipment()">Book Shipment</button>
    </div>
  </div>
</div>

<!-- ═══ Commodity Picker Modal ══════════════════════════════════ -->
<div id="commodityModal" style="display:none;position:fixed;inset:0;z-index:1200;background:rgba(0,0,0,.45);align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:10px;width:min(680px,95vw);max-height:80vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.3)">
    <div style="padding:16px 20px;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between">
      <strong style="font-size:1rem">My Commodities</strong>
      <button onclick="closeCommodityPicker()" style="background:none;border:none;font-size:1.3rem;cursor:pointer;color:#718096;line-height:1">×</button>
    </div>
    <div style="padding:12px 20px;border-bottom:1px solid #e2e8f0">
      <input id="commoditySearch" type="text" class="adm-input" placeholder="Search by name or NMFC…" oninput="filterCommodities()" style="width:100%;box-sizing:border-box">
    </div>
    <div style="overflow-y:auto;flex:1">
      <table style="width:100%;border-collapse:collapse;font-size:.88rem">
        <thead>
          <tr style="background:#f7fafc">
            <th style="text-align:left;padding:8px 16px;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#4a5568">Name</th>
            <th style="text-align:left;padding:8px 12px;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#4a5568">Class</th>
            <th style="text-align:left;padding:8px 12px;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#4a5568">NMFC</th>
            <th style="padding:8px 16px"></th>
          </tr>
        </thead>
        <tbody id="commodityList"></tbody>
      </table>
    </div>
    <div style="padding:10px 20px;border-top:1px solid #e2e8f0;font-size:.75rem;color:#718096">
      Matches your saved commodities in WWEX SpeedShip. Select to auto-fill the cargo row.
    </div>
  </div>
</div>

<script>
/* ── State ────────────────────────────────────────────────────── */
var _rates        = [];
var _selected     = null;
var _txnId        = null;
var _shopShipment = null;  // full LTL shipment from shopFlow — echoed back in quoteOrderFlow
var _orderId  = '<%= orderId || "" %>';

/* ── Prefill Handling Units from server ───────────────────────── */
var _prefillHUs = <%- JSON.stringify(prefillHandlingUnits || []) %>;

/* ── Seed HU rows on load ─────────────────────────────────────── */
window.addEventListener('DOMContentLoaded', function() {
  if (_prefillHUs && _prefillHUs.length) {
    _prefillHUs.forEach(function(hu) { addHandlingUnit(hu); });
  } else {
    addHandlingUnit();
  }
  document.getElementById('commodityModal').addEventListener('click', function(e) {
    if (e.target === this) closeCommodityPicker();
  });
});

/* ── Step navigation ──────────────────────────────────────────── */
function showStep(n) {
  [1,2,3,'Success'].forEach(function(s) {
    var el = document.getElementById('step' + s);
    if (el) el.style.display = 'none';
    var ind = document.getElementById('step-ind-' + s);
    if (ind) { ind.classList.remove('active','done'); if (s < n) ind.classList.add('done'); }
  });
  var el = document.getElementById('step' + n);
  if (el) el.style.display = '';
  var ind = document.getElementById('step-ind-' + n);
  if (ind) ind.classList.add('active');
}

/* ── Handling Units ───────────────────────────────────────────── */
var _huCount = 0;
var FREIGHT_CLASSES = ['50','55','60','65','70','77.5','85','92.5','100','110','125','150','175','200','250','300','400','500'];
/* WWEX packagingType / commodityType — the ONLY 19 accepted values.
   Verified against SpeedshipAPI V4 Staging.postman_collection.json and the
   live SpeedShip LTL form. Order matches SpeedShip's own dropdown.
   CORRECTED 2026-08-31: the previous list had only 5 entries and used
   invented codes (CRT, BND, CTN, PCS) that WWEX rejects. There is no 'OTH'. */
var WWEX_PACK_TYPES = [
  { value:'BAG',      label:'Bag' },
  { value:'BALE',     label:'Bale' },
  { value:'BOX',      label:'Box' },
  { value:'BUNDLE',   label:'Bundle' },
  { value:'CARTON',   label:'Carton' },
  { value:'CASE',     label:'Case' },
  { value:'CRATE',    label:'Crate' },
  { value:'CYLINDER', label:'Cylinder' },
  { value:'DRUM',     label:'Drum' },
  { value:'PAIL',     label:'Pail' },
  { value:'PLT',      label:'Pallet' },
  { value:'PIECES',   label:'Pieces' },
  { value:'REEL',     label:'Reel' },
  { value:'ROLL',     label:'Roll' },
  { value:'SKID',     label:'Skid' },
  { value:'TANK',     label:'Tank' },
  { value:'TOTE',     label:'Tote' },
  { value:'TRAILER',  label:'Trailer' },
  { value:'TUBE',     label:'Tube' },
];
// Handling Unit Type and Commodity Piece Type share the same enum in WWEX.
var HU_TYPES    = WWEX_PACK_TYPES;
var PIECE_TYPES = WWEX_PACK_TYPES;

/* ═══════════════════════════════════════════════════════════════
   BVO PICKUP SOP DEFAULTS
   These pre-fill Step 3 (Confirm & Book) on every LTL shipment.
   They are starting values only — staff can overwrite any of them
   per shipment before booking.

   >>> EDIT HERE to change the standing defaults. <<<

   Character limits are enforced by WWEX and by maxlength on the
   inputs: pickup 60, delivery 60, handling 82.
═══════════════════════════════════════════════════════════════ */
var SOP_READY_TIME = '11:30';   // 11:30 AM — earliest pickup
var SOP_CLOSE_TIME = '16:00';   // 4:00 PM  — latest pickup
var SOP_PICKUP_INSTRUCTIONS   = 'Store located on BACKSIDE of shopping strip BEHIND ROSS';
var SOP_DELIVERY_INSTRUCTIONS = 'Call receiver 24 hours in advance with delivery window.';
var SOP_HANDLING_INSTRUCTIONS = 'DO NOT STACK ON';

/** Escape a string for safe use inside an HTML attribute value.
 *  Step 3 is built by string concatenation, so any value containing a quote
 *  would otherwise break out of the attribute. */
function esc(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function addHandlingUnit(d) {
  d = d || {};
  _huCount++;
  var n = _huCount;

  var huTypeOpts = '<option value="">— Select type —</option>'
    + HU_TYPES.map(function(t) {
        return '<option value="' + t.value + '"' + (d.huType === t.value ? ' selected' : '') + '>' + t.label + '</option>';
      }).join('');

  var label = d.productName
    ? (d.productName + (d.componentType ? ' — ' + d.componentType : '') + (d.sku ? ' <span class="hu-sku-badge">(' + d.sku + ')</span>' : ''))
    : ('Handling Unit #' + n);

  var comms = (d.commodities && d.commodities.length) ? d.commodities : [{}];

  var html = '<div class="ship-hu-row" id="hu-' + n + '">'
    + '<div class="ship-hu-header">'
    +   '<span class="ship-hu-label">' + label + '</span>'
    +   '<button class="ship-item-remove" onclick="removeHU(' + n + ')" title="Remove">✕</button>'
    + '</div>'
    + '<div class="ship-hu-dims">'
    +   '<div class="adm-field"><label>Type</label><select class="adm-input hu-type" onchange="togglePalletSize(this)">' + huTypeOpts + '</select></div>'
    +   '<div class="adm-field"><label>Count</label><input type="number" class="adm-input hu-count" min="1" value="' + (d.count || 1) + '"></div>'
    +   '<div class="adm-field"><label>Stackable</label><select class="adm-input hu-stackable"><option value="N"' + (!d.stackable ? ' selected' : '') + '>No</option><option value="Y"' + (d.stackable ? ' selected' : '') + '>Yes</option></select></div>'
    +   '<div class="adm-field hu-pallet-wrap" style="' + (d.huType === 'PLT' ? '' : 'display:none') + '"><label>Pallet Size</label><select class="adm-input hu-pallet-size" onchange="applyPalletSize(this)"><option value="">— pick a size —</option><option value="48x40">48 × 40</option><option value="24x24">24 × 24</option><option value="24x40">24 × 40</option><option value="36x36">36 × 36</option><option value="42x42">42 × 42</option><option value="48x42">48 × 42</option><option value="48x48">48 × 48</option><option value="58x41">58 × 41</option><option value="72x48">72 × 48</option><option value="96x48">96 × 48</option><option value="other">Other</option></select></div>'
  +   '<div class="adm-field"><label>Length (in)</label><input type="number" class="adm-input hu-length" min="1" value="' + (d.length || '') + '" placeholder="in"></div>'
    +   '<div class="adm-field"><label>Width (in)</label><input type="number" class="adm-input hu-width" min="1" value="' + (d.width || '') + '" placeholder="in"></div>'
    +   '<div class="adm-field"><label>Height (in)</label><input type="number" class="adm-input hu-height" min="1" value="' + (d.height || '') + '" placeholder="in"></div>'
    +   '<div class="adm-field"><label>Gross Weight (lbs)</label><input type="number" class="adm-input hu-weight" min="1" value="' + (d.grossWeight || '') + '" placeholder="lbs"></div>'
    + '</div>'
    + '<div class="ship-hu-commodities">'
    +   '<div class="ship-comm-header"><span class="ship-comm-title">Commodity</span></div>'
    +   '<div class="ship-comm-list" id="comm-list-' + n + '">'
    +   buildCommodityHTML(n, 1, comms[0])
    +   '</div>'
    + '</div>'
    + '</div>';

  document.getElementById('huList').insertAdjacentHTML('beforeend', html);
}

function buildCommodityHTML(huN, commN, c) {
  c = c || {};
  // Freight Class is REQUIRED by WWEX (commodityClass). No "Auto" option —
  // a blank class is rejected. validateStep1() blocks submission until set.
  var fcOpts = '<option value="">— Select class —</option>' + FREIGHT_CLASSES.map(function(fc) {
    return '<option' + (String(c.freightClass) === fc ? ' selected' : '') + '>' + fc + '</option>';
  }).join('');
  var ptOpts = PIECE_TYPES.map(function(t) {
    return '<option value="' + t.value + '"' + ((c.pieceType || 'CARTON') === t.value ? ' selected' : '') + '>' + t.label + '</option>';
  }).join('');
  return '<div class="ship-comm-row" id="comm-' + huN + '-' + commN + '">'
    + '<div class="adm-field" style="grid-column:span 3">'
    +   '<label>Commodity <span class="req-star">*</span></label>'
    +   '<div style="display:flex;gap:4px">'
    +   '<input type="text" class="adm-input comm-desc" placeholder="e.g. Top, Sink or Bathroom Vanity" value="' + (c.description || '') + '" style="flex:1">'
    +   '<button type="button" onclick="openCommodityPicker(' + huN + ',' + commN + ')" class="comm-search-btn" title="Browse saved commodities">&#128269;</button>'
    +   '</div>'
    + '</div>'
    + '<div class="adm-field"><label>NMFC Code</label><input type="text" class="adm-input comm-nmfc" placeholder="e.g. 159530-2" value="' + (c.nmfcCode || '') + '"></div>'
    + '<div class="adm-field"><label>Class <span class="req-star">*</span></label><select class="adm-input comm-class">' + fcOpts + '</select></div>'
    + '<div class="adm-field"><label>Weight (lbs) <span class="req-star">*</span></label><input type="number" class="adm-input comm-weight" min="1" step="0.01" value="' + (c.weight || '') + '" placeholder="lbs"></div>'
    + '<div class="adm-field"><label>Pieces</label><input type="number" class="adm-input comm-pieces" min="1" value="' + (c.pieces || 1) + '"></div>'
    + '<div class="adm-field"><label>Piece Type</label><select class="adm-input comm-ptype">' + ptOpts + '</select></div>'
    + '<div class="adm-field"><label style="display:flex;align-items:center;gap:6px;cursor:pointer;margin-top:20px">'
    +   '<input type="checkbox" class="comm-hazmat"' + (c.isHazMat ? ' checked' : '') + '> Hazmat</label></div>'
    + '</div>';
}

function removeHU(n) {
  var el = document.getElementById('hu-' + n);
  if (el) el.remove();
}

function getProductType() {
  var sel = document.querySelector('input[name="productType"]:checked');
  return sel ? sel.value : 'LTL';
}

function getHandlingUnits() {
  return Array.from(document.querySelectorAll('.ship-hu-row')).map(function(hu) {
    var commodities = Array.from(hu.querySelectorAll('.ship-comm-row')).map(function(cr) {
      return {
        description:  (cr.querySelector('.comm-desc')   || {}).value || '',
        nmfcCode:     (cr.querySelector('.comm-nmfc')   || {}).value || null,
        freightClass: (cr.querySelector('.comm-class')  || {}).value || null,
        pieces:       parseInt((cr.querySelector('.comm-pieces') || {}).value)  || 1,
        pieceType:    (cr.querySelector('.comm-ptype')  || {}).value || 'CARTON',
        isHazMat:     !!(cr.querySelector('.comm-hazmat') || {}).checked,
        // FIXED 2026-08-31: read this commodity's OWN weight. Previously every
        // commodity inherited the parent handling unit's gross weight, so a
        // 2-commodity pallet reported double its true weight to WWEX.
        // When left blank the controller splits the HU weight evenly.
        weight:       parseFloat((cr.querySelector('.comm-weight') || {}).value) || null,
      };
    });
    return {
      huType:      (hu.querySelector('.hu-type')      || {}).value || 'BOX',
      count:       parseInt((hu.querySelector('.hu-count')   || {}).value) || 1,
      stackable:   (hu.querySelector('.hu-stackable') || {}).value === 'Y',
      length:      parseFloat((hu.querySelector('.hu-length') || {}).value) || null,
      width:       parseFloat((hu.querySelector('.hu-width')  || {}).value) || null,
      height:      parseFloat((hu.querySelector('.hu-height') || {}).value) || null,
      grossWeight: parseFloat((hu.querySelector('.hu-weight') || {}).value) || null,
      commodities: commodities,
    };
  });
}

/* ── Product type visibility ──────────────────────────────────── */
document.querySelectorAll('input[name="productType"]').forEach(function(r) {
  r.addEventListener('change', function() {
    var isLTL = r.value === 'LTL';
    document.getElementById('ltlOptions').style.display = isLTL ? '' : 'none';
    document.getElementById('spOptions').style.display  = isLTL ? 'none' : '';
  });
});

function toggleInsureVal(v) {
  document.getElementById('ltl_insure_val').style.display = v === 'yes' ? '' : 'none';
}

/* ── Residential address sync ─────────────────────────────────── */
function onResidentialChange(checked) {
  // Auto-check Residential Delivery + Liftgate Delivery when address is residential
  var rd = document.getElementById('acc_residentialDelivery');
  var lg = document.getElementById('acc_liftgateDelivery');
  var lt = document.getElementById('dest_locationType');
  if (rd) rd.checked = checked;
  if (lg && checked) lg.checked = true;  // liftgate on; don't uncheck if user had it set
  if (lt) lt.value = checked ? 'RESIDENTIAL' : '';
}

/* ── Step 1 validation before GET QUOTE ──────────────────────── */
// Clear adm-error on any input change
document.addEventListener('input', function(e) {
  if (e.target && e.target.classList && e.target.classList.contains('adm-error')) {
    e.target.classList.remove('adm-error');
  }
});
document.addEventListener('change', function(e) {
  if (e.target && e.target.classList && e.target.classList.contains('adm-error')) {
    e.target.classList.remove('adm-error');
  }
});

function validateStep1() {
  var errors = [];
  // Clear previous highlights
  ['dest_zip','dest_state','dest_city','dest_phone','orig_phone'].forEach(function(id) {
    var el = document.getElementById(id); if (el) el.classList.remove('adm-error');
  });
  document.querySelectorAll('.comm-class, .hu-weight').forEach(function(el) {
    el.classList.remove('adm-error');
  });

  var zipEl   = document.getElementById('dest_zip');
  var stateEl = document.getElementById('dest_state');
  var cityEl  = document.getElementById('dest_city');
  var zip   = (zipEl   || {}).value || '';
  var state = (stateEl || {}).value || '';
  var city  = (cityEl  || {}).value || '';

  if (!zip.trim())   { errors.push('Destination ZIP is required.');   if (zipEl)   zipEl.classList.add('adm-error'); }
  if (!state.trim()) { errors.push('Destination State is required.'); if (stateEl) stateEl.classList.add('adm-error'); }
  if (!city.trim())  { errors.push('Destination City is required.');  if (cityEl)  cityEl.classList.add('adm-error'); }

  /* ADDED 2026-08-31 — WWEX rejects the BOOKING (not the rate shop) with
     "Destination Phone is required" when address.phone is blank. Both origin
     and destination phone are Required in quoteOrderFlow. Caught here at
     Step 1 so the user isn't told about it only after picking a carrier and
     filling in the whole confirm page. */
  var dPhoneEl = document.getElementById('dest_phone');
  var oPhoneEl = document.getElementById('orig_phone');
  var dPhone   = (dPhoneEl || {}).value || '';
  var oPhone   = (oPhoneEl || {}).value || '';
  /* Must be a full 10-digit number, not merely non-empty. WWEX rejects
     anything shorter with "Invalid Origin/Destination phone". Formatting
     is fine here — the server strips it to digits before sending. */
  function _digits(s) {
    var d = String(s || '').replace(/\D/g, '');
    if (d.length === 11 && d.charAt(0) === '1') d = d.slice(1);
    return d;
  }
  var dDigits = _digits(dPhone), oDigits = _digits(oPhone);
  if (dDigits.length < 10) {
    errors.push(dDigits.length
      ? 'Destination Phone looks incomplete — WWEX needs a full 10-digit number.'
      : 'Destination Phone is required — WWEX will reject the booking without it.');
    if (dPhoneEl) dPhoneEl.classList.add('adm-error');
  }
  if (oDigits.length < 10) {
    errors.push(oDigits.length
      ? 'Origin Phone looks incomplete — WWEX needs a full 10-digit number.'
      : 'Origin Phone is required — WWEX will reject the booking without it.');
    if (oPhoneEl) oPhoneEl.classList.add('adm-error');
  }

  /* CHANGED 2026-08-31 — Freight Class and Commodity Description are REQUIRED by
     WWEX (commodityClass / commodityDescription) on EVERY commodity, not just one.
     Previously only a single handling unit had to be valid, so a second commodity
     with a blank class was sent through and WWEX rejected the whole rate request
     with an unhelpful message. Every offending field is highlighted at once. */
  var huEls = document.querySelectorAll('.ship-hu-row');
  document.querySelectorAll('.comm-desc, .comm-weight').forEach(function(el) {
    el.classList.remove('adm-error');
  });

  var missingRequired = false;
  huEls.forEach(function(hu, hi) {
    var weightEl = hu.querySelector('.hu-weight');
    if (weightEl && !(parseFloat(weightEl.value) > 0)) {
      weightEl.classList.add('adm-error');
      missingRequired = true;
    }
    hu.querySelectorAll('.ship-comm-row').forEach(function(cr) {
      var classEl = cr.querySelector('.comm-class');
      var descEl  = cr.querySelector('.comm-desc');
      if (classEl && !classEl.value) { classEl.classList.add('adm-error'); missingRequired = true; }
      if (descEl  && !descEl.value.trim()) { descEl.classList.add('adm-error'); missingRequired = true; }
    });
  });

  if (missingRequired) {
    // Put the requested headline first so it reads clearly in the alert.
    errors.unshift('Please fill out all required fields.');
  }

  if (errors.length) {
    // De-duplicate in case the headline collides with a specific message.
    alert(errors.filter(function(e, i, a) { return a.indexOf(e) === i; }).join('\n'));
    // Focus the first offending field so the user lands on it directly.
    var firstBad = document.querySelector('.adm-error');
    if (firstBad && firstBad.scrollIntoView) {
      firstBad.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (firstBad.focus) firstBad.focus();
    }
    return false;
  }
  return true;
}
function toggleSpInsureVal(v) {
  document.getElementById('sp_insure_val').style.display = v === 'yes' ? '' : 'none';
}
function toggleHandlingVal(v) {
  var el = document.getElementById('ltl_handling_val');
  if (el) el.style.display = v === 'yes' ? '' : 'none';
}
function togglePalletSize(sel) {
  var wrap = sel.closest('.ship-hu-dims').querySelector('.hu-pallet-wrap');
  if (!wrap) return;
  wrap.style.display = sel.value === 'PLT' ? '' : 'none';
  if (sel.value !== 'PLT') { var ps = wrap.querySelector('.hu-pallet-size'); if (ps) ps.value = ''; }
}
function applyPalletSize(sel) {
  if (!sel.value || sel.value === 'other') return;
  var parts = sel.value.split('x');
  var dims = sel.closest('.ship-hu-dims');
  if (dims.querySelector('.hu-length')) dims.querySelector('.hu-length').value = parts[0] || '';
  if (dims.querySelector('.hu-width'))  dims.querySelector('.hu-width').value  = parts[1] || '';
}
function chk(id) { var el = document.getElementById(id); return el ? el.checked : false; }
function val(id) { var el = document.getElementById(id); return el ? el.value : ''; }
function rval(name) { var el = document.querySelector('input[name="'+name+'"]:checked'); return el ? el.value : ''; }

/* ── Step 1 → 2: Get Rates ────────────────────────────────────── */
function goToRates() {
  // Must have at least one handling unit before validating its contents.
  var hus = getHandlingUnits();
  if (!hus.length) { alert('Add at least one handling unit.'); return; }
  // validateStep1() now covers destination ZIP/state/city, handling-unit gross
  // weight, and Freight Class + Description on EVERY commodity — including the
  // "Please fill out all required fields." headline and field highlighting.
  // The duplicated per-commodity loop that used to live here was removed.
  if (!validateStep1()) return;

  showStep(2);
  document.getElementById('rateLoading').style.display = '';
  document.getElementById('rateError').style.display   = 'none';
  document.getElementById('rateList').style.display    = 'none';

  var productType = getProductType();

  var body = {
    productType: productType,
    insure:              rval('ltl_insure') === 'yes',
    declaredValue:       parseFloat(val('acc_declaredValue')) || 0,
    handlingCharge:      rval('ltl_handling') === 'yes',
    handlingChargeValue: parseFloat(val('acc_handlingChargeValue')) || 0,
    handlingChargeUnit:  val('acc_handlingChargeUnit') || 'AMOUNT',
    insidePickup:        chk('acc_insidePickup'),
    liftgatePickup:      chk('acc_liftgatePickup'),
    residentialPickup:   chk('acc_residentialPickup'),
    tradeshowPickup:     chk('acc_tradeshowPickup'),
    constructionPickup:  chk('acc_constructionPickup'),
    dropAtTerminal:      chk('acc_dropAtTerminal'),
    groceryPickup:       chk('acc_groceryPickup'),
    insideDelivery:      chk('acc_insideDelivery'),
    liftgateDelivery:    chk('acc_liftgateDelivery'),
    residentialDelivery: chk('acc_residentialDelivery'),
    tradeshowDelivery:   chk('acc_tradeshowDelivery'),
    groceryDelivery:     chk('acc_groceryDelivery'),
    constructionDelivery:chk('acc_constructionDelivery'),
    notifyBeforeDelivery:chk('acc_notifyBeforeDelivery'),
    holdAtTerminal:      chk('acc_holdAtTerminal'),
    appointment:         chk('acc_appointment'),
    sortAndSegregate:    chk('acc_sortAndSegregate'),
    protectFromFreeze:   chk('acc_protectFromFreeze'),
    billingType:         val('ltl_billing') || 'BILL_SHIPPER',
    sp_insure:           rval('sp_insure') === 'yes',
    sp_declaredValue:    parseFloat(val('sp_declaredValue')) || 0,
    sp_handlingCharge:   chk('sp_handlingCharge'),
    sp_carbonNeutral:    chk('sp_carbonNeutral'),
    sp_returnLabel:      chk('sp_returnLabel'),
    sp_shipmentAlerts:   chk('sp_shipmentAlerts'),
    sp_upsNotifications: chk('sp_upsNotifications'),
    sp_senderReceipt:    chk('sp_senderReceipt'),
    sp_emailLabel:       chk('sp_emailLabel'),
    sp_signature:        val('sp_signature') || '',
    sp_billingType:      val('sp_billing') || 'BILL_SHIPPER',
    residential: document.getElementById('dest_residential').checked,
    origin: {
      company:      val('orig_company'),
      address1:     val('orig_address1'),
      address2:     val('orig_address2'),
      city:         val('orig_city'),
      state:        document.getElementById('orig_state').value.toUpperCase(),
      zip:          val('orig_zip'),
      phone:        val('orig_phone'),
      country:      'US',
      locationType: val('orig_locationType') || null,
    },
    destination: {
      company:      val('dest_company'),
      name:         val('dest_name'),
      address1:     val('dest_address1'),
      address2:     val('dest_address2'),
      city:         val('dest_city'),
      state:        document.getElementById('dest_state').value.toUpperCase(),
      zip:          val('dest_zip'),
      phone:        val('dest_phone'),
      email:        val('dest_email'),
      country:      document.getElementById('dest_country').value.toUpperCase() || 'US',
      locationType: document.getElementById('dest_locationType').value || null,
    },
    shipmentDate: val('shipmentDate'),
    handlingUnits: hus,
  };

  fetch('/admin/shipping/rates', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  })
  .then(function(r){ return r.json(); })
  .then(function(d) {
    document.getElementById('rateLoading').style.display = 'none';
    if (!d.ok || !d.rates || !d.rates.length) {
      document.getElementById('rateError').style.display = '';
      // d.error may be an object (WWEX API error body) — normalize to string
      var errMsg = d.error
        ? (typeof d.error === 'string' ? d.error : d.error.message || d.error.description || JSON.stringify(d.error))
        : 'No rates returned. Check origin/destination details.';
      document.getElementById('rateError').textContent = errMsg;
      return;
    }
    _rates        = d.rates;
    _txnId        = d.productTransactionId;
    _shopShipment = d.shopShipment || null;
    _selected     = null;  // clear stale selection — offer IDs from prior rate shop are invalid for new txnId
    renderRates(d.rates, d.stub);
  })
  .catch(function(e) {
    document.getElementById('rateLoading').style.display = 'none';
    document.getElementById('rateError').style.display   = '';
    document.getElementById('rateError').textContent     = 'Request failed: ' + e.message;
  });
}

/* Safely stringify a field that might be an object (live WWEX API returns objects) */
function strField(v) {
  if (!v) return '';
  if (typeof v === 'string') return v;
  if (typeof v === 'object') return v.name || v.description || v.code || JSON.stringify(v);
  return String(v);
}

function titleCase(s) {
  return (s||'').toLowerCase().replace(/\b\w/g, function(c){ return c.toUpperCase(); });
}
function fmtDate(s) {
  if (!s) return '';
  var d = new Date(s + 'T12:00:00'); // noon to avoid timezone shift
  return d.toLocaleDateString('en-US', { month:'short', day:'numeric' });
}
/* _rateMap: id → rate object, populated by renderRates() */
var _rateMap = {};

function renderRates(rates, isStub) {
  _rateMap = {};

  /* Group by carrier (title-cased name) preserving sort order */
  var grouped = {};
  var order   = [];
  rates.forEach(function(r, i) {
    var key = titleCase(strField(r.carrier)) || '—';
    if (!grouped[key]) { grouped[key] = { name: key, std: null, gtd: null }; order.push(key); }
    var id  = 'rate-' + i;
    _rateMap[id] = r;
    var svc = (strField(r.serviceLevel) || '').toLowerCase();
    if (svc.indexOf('guarantee') !== -1) { grouped[key].gtd = id; }
    else                                 { grouped[key].std = id; }
  });

  var clockSvg = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 12"/></svg>';
  var calSvg   = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>';

  var html = '';
  if (isStub) html += '<p style="font-size:.8rem;color:#975a16;margin:0 0 8px">⚠ Stub rates — connect WWEX credentials to get live pricing.</p>';

  /* Header */
  html += '<div class="ship-rate-hdr">'
    + '<div class="ship-rate-col-name"></div>'
    + '<div class="ship-rate-col-std">Standard</div>'
    + '<div class="ship-rate-col-gtd">Guaranteed</div>'
    + '</div>';

  order.forEach(function(key) {
    var g   = grouped[key];
    var ref = _rateMap[g.std] || _rateMap[g.gtd];
    var transit  = ref && ref.transitDays ? ref.transitDays + ' day' + (ref.transitDays !== 1 ? 's' : '') : '';
    var delivery = ref && ref.estimatedDelivery ? fmtDate(ref.estimatedDelivery) : '';

    html += '<div class="ship-rate-row">';

    /* Carrier column */
    html += '<div class="ship-rate-col-name">'
      + '<div class="ship-rate-carrier-name">' + g.name + '</div>'
      + '<div class="ship-rate-meta">'
      + (transit  ? '<span class="ship-rate-meta-item">' + clockSvg + ' ' + transit  + '</span>' : '')
      + (delivery ? '<span class="ship-rate-meta-item">' + calSvg   + ' ' + delivery + '</span>' : '')
      + '</div></div>';

    /* Standard column */
    html += '<div class="ship-rate-col-std">';
    if (g.std) {
      var sp = Number((_rateMap[g.std].totalCharge)||0).toLocaleString('en-US',{minimumFractionDigits:2});
      html += '<button class="ship-rate-btn" id="' + g.std + '" onclick="selectRate(\'' + g.std + '\')">'
        + '$' + sp + '</button>';
    } else {
      html += '<span class="ship-rate-na">—</span>';
    }
    html += '</div>';

    /* Guaranteed column */
    html += '<div class="ship-rate-col-gtd">';
    if (g.gtd) {
      var gp = Number((_rateMap[g.gtd].totalCharge)||0).toLocaleString('en-US',{minimumFractionDigits:2});
      html += '<button class="ship-rate-btn ship-rate-btn--gtd" id="' + g.gtd + '" onclick="selectRate(\'' + g.gtd + '\')">'
        + '$' + gp + '</button>';
    } else {
      html += '<span class="ship-rate-na ship-rate-na--gtd">Not available</span>';
    }
    html += '</div>';

    html += '</div>'; /* ship-rate-row */
  });

  document.getElementById('rateList').innerHTML = html;
  document.getElementById('rateList').style.display = '';
}

function selectRate(id) {
  document.querySelectorAll('.ship-rate-btn').forEach(function(b) { b.classList.remove('selected'); });
  var btn = document.getElementById(id);
  if (btn) btn.classList.add('selected');
  _selected = _rateMap[id];
  buildConfirmStep();
  showStep(3);
}

/* ── Step 3: Confirm ──────────────────────────────────────────── */
function buildConfirmStep() {
  var r    = _selected;
  var pt   = getProductType();
  var hus  = getHandlingUnits();
  // Derive labels from the single WWEX enum so this can never drift out of sync
  // with the dropdown again. (The old hardcoded map listed codes — DRM, RLL,
  // OTH — that the dropdown never even offered.)
  var HU_LABEL = {};
  WWEX_PACK_TYPES.forEach(function(t) { HU_LABEL[t.value] = t.label; });

  // ── Carrier / rate header bar
  var html = '<div style="background:#1a2e4a;color:#fff;border-radius:8px;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:14px">'
    + '<div>'
    + '<div style="font-size:1.05rem;font-weight:700">' + (strField(r.carrier)||'Carrier') + '</div>'
    + '<div style="opacity:.75;font-size:.85rem">' + (strField(r.serviceLevel)||strField(r.service)||'Standard') + '</div>'
    + (r.transitDays ? '<div style="opacity:.6;font-size:.78rem;margin-top:2px">' + r.transitDays + ' business day' + (r.transitDays > 1 ? 's' : '') + (r.estimatedDelivery ? ' · Est. ' + r.estimatedDelivery : '') + '</div>' : '')
    + '</div>'
    + '<div style="text-align:right">'
    + '<div style="font-size:1.9rem;font-weight:800">$' + Number(r.totalCharge||0).toLocaleString('en-US',{minimumFractionDigits:2}) + '</div>'
    + '<div style="opacity:.6;font-size:.75rem">' + (pt === 'LTL' ? 'LTL Freight' : 'Small Package') + '</div>'
    + '</div>'
    + '</div>';

  // ── Ship From / Ship To
  function addrCard(label, name, addr1, city, state, zip, phone, email) {
    var lines = [addr1, [city, state, zip].filter(Boolean).join(' ')].filter(Boolean);
    return '<div class="admin-card">'
      + '<div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#718096;margin-bottom:6px">' + label + '</div>'
      + (name ? '<div style="font-weight:700;margin-bottom:3px;font-size:.92rem">' + name + '</div>' : '')
      + '<div style="font-size:.85rem;color:#4a5568;line-height:1.7">' + lines.join('<br>') + '</div>'
      + (phone ? '<div style="font-size:.82rem;color:#718096;margin-top:4px">📞 ' + phone + '</div>' : '')
      + (email ? '<div style="font-size:.82rem;color:#718096">✉ ' + email + '</div>' : '')
      + '</div>';
  }
  var oState = (document.getElementById('orig_state').value||'').toUpperCase();
  var dState = (document.getElementById('dest_state').value||'').toUpperCase();
  html += '<div class="ship-panel-grid" style="margin-bottom:14px">';
  html += addrCard('Ship From', val('orig_company'), val('orig_address1'), val('orig_city'), oState, val('orig_zip'), val('orig_phone'), '');
  html += addrCard('Ship To', val('dest_company')||val('dest_name'), val('dest_address1'), val('dest_city'), dState, val('dest_zip'), val('dest_phone'), val('dest_email'));
  html += '</div>';

  // ── Freight details
  html += '<div class="admin-card" style="margin-bottom:14px">';
  html += '<div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#718096;margin-bottom:8px">Freight Details</div>';
  if (!hus.length) {
    html += '<div style="color:#a0aec0;font-size:.85rem">No handling units found.</div>';
  } else {
    hus.forEach(function(hu, i) {
      var dims = [hu.length, hu.width, hu.height].filter(Boolean).join(' × ');
      html += '<div style="background:#f7fafc;border:1px solid #e2e8f0;border-radius:6px;padding:10px 14px;margin-bottom:8px">';
      html += '<div style="font-weight:700;font-size:.88rem;margin-bottom:5px">'
        + 'HU ' + (i+1) + ' — ' + (hu.count||1) + '× ' + (HU_LABEL[hu.huType]||hu.huType||'Unknown')
        + (dims ? '  <span style="font-weight:400;color:#718096;font-size:.82rem">(' + dims + '")</span>' : '')
        + '  <span style="font-weight:400;color:#4a5568;font-size:.82rem">' + (hu.grossWeight||'?') + ' lbs</span>'
        + (hu.stackable ? '  <span style="font-size:.72rem;background:#EBF8FF;color:#2b6cb0;border-radius:3px;padding:1px 5px">stackable</span>' : '')
        + '</div>';
      if (hu.commodities && hu.commodities.length) {
        hu.commodities.forEach(function(c) {
          html += '<div style="font-size:.82rem;color:#4a5568;margin-left:10px;line-height:1.7">'
            + '• ' + (c.description||'Commodity')
            + (c.freightClass ? ' &nbsp;·&nbsp; Class ' + c.freightClass : '')
            + (c.weight ? ' &nbsp;·&nbsp; ' + c.weight + ' lbs' : '')
            + (c.nmfcCode ? ' &nbsp;·&nbsp; NMFC ' + c.nmfcCode : '')
            + ' &nbsp;·&nbsp; ' + (c.pieces||1) + ' pc'
            + '</div>';
        });
      }
      html += '</div>';
    });
  }
  html += '</div>';

  // ── Services + References/Pickup side by side
  var svcMap = [
    ['acc_insidePickup','Inside Pickup'],['acc_liftgatePickup','Liftgate Pickup'],
    ['acc_residentialPickup','Residential Pickup'],['acc_tradeshowPickup','Tradeshow Pickup'],
    ['acc_constructionPickup','Construction Pickup'],['acc_dropAtTerminal','Drop at Terminal'],
    ['acc_insideDelivery','Inside Delivery'],['acc_liftgateDelivery','Liftgate Delivery'],
    ['acc_residentialDelivery','Residential Delivery'],['acc_tradeshowDelivery','Tradeshow Delivery'],
    ['acc_appointment','Appointment'],['acc_notifyBeforeDelivery','Notify Before Delivery'],
    ['acc_holdAtTerminal','Hold at Terminal'],['acc_sortAndSegregate','Sort & Segregate'],
    ['acc_protectFromFreeze','Protect from Freeze'],
  ];
  var activeSvcs = svcMap.filter(function(s) { return chk(s[0]); });
  var billing = val('ltl_billing') || 'BILL_SHIPPER';
  var billingLabel = { BILL_SHIPPER:'Prepaid (Bill Shipper)', BILL_THIRD_PARTY:'Bill Third Party', BILL_COLLECT:'Collect' };

  html += '<div class="ship-panel-grid">';

  // Services card
  html += '<div class="admin-card">';
  html += '<div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#718096;margin-bottom:8px">Services &amp; Billing</div>';
  if (activeSvcs.length) {
    activeSvcs.forEach(function(s) {
      html += '<div style="font-size:.85rem;color:#276749;margin-bottom:3px">✓ ' + s[1] + '</div>';
    });
  } else {
    html += '<div style="font-size:.85rem;color:#a0aec0">No accessorials selected</div>';
  }
  html += '<div style="font-size:.82rem;color:#718096;margin-top:8px;border-top:1px solid #e2e8f0;padding-top:8px">Billing: ' + (billingLabel[billing]||billing) + '</div>';
  html += '</div>';

  // References + Pickup card
  var today = new Date().toISOString().split('T')[0];
  html += '<div class="admin-card">';
  html += '<div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#718096;margin-bottom:8px">References &amp; Pickup</div>';
  html += '<div style="margin-bottom:5px"><span style="font-size:.78rem;color:#718096">Ref 1: </span><span style="font-weight:600;font-size:.88rem">' + (val('ref1')||'—') + '</span></div>';
  html += '<div style="margin-bottom:12px"><span style="font-size:.78rem;color:#718096">Ref 2: </span><span style="font-weight:600;font-size:.88rem">' + (val('ref2')||'—') + '</span></div>';
  // LTL always shows pickup date; SMALLPACK uses the checkbox section below
  if (pt === 'LTL') {
    /* Pickup Date defaults to the Shipment Date chosen in Step 1, not today.
       WWEX documents that quoteOrderFlow.pickupDate "should align with
       shipmentDate from shopFlow" — rating one date and booking another can
       change transit times and the quoted price. Falls back to today only if
       Step 1 was somehow left blank. */
    var sopDate = val('shipmentDate') || today;
    html += '<div class="adm-field" style="margin-bottom:6px"><label>Pickup Date</label>'
      + '<input id="ltlPickupDate" type="date" class="adm-input" value="' + sopDate + '"></div>';
    html += '<div class="adm-form-grid">';
    html += '<div class="adm-field"><label>Ready Time</label>'
      + '<input id="ltlPickupReady" type="time" class="adm-input" value="' + SOP_READY_TIME + '"></div>';
    html += '<div class="adm-field"><label>Close Time</label>'
      + '<input id="ltlPickupClose" type="time" class="adm-input" value="' + SOP_CLOSE_TIME + '"></div>';
    html += '</div>';
    /* ADDED 2026-08-31 — WWEX quoteOrderFlow accepts three free-text
       instruction fields. Character limits are enforced by the API, so
       maxlength matches exactly: pickup 60, delivery 60, handling 82. */
    /* Pre-filled with the BVO standing note set (see SOP_* constants at the top
       of this script). Staff can overwrite any of them per shipment. */
    html += '<div class="adm-field" style="margin-top:8px"><label>Pickup Instructions <small style="color:#718096;font-weight:400">(max 60)</small></label>'
      + '<input id="ltlPickupInstr" type="text" maxlength="60" class="adm-input" value="' + esc(SOP_PICKUP_INSTRUCTIONS) + '"></div>';
    html += '<div class="adm-field" style="margin-top:6px"><label>Delivery Instructions <small style="color:#718096;font-weight:400">(max 60)</small></label>'
      + '<input id="ltlDeliveryInstr" type="text" maxlength="60" class="adm-input" value="' + esc(SOP_DELIVERY_INSTRUCTIONS) + '"></div>';
    html += '<div class="adm-field" style="margin-top:6px"><label>Handling Instructions <small style="color:#718096;font-weight:400">(max 82)</small></label>'
      + '<input id="ltlHandlingInstr" type="text" maxlength="82" class="adm-input" value="' + esc(SOP_HANDLING_INSTRUCTIONS) + '"></div>';
  }
  html += '</div>';

  html += '</div>'; // /ship-panel-grid

  document.getElementById('confirmBody').innerHTML = html;

  // SMALLPACK-only pickup section
  document.getElementById('pickupSection').style.display = pt === 'SMALLPACK' ? '' : 'none';
}

function togglePickup(checked) {
  document.getElementById('pickupFields').style.display = checked ? '' : 'none';
}

/* ── Book ─────────────────────────────────────────────────────── */
/* ── Carrier notification options ──────────────────────────────────
   WWEX sends these alerts itself, driven by `notificationGroups` on the
   quoteOrderFlow request. Because they are part of the BOOKING request,
   the choices must be made BEFORE the API call — there is no endpoint to
   add notifications to an already-booked shipment. So this panel opens
   on "Confirm & Book" and the booking fires when it is confirmed.

   SOP default: the receiver gets the three progress alerts only.
   BVO staff get nothing here — internal visibility comes from the
   Shipping Dashboard, not carrier email.
─────────────────────────────────────────────────────────────────── */
var NOTIFY_ALERTS = [
  { value:'shipment.shipment_in_transit',      label:'In transit',        on:true  },
  { value:'shipment.shipment_out_for_delivery',label:'Out for delivery',  on:true  },
  { value:'shipment.shipment_delivered',       label:'Delivered',         on:true  },
  { value:'shipment.shipment_pickup_scheduled',label:'Pickup scheduled',  on:false },
  { value:'shipment.shipment_booked',          label:'Booked',            on:false },
  { value:'shipment.exception',                label:'Exception / delay', on:false },
  { value:'shipment.shipment_voided',          label:'Voided',            on:false },
];

function openNotifyPanel() {
  if (!_selected || !_txnId) { alert('Select a rate first.'); return; }
  var email = val('dest_email');

  var html = '<div style="margin-bottom:14px">'
    + '<label class="adm-label">Send carrier tracking alerts to</label>'
    + '<input id="notifyEmail" type="email" class="adm-input" value="' + esc(email) + '" placeholder="customer@example.com">'
    + '<small style="color:#718096;font-size:.75rem">Leave blank to send no alerts. WWEX emails these directly to the receiver.</small>'
    + '</div>'
    + '<div class="adm-label" style="margin-bottom:6px">Alerts</div>'
    + '<div style="display:grid;grid-template-columns:1fr 1fr;gap:2px 14px">';
  NOTIFY_ALERTS.forEach(function(a, i) {
    html += '<label class="ship-check"><input type="checkbox" class="notify-alert" value="' + a.value + '"'
         + (a.on ? ' checked' : '') + '> ' + a.label + '</label>';
  });
  html += '</div>';
  if (!email) {
    html += '<div class="adm-alert adm-alert--error" style="margin-top:10px;font-size:.82rem">'
         + 'No receiver email on this order — alerts will not be sent unless you add one above.</div>';
  }
  /* RESOLVED 2026-08-31 by WWEX support:
       • "Email BOL" — there is NO way to email a BOL through the API. It is
         portal-only. Removed rather than shown as a dead checkbox.
       • "Pallet Label" — not a booking option at all. PALLET_LABEL is a
         docType on documentDownloadFlow, so it is a download available AFTER
         booking, alongside the BOL. Surfaced on the Shipments list instead.
     Neither belongs in this panel. */
  html += '<div style="margin-top:14px;padding-top:12px;border-top:1px solid #e2e8f0;'
       +  'color:#718096;font-size:.75rem;line-height:1.6">'
       +  'The BOL and pallet label are available to download from the Shipments '
       +  'list once booked. WWEX has no API to email a BOL — use the SpeedShip '
       +  'portal if the receiver needs it sent directly.'
       +  '</div>';
  document.getElementById('notifyBody').innerHTML = html;
  document.getElementById('notifyModal').style.display = 'flex';
}
function closeNotifyPanel() {
  document.getElementById('notifyModal').style.display = 'none';
}
/** Read the panel's choices into the shape quoteOrderFlow expects. */
function getNotifyChoices() {
  var email  = val('notifyEmail').trim();
  var alerts = Array.prototype.slice
    .call(document.querySelectorAll('.notify-alert:checked'))
    .map(function(c) { return c.value; });
  if (!email || !alerts.length) return null;
  return { email: email, alerts: alerts };
}

function bookShipment() {
  if (!_selected || !_txnId) { alert('Select a rate first.'); return; }
  // Read the alert choices before the panel closes.
  var _notify = getNotifyChoices();
  closeNotifyPanel();
  // The panel's button is the one actually clicked; fall back to the Step 3
  // button so this still works if bookShipment() is ever called directly.
  var btn = document.getElementById('notifyBookBtn') || document.getElementById('bookBtn');
  btn.disabled    = true;
  btn.textContent = 'Booking…';

  var pt        = getProductType();
  var isLtl     = (pt === 'LTL');
  var schedPick = !isLtl && document.getElementById('schedulePickup') && document.getElementById('schedulePickup').checked;
  // LTL uses dynamically created fields in Step 3 (#ltlPickupDate/Ready/Close).
  // SMALLPACK uses the static #pickupDate/#pickupReady/#pickupClose fields.
  var _pdId    = isLtl ? 'ltlPickupDate'  : 'pickupDate';
  var _prId    = isLtl ? 'ltlPickupReady' : 'pickupReady';
  var _pcId    = isLtl ? 'ltlPickupClose' : 'pickupClose';
  var pickupDate = document.getElementById(_pdId) ? document.getElementById(_pdId).value : '';

  // Build confirmed addresses (non-empty addressLine filter guards against blanks)
  var origAddr = {
    addressLineList: [val('orig_address1')].filter(Boolean),
    locality:    val('orig_city'),
    region:      document.getElementById('orig_state').value.toUpperCase(),
    postalCode:  val('orig_zip'),
    countryCode: 'US',
    companyName: val('orig_company') || 'Shipper',
    phone:       val('orig_phone'),
    contactList: [{
      firstName:   val('orig_company') || 'Shipper',
      lastName:    '',
      phone:       val('orig_phone'),
      contactType: 'SENDER',
    }],
  };
  var destAddr = {
    addressLineList: [val('dest_address1')].filter(Boolean),
    locality:    val('dest_city'),
    region:      document.getElementById('dest_state').value.toUpperCase(),
    postalCode:  val('dest_zip'),
    countryCode: document.getElementById('dest_country').value.toUpperCase() || 'US',
    companyName: val('dest_company') || val('dest_name') || 'Residential',
    phone:       val('dest_phone'),
    contactList: [{
      firstName:   val('dest_name') || val('dest_company') || 'Consignee',
      lastName:    '',
      phone:       val('dest_phone'),
      email:       val('dest_email'),
      contactType: 'RECEIVER',
    }],
  };

  // Merge: start from the full LTL shipment that was rated (handlingUnitList, flags, weights,
  // shipmentDate, etc.) and override the addresses + add references.
  // This ensures quoteOrderFlow receives the exact same shipment data as shopFlow.
  var shipment = Object.assign({}, _shopShipment || {}, {
    originAddress:         { address: origAddr },
    destinationAddress:    { address: destAddr },
    shipmentReferenceList: [
      { type: 'Reference 1', value: val('ref1') },
      { type: 'Reference 2', value: val('ref2') },
    ].filter(function(r) { return r.value; }),
  });

  fetch('/admin/shipping/book', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      productType:          pt,
      // Prefer the productTransactionId belonging to the SELECTED offer.
      // WWEX returns one per offer; _txnId is only a session-level fallback.
      productTransactionId: _selected.productTransactionId || _txnId,
      offerId:              _selected.offerId,              // carrier-level → shipmentOfferId
      // Still sent so the server can record which service level (Standard vs
      // Guaranteed) was picked. NOT forwarded to WWEX — shipmentOfferedProductId
      // does not exist in the V4 API. See SHIPPING_WWEX_BRIEF.md.
      offeredProductId:     _selected.offeredProductId || null,
      carrier:              strField(_selected.carrier),
      serviceLevel:         strField(_selected.serviceLevel) || strField(_selected.service),
      totalCharge:          _selected.totalCharge,
      estimatedDelivery:    _selected.estimatedDelivery || null,
      orderId:              _orderId || null,
      schedulePickup:       schedPick,
      pickupDate:           pickupDate,
      pickupReadyTime:      document.getElementById(_prId) ? document.getElementById(_prId).value + ':00' : '08:00:00',
      pickupCloseTime:      document.getElementById(_pcId) ? document.getElementById(_pcId).value + ':00' : '17:00:00',
      // Free-text instructions — passed straight through to quoteOrderFlow.
      pickupInstructions:   val('ltlPickupInstr'),
      deliveryInstructions: val('ltlDeliveryInstr'),
      handlingInstructions: val('ltlHandlingInstr'),
      // Carrier-sent tracking alerts. Null when no email or no alerts chosen.
      notify:               _notify,
      shipment:             shipment,
    }),
  })
  .then(function(r){ return r.json(); })
  .then(function(d) {
    if (!d.ok) {
      btn.disabled    = false;
      btn.textContent = 'Book Shipment';
      var errMsg = typeof d.error === 'string' ? d.error
        : (d.error && (d.error.clientStatus && d.error.clientStatus.message) || d.error && d.error.message || JSON.stringify(d.error));
      alert('Booking failed: ' + (errMsg || 'Unknown error'));
      return;
    }
    var details = '';
    if (d.bolNumber) details += '<p><strong>BOL #:</strong> ' + d.bolNumber + '</p>';
    if (d.proNumber) details += '<p><strong>PRO #:</strong> ' + d.proNumber + '</p>';
    if (d.pickupConfirmation) details += '<p><strong>Pickup Confirmation:</strong> ' + d.pickupConfirmation + '</p>';
    if (d.stub) details += '<p style="color:#975a16;font-size:.8rem">⚠ Stub booking — no actual shipment created.</p>';
    document.getElementById('successDetails').innerHTML = details;
    if (d.bolUrl) {
      var link = document.getElementById('bolLink');
      link.href = d.bolUrl;
      link.style.display = '';
    }
    showStep('Success');
  })
  .catch(function(e) {
    btn.disabled    = false;
    btn.textContent = 'Book Shipment';
    alert('Error: ' + e.message);
  });
}

/* ── Commodity Picker ─────────────────────────────────────────── */
var COMMODITY_PRESETS = [
  { name:'Top, Sink or Bathroom Vanity W/O', nmfc:'159530-2', cls:'70'   },
  { name:'Top, Sink or Bathroom Vanity',     nmfc:'159530-1', cls:'92.5' },
  { name:'Bathtub PCF Less than 4',          nmfc:'158260',   cls:'300'  },
  { name:'Toilet (1 Unit)',                  nmfc:'158880-1', cls:'300'  },
  { name:'Toilets (More Than 1 Unit)',        nmfc:'158880-3', cls:'250'  },
];
var _activeHU   = null;
var _activeComm = null;
var _filteredPresets = [];

function openCommodityPicker(huN, commN) {
  _activeHU   = huN;
  _activeComm = commN;
  document.getElementById('commoditySearch').value = '';
  renderCommodityList('');
  document.getElementById('commodityModal').style.display = 'flex';
  setTimeout(function(){ document.getElementById('commoditySearch').focus(); }, 50);
}
function closeCommodityPicker() {
  document.getElementById('commodityModal').style.display = 'none';
  _activeHU = _activeComm = null;
}
function filterCommodities() {
  renderCommodityList(document.getElementById('commoditySearch').value);
}
function renderCommodityList(q) {
  _filteredPresets = COMMODITY_PRESETS.filter(function(p) {
    var s = q.toLowerCase();
    return !s || p.name.toLowerCase().indexOf(s) !== -1 || p.nmfc.indexOf(s) !== -1 || p.cls.indexOf(s) !== -1;
  });
  var html = _filteredPresets.map(function(p, i) {
    return '<tr class="comm-row" onclick="applyCommodity(' + i + ')">'
      + '<td class="comm-td">' + p.name + '</td>'
      + '<td class="comm-td comm-td--num">' + p.cls + '</td>'
      + '<td class="comm-td comm-td--num">' + p.nmfc + '</td>'
      + '<td class="comm-td" style="text-align:right"><button type="button" class="btn btn-sm btn-outline" style="font-size:.75rem;pointer-events:none">Select</button></td>'
      + '</tr>';
  }).join('');
  document.getElementById('commodityList').innerHTML = html
    || '<tr><td colspan="4" style="text-align:center;color:#718096;padding:24px">No matches</td></tr>';
}
function applyCommodity(i) {
  var preset = _filteredPresets[i];
  if (!preset || _activeHU === null) return;
  var commRow = document.getElementById('comm-' + _activeHU + '-' + _activeComm);
  if (!commRow) return;
  var descEl = commRow.querySelector('.comm-desc');
  var nmfcEl = commRow.querySelector('.comm-nmfc');
  var clsEl  = commRow.querySelector('.comm-class');
  if (descEl) descEl.value = preset.name;
  if (nmfcEl) nmfcEl.value = preset.nmfc;
  if (clsEl) {
    for (var j = 0; j < clsEl.options.length; j++) {
      if (clsEl.options[j].value === preset.cls || clsEl.options[j].text === preset.cls) {
        clsEl.selectedIndex = j; break;
      }
    }
  }
  closeCommodityPicker();
}

</script>

