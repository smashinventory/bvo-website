.ship-rate-meta    { font-size:.8rem;color:#718096;display:flex;gap:12px;flex:1;justify-content:center }
.ship-rate-price   { font-size:1.15rem;font-weight:700;color:#1a2e4a;white-space:nowrap }

.ship-spinner { width:28px;height:28px;border:3px solid #e2e8f0;border-top-color:#1a2e4a;border-radius:50%;animation:spin .7s linear infinite;margin:0 auto }
@keyframes spin { to { transform:rotate(360deg) } }

.ship-acc-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px;margin-top:8px }
.ship-acc-section { display:flex;flex-direction:column;gap:5px }
.ship-acc-label { font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#4a5568;margin-bottom:4px;border-bottom:1px solid #e2e8f0;padding-bottom:4px }

@media(max-width:700px) {
  .ship-panel-grid { grid-template-columns:1fr }
  .ship-full-col   { grid-column:1 }
}
</style>
