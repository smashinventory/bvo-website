<link rel="stylesheet" href="/css/site3.css?v=31"><!-- site3: injected per-page (perf) -->
<%/* Inspiration Guide — /inspiration/:slug */%>
<div class="inspo-guide-wrap">

  <div class="inspo-guide-container">

    <%/* ── Structured data ────────────────────────────────────────────
         OnlineStore + WebSite + WebPage + BreadcrumbList + Article, built
         by src/utils/structuredData.js and passed in by
         inspirationController.

         ⚠️ EMITTED HERE, IN THE VIEW, NOT AS THE `script` LOCAL. This
         page previously passed its Article JSON-LD to res.render as
         `script:`, and it NEVER REACHED THE PAGE: express-ejs-layouts
         runs with `layout extractScripts` enabled (server.js:504) and
         sets locals.script = '' before refilling it from <script> tags
         found in this rendered output. A controller's value is thrown
         away. That is why an SEO audit of these pages reported no
         structured data at all.

         The BreadcrumbList below mirrors the visible trail immediately
         following this block - same three crumbs, same order. Google
         requires markup to match visible content. */%>
    <% if (typeof jsonLd !== 'undefined' && jsonLd) { %><%- jsonLd %><% } %>

    <%/* Breadcrumb */%>
    <nav class="inspo-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="inspo-breadcrumb-sep" aria-hidden="true">›</span>
      <a href="/inspiration">Inspiration</a>
      <span class="inspo-breadcrumb-sep" aria-hidden="true">›</span>
      <span aria-current="page"><%= page.title %></span>
    </nav>

    <%/* ── Full-bleed hero (shown when og_image is set) ────────────── */%>
    <% if (page.og_image) { %>
    <div class="inspo-hero">
      <%/* ⚠️ alt="" IS DELIBERATE, not an omission.
           This used to echo the page title, which is a verbatim copy of
           the h1 directly below it. A screen reader then announces the
           same sentence twice in a row - the documented anti-pattern -
           and it tells a sighted user nothing either.

           The honest options were: describe the photograph, or mark it
           decorative. Nothing in the database describes these images, and
           inventing a description of a picture nobody has looked at is
           worse than silence. The heading immediately after carries the
           meaning, so decorative is correct.

           THE TRADE-OFF, stated: an empty alt forgoes Google Images
           value. If that is wanted, the fix is an og_image_alt column and
           a real sentence per guide - ten of them. Not a template change,
           so it is not smuggled in here.

           (This comment originally spelled the old EJS tag out in full,
           which closed the comment early and broke the template. An EJS
           comment cannot contain an EJS tag. Ninth instance of that trap
           in this codebase today, and the fifth I have written myself.) */%>
      <img class="inspo-hero-img" src="<%= page.og_image %>" alt="" loading="eager" width="1200" height="630">
      <div class="inspo-hero-overlay" aria-hidden="true"></div>
      <div class="inspo-hero-text">
        <span class="inspo-eyebrow">Inspiration Guide</span>
        <h1 class="inspo-hero-title"><%= page.title %></h1>
        <div class="inspo-guide-meta">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <%= page.readTime %> min read
        </div>
      </div>
    </div>
    <% } %>

    <div class="inspo-guide-layout">

      <%/* Main content */%>
      <main class="inspo-guide-main">

        <%/* Editorial header — shown when NO hero image */%>
        <% if (!page.og_image) { %>
        <div class="inspo-guide-header-plain">
          <span class="inspo-eyebrow">Inspiration Guide</span>
          <h1 class="inspo-guide-title"><%= page.title %></h1>
          <div class="inspo-guide-meta">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <%= page.readTime %> min read
          </div>
        </div>
        <% } else { %>
        <%/* When hero shows the title, still add reading time above content */%>
        <div class="inspo-guide-meta inspo-guide-meta--after-hero">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <%= page.readTime %> min read
        </div>
        <% } %>

        <%/* ── BYLINE ──────────────────────────────────────────────────
             Above the content, not below it. The point of a byline is to
             tell the reader who is talking BEFORE they decide whether to
             trust the advice; at the foot of the page it is a footnote.

             Rendered only when the guide has an author, so a page written
             before the authors migration ran shows nothing rather than an
             empty row. The date is shown only when the column holds one -
             an invented date claims a maintenance history that does not
             exist. */%>
        <% if (page.author) { %>
        <div class="inspo-byline">
          <% if (page.author.image_base) { %>
          <a class="inspo-byline-photo-link" href="/authors/<%= page.author.slug %>" aria-hidden="true" tabindex="-1">
            <picture>
              <source type="image/webp" srcset="<%= page.author.image_base %>-160.webp">
              <img class="inspo-byline-photo" src="<%= page.author.image_base %>-160.png"
                   alt="" width="44" height="44" loading="lazy" decoding="async">
            </picture>
          </a>
          <% } %>
          <div class="inspo-byline-text">
            <p class="inspo-byline-name">
              By <a href="/authors/<%= page.author.slug %>" rel="author"><%= page.author.name %></a>
            </p>
            <% if (page.author.credential) { %>
            <p class="inspo-byline-cred"><%= page.author.credential %></p>
            <% } %>
            <% if (page.publishedLabel || page.updatedLabel) { %>
            <p class="inspo-byline-dates">
              <% if (page.publishedLabel) { %><span>Published <%= page.publishedLabel %></span><% } %>
              <% if (page.updatedLabel) { %><span>Updated <%= page.updatedLabel %></span><% } %>
            </p>
            <% } %>
          </div>
        </div>
        <% } %>

        <%/* Article body */%>
        <div class="inspo-guide-content">
          <%- page.content %>
        </div>

        <%/* ── Social Share Bar ──────────────────────────────────── */%>
        <%# ONE definition — views/partials/social-share.ejs. Was duplicated
            here and in product.ejs, each copy gating its buttons on whether
            BVO owns a profile on that network, which silently disabled
            LinkedIn sharing everywhere. See the partial. %>
        <%- include('../partials/social-share', {
              shareLabel: 'Share this guide',
              shareImage: (typeof page !== 'undefined' && page && page.og_image) ? page.og_image : ''
            }) %>

        <%/* ── Product showcase ─────────────────────────────────── */%>
        <% if (shopProducts && shopProducts.length) { %>
        <section class="inspo-shop-showcase" aria-label="Shop <%= shopLabel %> vanities">
          <div class="inspo-shop-showcase-header">
            <span class="inspo-eyebrow">Shop the Look</span>
            <h2 class="inspo-shop-showcase-title"><%= shopLabel %> Bathroom Vanities</h2>
          </div>
          <div class="inspo-shop-grid">
            <% shopProducts.forEach(function(p) { %>
            <a href="/products/<%= p.slug %>" class="inspo-shop-card">
              <div class="inspo-shop-card-img-wrap">
                <% if (p.primary_image) { %>
                <img src="<%= p.primary_image %>?width=640" alt="<%= p.name %>" class="inspo-shop-card-img" loading="lazy" width="320" height="280">
                <% } else { %>
                <div class="inspo-shop-card-img-placeholder"></div>
                <% } %>
                <% if (p.compare_price && p.compare_price > p.price) { %>
                <span class="inspo-shop-badge">Sale</span>
                <% } %>
              </div>
              <div class="inspo-shop-card-body">
                <% if (p.brand) { %><span class="inspo-shop-card-brand"><%= p.brand %></span><% } %>
                <span class="inspo-shop-card-name"><%= p.name %></span>
                <div class="inspo-shop-card-price-row">
                  <span class="inspo-shop-card-price">$<%= p.price.toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0}) %></span>
                  <% if (p.compare_price && p.compare_price > p.price) { %>
                  <span class="inspo-shop-card-compare">$<%= p.compare_price.toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0}) %></span>
                  <% } %>
                </div>
              </div>
            </a>
            <% }) %>
          </div>
          <div class="inspo-shop-showcase-footer">
            <a href="<%= shopCollectionUrl %>" class="inspo-shop-all-btn">
              View All <%= shopLabel %> Vanities
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </section>
        <% } %>

      </main>

      <%/* Sidebar */%>
      <aside class="inspo-guide-sidebar">

        <div class="inspo-sidebar-card">
          <p class="inspo-sidebar-card-label">Shop Vanities</p>
          <p class="inspo-sidebar-card-text">Free shipping on every order. Premium quality at outlet prices.</p>
          <a href="/collections/bathroom-vanities" class="inspo-sidebar-btn">Browse Vanities</a>
        </div>

        <div class="inspo-sidebar-card">
          <p class="inspo-sidebar-card-label">Complete the Look</p>
          <ul class="inspo-sidebar-links">
            <li><a href="/collections/bathroom-mirrors">Bathroom Mirrors</a></li>
            <li><a href="/collections/faucets">Faucets</a></li>
            <li><a href="/collections/accessories">Accessories</a></li>
            <li><a href="/bundle-builder">Bundle Builder</a></li>
          </ul>
        </div>

        <% if (related && related.length > 0) { %>
        <div class="inspo-sidebar-card">
          <p class="inspo-sidebar-card-label">More Inspiration</p>
          <ul class="inspo-sidebar-links">
            <% related.forEach(function(r) { %>
            <li><a href="/inspiration/<%= r.slug %>"><%= r.title %></a></li>
            <% }) %>
          </ul>
        </div>
        <% } %>

      </aside>
    </div>

    <%/* Related guides strip */%>
    <% if (related && related.length > 0) { %>
    <section class="inspo-related">
      <h2 class="inspo-related-title">More Guides You May Like</h2>
      <div class="inspo-related-grid">
        <% related.forEach(function(r) { %>
        <a href="/inspiration/<%= r.slug %>" class="inspo-card<%= r.og_image ? ' inspo-card--img' : '' %>">
          <% if (r.og_image) { %>
          <div class="inspo-card-img-wrap">
            <img src="<%= r.og_image %>" alt="<%= r.title %>" class="inspo-card-img" loading="lazy" width="400" height="240">
          </div>
          <% } %>
          <div class="inspo-card-body">
            <span class="inspo-card-title"><%= r.title %></span>
            <% if (r.meta_desc) { %>
            <span class="inspo-card-desc"><%= r.meta_desc.substring(0, 90) + (r.meta_desc.length > 90 ? '…' : '') %></span>
            <% } %>
            <span class="inspo-card-arrow">Read guide →</span>
          </div>
        </a>
        <% }) %>
      </div>
    </section>
    <% } %>

  </div>
</div>
