<link rel="stylesheet" href="/css/site3.css?v=16"><!-- site3: injected per-page (perf) -->
<%/* Inspiration Guide — /inspiration/:slug */%>
<div class="inspo-guide-wrap">

  <div class="inspo-guide-container">

    <%/* Breadcrumb */%>
    <nav class="inspo-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="inspo-breadcrumb-sep" aria-hidden="true">›</span>
      <a href="/inspiration">Inspiration</a>
      <span class="inspo-breadcrumb-sep" aria-hidden="true">›</span>
      <span aria-current="page"><%= page.title %></span>
    </nav>

    <%/* ── Full-bleed hero (shown when og_image is set) ────────────── */%>
    <% if (page.og_image) { %>
    <div class="inspo-hero">
      <img class="inspo-hero-img" src="<%= page.og_image %>" alt="<%= page.title %>" loading="eager" width="1200" height="630">
      <div class="inspo-hero-overlay" aria-hidden="true"></div>
      <div class="inspo-hero-text">
        <span class="inspo-eyebrow">Inspiration Guide</span>
        <h1 class="inspo-hero-title"><%= page.title %></h1>
        <div class="inspo-guide-meta">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <%= page.readTime %> min read
        </div>
      </div>
    </div>
    <% } %>

    <div class="inspo-guide-layout">

      <%/* Main content */%>
      <main class="inspo-guide-main">

        <%/* Editorial header — shown when NO hero image */%>
        <% if (!page.og_image) { %>
        <div class="inspo-guide-header-plain">
          <span class="inspo-eyebrow">Inspiration Guide</span>
          <h1 class="inspo-guide-title"><%= page.title %></h1>
          <div class="inspo-guide-meta">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <%= page.readTime %> min read
          </div>
        </div>
        <% } else { %>
        <%/* When hero shows the title, still add reading time above content */%>
        <div class="inspo-guide-meta inspo-guide-meta--after-hero">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <%= page.readTime %> min read
        </div>
        <% } %>

        <%/* Article body */%>
        <div class="inspo-guide-content">
          <%- page.content %>
        </div>

        <%/* ── Social Share Bar ──────────────────────────────────── */%>
        <%
          var _isocSrc = settings && settings.social ? settings.social : {};
          var _iHasSoc = _isocSrc.facebook_url || _isocSrc.instagram_url || _isocSrc.twitter_url || _isocSrc.pinterest_url || _isocSrc.linkedin_url;
        %>
        <% if (_iHasSoc) { %>
        <div class="social-share-bar" aria-label="Share this guide">
          <span class="social-share-label">Share</span>
          <div class="social-share-icons">
            <%
              var _iShareUrl  = encodeURIComponent(canonicalUrl || '');
              var _iShareText = encodeURIComponent(page.title + ' – BathroomVanitiesOutlet.com');
              var _iShareImg  = encodeURIComponent(page.og_image || '');
            %>
            <% if (_isocSrc.pinterest_url) { %>
            <a href="https://pinterest.com/pin/create/button/?url=<%- _iShareUrl %>&media=<%- _iShareImg %>&description=<%- _iShareText %>"
               class="social-share-btn social-share-btn--pinterest" target="_blank" rel="noopener noreferrer" aria-label="Pin on Pinterest">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            </a>
            <% } %>
            <% if (_isocSrc.facebook_url) { %>
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%- _iShareUrl %>"
               class="social-share-btn social-share-btn--facebook" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.268h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
            </a>
            <% } %>
            <% if (_isocSrc.twitter_url) { %>
            <a href="https://twitter.com/intent/tweet?url=<%- _iShareUrl %>&text=<%- _iShareText %>"
               class="social-share-btn social-share-btn--twitter" target="_blank" rel="noopener noreferrer" aria-label="Share on X">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <% } %>
            <% if (_isocSrc.linkedin_url) { %>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%- _iShareUrl %>"
               class="social-share-btn social-share-btn--linkedin" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <% } %>
            <% if (_isocSrc.instagram_url) { %>
            <a href="<%= _isocSrc.instagram_url %>"
               class="social-share-btn social-share-btn--instagram" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Instagram">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
            </a>
            <% } %>
          </div>
        </div>
        <% } %>

        <%/* ── Product showcase ─────────────────────────────────── */%>
        <% if (shopProducts && shopProducts.length) { %>
        <section class="inspo-shop-showcase" aria-label="Shop <%= shopLabel %> vanities">
          <div class="inspo-shop-showcase-header">
            <span class="inspo-eyebrow">Shop the Look</span>
            <h2 class="inspo-shop-showcase-title"><%= shopLabel %> Bathroom Vanities</h2>
          </div>
          <div class="inspo-shop-grid">
            <% shopProducts.forEach(function(p) { %>
            <a href="/products/<%= p.slug %>" class="inspo-shop-card">
              <div class="inspo-shop-card-img-wrap">
                <% if (p.primary_image) { %>
                <img src="<%= p.primary_image %>" alt="<%= p.name %>" class="inspo-shop-card-img" loading="lazy" width="320" height="280">
                <% } else { %>
                <div class="inspo-shop-card-img-placeholder"></div>
                <% } %>
                <% if (p.compare_price && p.compare_price > p.price) { %>
                <span class="inspo-shop-badge">Sale</span>
                <% } %>
              </div>
              <div class="inspo-shop-card-body">
                <% if (p.brand) { %><span class="inspo-shop-card-brand"><%= p.brand %></span><% } %>
                <span class="inspo-shop-card-name"><%= p.name %></span>
                <div class="inspo-shop-card-price-row">
                  <span class="inspo-shop-card-price">$<%= p.price.toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0}) %></span>
                  <% if (p.compare_price && p.compare_price > p.price) { %>
                  <span class="inspo-shop-card-compare">$<%= p.compare_price.toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0}) %></span>
                  <% } %>
                </div>
              </div>
            </a>
            <% }) %>
          </div>
          <div class="inspo-shop-showcase-footer">
            <a href="<%= shopCollectionUrl %>" class="inspo-shop-all-btn">
              View All <%= shopLabel %> Vanities
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </section>
        <% } %>

      </main>

      <%/* Sidebar */%>
      <aside class="inspo-guide-sidebar">

        <div class="inspo-sidebar-card">
          <p class="inspo-sidebar-card-label">Shop Vanities</p>
          <p class="inspo-sidebar-card-text">Free shipping on every order. Premium quality at outlet prices.</p>
          <a href="/collections/bathroom-vanities" class="inspo-sidebar-btn">Browse Vanities</a>
        </div>

        <div class="inspo-sidebar-card">
          <p class="inspo-sidebar-card-label">Complete the Look</p>
          <ul class="inspo-sidebar-links">
            <li><a href="/collections/bathroom-mirrors">Bathroom Mirrors</a></li>
            <li><a href="/collections/faucets">Faucets</a></li>
            <li><a href="/collections/accessories">Accessories</a></li>
            <li><a href="/bundle-builder">Bundle Builder</a></li>
          </ul>
        </div>

        <% if (related && related.length > 0) { %>
        <div class="inspo-sidebar-card">
          <p class="inspo-sidebar-card-label">More Inspiration</p>
          <ul class="inspo-sidebar-links">
            <% related.forEach(function(r) { %>
            <li><a href="/inspiration/<%= r.slug %>"><%= r.title %></a></li>
            <% }) %>
          </ul>
        </div>
        <% } %>

      </aside>
    </div>

    <%/* Related guides strip */%>
    <% if (related && related.length > 0) { %>
    <section class="inspo-related">
      <h2 class="inspo-related-title">More Guides You May Like</h2>
      <div class="inspo-related-grid">
        <% related.forEach(function(r) { %>
        <a href="/inspiration/<%= r.slug %>" class="inspo-card<%= r.og_image ? ' inspo-card--img' : '' %>">
          <% if (r.og_image) { %>
          <div class="inspo-card-img-wrap">
            <img src="<%= r.og_image %>" alt="<%= r.title %>" class="inspo-card-img" loading="lazy" width="400" height="240">
          </div>
          <% } %>
          <div class="inspo-card-body">
            <span class="inspo-card-title"><%= r.title %></span>
            <% if (r.meta_desc) { %>
            <span class="inspo-card-desc"><%= r.meta_desc.substring(0, 90) + (r.meta_desc.length > 90 ? '…' : '') %></span>
            <% } %>
            <span class="inspo-card-arrow">Read guide →</span>
          </div>
        </a>
        <% }) %>
      </div>
    </section>
    <% } %>

  </div>
</div>
