  <!-- CSRF: patch fetch to include token on all non-GET requests -->
  <script nonce="<%= cspNonce %>">
  (function(){
    var _f = window.fetch;
    window.fetch = function(url, opts){
      opts = opts || {};
      if (!opts.method || opts.method.toUpperCase() === 'GET') return _f(url, opts);
      opts.headers = opts.headers || {};
      var t = document.querySelector('meta[name="csrf-token"]');
      if (t) opts.headers['X-CSRF-Token'] = t.content;
      return _f(url, opts);
    };
  })();
  </script>

  <script nonce="<%= cspNonce %>" src="/js/site.js"></script>
  <script nonce="<%= cspNonce %>">
    // Sidebar toggle (mobile)
    document.getElementById('adminMenuToggle')?.addEventListener('click', () => {
      document.getElementById('adminSidebar').classList.toggle('open');
    });
  </script>

  <script nonce="<%= cspNonce %>">
  (function() {
    // ── Accordion sidebar ────────────────────────────────────
    var PAGE_GROUP = {
      'products':        'products',
      'categories':      'products',
      'models':          'products',
      'color-report':    'products',
      'orders':          'orders',
      'returns':         'orders',
      'shipments':       'orders',
      'reports':         'orders',
      'theme':           'website',
      'pages':           'website',
      'blog':            'website',
      'menus':           'website',
      'inspiration':     'website',
      'email-templates': 'settings'
    };

    var activePage  = '<%= typeof activePage !== "undefined" ? activePage : "" %>';
    var activeGroup = PAGE_GROUP[activePage] || null;

    // Saved manual-toggle state from localStorage
    var saved = {};
    try { saved = JSON.parse(localStorage.getItem('bvo_nav_open') || '{}'); } catch(e) {}

    document.querySelectorAll('.nav-group').forEach(function(group) {
      var key = group.dataset.group;
      var btn = group.querySelector('.nav-group-btn');

      // Open if: it's the active group OR user manually opened it last session
      // But keep closed if user manually closed the active group
      var isActive    = (key === activeGroup);
      var savedState  = saved.hasOwnProperty(key) ? saved[key] : null;

      // Active group always opens by default unless explicitly closed by user
      if (savedState === true || (isActive && savedState !== false)) {
        group.classList.add('open');
      }

      btn.addEventListener('click', function() {
        var isOpen = group.classList.toggle('open');
        saved[key] = isOpen;
        try { localStorage.setItem('bvo_nav_open', JSON.stringify(saved)); } catch(e) {}
      });
    });
  })();
  </script>
  <%- script %>

</body>
</html>
