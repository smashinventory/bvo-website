<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600&family=Lato:wght@300;400;700;900&display=swap" rel="stylesheet">

  <!-- Brand tokens -->
  <link rel="stylesheet" href="/css/brand.css">
  <!-- Admin CSS (appended to site.css) -->
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/site4.css">

  <%- style %>
  <meta name="csrf-token" content="<%= csrfToken %>">

  <style>
    /* ── Accordion Sidebar ──────────────────────────────────── */
    .nav-group { margin-bottom: 2px; }

    .nav-group-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 10px 12px;          /* exact match to .admin-nav-item */
      background: none;
      border: none;
      border-radius: 7px;          /* exact match to .admin-nav-item */
      cursor: pointer;
      font-family: inherit;
      font-size: .82rem;           /* exact match */
      font-weight: 700;            /* exact match */
      letter-spacing: .04em;       /* exact match */
      text-transform: uppercase;   /* exact match */
      color: rgba(255,255,255,.65); /* exact match */
      text-align: left;
      transition: background var(--transition-fast), color var(--transition-fast);
    }
    .nav-group-btn:hover { background: rgba(255,255,255,.08); color: #fff; }
    .nav-group.open .nav-group-btn { color: #fff; }

    .nav-group-left {
      display: flex;
      align-items: center;
      gap: 10px;                   /* exact match to .admin-nav-item gap */
    }

    .nav-chevron {
      width: 13px;
      height: 13px;
      flex-shrink: 0;
      transition: transform .22s ease;
      opacity: .5;
    }
    .nav-group.open .nav-chevron { transform: rotate(180deg); opacity: .85; }

    .nav-group-items {
      overflow: hidden;
      max-height: 0;
      transition: max-height .28s ease;
    }
    .nav-group.open .nav-group-items { max-height: 500px; }

    /* Child items indented past the group header icon */
    .admin-nav-item--child {
      padding-left: 38px !important;
    }

    .nav-coming-soon {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px 8px 38px;
      font-size: .78rem;
      font-weight: 600;
      letter-spacing: .04em;
      text-transform: uppercase;
      color: rgba(255,255,255,.3);
      cursor: default;
    }

    .admin-nav-disabled {
      opacity: .35;
      pointer-events: none;
      cursor: default;
    }
  </style>
</head>
