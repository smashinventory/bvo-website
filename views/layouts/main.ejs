  <!-- CSRF: patch fetch to include token on all non-GET requests -->
  <script nonce="<%= cspNonce %>">
  (function(){
    var _f = window.fetch;
    window.fetch = function(url, opts){
      opts = opts || {};
      if (!opts.method || opts.method.toUpperCase() === 'GET') return _f(url, opts);
      opts.headers = opts.headers || {};
      var t = document.querySelector('meta[name="csrf-token"]');
      if (t) opts.headers['X-CSRF-Token'] = t.content;
      return _f(url, opts);
    };
  })();
  </script>

