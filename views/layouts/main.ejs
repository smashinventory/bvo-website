<%
/* ── Build dynamic Google Fonts URL ───────────────────────────── */
const _d      = (settings && settings.design) ? settings.design : {};
const _seo    = (settings && settings.seo)    ? settings.seo    : {};
const _colors = _d.colors || {};
const _hFont  = _d.heading_font || 'Lora';
const _bFont  = _d.body_font    || 'Lato';
const _baseSize = parseInt(_d.base_size_px) || 16;
const _hWeight  = _d.heading_weight || '600';
const _btnR     = _d.button_radius  || '6px';
const _cardR    = _d.card_radius    || '12px';

// Build Google Fonts family string
const _fontFamilies = [...new Set([_hFont, _bFont])];
const _gfQuery = _fontFamilies.map(f => {
  const enc = encodeURIComponent(f);
  return `family=${enc}:ital,wght@0,300;0,400;0,600;0,700;1,400`;
}).join('&');
const _gfUrl = `https://fonts.googleapis.com/css2?${_gfQuery}&display=optional`;

// CSS color overrides — validate hex before injecting into <style> block (MED-3)
const _hexRe = /^#[0-9a-fA-F]{3}$|^#[0-9a-fA-F]{6}$/;
function _safeColor(val, def) { return (val && _hexRe.test(val.trim())) ? val.trim() : def; }
const _navyC   = _safeColor(_colors.navy,    '#182840');
const _amberC  = _safeColor(_colors.amber,   '#926A21');
const _sageC   = _safeColor(_colors.sage,    '#5A7A5A');
const _whisperC= _safeColor(_colors.whisper, '#F8F6F2');
const _whiteC  = _safeColor(_colors.white,   '#FFFFFF');

// SEO
const _pageTitle = typeof pageTitle !== 'undefined' && pageTitle
                 ? pageTitle : (_seo.home_title || 'BathroomVanitiesOutlet.com');
const _metaDesc  = typeof metaDesc !== 'undefined' && metaDesc
                 ? metaDesc : (_seo.home_description || '');
const _ogImg     = _seo.og_image || '/images/og-default.jpg';
const _ogTitle   = (typeof ogTitle !== 'undefined' && ogTitle) ? ogTitle : (_seo.og_title || _pageTitle);
const _ogDesc    = (typeof ogDesc  !== 'undefined' && ogDesc)  ? ogDesc  : (_seo.og_description || _metaDesc);
const _siteName  = (settings && settings.global) ? (settings.global.site_name || 'BathroomVanitiesOutlet.com') : 'BathroomVanitiesOutlet.com';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <%/* CSP as a meta tag - see CSP_DIRECTIVES in src/server.js for why. Must be
       the first thing after charset: a meta policy only governs what comes
       after it. Empty (not rendered) unless the rollout switch is on. */%>
  <% if (typeof cspMeta !== 'undefined' && cspMeta) { %><meta http-equiv="Content-Security-Policy" content="<%= cspMeta %>"><% } %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- SEO -->
  <title><%= _pageTitle %></title>
  <meta name="description" content="<%= _metaDesc %>">

  <!-- Canonical + robots -->
  <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <% } %>
  <% if (typeof noindex !== 'undefined' && noindex) { %>
  <meta name="robots" content="noindex,follow">
  <% } %>

  <!-- Sitemap discovery -->
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <!-- Favicon + touch icon -->
  <link rel="icon" type="image/png" sizes="512x512" href="/images/logos/BVOLOGOSQ_512.png">
  <link rel="apple-touch-icon" href="/images/logos/BVOLOGOSQ_512.png">

  <!-- Open Graph -->
  <meta property="og:title"       content="<%= _ogTitle %>">
  <meta property="og:description" content="<%= _ogDesc %>">
  <meta property="og:image"       content="<%= _ogImg %>">
  <meta property="og:image:alt"   content="<%= _seo.og_image_alt || _pageTitle %>">
  <meta property="og:type"        content="<% if (typeof product !== 'undefined' && product) { %>product<% } else { %>website<% } %>">
  <meta property="og:url"         content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : '' %>">
  <meta property="og:site_name"   content="<%= _siteName %>">
  <meta name="twitter:card"       content="summary_large_image">

  <!-- Google Fonts: preconnect + async load. The URL carries display=optional, not swap:
       optional gives the font one short block period and then keeps the fallback for
       this page view, which is why CLS is 0. Do not "fix" this comment back to swap. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Bunny pull zone: serves the hero + every product and category image.
       Largest origin on the page by bytes; it had no hint while fonts had two. -->
  <link rel="preconnect" href="https://images.bathroomvanitiesoutlet.com">
  <%/* Non-blocking font CSS WITHOUT an inline onload="" attribute (the CSP's
       script-src-attr 'none' blocks those). rel=preload keeps the fetch at HIGH
       priority; the nonced script swaps it to a stylesheet when it arrives.

       Do NOT "simplify" this to <link rel=stylesheet media=print>: that was
       tried on 2026-09-21 and browsers fetch print stylesheets at the LOWEST
       priority. A/B on the live page under Moto G / Slow 4G throttling, 7 runs
       each: font CSS arrived at ~1,280 ms with media=print vs ~310 ms with
       preload, costing roughly 0.3-0.6 s of LCP.

       The listener is attached synchronously right after the link is parsed,
       and a load event always fires as a later task, so it cannot be missed. */%>
  <link rel="preload" href="<%- _gfUrl %>" as="style" id="gf-css">
  <script nonce="<%= cspNonce %>">(function(l){if(!l)return;l.addEventListener('load',function(){l.rel='stylesheet';});})(document.getElementById('gf-css'));</script>
  <noscript><link href="<%- _gfUrl %>" rel="stylesheet"></noscript>

  <!-- CSS bundle: brand.css + site.css + site2.css concatenated into one file.
       One blocking request instead of three — eliminates 2 extra HTTP round trips on critical path.
       SOURCE FILES: public/css/brand.css, site.css, site2.css (edit these, then rebuild).
       REBUILD: DO NOT run a plain `cat brand.css site.css site2.css`.
       Verified 2026-09-06: site-bundle.css is brand + site + site2 PLUS the
       first 7984 bytes of site4.css -- the public responsive polish
       (checkout, PDP chips, nav touch targets). The rest of site4.css is
       admin-only and is loaded separately by layouts/admin.ejs. A plain cat
       silently drops those 7984 bytes from every public page.
         cat brand.css site.css site2.css > site-bundle.css
         head -c 7984 site4.css >> site-bundle.css   # was 8039 before 2026-09-23

       ** THIS RECIPE DOES NOT REPRODUCE THE FILE ON DISK. ** Measured
       2026-09-23: site4.css's first 7984 bytes do appear in the bundle,
       starting at offset 114503 -- but 4917 further bytes follow them
       that the recipe does not account for. Run the recipe as written
       and you lose those 4917 bytes. The discrepancy predates the
       2026-09-23 alignment change (it was 8043/4917 before). Do not
       rebuild from this recipe until someone works out what the tail
       is -- patch site4.css and site-bundle.css with the same edit
       instead, which is what 2026-09-23 did. Logged in OPEN_ITEMS.
       Better: patch site.css and site-bundle.css with the same edit and do
       not concatenate at all.
       Bump ?v= any time any source CSS changes to bust Hostinger CDN cache (CLAUDE.md Rule 5).

       CORRECTED 2026-08-31 — this comment previously listed site4.css as part
       of the bundle and told you to cat it in. That is WRONG. site4.css is
       ADMIN-ONLY and is loaded separately by views/layouts/admin.ejs. Adding
       it here ships ~23KB of admin CSS to every public visitor and grows the
       bundle from 121KB to 137KB for no benefit. Do not add it. -->
  <link rel="stylesheet" href="/css/site-bundle.css?v=14">
  <!-- site3.css: Trust signals, checkout, CMS pages, blog, inspiration guides -->
  <!-- Loaded conditionally per-page via <%- style %> slot — not global (perf: saves 37KB blocking CSS on homepage/collections/products) -->

  <!-- Design tokens: CSS var aliases resolved before external CSS (prevents cascade gaps) -->
  <style>
    :root {
      /* Brand palette — editable in Admin > Theme */
      --color-navy:    <%= _navyC %>;
      --color-amber:   <%= _amberC %>;
      --color-sage:    <%= _sageC %>;
      --color-whisper: <%= _whisperC %>;
      --color-white:   <%= _whiteC %>;
      /* Short aliases (also defined at EOF of site.css — pre-defining here
         ensures they resolve even before site.css finishes parsing) */
      --navy:      <%= _navyC %>;
      --amber:     <%= _amberC %>;
      --sage:      <%= _sageC %>;
      --whisper:   <%= _whisperC %>;
      --white:     <%= _whiteC %>;
      --muted:     #787063;
      --border:    #E8E4DC;
      --hero-bg:   #FAF7F2;
      --sage-deep: #486854;
      --sage-light:#DCF0E2;
      --navy-deep: #101828;
      /* Derived tokens brand.css references */
      --color-sage-deep:    #486854;
      --color-navy-deep:    #101828;
      --color-whisper-hero: #FAF7F2;
      --text-muted:         #787063;
      --border-card:        #E8E4DC;
      --bg-promo:           <%= _navyC %>;
      /* Typography + layout */
      --font-serif: '<%= _hFont %>', Georgia, serif;
      --font-sans:  '<%= _bFont %>', system-ui, sans-serif;
      --base-size:  <%= _baseSize %>px;
      --h-weight:   <%= _hWeight %>;
      --radius-btn:  <%= _btnR %>;
      --radius-card: <%= _cardR %>;
    }
    html { font-size: <%= _baseSize %>px; }
  </style>

  <!-- Page-level styles injected by individual views -->
  <%- style %>

  <!-- Google Tag Manager -->
  <% if (typeof gtmId !== 'undefined' && gtmId) { %>
  <script nonce="<%= cspNonce %>">(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','<%= gtmId %>');</script>
  <% } %>

  <!-- GA4 -->
  <% const _gaId = (typeof ga4Id !== 'undefined' && ga4Id) ? ga4Id : _seo.google_analytics_id; %>
  <%/* gtag.js is fetched on the visitor's first interaction, or 3s after this
       script runs, whichever comes first — NOT with the page. Measured
       2026-09-22 on throttled mobile (5 runs each): loading it with the page
       cost ~250ms of LCP (2744ms vs 2492ms median) plus the page's only long
       main-thread task (86ms), because 162KB of async script competes for
       bandwidth with the hero image on a slow connection.

       The dataLayer queue below is filled immediately, so the pageview keeps
       the real URL and referrer and is sent as soon as the script arrives.
       KNOWN TRADE: a visitor who leaves within ~3s without touching anything
       is not counted. The visibilitychange hook catches most tab-switchers;
       a hard close inside the window is lost.

       CSP: the injected <script> carries no nonce and does not need one —
       'strict-dynamic' trusts scripts added by an already-trusted script. */%>
  <% if (_gaId && !(typeof gtmId !== 'undefined' && gtmId)) { %>
  <script nonce="<%= cspNonce %>">
  window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
  gtag('js',new Date());gtag('config','<%= _gaId %>');
  (function(){
    var loaded=false,evts=['pointerdown','keydown','touchstart','scroll','wheel'],t;
    function load(){
      if(loaded)return;loaded=true;clearTimeout(t);
      evts.forEach(function(e){window.removeEventListener(e,load,{passive:true});});
      var s=document.createElement('script');
      s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=<%= _gaId %>';
      document.head.appendChild(s);
    }
    evts.forEach(function(e){window.addEventListener(e,load,{passive:true});});
    document.addEventListener('visibilitychange',function(){if(document.visibilityState==='hidden')load();});
    t=setTimeout(load,3000);
  })();
  </script>
  <% } %>
  <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body>

  <!-- GTM noscript -->
  <% if (typeof gtmId !== 'undefined' && gtmId) { %>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%= gtmId %>"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <% } %>

  <!-- Cart drawer (included once, JS toggles visibility) -->
  <%- include('../partials/cart-drawer') %>

  <%- include('../partials/header') %>

  <main id="main-content">
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <!-- Auth state for client-side heart toggle -->
  <script nonce="<%= cspNonce %>">window.__bvoIsLoggedIn = <%= (typeof isLoggedIn !== 'undefined' && isLoggedIn) ? 'true' : 'false' %>;</script>

  <!-- CSRF: patch fetch to include token on all non-GET requests -->
  <script nonce="<%= cspNonce %>">
  (function(){
    var _f = window.fetch;
    window.fetch = function(url, opts){
      opts = opts || {};
      if (!opts.method || opts.method.toUpperCase() === 'GET') return _f(url, opts);
      opts.headers = opts.headers || {};
      var t = document.querySelector('meta[name="csrf-token"]');
      if (t) opts.headers['X-CSRF-Token'] = t.content;
      return _f(url, opts);
    };
  })();
  </script>

  <!-- Site JS -->
  <script nonce="<%= cspNonce %>" src="/js/site.js?v=9" defer></script>
  <!-- Carousel binding by data attribute — supports duplicated sections.
       site.js still contains the old id-based blocks; they no-op because
       index.ejs no longer emits those ids. See public/js/carousels.js. -->
  <%# v=2 — added variant navigation for product cards. The .htaccess sets
      long cache headers on /js, so returning visitors would keep v=1 and
      their size chips would swap the photo without navigating. %>
  <script nonce="<%= cspNonce %>" src="/js/carousels.js?v=2" defer></script>

  <!-- Page-level scripts -->
  <%- script %>

  <!-- Scroll to top -->
  <button id="scrollTopBtn" class="scroll-top-btn" aria-label="Back to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
  </button>

  <!-- Tidio Live Chat -->
  <% if (typeof tidioKey !== 'undefined' && tidioKey) { %>
  <script nonce="<%= cspNonce %>" src="//code.tidio.co/<%= tidioKey %>.js" async></script>
  <% } %>

  <%/* Sort dropdowns submit their form on change. Delegated here instead of
       onchange="" attributes, which the CSP (script-src-attr 'none') blocks. */%>
  <script nonce="<%= cspNonce %>">document.addEventListener('change',function(e){var s=e.target&&e.target.closest?e.target.closest('select[data-autosubmit]'):null;if(s&&s.form)s.form.submit();});</script>

</body>
</html>
