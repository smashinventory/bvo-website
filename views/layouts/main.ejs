<%
/* ── Build dynamic Google Fonts URL ───────────────────────────── */
const _d      = (settings && settings.design) ? settings.design : {};
const _seo    = (settings && settings.seo)    ? settings.seo    : {};
const _colors = _d.colors || {};
const _hFont  = _d.heading_font || 'Georgia';
const _bFont  = _d.body_font    || 'system-ui';
const _baseSize = parseInt(_d.base_size_px) || 16;
const _hWeight  = _d.heading_weight || '600';
const _btnR     = _d.button_radius  || '6px';
const _cardR    = _d.card_radius    || '12px';

/* Fonts. The whole list of allowed choices lives in src/utils/fontStacks.js
   — see the header there for Sam's rule. Every option is already on the
   device, so the storefront downloads NO font files and there is no code
   path here that can produce one.

   fontStacks.resolve() is the enforcement point, not the dropdown: theme
   settings also arrive from data/theme_settings.json and the app_settings
   DB row, neither of which passes through the admin form. Anything not on
   the list — a legacy 'Lora', a hand-edited value — resolves to the default
   instead of being emitted. Nothing from settings reaches the <style> block
   verbatim, which is the same reason _safeColor exists below (MED-3).

   WHAT WAS HERE BEFORE, 2026-09-24: a Google Fonts URL built from the two
   settings, two preconnects, a preload, a nonced swap script and a noscript
   fallback. All removed. If a webfont is ever wanted again, read
   docs/briefs/BVO_TYPOGRAPHY_DECISION.md first — self-hosting is the answer,
   not this. */
/* fontStacks arrives as res.locals (src/server.js, beside ownedImageHosts).
   If it is ever absent this layout must still render: it is the layout for
   EVERY public page, so a missing local here is not a typography bug, it is
   a site-wide 500. Seen for real on 2026-09-24 when a gate rendered this
   template without the local and every page threw
   "_fonts.resolve is not a function".

   The two literals below duplicate fontStacks.DEFAULT_* deliberately —
   normally a Rule 10 violation, but a last-resort fallback cannot import
   the thing it is a fallback for. They are only ever reached when the
   module is missing entirely, and G2 asserts the normal path agrees with
   fontStacks, so the two cannot silently diverge in what actually ships. */
const _fonts = (typeof fontStacks !== 'undefined' && fontStacks
                && typeof fontStacks.resolve === 'function') ? fontStacks : null;
const _serifStack = _fonts
  ? _fonts.resolve(_hFont, _fonts.DEFAULT_HEADING)
  : 'Georgia, Cambria, "Times New Roman", serif';
const _sansStack = _fonts
  ? _fonts.resolve(_bFont, _fonts.DEFAULT_BODY)
  : 'system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif';

// CSS color overrides — validate hex before injecting into <style> block (MED-3)
const _hexRe = /^#[0-9a-fA-F]{3}$|^#[0-9a-fA-F]{6}$/;
function _safeColor(val, def) { return (val && _hexRe.test(val.trim())) ? val.trim() : def; }
const _navyC   = _safeColor(_colors.navy,    '#182840');
const _amberC  = _safeColor(_colors.amber,   '#926A21');
const _sageC   = _safeColor(_colors.sage,    '#5A7A5A');
const _whisperC= _safeColor(_colors.whisper, '#F8F6F2');
const _whiteC  = _safeColor(_colors.white,   '#FFFFFF');

// SEO
const _pageTitle = typeof pageTitle !== 'undefined' && pageTitle
                 ? pageTitle : (_seo.home_title || 'BathroomVanitiesOutlet.com');
const _metaDesc  = typeof metaDesc !== 'undefined' && metaDesc
                 ? metaDesc : (_seo.home_description || '');
const _ogImg     = _seo.og_image || '/images/og-default.jpg';
const _ogTitle   = (typeof ogTitle !== 'undefined' && ogTitle) ? ogTitle : (_seo.og_title || _pageTitle);
const _ogDesc    = (typeof ogDesc  !== 'undefined' && ogDesc)  ? ogDesc  : (_seo.og_description || _metaDesc);
const _siteName  = (settings && settings.global) ? (settings.global.site_name || 'BathroomVanitiesOutlet.com') : 'BathroomVanitiesOutlet.com';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <%/* CSP as a meta tag - see CSP_DIRECTIVES in src/server.js for why. Must be
       the first thing after charset: a meta policy only governs what comes
       after it. Empty (not rendered) unless the rollout switch is on. */%>
  <% if (typeof cspMeta !== 'undefined' && cspMeta) { %><meta http-equiv="Content-Security-Policy" content="<%= cspMeta %>"><% } %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- SEO -->
  <title><%= _pageTitle %></title>
  <meta name="description" content="<%= _metaDesc %>">

  <!-- Canonical + robots -->
  <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <% } %>
  <% if (typeof noindex !== 'undefined' && noindex) { %>
  <meta name="robots" content="noindex,follow">
  <% } %>

  <!-- Sitemap discovery -->
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <%# ── Favicon + touch icon ───────────────────────────────────────────
       Both links used to point at BVOLOGOSQ_512.png — a 512x512, 19 KB
       master — to draw a 16-32px tab icon. GTmetrix 2026-09-23 caught it
       as a 22.7 KB request, and it came off the ORIGIN, not Bunny, so it
       competed with the HTML and CSS on the one connection that already
       costs ~598 ms to establish.

       Sizes are declared so the browser fetches ONE file, not all of them:
           favicon-32.png        1.4 KB   what a normal page load takes
           favicon-16.png        0.6 KB   older/smaller chrome
           apple-touch-icon.png  9.2 KB   iOS only, and only on "add to
                                          home screen" — never a page load
           /favicon.ico          4.6 KB   never referenced; it exists so
                                          clients that request the root
                                          path blindly get 200, not 404

       17.5 KB off every page load.

       THE ARTWORK IS NOT THE FULL LOGO. Scaling the badge to 32px turns
       it to mud: the gold ring, the white frame and "EST. 2019" eat the
       tile and leave "BVO" a few pixels tall. These are rebuilt — brand
       navy rgb(29,45,68), with the BVO glyphs lifted from the master at
       full resolution (crop 147,206-370,283) and set to 80% of the tile.
       Same colours, same letterforms, legible at 16px.

       All three are rounded. The tab icons have TRANSPARENT corners, so
       they blend into light or dark browser chrome. The iOS one is
       rounded too but its corners are filled WHITE, never transparent:
       iOS discards alpha and composites on black, which would wrap navy
       artwork in black wedges. At 20% radius those corners fall outside
       iOS's own ~22.5% superellipse mask, so iOS clips them away and the
       double-rounding never shows.

       Regenerate from the 512 master with Pillow if the logo changes. %>
  <%# ── 192 ADDED 2026-10-03: GOOGLE WOULD NOT SHOW ANY OF THE ABOVE ──
      The SERP showed a generic globe while the browser tab showed BVO
      correctly — which is exactly what a size floor looks like. Google
      requires the favicon to be a SQUARE MULTIPLE OF 48px (48, 96, 144,
      192). 32 and 16 are both under it, and apple-touch-icon at 180 is a
      supported type but not a multiple of 48, so Google had nothing it
      would accept and fell back to the globe.

      192 is declared FIRST so Google takes it. Browsers ignore it for a
      tab: they match on `sizes` and still fetch the 32, so the page-weight
      work above is intact — the 192 is only ever requested by Google's
      favicon crawler, which runs on its own schedule, not on page load.

      Expect days to weeks before the SERP updates. Google refetches
      favicons rarely and independently of page crawls. %>
  <link rel="icon" type="image/png" sizes="192x192" href="/images/logos/favicon-192.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/logos/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/logos/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/logos/apple-touch-icon.png">

  <!-- Open Graph -->
  <meta property="og:title"       content="<%= _ogTitle %>">
  <meta property="og:description" content="<%= _ogDesc %>">
  <meta property="og:image"       content="<%= _ogImg %>">
  <meta property="og:image:alt"   content="<%= _seo.og_image_alt || _pageTitle %>">
  <meta property="og:type"        content="<% if (typeof product !== 'undefined' && product) { %>product<% } else { %>website<% } %>">
  <meta property="og:url"         content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : '' %>">
  <meta property="og:site_name"   content="<%= _siteName %>">
  <meta name="twitter:card"       content="summary_large_image">

  <%# No font preconnects. Every font BVO offers is already on the device —
     see src/utils/fontStacks.js. There is nothing to connect to. %>
  <!-- Bunny pull zone: serves the hero + every product and category image.
       Largest origin on the page by bytes; it had no hint while fonts had two. -->
  <link rel="preconnect" href="https://images.bathroomvanitiesoutlet.com">
  <%# The font CSS preload + nonced swap that used to sit here is gone with
     the webfonts, 2026-09-24. It was good engineering — preload beat
     media=print by ~970ms in a measured A/B — but it existed to make a
     download fast, and there is no longer a download. The reasoning is
     preserved in docs/briefs/BVO_TYPOGRAPHY_DECISION.md in case a
     self-hosted face is ever added. %>

  <%# ⚠️⚠️⚠️ READ THIS BEFORE TOUCHING site-bundle.css.
       On 2026-09-?? commit 83e81b4 rebuilt this bundle with a plain
       `cat brand.css site.css site2.css` and silently dropped 7,892
       bytes — the whole PUBLIC half of site4.css, 46 selector groups:
       checkout layout, PDP colour chips, nav touch targets, the split
       hero, the mobile mega-menu, button hover states, and the rule that
       stacks the bundle-teaser cards on a phone. Nothing failed. Every
       gate passed. The site just lost a layer of responsive polish on
       every page and stayed that way until the owner noticed cards that
       used to line up no longer did.

       THE BOUNDARY IS NOT A BYTE COUNT. It is the
       `/* ==== ORDER MANAGEMENT` banner comment inside site4.css:
       everything ABOVE it is public and belongs in this bundle,
       everything BELOW is admin-only and is loaded by layouts/admin.ejs.
       The old recipe below said `head -c 7984`, which drifts every time
       site4.css is edited and tells you nothing when it is wrong — that
       is a large part of why the loss was silent.

       gates/gate_bundle_slice.js now asserts byte-for-byte that the
       public slice is present and the admin half is not. Do not rebuild
       from the recipe; patch the source file and this bundle with the
       same edit, and run that gate. %>
  <%# CSS bundle: brand.css + site.css + site2.css concatenated into one file.
       One blocking request instead of three — eliminates 2 extra HTTP round trips on critical path.
       SOURCE FILES: public/css/brand.css, site.css, site2.css (edit these, then rebuild).
       REBUILD: DO NOT run a plain `cat brand.css site.css site2.css`.
       Verified 2026-09-06: site-bundle.css is brand + site + site2 PLUS the
       first 7984 bytes of site4.css -- the public responsive polish
       (checkout, PDP chips, nav touch targets). The rest of site4.css is
       admin-only and is loaded separately by layouts/admin.ejs. A plain cat
       silently drops those 7984 bytes from every public page.
         cat brand.css site.css site2.css > site-bundle.css
         head -c 7984 site4.css >> site-bundle.css   # was 8039 before 2026-09-23

       ** THIS RECIPE DOES NOT REPRODUCE THE FILE ON DISK. ** Measured
       2026-09-23: site4.css's first 7984 bytes do appear in the bundle,
       starting at offset 114503 -- but 4917 further bytes follow them
       that the recipe does not account for. Run the recipe as written
       and you lose those 4917 bytes. The discrepancy predates the
       2026-09-23 alignment change (it was 8043/4917 before). Do not
       rebuild from this recipe until someone works out what the tail
       is -- patch site4.css and site-bundle.css with the same edit
       instead, which is what 2026-09-23 did. Logged in OPEN_ITEMS.
       Better: patch site.css and site-bundle.css with the same edit and do
       not concatenate at all.
       Bump ?v= any time any source CSS changes to bust Hostinger CDN cache (CLAUDE.md Rule 5).

       CORRECTED 2026-08-31 — this comment previously listed site4.css as part
       of the bundle and told you to cat it in. That is WRONG. site4.css is
       ADMIN-ONLY and is loaded separately by views/layouts/admin.ejs. Adding
       it here ships ~23KB of admin CSS to every public visitor and grows the
       bundle from 121KB to 137KB for no benefit. Do not add it. %>
  <%# BUMP THIS EVERY TIME site-bundle.css CHANGES. Without it the CDN and
      every returning visitor keep the previous file, so markup ships against
      a stylesheet that does not match it.
        v=22 (2026-10-01) card-stretch overlay for the homepage tiles
        v=23 (2026-10-01) footer grid retracked to 2 columns, trust-band and
                          footer-brand selectors moved off their old tags,
                          .footer-brand p max-width
        v=24 (2026-10-01) .hp-guide-preview scroll box on the homepage
        v=25 (2026-10-01) footer column labels h4 -> h2 (heading order)
        v=26 (2026-10-01) font-weight pinned on .section-title/.hero-h1 so
                          the "Label (not a heading)" option cannot unbold them
        v=39 (2026-10-05) samples banner switches at 769 (where .iwt-grid
                          stops being one column) not 861; guide-preview
                          subhead scoped instead of !important
        v=38 (2026-10-05) bundle-teaser rules REMOVED from the bundle -
                          all three bands are emitted inline now
        v=37 (2026-10-05) bundle-teaser 2x2 grid in the 601-900px tablet
                          band - the flex row wrapped 3+1 and stranded a +
        v=36 (2026-10-05) RESTORED the public slice of site4.css, dropped
                          by a plain cat in 83e81b4 - 7,892 bytes, 46
                          selector groups, missing from every public page
        v=35 (2026-10-05) .sb-banner alignment rules — the samples banner
                          centres on mobile and reads the desktop choice
                          from --sb-* custom properties
      The source rules live in site.css / site2.css and are hand-minified
      into this bundle, per the instruction above — those files reach no
      browser on their own. %>
  <link rel="stylesheet" href="/css/site-bundle.css?v=39">
  <%# ── SECTION VISIBILITY, FROM THE OWNER'S BREAKPOINTS ─────────────
      "Visible on" offered All / Desktop / Mobile and was implemented as
      two rules hardcoded at 861px. There was no Tablet option because
      there was no tablet band — which is also why the editor's Tablet
      preview button appeared broken: at 768px the site rendered its
      mobile layout, correctly, because 860 was the only line it knew.

      Now the three bands come from Theme Editor > Breakpoints, and a
      section can be shown on exactly one of them.

      EMITTED INLINE, not added to a stylesheet, deliberately. Verified
      2026-09-29: public/css/site4.css is linked ONLY by the admin
      layout, and site-bundle.css does not contain its storefront rules —
      which is why site4's `@media (max-width:480px){.site-nav{padding:0
      12px}}` has never once applied to a shopper. Anything the owner
      controls has to reach the page without depending on a bundle
      rebuild. See src/utils/breakpoints.js. %>
  <% if (typeof breakpoints !== 'undefined' && breakpoints) { %>
  <style nonce="<%= cspNonce %>"><%- breakpoints.visibilityCss(breakpoints.resolve(settings || {})) %></style>
  <%# The bundle teaser's three bands. Its lower edge is the owner's
      mobile_max; its upper edge is bundleTeaserNeeds(), arithmetic about
      the component rather than about devices. Emitted here for the same
      reason as the block above — it cannot go stale against a bundle.
      Every selector is .bt-*, which exists only in the bundle_teaser
      block of views/pages/index.ejs, so this matches nothing anywhere
      else even though it ships on every page. %>
  <style nonce="<%= cspNonce %>"><%- breakpoints.bundleTeaserCss(breakpoints.resolve(settings || {})) %></style>
  <% } %>
  <%# site3.css: Trust signals, checkout, CMS pages, blog, inspiration guides.
      Loaded conditionally per-page via the `style` slot below, not globally
      (perf: saves 37KB blocking CSS on homepage/collections/products).

      THIS WAS AN HTML COMMENT UNTIL 2026-09-23 AND IT CONTAINED A LIVE EJS
      TAG. EJS does not know what an HTML comment is, so the tag was
      evaluated here as well as in its real slot, and the entire extracted
      style payload -- the site3 link, all three hero preloads and every
      inline <style> block, 6933 bytes -- shipped twice on every page.
      Measured in the served HTML: two copies at a constant 8417-byte
      offset. Do not write an EJS tag inside a comment; use an EJS comment. %>

  <%# Design tokens: CSS var aliases resolved before external CSS (prevents cascade gaps) %>
  <style>
