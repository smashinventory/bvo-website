  <%# v=2 — added variant navigation for product cards. The .htaccess sets
      long cache headers on /js, so returning visitors would keep v=1 and
      their size chips would swap the photo without navigating. %>
  <script nonce="<%= cspNonce %>" src="/js/carousels.js?v=4" defer></script>

  <!-- Page-level scripts -->
  <%- script %>

  <!-- Scroll to top -->
  <button id="scrollTopBtn" class="scroll-top-btn" aria-label="Back to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
  </button>

  <!-- Tidio Live Chat -->
  <% if (typeof tidioKey !== 'undefined' && tidioKey) { %>
  <script nonce="<%= cspNonce %>" src="//code.tidio.co/<%= tidioKey %>.js" async></script>
  <% } %>

  <%/* Sort dropdowns submit their form on change. Delegated here instead of
       onchange="" attributes, which the CSP (script-src-attr 'none') blocks. */%>
  <script nonce="<%= cspNonce %>">document.addEventListener('change',function(e){var s=e.target&&e.target.closest?e.target.closest('select[data-autosubmit]'):null;if(s&&s.form)s.form.submit();});</script>

</body>
</html>
