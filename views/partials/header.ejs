<% const S = settings || {}; const ps = S.promo_strip || {}; const nav = S.nav || {}; %>

<!-- ── Promo strip ──────────────────────────────────────────────── -->
<% if (ps.enabled !== false) { %>
<%
  /* Always apply inline bg/text so the CSS default is never relied on.
     Empty string means "not set" — fall back to brand navy / white. */
  var _psBg   = ps.bg_color   || '#182840';
  var _psFg   = ps.text_color || '#ffffff';
  var _psStyle = 'background:' + _psBg + ';color:' + _psFg + ';';
%>
<div class="promo-strip" role="banner" aria-label="Promotional announcement" style="<%= _psStyle %>">
  <%= ps.message || 'Free Shipping on Every Order' %>
  <% if (ps.link_url && ps.link_text) { %>
  &nbsp;·&nbsp; <a href="<%= ps.link_url %>" style="color:inherit"><strong><%= ps.link_text %> →</strong></a>
  <% } %>
</div>
<% } %>

<!-- ── Site navigation ──────────────────────────────────────────── -->
<header class="site-header">
  <nav class="site-nav" aria-label="Main navigation">

    <!-- Logo — editable via Theme Editor > Navigation > Logo -->
    <%
      var _navCfg   = nav || {};
      var _logoSrc  = _navCfg.logo_url    || '/images/logos/BVOLOGOSQ_512.png';
      var _logoW    = parseInt(_navCfg.logo_width)  || 90;
      var _logoH    = parseInt(_navCfg.logo_height) || 90;
      var _logoAlt  = _navCfg.logo_alt    || ((S.global || {}).site_name || 'BathroomVanitiesOutlet.com') + ' logo';

      /* ══ HEADER SIZING, PER BAND ═══════════════════════════════════════
         Owner, 2026-09-29: "help me take control as opposed to you
         hardcoding."

         What this replaces, and why it was not working:

           - The old block wrote ONE rule, at (min-width:861px). Below that
             site.css pinned .nav-logo to 90x90 and .site-nav to 106px, so
             on a phone the Theme Editor's Logo Width/Height did nothing at
             all. Commit f46d687 said "Phones keep 90px on purpose"; that
             purpose has expired.
           - .site-nav's padding (40px) and gap (28px) had no mobile rule
             that reaches the storefront, so a 375px phone laid out
             40+90+28+160+28+24+40 = 410px of content in a 375px bar and
             clipped the hamburger. site4.css DOES carry a 480px override
             — but site4.css is linked only by the ADMIN layout, and the
             storefront's site-bundle.css does not contain it. Verified
             2026-09-29. See src/utils/breakpoints.js.

         Now: three bands from the owner's own numbers, emitted inline so
         no stale bundle can swallow them. An empty setting inherits the
         band above, so only the differences need filling in.

         Widths and heights are clamped; padding and gap are not allowed
         to be negative. A 0 is a legitimate value and must survive — only
         '' means "not set", hence the String()!=='' tests. */
      /* breakpoints comes from res.locals (src/server.js) — an EJS
         template cannot require(). Guarded because header.ejs is also
         rendered by the 404 and error pages, which bypass some
         middleware; a missing local must not take the error page down
         as well. */
      var _bpMod = (typeof breakpoints !== 'undefined' && breakpoints)
        ? breakpoints
        : { resolve: function () {
              return { mq: { mobile:  '(max-width:600px)',
                             tablet:  '(min-width:601px) and (max-width:1024px)',
                             desktop: '(min-width:1025px)' } };
            } };
      var _bp = _bpMod.resolve(S);

      var _numOr = function (v, fallback) {
        if (v === undefined || v === null || String(v).trim() === '') return fallback;
        var n = parseInt(v, 10);
        return Number.isFinite(n) ? n : fallback;
      };
      var _clampLogo = function (v) { return Math.min(Math.max(v, 16), 400); };
      var _clampBox  = function (v) { return Math.min(Math.max(v, 0), 200); };

      /* Desktop is the base every other band falls back to. */
      var _band = {
        desktop: {
          lw:  _clampLogo(_numOr(_navCfg.logo_width,  90)),
          lh:  _clampLogo(_numOr(_navCfg.logo_height, 90)),
          pad: _clampBox(_numOr(_navCfg.pad_desktop, 40)),
          gap: _clampBox(_numOr(_navCfg.gap_desktop, 28)),
          h:   _numOr(_navCfg.height_desktop, 106),
        }
      };
      ['tablet', 'mobile'].forEach(function (b) {
        var base = _band.desktop;
        _band[b] = {
          lw:  _clampLogo(_numOr(_navCfg['logo_width_'  + b], base.lw)),
          lh:  _clampLogo(_numOr(_navCfg['logo_height_' + b], base.lh)),
          pad: _clampBox(_numOr(_navCfg['pad_'    + b], base.pad)),
          gap: _clampBox(_numOr(_navCfg['gap_'    + b], base.gap)),
          h:   _numOr(_navCfg['height_' + b], 0),
        };
      });

      /* Bar height: an explicit value wins; otherwise it grows to hold the
         logo. Never shorter than the logo plus breathing room, or the logo
         overflows the bar it lives in. */
      var _barH = function (bd, floor) {
        return bd.h > 0 ? Math.max(bd.h, bd.lh + 8) : Math.max(floor, bd.lh + 16);
      };

      var _navCss = ''
        + '@media ' + _bp.mq.mobile + '{'
          + '.nav-logo{width:' + _band.mobile.lw + 'px;height:' + _band.mobile.lh + 'px}'
          + '.site-nav{padding:0 ' + _band.mobile.pad + 'px;gap:' + _band.mobile.gap + 'px;'
          + 'height:' + _barH(_band.mobile, 64) + 'px}'
        + '}'
        + '@media ' + _bp.mq.tablet + '{'
          + '.nav-logo{width:' + _band.tablet.lw + 'px;height:' + _band.tablet.lh + 'px}'
          + '.site-nav{padding:0 ' + _band.tablet.pad + 'px;gap:' + _band.tablet.gap + 'px;'
          + 'height:' + _barH(_band.tablet, 88) + 'px}'
        + '}'
        + '@media ' + _bp.mq.desktop + '{'
          + '.nav-logo{width:' + _band.desktop.lw + 'px;height:' + _band.desktop.lh + 'px}'
          + '.site-nav{padding:0 ' + _band.desktop.pad + 'px;gap:' + _band.desktop.gap + 'px;'
          + 'height:' + _barH(_band.desktop, 106) + 'px}'
        + '}'

        /* ══ WHERE THE HAMBURGER TAKES OVER ════════════════════════════
           Owner-approved 2026-09-29. Follows the TABLET band instead of
           the 860px that was hardcoded in site-bundle.css.

           What was wrong, measured on the live site:

             861px  the hamburger switched off and the full desktop menu
                    switched on — but logo + brand + six links + icons
                    needs 1,222px. From 861 to 1,231 the icon cluster was
                    pushed past the right edge and simply absent. No
                    search, no account, no wishlist, NO CART. That is
                    every iPad in landscape (1024) and the 11-inch Pro
                    (1180).

           The breakpoint was not the only problem. The Vanities megamenu
           opens on :hover / :focus-within / pointerenter, and a touch
           screen has no hover — so even at a width where it fitted, the
           main route into the catalogue was unreliable on an iPad. The
           mobile accordion is tap-driven and already works.

           So the desktop menu now waits until the Desktop band. Below
           that the hamburger runs, at any width, including the tablet
           sizes it never used to cover.

           No !important: these rules sit later in the document than the
           stylesheet, so they win on order at equal specificity. If a
           future rule outranks them the gate's width sweep catches it.

           ══ ONE LIST, TWO LAYOUTS — rewritten 2026-10-02 ══════════════
           The .nav-links list used to be display:none here and a separate
           #mobile-menu took over. Now the SAME list becomes the off-canvas
           panel, because there is only one list.

           Below Desktop:
             .nav-links is the panel — fixed, off-screen, slid in by
             .is-open from the hamburger. It is NOT display:none, so its
             links stay in the accessibility tree and stay crawlable in the
             one place they exist.
             <summary> shows its marker and the <details> start closed —
             the accordion, tap-driven, no JS.

           At Desktop:
             .nav-links is the horizontal bar again.
             The marker is hidden and .mega-menu is absolutely positioned,
             revealed by the existing :hover/:focus-within rules in
             site-bundle.css. Those rules are untouched.

           WHY THE PANEL IS NOT FORCED OPEN AT DESKTOP
             It cannot be. A <details> shows its content when the `open`
             ATTRIBUTE is present; CSS cannot set an attribute. Verified
             before relying on it. So the desktop dropdown does not depend
             on open state at all — .mega-menu is positioned and revealed
             on hover exactly as before, which works whether the <details>
             happens to be open or shut. A desktop visitor who clicks the
             summary opens it; the hover rules still show the same panel in
             the same place, so nothing looks different. */
        + '@media ' + _bp.mq.upToTablet + '{'
          + '.nav-brand{display:none}'
          + '.nav-hamburger{display:flex}'
          /* The list IS the drawer below Desktop. Was display:none. */
          + '.nav-links{display:block;position:fixed;top:0;left:0;bottom:0;'
          + 'width:min(86vw,360px);z-index:1200;background:#fff;'
          + 'padding:72px 0 32px;margin:0;overflow-y:auto;'
          + '-webkit-overflow-scrolling:touch;'
          + 'transform:translateX(-100%);transition:transform .25s ease;'
          + 'box-shadow:2px 0 24px rgba(0,0,0,.18)}'
          + '.nav-links.is-open{transform:translateX(0)}'
          + '.nav-links>li{display:block;border-bottom:1px solid #eee}'
          + '.nav-links>li>a,.nav-mega-trigger{display:flex;'
          + 'align-items:center;justify-content:space-between;'
          + 'padding:14px 20px;font-size:1rem;cursor:pointer}'
          /* Panel flows inline under its summary — no absolute positioning,
             no hover, no fixed width. */
          + '.mega-menu{position:static;display:block;opacity:1;visibility:visible;'
          + 'width:auto;min-width:0;transform:none;box-shadow:none;'
          + 'border:0;padding:0 0 8px;background:#fafafa}'
          + '.mega-col{display:block;padding:4px 20px 12px;border:0}'
          + '.mega-col--promo{display:none}'
          + '.mega-link{padding:9px 0;font-size:.94rem}'
        + '}'
        + '@media ' + _bp.mq.desktop + '{'
          + '.nav-hamburger{display:none}'
          /* Marker hiding is NOT here. The summary carries its own SVG
             chevron, so the UA triangle is a duplicate affordance at every
             width, not just desktop - so it lives in site.css /
             site-bundle.css as .nav-disclosure>summary, unconditionally. */
        + '}';

      /* The <img> attributes stay on the DESKTOP numbers: they are there to
         reserve layout space against CLS, and the desktop size is the
         largest, so reserving it never under-reserves. */
      var _logoDW = _band.desktop.lw;
      var _logoDH = _band.desktop.lh;
    %>
    <style nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>"><%- _navCss %></style>
    <a href="/" class="nav-logo-link" aria-label="<%= (S.global || {}).site_name || 'BathroomVanitiesOutlet.com' %> — Home">
      <%
        /* Use WebP if the logo is the default square PNG — fall back to original for custom logos */
        var _logoWebp = (_logoSrc === '/images/logos/BVOLOGOSQ_512.png')
          ? '/images/logos/BVOLOGOSQ_512.webp'
          : null;
      %>
      <% if (_logoWebp) { %>
      <picture>
        <source srcset="<%= _logoWebp %>" type="image/webp">
        <img
          class="nav-logo"
          src="<%= _logoSrc %>"
          alt="<%= _logoAlt %>"
          width="<%= _logoW %>"
          height="<%= _logoH %>"
          loading="eager"
        >
      </picture>
      <% } else { %>
      <%/* Bunny logo: offer a resized copy to 1x screens. The stored file is
           512px for a 150px slot, so 1x downloads ~2.4x more than it shows.
           2x deliberately points at the ORIGINAL rather than ?width=300 —
           the resizer re-encodes, and at 300 the result measured 16KB
           against the original's 11.4KB. x-descriptors, not w: the slot is a
           fixed CSS size (150px desktop, 90px phones), not viewport-relative.
           Only for our own host, and only when the URL carries no query of
           its own. */%>
      <% var _logoRaw = String(_logoSrc || ''), _logoSet = '';
         if (_logoRaw.indexOf('images.bathroomvanitiesoutlet.com') !== -1 && _logoRaw.indexOf('?') === -1) {
           _logoSet = _logoRaw + '?width=' + _logoDW + ' 1x, ' + _logoRaw + ' 2x';
         } %>
      <img
        class="nav-logo"
        src="<%= _logoSrc %>"
        <% if (_logoSet) { %>srcset="<%= _logoSet %>"<% } %>
        alt="<%= _logoAlt %>"
        width="<%= _logoW %>"
        height="<%= _logoH %>"
        loading="eager"
      >
      <% } %>
    </a>

    <!-- Brand name -->
    <a href="/" class="nav-brand" tabindex="-1">
      <%= nav.brand_line1 || 'BathroomVanities' %><span><%= nav.brand_line2 || 'Outlet' %></span><%= nav.brand_line3 || '.com' %>
    </a>

    <!-- Primary links -->
    <ul class="nav-links" id="primary-nav" role="list">
      <% (nav.links || []).forEach(link => { %>
      <% if (link.megaMenu) { %>
      <%/* ── ONE NAV, TWO LAYOUTS — rebuilt 2026-10-02 ──────────────────

           WAS: this megamenu, plus a second hand-written copy of every
           link inside #mobile-menu further down the file. Both shipped in
           the HTML on every page; CSS showed one. Crawlers read both, which
           is 25 of the 27 duplicate-anchor-text groups the SEO tools report,
           and it meant two places to edit for one change.

           NOW: one list. <details> gives the mobile accordion natively —
           tap to expand, no JavaScript, and it works on touch where the
           desktop hover never did. At the Desktop band the CSS hides the
           marker and hover/focus-within reveals the panel as before.

           WHY <details> AND NOT A BUTTON + hidden
           The old drawer collapsed its sub-list with the `hidden` ATTRIBUTE,
           toggled by an inline script. `hidden` is global — it hides at
           every width — so shared markup cannot use it without blanking the
           desktop columns too. <details> carries its own open/closed state,
           so the same element can be a closed accordion on a phone and an
           open-on-hover panel on a desktop. The inline script is deleted.

           THE ONE BEHAVIOUR CHANGE, DELIBERATE AND FLAGGED
           The top-level "Vanities" was an <a> that both navigated and opened
           the menu. A <summary> is the toggle, and nesting a link inside it
           puts an interactive element inside an interactive element — so the
           destination moved to "Shop All Vanities", the first row in the
           panel. The listing is still one click from the nav, the anchor
           text still contains the keyword, and there is no nested control.

           Panel class names are UNCHANGED (.mega-menu, .mega-col,
           .mega-section, .mega-heading, .mega-link) so the existing desktop
           CSS keeps applying. Only the wrapper and the trigger are new. */%>
      <li class="has-mega">
        <details class="nav-disclosure">
          <summary class="nav-mega-trigger">
            <%= link.label %>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
        <div class="mega-menu" role="navigation" aria-label="<%= link.label %> menu">
          <%
            var _vm  = nav.vanities_mega || {};
            var _vml = _vm.links || [];
            var _vmp = _vm.promo || {};

            /* Admin-editable text -> plain prose. Strips tags and collapses
               whitespace, with a fallback when the field is blank.

               WHY IT EXISTS: these fields are printed with the ESCAPING
               output tag, so a tag typed into the Theme Editor is escaped
               and renders as visible raw markup rather than as formatting.
               The promo title shipped exactly that for months - the field's
               own help text used to tell admins to type a line-break tag.

               NOT solved by the unescaped output tag: that renders
               admin-editable text as live HTML, which is a script-injection
               hole in a field any admin can edit.

               Defined HERE, at the top of the block, rather than beside its
               first use further down. Function declarations hoist, so the
               late definition did work - but depending on hoisting across
               200 lines of template is not something to leave for the next
               person to discover. */
            function _plain(s, fb) {
              s = String(s == null ? '' : s).replace(/<[^>]*>/g, ' ')
                   .replace(/\s+/g, ' ').trim();
              return s || fb;
            }
          %>
          <!-- Left col: editable type links (admin) + dynamic size chips (DB) -->
          <div class="mega-col mega-col--links">
            <div class="mega-section">
              <%/* Carries the destination the old <a class="nav-mega-trigger">
                   used to have. Keyword-bearing anchor text, one click from
                   the bar, and reachable on touch where the hover trigger
                   was not.

                   Editable: Theme Editor -> Navigation -> Mega Menu.
                   Blank falls back to the default rather than hiding the row,
                   because this is the mega menu's ONLY link to the main
                   collection - see the note in themeSettings.js. */%>
              <a class="mega-link mega-link--all" href="<%= link.url %>"><%= _plain(_vm.all_label, 'All Bathroom Vanities') %></a>
            </div>
            <% if (_vml.length) { %>
            <div class="mega-section">
              <p class="mega-heading"><%= _vm.section_heading || 'Shop By Type' %></p>
              <% _vml.forEach(function(sl) { %>
              <a class="mega-link" href="<%= sl.url %>"><%= sl.label %></a>
              <% }) %>
            </div>
            <% } %>
            <div class="mega-section">
              <p class="mega-heading">Shop By Size</p>
              <%/* Dynamic: only sizes with ≥1 active vanity product — from megaMenuData middleware */%>
              <div class="mega-sizes">
                <% (typeof megaMenuSizes !== 'undefined' ? megaMenuSizes : []).forEach(function(sz) { %>
                <a class="mega-size-chip" href="<%= (typeof pathFilters !== 'undefined' && pathFilters.sizePath(sz)) ? '/collections/bathroom-vanities/size/' + pathFilters.sizePath(sz) : '/collections/bathroom-vanities?size_in=' + encodeURIComponent(sz) %>"><%= sz %>"</a>
                <% }) %>
              </div>
            </div>
          </div>
          <!-- Middle col: finish/color track — fully dynamic from DB -->
          <div class="mega-col mega-col--finish">
            <div class="mega-section">
              <p class="mega-heading">Shop By Finish</p>
              <%/* Dynamic: cabinet color families with ≥1 active vanity — labels from colorFamilies.js.
                * Rose, Sage, etc. appear automatically once matching products are imported. */%>
              <% (typeof megaMenuColorFamilies !== 'undefined' ? megaMenuColorFamilies : []).forEach(function(fam) { %>
              <a class="mega-link" href="<%= (typeof pathFilters !== 'undefined' && pathFilters.finishPath(fam.key)) ? '/collections/bathroom-vanities/finish/' + pathFilters.finishPath(fam.key) : '/collections/bathroom-vanities?color_family=' + fam.key %>"><%= fam.label %> Vanities</a>
              <% }) %>
            </div>
          </div>
          <!-- Style col: canonical BVO style buckets — from settings -->
          <% var _vms = _vm.style_links || []; %>
          <% if (_vms.length) { %>
          <div class="mega-col mega-col--style">
            <div class="mega-section">
              <%/* WAS nine hardcoded <a> here AND nine more in #mobile-menu.
                   Now one list in themeSettings.js (nav.vanities_mega.style_links),
                   rendered once. Same nine destinations, same nine labels. */%>
              <p class="mega-heading"><%= _vm.style_heading || 'Shop By Style' %></p>
              <% _vms.forEach(function(sl) { %>
              <a class="mega-link" href="<%= sl.url %>"><%= sl.label %></a>
              <% }) %>
            </div>
          </div>
          <% } %>
          <!-- Right col: promo card — editable in admin theme editor -->
          <div class="mega-col mega-col--promo">
            <%/* CARD IS NOT A LINK — changed 2026-10-01.

                 This was <a class="mega-promo-card"> around the whole card, so
                 the link's anchor text was the eyebrow, the title, the sub and
                 the CTA concatenated — 155 characters reading:
                   "Our Collections Every Model, Every Finish Save Time and
                    Find the Right Vanity Quickly with Our Advanced AI DRIVEN
                    Smart Filtering. Browse All Collections"
                 Google reads anchor text to decide what a link is about, and
                 that names no single subject.

                 The link now sits on the title and carries .card-stretch,
                 whose ::after overlay covers the card — whole card still
                 clickable, destination unchanged, anchor text is just the
                 title. Same change as the homepage tiles (commit f259c30).

                 .card-stretch is defined once, at the end of site2.css and in
                 site-bundle.css. It needs its container positioned, which is
                 why .mega-promo-card gains position:relative. */%>
            <%/* PRE-EXISTING BUG, fixed here 2026-10-02. Not caused by the nav
                 rewrite - found while diffing the rendered anchor list against
                 the old one.

                 The stored title in data/theme_settings.json literally
                 contains a br tag, and it is printed with the ESCAPING output
                 tag, so the tag is HTML-escaped rather than rendered. The card
                 has been displaying the raw characters of that tag on screen,
                 visible to shoppers, and the same string was the anchor text
                 of the link.

                 NOT fixed by switching to the unescaped output tag. That
                 renders admin-editable text as live HTML, which is a
                 script-injection hole in a field any admin can edit. And a
                 line break inside anchor text is poor anchor text regardless
                 of whether it renders.

                 (This comment deliberately does not spell those two EJS tags
                 out. EJS scans the raw template text for its delimiters and
                 does not care that they sit inside a comment - writing them
                 here is what broke this file once already.)

                 Fixed by stripping tags and collapsing the whitespace, so the
                 title reads "Every Model, Every Finish". Stripping happens HERE
                 rather than only in the defaults because the settings FILE wins
                 over the defaults on a deep merge - a defaults-only fix would
                 change nothing on the live site. The default is corrected too,
                 so a fresh environment does not reintroduce it. */%>
            <div class="mega-promo-card">
              <p class="mega-promo-eyebrow"><%= _plain(_vmp.eyebrow, 'Our Collection') %></p>
              <p class="mega-promo-title"><a href="<%= _vmp.url || '/collections/vanity-models' %>" class="card-stretch"><%= _plain(_vmp.title, 'Every Model, Every Finish') %></a></p>
              <p class="mega-promo-sub"><%= _vmp.sub || '' %></p>
              <span class="mega-promo-cta"><%= _vmp.cta || 'Browse All Collections' %> &rarr;</span>
            </div>
          </div>
        </div>
        </details>
      </li>
      <% } else { %>
      <li><a href="<%= link.url %>"<%= link.highlight ? ' class="nav-link-sale"' : '' %>><%= link.label %></a></li>
      <% } %>
      <% }) %>
    </ul>

    <!-- Icon group: search · account · cart -->
    <div class="nav-icons" aria-label="Site utilities">

      <button class="nav-icon-btn" aria-label="Open search" aria-expanded="false"
              aria-controls="site-search-bar" id="nav-search-btn">
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/>
        </svg>
      </button>

      <%/* THE LABEL IS TEXT IN THE LINK, NOT AN aria-label — changed 2026-10-02.

           These three were icon-only links carrying aria-label and nothing
           else. Correct markup, and screen readers were always fine, but a
           crawler reads link TEXT and does not count aria-label — so
           seobility reported "3 links don't have an anchor text".

           REPLACED rather than added alongside. If a link has an aria-label
           AND text inside it, the aria-label wins the accessible name and
           the text is never announced: two labels saying the same thing,
           one of them dead and free to drift. One source now, which serves
           the screen reader and the crawler at once.

           .sr-only is clipped (position:absolute; clip:rect(0,0,0,0)), NOT
           display:none — that distinction is the whole point. Clipped text
           is read by crawlers and announced by assistive tech; display:none
           text is neither. Same pattern as the "View Details" buttons.

           Nothing visual changes: the span renders at 1px and is clipped.

           Checked before removing the attributes: no JavaScript writes to
           these three aria-labels. (site.js DOES rewrite aria-label on the
           .heart-btn wishlist buttons on product cards — different elements,
           untouched.)

           The cart count lives in the span now, so there is one source for
           it too; the visible badge stays aria-hidden and is not read twice.

           SEO value here is zero and that is fine: robots.txt disallows
           /cart and /account/, so none of these are crawled. This exists to
           clear a report warning, nothing more. */%>
      <a href="/account" class="nav-icon-btn">
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
        <%/* Wording matches the mobile drawer's VISIBLE labels exactly (see
             the <li> list further down: "My Account", "Saved Items",
             "Cart (n)"). These three are invisible, the drawer's are not, so
             the hidden copy follows the visible one rather than the reverse.

             They disagreed until 2026-10-02: desktop sentence case, drawer
             title case. That mismatch was hidden while these were
             aria-labels and only surfaced once they became link text. */%>
        <span class="sr-only">My Account</span>
      </a>

      <a href="/account/favorites" class="nav-icon-btn nav-favorites-btn">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="sr-only">Saved Items</span>
      </a>

      <a href="/cart" class="nav-icon-btn nav-cart-wrap">
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <% if (cart.count > 0) { %>
        <span class="nav-cart-badge" aria-hidden="true"><%= cart.count %></span>
        <% } %>
        <span class="sr-only">Cart (<%= cart.count %>)</span>
      </a>

    </div>

    <%/* aria-controls was "mobile-menu", which no longer exists — a dangling
         reference is an accessibility error, not a cosmetic one. It now points
         at the one nav list, which is what this button actually opens. */%>
    <button class="nav-hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="primary-nav">
      <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" fill="none" stroke-width="2" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>

  </nav>

  <!-- ── Search bar (hidden until icon click) ────────────────────── -->
  <div class="site-search" id="site-search-bar" role="search" aria-label="Search products">
    <div class="site-search-inner">
      <label for="search-input" class="sr-only">Search products</label>
      <svg class="site-search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none"
        stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/>
      </svg>
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="Search vanities, faucets, mirrors…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search products"
        aria-controls="search-results"
        aria-autocomplete="list"
      >
      <div id="search-results" class="search-results-wrap" hidden role="listbox" aria-label="Search suggestions"></div>
    </div>
  </div>

  <%/* ── #mobile-menu DELETED 2026-10-02 ───────────────────────────────

         A second copy of the whole navigation lived here: every top-level
         link, all nine type links, every colour family, nine more style
         links, and three utility rows. ~45 anchors, duplicating ~45 anchors
         200 lines above. Both copies were in the HTML on every page; CSS
         showed one, crawlers read both.

         Replaced by nothing. <ul class="nav-links"> above is now the only
         navigation, and the inline breakpoint CSS turns it into this
         off-canvas panel below the Desktop band.

         ALSO DELETED: the accordion <script> that used to sit here. The
         <details> elements in the list do the same job natively, so there
         is one less script in the header and one less thing to break with
         JS off.

         THREE LINKS THAT LIVED ONLY IN THE DRAWER, and where they went:
           "Browse All Collections"  -> the promo card's CTA in the panel
           "My Account"              -> .nav-icons, as .sr-only text
           "Saved Items"             -> .nav-icons, as .sr-only text
           "Cart (n)"                -> .nav-icons, as .sr-only text
         .nav-icons renders at every width, so none of these became
         unreachable on a phone.

         If this needs undoing: bash restore_nav.sh — it restores the
         template AND both stylesheets from tag nav-pre-rewrite as a set,
         because a template restored without its CSS looks worse than the
         bug you were escaping. */%>

</header>
