node_modules/
.env
.env.local
uploads/csv/*.csv
public/images/products/
*.log
.DS_Store
coverage/
dist/

# Runtime-editable settings — saved by the admin UI; must NOT be overwritten by git pull
data/theme_settings.json

# Operational scratchpad — rollback docs and one-off push scripts
ROLLBACK_*.md
git_push_*.sh

# Gate harness scratch — regenerated by the push script each run
.gates.*.py
.gates.loader.py
.dryrun.sh
git_push_top_options.sh
git_push_bundle_cache.sh
git_push_migration_safety.sh
git_push_verify_fixes.sh
git_push_swatches_and_samples.sh

# Editor/scratch copies kept on disk, never in git (2026-09-22 clean-up).
# Every *.bak-<tag>-<timestamp> file is a hand-made snapshot from an earlier
# edit; git already holds those versions. The -1 files are working copies of
# a page or controller, NOT alternates the app loads — adding them once cost
# a 1,171-line accidental commit.
*.bak
*.bak[0-9]
*.bak-*
*-1.ejs
*-1.js

# Admin password hash (config/admin.hash). Must never enter git.
#
# ANCHORED WITH A LEADING SLASH — corrected 2026-10-02.
# This was a bare `config/`, which in gitignore matches a directory of that
# name at ANY depth. So it silently ignored src/config/ as well, where the
# application's config MODULES live. The four files already in there
# (colorFamilies, database, orderStatuses, sizeBuckets) were unaffected only
# because git had already begun tracking them — .gitignore does not apply to
# tracked files. Every NEW file added to src/config was invisible to git.
#
# Found when src/config/filterLandingPages.js — the entire content map for
# the filter landing pages — failed `git check-ignore`. It would have been
# left out of the commit, and `git add` erroring on an explicitly-named
# ignored path would have aborted the push script after the gates had run.
#
# /config/ matches only the directory at the repository root, which is the
# one holding admin.hash. Verified both directions after the change.
/config/

# Local scratch only: _to_delete is the holding pen for files this Mac
# cannot rm, `instant` is stray gate-harness output, git_amend_*.sh is a
# one-off history-repair script (git_push_*.sh is already ignored above).
_to_delete/
instant
git_amend_*.sh
# git_rollback_*.sh is the undo twin of a push script — same kind of one-off
# operational file, not part of the codebase. The durable record of HOW to
# roll a change back lives in docs/, not in a shell script that may be absent.
git_rollback_*.sh

# Local pre-change CSS backups (2026-09-29). Git history is the real
# backup; these exist so a rollback needs no git knowledge.
public/css/_backup/

# Local pre-change backups (model card scope work, 2026-09-29).
_backup/
scripts/out/
